@using BLAZAM.Common.Exceptions
@inherits AppModalContent
@inject BLAZAM.Services.Analytics AnalyticsService

<MudSimpleTable Class="mud-width-full p-5 m-5">
    <thead>
        <tr>
            <th>@AppLocalization[Lang.Delegate]</th>
            <th>@AppLocalization[Lang.Access_Level]</th>
            <th>@AppLocalization[Lang.Permission_Mapping]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <StatusCheck Status="@(_delegate?.Id>0)" Text="@(_delegate?.Id>0?"Use existing":"Will be created")" />
            </td>
            <td>
                <StatusCheck Status="@(_accessLevel?.Id>0)" Text="@(_accessLevel?.Id>0?"Use existing":"Will be created")" />
            </td>
            <td>
                <StatusCheck Status="@(_permissionMapping?.Id>0)" Text="@(_permissionMapping?.Id>0?"Use existing":"Will be created")" />
            </td>
        </tr>
        <tr>
            <td>
                <MudText>@AppLocalization[Lang.Name]: </MudText><MudText>@_delegate?.DelegateName</MudText>
            </td>
            <td>
                <MudText>@AppLocalization[Lang.Name]: </MudText><MudText>@_accessLevel?.Name</MudText>

            </td>
            <td>
                <MudText>@AppLocalization[Lang.Name]: </MudText><MudText>@_target?.CanonicalName</MudText>

            </td>
        </tr>
    </tbody>
</MudSimpleTable>
<LoadingData Loading=LoadingData />
@code {

    [Parameter]
    public UserNotification Request { get; set; }
    [Parameter]
    public EventCallback OnApproved { get; set; }

    private IDirectoryEntryAdapter _target;
    private PermissionDelegate? _delegate;
    private AccessLevel? _accessLevel;
    private PermissionMapping? _permissionMapping;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Modal.SetYesText(AppLocalization[Lang.Approve]);
        base.Modal.SetOnYes(Approve);
        _ = LoadData();
        await Modal.RefreshView();

    }

    private async Task Approve()
    {
        LoadingData = true;
        if (_delegate?.Id == 0)
        {
            Context.PermissionDelegate.Add(_delegate);
        }
        if (_permissionMapping?.Id == 0)
        {
            Context.PermissionMap.Add(_permissionMapping);
        }
        try
        {
            await Context.SaveChangesAsync();
            // Check if SaveChanges was successful before sending analytics
            // This can be tricky as SaveChangesAsync returns int and doesn't throw by default on concurrency issues if not configured.
            // A simple proxy for success here is just proceeding if no exception was caught before this point.
            // A more robust check might involve checking entity states if possible, but let's keep it simple first.
            await AnalyticsService.AccessRequestApproved($"Approved: {Request.Notification.Title}");
            await OnApproved.InvokeAsync();
            await Modal.CloseAsync();

            LoadingData = false;
        }catch(Exception ex)
        {
            Loggers.DatabaseLogger.Error("Error adding approved permission mapping {Error}", ex.InnerException);
            SnackBarService.Error("Error trying to create permission mapping");
            await LoadData();
        }
        
    }

    private async Task LoadData()
    {
        LoadingData = true;

        var _creator = await Context.UserSettings.FirstOrDefaultAsync(x => x.Id == Request.Notification.CreatorId);
        var _creatorAD = Directory.FindEntryBySid(_creator.UserGUID);

        _delegate = await PrepareDelegate(_creator, _creatorAD);
        _target = Directory.GetDirectoryEntryByDN(Request.Notification.TargetDN)!;
        _accessLevel = await PrepareAccessLevel(_target, Request.Notification.Action);
        _permissionMapping = await PreparePermissionMapping(_target, _accessLevel, _delegate, _creator);

        LoadingData = false;
    }

    private async Task<PermissionDelegate> PrepareDelegate(AppUser _creator, IDirectoryEntryAdapter _creatorAD)
    {
        var _deleg = await Context.PermissionDelegate.FirstOrDefaultAsync(x => x.DelegateSid == _creator.UserGUID.ToSidByteArray());
        if (_deleg == null)
        {
            return new PermissionDelegate()
            {
                DelegateName = _creatorAD != null ? _creatorAD.CanonicalName : _creator.Username,
                DelegateSid = _creator.UserGUID.ToSidByteArray()
            };
        }
        _deleg.DeletedAt = null;
        return _deleg;
    }

    private async Task<AccessLevel> PrepareAccessLevel(IDirectoryEntryAdapter _target, ActiveDirectoryObjectAction? action)
    {
        var _accessLvl = await Context.AccessLevels.FirstOrDefaultAsync(x => x.ObjectMap.Count == 1
            && x.ObjectMap.Any(x => x.ObjectType == _target.ObjectType)
            && x.ActionMap.Count == 1 && x.ActionMap.Any(x => x.AllowOrDeny == true && x.ObjectAction.Action == action));
        if (_accessLvl == null)
        {
            var objActions = await Context.ObjectActionFlag.ToListAsync();

            var objectMap = new ObjectAccessMapping()
            {
                ObjectAccessLevelId = ObjectAccessLevels.Read.Id,
                ObjectType = _target != null ? _target.ObjectType : ActiveDirectoryObjectType.Group
            };
            var actionMap = new ActionAccessMapping()
            {
                ObjectActionId = objActions.First(x => x.Action == action).Id,
                AllowOrDeny = true,
                ObjectType = _target != null ? _target.ObjectType : ActiveDirectoryObjectType.Group
            };
            return new AccessLevel()
            {
                ActionMap = new List<ActionAccessMapping>() { actionMap },
                ObjectMap = new List<ObjectAccessMapping>() { objectMap },
                Name = AppLocalization[action.ToString()!] + " " + AppLocalization[_target!.ObjectType.ToString()]
            };
        }
        _accessLvl.DeletedAt = null;
        return _accessLvl;
    }

    private async Task<PermissionMapping> PreparePermissionMapping(IDirectoryEntryAdapter _target, AccessLevel _accessLevel, PermissionDelegate _delegate, AppUser _creator)
    {
        var _permMap = await Context.PermissionMap.FirstOrDefaultAsync(x => x.OU == _target.DN && x.AccessLevels.Count() == 1
            && x.AccessLevels.Any(x => x.Id == _accessLevel.Id) && x.PermissionDelegates.Count() == 1
            && x.PermissionDelegates.Any(x => x.DelegateSid == _creator.UserGUID.ToSidByteArray()));
        if (_permMap == null)
        {
            return new PermissionMapping()
            {
                AccessLevels = new List<AccessLevel>() { _accessLevel },
                PermissionDelegates = new List<PermissionDelegate>() { _delegate },
                OU = _target.DN!,
            };
        }
        return _permMap;
    }
}




@using BLAZAM.Database.Models.Audit
@inject IStringLocalizer<AppLocalization> AppLocalization
@foreach (var change in Changes)
{
    <MudStack Row=true>
        <MudChip T="string" Text=@change.Key />
        @((MarkupString)change.Value)
    </MudStack>
}

@code {
    [Parameter]
    public DirectoryEntryAuditLog AuditEntry { get; set; }
    [Parameter]
    public Align Align { get; set; }

    private readonly Dictionary<string, string?> Changes = new();
    private readonly List<string> Attributes = new();
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (AuditEntry == null) return;

        Changes.Clear();
        AddAttributes(AuditEntry.BeforeAction);
        if (Changes.Count == 0)
            AddAttributes(AuditEntry.AfterAction);

        foreach (var attr in Changes.Keys.ToList())
        {
            var beforeValue = GetAttributeValue(AuditEntry.BeforeAction, attr);
            var afterValue = GetAttributeValue(AuditEntry.AfterAction, attr);

            Changes[attr] = BuildOutputString(beforeValue, afterValue);
        }
    }

    private void AddAttributes(string? action)
    {
        if (action.IsNullOrEmpty()) return;

        if (action.Contains(";"))
        {
            foreach (var str in action.Split(";"))
            {
                var attr = str.Split("=").FirstOrDefault();
                if (!attr.IsNullOrEmpty())
                    Changes.TryAdd(attr, null);
            }
        }
        else
        {
            Changes.TryAdd(AppLocalization[Lang.Action], null);
        }
    }

    private string? GetAttributeValue(string? action, string attr)
    {
        if (action.IsNullOrEmpty()) return null;

        if (action.Contains(";"))
        {
            var match = action.Split(";").FirstOrDefault(s => s.StartsWith(attr));
            if (match?.Contains("=") == true)
                return match.Split("=", 2)[1];
            return null;
        }
        return action;
    }

    private string BuildOutputString(string? beforeValue, string? afterValue)
    {
        var output = beforeValue ?? "";
        if (afterValue == null || beforeValue == null || !afterValue.Contains(beforeValue))
            output = $"<s>{output}</s>";

        if (afterValue!=null && !afterValue.IsNullOrEmpty())
        {
            var added = beforeValue.IsNullOrEmpty()
                ? afterValue
                : afterValue.Replace(beforeValue ?? "", "");
            output += $"<text style=\"display:contents;color:var(--mud-palette-success)\">{added}</text>";
        }
        return output;
    }
}
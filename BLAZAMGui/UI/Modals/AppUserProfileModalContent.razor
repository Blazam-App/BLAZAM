@inherits AppModalContent
@using BLAZAM.Helpers
@using System.Security
<MudStack>
    @if (CurrentUser.State.Preferences.ProfilePicture != null)
    {
        <Base64Image Data="@CurrentUser.State.Preferences.ProfilePicture" />
    }
    <MudFileUpload T="IBrowserFile"
    FilesChanged="UploadProfilePicture">

            <MudButton HtmlTag="label"
            Variant="Variant.Filled"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.CloudUpload">
                @if (CurrentUser.State.Preferences.ProfilePicture == null)
                {
                    <MudText>Upload Profile Icon</MudText>

                }
                else
                {
                    <MudText>Change Profile Icon</MudText>
                }
            </MudButton>
            @if (CurrentUser.State.Preferences.ProfilePicture != null)
            {
                <MudButton OnClick="@(async ()=>{
                                    CurrentUser.State.Preferences.ProfilePicture=null;

                                    })"
                Variant="Variant.Filled"
                Color="Color.Error"
                StartIcon="@Icons.Material.Filled.Remove">
                    Remove
                </MudButton>

            }

    </MudFileUpload>

    <MudTextField T="string" @bind-Text=@CurrentUser.State.Preferences.Email Label=@AppLocalization[Lang.Email] />
    
    <MudNavGroup Title="Themes">
        @foreach (var theme in ApplicationTheme.Themes)
        {
            <MudButton OnClick=@(()=>{mainLayout.SetUserTheme(theme);})>
                @theme.Name
            </MudButton>
        }
        <MudSwitch Value="@CurrentUser.State.Preferences.DarkMode"
        ValueChanged=@((state)=>{mainLayout.SetDarkMode(state);})
        Color="Color.Primary"
        Class="ma-4"
        T="bool"
        Label="Toggle Light/Dark Mode" />
    </MudNavGroup>

    @if (!CurrentUser.State.IsAdminOrDemo() && authSettings != null && authSettings.MFAType == MfaType.GoogleAuthenticator)
    {
        <CreateGoogleAuthenticationToken/>
    }

    @*//TODO Add explanation of missing google authenticator for admin and demo*@

    @if (CurrentUser.State.IsSuperAdmin)
    {
        <MudSwitch @bind-Value=@CurrentUser.State.ShowPluginPlaceholders Label="Show Plugin Placeholders in GUI"/>
    }

        <LoadingData Loading=LoadingData />
    </MudStack>
    @code {
    private AuthenticationSettings? authSettings;

    [CascadingParameter]
    public MainLayout mainLayout { get; set; }
    protected override void OnInitialized()
    {
        base.OnInitialized();

        Modal.SetYesText(AppLocalization[Lang.Save]);
        Modal.SetOnYes(SaveSettings);
        Modal.YesEnabled = () => { return !LoadingData; };
        authSettings = Context.AuthenticationSettings.FirstOrDefault();
    }
    private async Task SaveSettings()
    {
        LoadingData = true;
        await Modal.RefreshView();
        if (await CurrentUser.State.SaveAllUserSettings())
        {
            SnackBarService.Success(AppLocalization[Lang.Settings_saved]);
            await Modal.CloseAsync();
        }
        else
        {
            SnackBarService.Warning(AppLocalization[Lang.Failed_to_save_settings]);

        }
        LoadingData = false;
        await Modal.RefreshView();


    }

    async Task UploadProfilePicture(IBrowserFile profilePictureFile)
    {
        var rawBytes = await profilePictureFile.ReadByteArrayAsync();

        if (rawBytes != null)
        {
            CurrentUser.State.Preferences.ProfilePicture = rawBytes.ResizeRawImage(100, true);
        }
    }

  
}

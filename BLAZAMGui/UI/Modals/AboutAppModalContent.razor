@inherits AppModalContent
<MudStack Spacing="1" Style="width:min-content;" Class="mx-auto">


    <MudText Align="Align.Center">
        @AppLocalization[Lang.Company]: Jacobsen Productions LLC
    </MudText>

    <MudText Align="Align.Center">
        @AppLocalization[Lang.Founder]: Chris Jacobsen
    </MudText>

    <MudText Align="Align.Center">
        @AppLocalization[Lang.Founded]: 2022
    </MudText>
    <MudText Align="Align.Center">
        @AppLocalization[Lang.Version]: @ApplicationInfo.RunningVersion.ToString()
    </MudText>
    <MudText Align="Align.Center">

        <MudLink Href="https://blazam.org">blazam.org</MudLink>
    </MudText>
    <MudText Align="Align.Center">

        <MudLink Href="https://github.com/Blazam-App/BLAZAM">@AppLocalization[Lang.Source_Code]</MudLink>
    </MudText>
    <MudText Align="Align.Center">
        <MudBreakpointProvider>
            <MudHidden Breakpoint="Breakpoint.SmAndUp">
                <MudImage Width="250" Src=@imageSrc />
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.Xs">
                <MudImage Width="350" Src=@imageSrc />
            </MudHidden>
        </MudBreakpointProvider>

    </MudText>
    <MudText Align="Align.Center">@AppLocalization[Lang.Dedicated_To] Maggie</MudText>
    <MudText Align="Align.Center">@AppLocalization[Lang.In_Loving_Memory]</MudText>
    <MudText Align="Align.Center">2014-2024</MudText>
</MudStack>

@code {
    protected override void OnInitialized()
    {

        Modal.SetYesText(AppLocalization[Lang.Close]);
        base.OnInitialized();


    }
    private const string ThumbnailPath = "/img/maggie_thumbnail.png";
    private const string FullResolutionPath = "/img/maggie.png";

    private string imageSrc = ThumbnailPath; // Start by showing the thumbnail

    // OnAfterRenderAsync is called after the component has rendered
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Give the browser a moment to render the thumbnail
            await Task.Delay(1);

            // Change the image source to the full-resolution version
            imageSrc = FullResolutionPath;

            // Notify Blazor that the state has changed to trigger a re-render
            await StateHasChangedAsync();
        }
    }
}

@inherits AppComponentBase

@if (!qrCode.IsNullOrEmpty())
{
    <MudText>@AppLocalization[Lang.Google_Authenticator]</MudText>
    <MudImage Src="@qrCode" />
}
<MudButton Color="Color.Primary"
Variant="Variant.Filled"
OnClick="GenerateGoogleAuthToken">@AppLocalization[Lang.Create_Google_Authenticator_Token]</MudButton>
@if (!qrCode.IsNullOrEmpty())
{
    <MudButton Color="Color.Error"
    Variant="Variant.Filled"
    OnClick="DeleteGoogleAuthToken">@AppLocalization[Lang.Disable_Google_Authenticator]</MudButton>

}

<GoogleAuthenticatorModal @ref=googleAuthenticatorModal />

@code {
    string? _authenticatorSecret;
    private string? qrCode;
    GoogleAuthenticatorModal? googleAuthenticatorModal;
    [Parameter]
    public EventCallback OnCreated{ get; set; }
    [Parameter]
    public bool AutoOpen { get; set; }
    /// <summary>
    /// Optional parameter for unauthenticate token creation when CurrentUser would be not set.
    /// </summary>
    [Parameter]
    public string Username { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        try
        {
            _authenticatorSecret = CurrentUser.State.Preferences?.AuthenticatorSecret?.Decrypt<string>();
            if (!_authenticatorSecret.IsNullOrEmpty())
            {
                qrCode = GoogleAuthenticatorService.GenerateSetupCode(CurrentUser.Username, _authenticatorSecret.ToString()).QrCodeSetupImageUrl;
            }
        }
        catch (Exception ex)
        {
            Loggers.SystemLogger.Error("Error fetching users authentication secret {Error}", ex);
        }
    }
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender && _authenticatorSecret.IsNullOrEmpty() && AutoOpen)
        {
            _ = GenerateGoogleAuthToken();
        }
    }
    async Task GenerateGoogleAuthToken()
    {

        if (qrCode == null || await MessageService.Confirm(AppHelpLocalization[HelpLang.Overwrite_Auth_Token_Confirmation]) == true)
        {


            var guid = Guid.NewGuid().ToString().Replace("-", "");

            var setupcode = GoogleAuthenticatorService.GenerateSetupCode(CurrentUser.Username ?? Username, guid.ToString());
            var confirm = await googleAuthenticatorModal.ShowAsync(guid.ToString().ToSecureString(), setupcode.QrCodeSetupImageUrl);
            if (confirm != null)
            {
                qrCode = setupcode.QrCodeSetupImageUrl;
                _authenticatorSecret = guid;
                CurrentUser.State.Preferences.AuthenticatorSecret = guid.Encrypt();
                await CurrentUser.State.SaveBasicUserPreferences();
                await OnCreated.InvokeAsync();
            }
        }
    }
    async Task DeleteGoogleAuthToken()
    {
        if (await MessageService.Confirm(AppHelpLocalization[HelpLang.Delete_Auth_Token_Confirmation]) == true)
        {
            qrCode = null;
            CurrentUser.State.Preferences.AuthenticatorSecret = null;
            await CurrentUser.State.SaveBasicUserPreferences();
            await InvokeAsync(StateHasChanged);
        }
    }
}
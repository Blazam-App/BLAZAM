@inherits AppComponentBase
@if (_decryptedToken != null && !LoadingData)
{
    <MudStack Row=true>
        <MudText>@(_decryptedToken.FromSecureString().Substring(0, 10))...</MudText>
        <AppCopyButton TextToCopy="@_decryptedToken.FromSecureString()" />
        @if (_undecodableJwtToken)
        {
            <AppTooltip Text="@AppLocalization[Lang.Error]">
                <MudIcon Color="Color.Error"
                         Icon="@Icons.Material.Filled.Error" />
            </AppTooltip>
        }
    </MudStack>
}else if (LoadingData)
{
    <MudProgressLinear Indeterminate="true"/>
}
@code {
    [Parameter]
    public string? Token { get; set; }

    private bool _undecodableJwtToken;

    private SecureString? _decryptedToken;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            _ = Task.Run(() =>
            {
                LoadingData = true;
                if (Token != null)
                {
                    _decryptedToken = Token.Decrypt<string>()?.ToSecureString();

                    if(!_decryptedToken.FromSecureString().IsNullOrEmpty()){
                        var decodedToken = JwtTokenService.DecodeJwtToken(_decryptedToken.FromSecureString());
                        if (decodedToken == null)
                        {
                            _undecodableJwtToken = true;
                        }
                    }
                }
                LoadingData = false;
                _ = InvokeAsync(StateHasChanged);

            });
        }
    }

}
@using BLAZAM.Common.Exceptions
@using BLAZAM.EmailMessage.Email.Base
@using BLAZAM.EmailMessage.Email.Notifications
@inherits AppModalContent
@inject NotificationGenerationService notificationGenerationService
@inject BLAZAM.Services.Analytics AnalyticsService

@if (_objectActions != null && _objectActions.Count > 0 && globalPermissionRequestActions.Count > 0)
{
    @if (_dbAllowedActions.Any(x => x.IsActionAppropriateForObject(Entry.ObjectType)))
    {
        <MudChipSet T="ActiveDirectoryObjectAction"
                    @bind-SelectedValues="_selectedActions"
                    SelectionMode="SelectionMode.MultiSelection"
                    Color="Color.Info"
                    CheckedIcon="@Icons.Material.Filled.Check"
                    IconColor="Color.Success"
                    SelectedColor="Color.Success">
            @foreach (var action in _objectActions)
            {
                if (action.IsActionAppropriateForObject(Entry.ObjectType) && globalPermissionRequestActions.Any(x => x.ObjectAction == action))
                {
                    <MudChip Value="action"
                             Disabled="@(IsActionDisabled(action))"
                             Text="@AppLocalization[action.ToString()]" />
                }
            }
        </MudChipSet>


    }
    else
    {
        <MudAlert Severity="Severity.Info">@AppHelpLocalization[HelpLang.No_Request_Actions_Available]</MudAlert>

    }

}
<LoadingData Loading=LoadingData />
@code {

    [Inject]
    private AppAuthenticationStateProvider AppAuthenticationStateProvider { get; set; }



    IReadOnlyCollection<ActiveDirectoryObjectAction>? _selectedActions = new List<ActiveDirectoryObjectAction>();

    List<ActiveDirectoryObjectAction> _objectActions;
    List<ActiveDirectoryObjectAction> _dbAllowedActions;
    List<GlobalPermissionRequestAction> globalPermissionRequestActions = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _objectActions = ActiveDirectoryObjectAction.Assign.ToList();
        _dbAllowedActions = await Context.GlobalPermissionRequestActions.Select(x => x.ObjectAction).ToListAsync();
        globalPermissionRequestActions = await Context.GlobalPermissionRequestActions.ToListAsync();
        Modal.SetOnYes(Submit);
    }
    public async Task Submit()
    {
        if (_selectedActions != null && _selectedActions.Count > 0)
        {
            LoadingData = true;
            await StateHasChangedAsync();

            var adminUsers = await GetAdminUsersAsync();

            foreach (var action in _selectedActions)
            {
                var notification = GenerateNotification(action);
                if (notification == null)
                {
                    LogNotificationError(action);
                    LoadingData = false;
                    continue;
                }

                await PublishAndTrackNotificationAsync(adminUsers, notification);

                await SendAccessRequestEmailsAsync(adminUsers, notification, action);
            }
            SnackBarService.Success(AppLocalization[Lang.Access_request_sent]);
        }
        await Modal.CloseAsync();
        LoadingData = false;
    }

    private async Task<List<AppUser>> GetAdminUsersAsync()
    {
        var users = await Context.UserSettings.ToListAsync();
        var adminUsers = new List<AppUser>();
        await Parallel.ForEachAsync(users, async (user, cancellationToken) =>
        {
            var adUser = Directory.Users.FindUserBySID(user.UserGUID);
            var userState = new ApplicationUserState(DbFactory);
            try
            {
                var appUser = await AppAuthenticationStateProvider.CreateDirectoryPrincipal(userState, adUser);
                if (appUser == null)
                {
                    Loggers.SystemLogger.Error("Failed to create app user for SID {SID}", user.UserGUID);
                    return;
                }
                userState.User = appUser;
                if (userState.IsSuperAdmin || user.IsAdminOrDemo())
                {
                    lock (adminUsers)
                    {
                        adminUsers.Add(user);
                    }
                }
            }
            catch (DeniedLoginException)
            {
                //Ignore users who can't login
            }
        });
        return adminUsers;
    }

    private NotificationMessage GenerateNotification(ActiveDirectoryObjectAction action)
    {
        notificationGenerationService.PackageRequest(Entry, action, CurrentUser.State, out var notification);
        return notification;
    }

    private void LogNotificationError(ActiveDirectoryObjectAction action)
    {
        Loggers.SystemLogger.Error("Failed to generate notification for action {Action} on entry {Entry}", action, Entry.CanonicalName);
    }

    private async Task PublishAndTrackNotificationAsync(List<AppUser> adminUsers, NotificationMessage notification)
    {
        _ = NotificationPublisher.PublishNotification(adminUsers, notification);
        if (notification.Title != null)
        {
            await AnalyticsService.AccessRequestCreated(notification.Title);
        }
    }

    private async Task SendAccessRequestEmailsAsync(List<AppUser> adminUsers, NotificationMessage notification, ActiveDirectoryObjectAction action)
    {
        AccessRequestEmailMessage requestEmail = new AccessRequestEmailMessage
        {
            Notification = notification,
            TargetName = Entry.CanonicalName
        };
        foreach (var user in adminUsers)
        {
            if (EmailService.IsConfigured && !user.Email.IsNullOrEmpty())
            {
                string body = CurrentUser.Username + " " + AppLocalization["is requesting"]
                    + " " + AppLocalization[action.ToString()].ToString().ToLower() + " " + AppLocalization["access to"] + " " +
                    Entry.CanonicalName;
                if (user.Email==null || user.Email.IsNullOrEmpty())
                {
                    Loggers.SystemLogger.Information("User {Username} has no email configured, skipping email notification.", user.Username);
                    continue;
                }
                if(notification.Title == null)
                {
                    Loggers.SystemLogger.Information("Notification title is null for action {Action} on entry {Entry}", action, Entry.CanonicalName);
                    continue;
                }
                await EmailService.SendMessage(notification.Title, requestEmail, user.Email);
            }
        }
    }

    private bool IsActionDisabled(ActiveDirectoryObjectAction action)
    {
        switch (action)
        {
            case ActiveDirectoryObjectAction.Assign:
                return !IsGroupAssignable(Entry);

            case ActiveDirectoryObjectAction.Unassign:
                return !IsGroupUnassignable(Entry);

            case ActiveDirectoryObjectAction.Move:
                return !Entry.CanMove;

            case ActiveDirectoryObjectAction.Delete:
                return !Entry.CanDelete;

            case ActiveDirectoryObjectAction.Disable:
                return !IsAccountDisableable(Entry);

            case ActiveDirectoryObjectAction.Enable:
                return !IsAccountEnableable(Entry);

            case ActiveDirectoryObjectAction.SetPassword:
                return !IsPasswordSettable(Entry);

            case ActiveDirectoryObjectAction.Rename:
                return !Entry.CanRename;

            case ActiveDirectoryObjectAction.Create:
                return !Entry.CanCreate;

            case ActiveDirectoryObjectAction.Unlock:
                return !IsAccountUnlockable(Entry);

            default:
                return false;
        }
    }

    private bool IsGroupAssignable(object entry) =>
        entry is IADGroup group && group.CanAssign;

    private bool IsGroupUnassignable(object entry) =>
        entry is IADGroup group && group.CanUnassign;

    private bool IsAccountDisableable(object entry) =>
        entry is IAccountDirectoryAdapter adapter && adapter.CanDisable;

    private bool IsAccountEnableable(object entry) =>
        entry is IAccountDirectoryAdapter adapter && adapter.CanDisable;

    private bool IsPasswordSettable(object entry) =>
        entry is IAccountDirectoryAdapter adapter && adapter.CanSetPassword;

    private bool IsAccountUnlockable(object entry) =>
        entry is IAccountDirectoryAdapter adapter && adapter.CanDisable;
}
@inherits AppModalContent

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudForm @ref="Form" @bind-IsValid="IsValid">
        <MudStack Spacing="3">

            <MudText Typo="Typo.h6">@AppLocalization[Lang.Password_Reset_Settings]</MudText>

            <MudText Typo="Typo.body2">@AppHelpLocalization[HelpLang.Password_Reset_Settings_Description]</MudText>

            <MudTextField Label="@AppLocalization[Lang.PIN]"
                          InputType="InputType.Password"
                          Immediate="true"
                          @bind-Value="pin"
                          For="@(() => pin)" />

            <MudDivider />
            <MudText Typo="Typo.subtitle1">@AppLocalization[Lang.Security_Questions]</MudText>

            <MudTextField Label=@(AppLocalization[Lang.Question] + "1")
                          Immediate="true"
                          @bind-Value="question1" />
            <MudTextField Label=@(AppLocalization[Lang.Answer] + "1")
                          Immediate="true"
                          @bind-Value="answer1" />

            <MudTextField Label=@(AppLocalization[Lang.Question] + "2")
                          Immediate="true"
                          @bind-Value="question2" />
            <MudTextField Label=@(AppLocalization[Lang.Answer] + "2")
                          Immediate="true"
                          @bind-Value="answer2" />

            <MudTextField Label=@(AppLocalization[Lang.Question] + "3")
                          Immediate="true"
                          @bind-Value="question3" />
            <MudTextField Label=@(AppLocalization[Lang.Answer] + "3")
                          Immediate="true"
                          @bind-Value="answer3" />

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">

                <MudText Class="mud-text-caption">
                    @if (HasSettings)
                    {
                        <MudText>@AppLocalization[Lang.Password_Reset_Enabled]</MudText>
                    }
                    else
                    {
                        <MudText>@AppLocalization[Lang.Not_Configured]</MudText>
                    }
                </MudText>
            </MudStack>

            <LoadingData Loading="@LoadingData" />
        </MudStack>
    </MudForm>
</MudContainer>
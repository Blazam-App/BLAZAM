@using BLAZAM.ActiveDirectory.Services
@using BLAZAM.Services.Background

@inherits AppModalContent

<ADAutoComplete Label=@AppLocalization[Lang.Application_User]
                SearchObjectType="ActiveDirectoryObjectType.User"
                SelectedResult=@selectedUser
                SelectedResultChanged="@(async(tgt)=>{selectedUser=tgt; await onRun();})" />


@if (!simRunning&& simRan)
{
    <EffectivePermissionsDataGrid Target="simTarget" Disabled="!simRan" />
}
else if(simRunning)
{
    <MudProgressLinear Indeterminate=true />
}
@code {
    private IDirectoryEntryAdapter selectedUser;
    [Parameter]
    public IDirectoryEntryAdapter Target { get; set; }

    IDirectoryEntryAdapter? simTarget;

    bool simRan;
    bool simRunning;
    private async Task onRun()
    {
        simRunning = true;
        await StateHasChangedAsync();
        simTarget = Directory.FindGlobalEntryBySid(Target.SID);
        var permissionApplicator = new PermissionApplicator(UserStateService, DbFactory, Directory);
        var simUser = new ApplicationUserState(DbFactory);
        await permissionApplicator.LoadPermissions(simUser, selectedUser as IADUser);
        simTarget.SetCurrentUser(simUser.ToActiveDirectoryUserState());
        simRunning = false;
        simRan = true;
        await StateHasChangedAsync();
    }
}

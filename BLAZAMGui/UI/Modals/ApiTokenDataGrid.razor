@inherits AppComponentBase
<MudDataGrid Items="@Tokens"
    Class="mb-5">
    <Columns>
        @if (ShowUser)
        {
            <TemplateColumn Class="" Title="@AppLocalization["User"]">
                <CellTemplate>
                        <MudText>@(context.Item.User.Username)</MudText>
                </CellTemplate>
            </TemplateColumn>
        }
        <TemplateColumn Class="" Title="@AppLocalization["Token"]">
            <CellTemplate>
                @{
                    var decrypted = context.Item.Token.Decrypt<string>();
                }
                <MudStack Row=true>
                    <MudText>@(decrypted.Substring(0, 10))...</MudText>
                    <AppCopyButton TextToCopy="@decrypted" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization["Created"]">
            <CellTemplate>
                <MudText>@(context.Item.CreatedAt.ToLocalTime())</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization["Expires"]">
            <CellTemplate>
                <MudText>@(context.Item.ExpiresAt.ToLocalTime())</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization["Description"]">
            <CellTemplate>
                <MudTextField Disabled="context.Item.DeletedAt!=null"
 @bind-Value=@(context.Item.Description) />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization["Last Used"]">
            <CellTemplate>
                <MudText>
                    @(context.Item.LastUsedAt != null ?
                        context.Item.LastUsedAt.Value.ToLocalTime() :
                        AppLocalization["Never used"])
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization["Is Revoked"]">
            <CellTemplate>
                <MudSwitch Color="Color.Error"
                Disabled="context.Item.DeletedAt!=null"
                @bind-Value=@context.Item.IsRevoked />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization["Delete"]">
            <CellTemplate>
               @if(context.Item.DeletedAt==null){
                <AppIconButton Color="@Color.Error"
                               Icon="@Icons.Material.Filled.Delete"
                    OnClick="@(()=>{Delete(context.Item);})" />
                }
                else
                {
                    <MudAlert Severity="Severity.Error">
                        <MudStack>
                            <MudText>@AppLocalization["Deleted"]</MudText>
                            <MudText>@context.Item.DeletedAt.Value.ToLocalTime().ToString()</MudText>
                        </MudStack></MudAlert>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        
        @AppLocalization[ShowUser==true?"There are no active API tokens." :"You don't have any active API tokens."]
    </NoRecordsContent>
</MudDataGrid>


@code {
    [Parameter]
    public IEnumerable<ApiToken> Tokens { get; set; }
    [Parameter]
    public bool ShowUser{ get; set; }

    [Parameter]
    public EventCallback<ApiToken?> OnTokenDeleted { get; set; }
    private async Task Delete(ApiToken? tokenToDelete)
    {
        await OnTokenDeleted.InvokeAsync(tokenToDelete);
    }
}
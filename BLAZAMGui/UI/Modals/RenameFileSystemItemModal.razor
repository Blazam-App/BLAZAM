@using BLAZAM.FileSystem
@inject IStringLocalizer<AppLocalization> AppLocalization

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@AppLocalization[Lang.Rename]</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewName" Label="@AppLocalization[Lang.New_Name]" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@AppLocalization[Lang.Cancel]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">@AppLocalization[Lang.Rename]</MudButton>
    </DialogActions>
</MudDialog>

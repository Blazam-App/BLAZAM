@using ApplicationNews
@inherits AppComponentBase


<MudDialog @ref=dialog>
    <TitleContent>
        <MudText Align="Align.Center">@AppLocalization["Google Authenticator Token"]</MudText>
    </TitleContent>
    <DialogContent>

        @if (!_authenticated)
        {
            if (!registrationUri.IsNullOrEmpty())
            {
                <MudText Align="Align.Center">@AppLocalization["Scan the code below from your authenticator app"]</MudText>
                <MudText Align="Align.Center"> <MudImage Src="@registrationUri" /></MudText>
                <MudText Align="Align.Center">@AppLocalization["Then enter the passcode to activate"]</MudText>
            }
            <GoogleAuthenticatorInput @ref=googleAuthInput 
                @bind-Authenticated="_authenticated" 
                @bind-Passcode=authToken
                                      AuthSecret="@authSecret"
                OnAuthenticated="@(async()=>{await InvokeAsync(StateHasChanged);  await Task.Delay(1000); dialog?.CloseAsync();})" />
            <MudStack Row=true>
                <MudSpacer/>
                <MudButton Color="@Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="@(()=>{dialog?.CloseAsync();})">@AppLocalization["Cancel"]</MudButton>
                <MudButton Color="@Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="@(()=>{googleAuthInput?.Authenticate(true);})">@AppLocalization["OK"]</MudButton>

            </MudStack>
        }
        else
        {
            <MudText Align="Align.Center">
                <MudIcon Icon="@Icons.Material.Filled.ThumbUpAlt"
                         Color="Color.Success"
                         Size="Size.Large" />
            </MudText>
        }

    </DialogContent>

</MudDialog>

@code {
    GoogleAuthenticatorInput? googleAuthInput;
    private string? registrationUri;
    private string? authToken;
    private MudDialog? dialog;
    private string? authSecret;
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter]
    public AppEvent? OnAuthenticated { get; set; }

    private bool _authenticated;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        authSecret = CurrentUser?.State?.Preferences?.AuthenticatorSecret?.Decrypt();
        _authenticated = false;
    }
    public async Task<string?> ShowAsync(string? customSecret = null, string? customRegistrationUri = null)
    {
        if (customSecret != null)
        {
            authSecret = customSecret;
        }
        registrationUri = customRegistrationUri;
        await (await dialog?.ShowAsync()).Result;
        var result = _authenticated;

        _authenticated = false;
        var validToken = authToken?.Replace(" ", "");
        authToken = null;
        if (result)
        {
            return validToken;
        }
        else
        {
            return null;
        }
    }
   
}

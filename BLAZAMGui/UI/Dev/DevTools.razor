@using System.Diagnostics

@inherits AppComponentBase
@inject IHttpContextAccessor ca

<MudText Typo="Typo.h6">Dev Tools</MudText>
<MudText>Debugger Attached: @Debugger.IsAttached</MudText>
<MudButton Color="Color.Primary"
           Style="height:35px;"
           OnClick=SendTestNoification>
    Test Notification
</MudButton>
<MudButton Color=" Color.Primary"
           Style="height:35px;"
           OnClick=SendTestBroadcast>
    Test Broadcast
</MudButton>
<MudButton Color="Color.Primary"
           Style="height:35px;"
           OnClick=TestNotificationBroadcast>
    Test Notification Broadcast
</MudButton>
<MudButton Color="Color.Primary"
           Style="height:35px;"
           OnClick=RunTestJob>
    Run Test Job
</MudButton>

<MudCard Class="mud-theme-dark">
    <MudCardHeader>
        Conn Monitor
    </MudCardHeader>
    <MudText>Database Status: @Enum.GetName(typeof(ServiceConnectionState), Monitor.DatabaseConnectionStatus)</MudText>
    <MudText>ActiveDirectory Status: @Enum.GetName(typeof(ServiceConnectionState), Monitor.DirectoryConnectionStatus)</MudText>
    <MudText>App Ready Status: @Enum.GetName(typeof(ServiceConnectionState), Monitor.AppReady)</MudText>

</MudCard>

<MudDataGrid Items="@UserStateService.UserStates">
    <Columns>
        <PropertyColumn Title="Username" Property="x => x.User.Identity == null ? null : x.User.Identity.Name" />
        <PropertyColumn Title="IP Address" Property="x => x.IPAddress == null ? null : x.IPAddress" />
        <PropertyColumn Title="Browser" Property="x => x.Browser == null ? null : x.Browser" />

        <PropertyColumn Title="Auth Type" Property="x => x.User.Identity == null || x.User.Identity.AuthenticationType == null ? null : x.User.Identity.AuthenticationType.ToString()" />
        <PropertyColumn Title="Authenticated" Property="x => x.User.Identity == null ? null : x.User.Identity.IsAuthenticated.ToString()" />
        <PropertyColumn Property="s => s.Ticket != null && s.Ticket.Principal != null && s.Ticket.Principal.Identity != null ? s.Ticket.Principal.Identity.Name : null" />

        <PropertyColumn Title="Last URI" Property="x => x.LastUri" />
        <PropertyColumn Title="Super Admin" Property="x => x.IsSuperAdmin" />
        <TemplateColumn Title="Last Access">
            <CellTemplate>
                <MudText>@context.Item.LastAccessed.ToLocalTime()</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Expires">
            <CellTemplate>
                @context.Item.Ticket?.Properties.ExpiresUtc?.LocalDateTime
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Title="Session Expiration Time" Property="x => x.Ticket == null ? null : (DateTimeOffset.UtcNow - x.Ticket.Properties.ExpiresUtc)" />



        <TemplateColumn Title="Has User Priv">
            <CellTemplate>
                @context.Item.HasUserPrivilege
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Has Group Priv">
            <CellTemplate>
                @context.Item.HasGroupPrivilege
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Has OU Priv">
            <CellTemplate>
                @context.Item.HasOUPrivilege
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Has Computer Priv">
            <CellTemplate>
                @context.Item.HasComputerPrivilege
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>


<MudCard Class="mud-theme-dark">
    <MudCardHeader>
        User
    </MudCardHeader>
    @{
        var ids = ca.HttpContext?.User.Identities.ToList();
    }
    @if (ids != null)
    {
        @foreach (var id in ids)
        {

            var claims2 = @ca.HttpContext?.User.Claims.ToList();

            <MudText>Name: @id.Name</MudText>
            <MudText>Authenticated: @id.IsAuthenticated.ToString()</MudText>
            <MudText>Type: @id.AuthenticationType</MudText>
            @if (claims2 != null)
            {
                @foreach (var claim in claims2)
                {
                    <MudText>@claim.Type: @claim.Value</MudText>

                }
            }
        }
    }
</MudCard>



<MudCard Class="mud-theme-dark">
    <MudCardHeader>
        Active Directory
    </MudCardHeader>
    <MudStack Row="true">
        <MudText>ActiveDirectory Status: @DirectoryStatus</MudText>
        <MudText>ActiveDirectory Server: @Directory.ConnectionSettings?.ServerAddress</MudText>

        <MudText>ActiveDirectory Server Port: @Directory.ConnectionSettings?.ServerPort</MudText>
        <MudText>ActiveDirectory Server Port Open: @DirectoryPortOpen</MudText>

    </MudStack>
</MudCard>

@*     </MudNavMenu>
</MudPaper> *@

@code {
    string DirectoryStatus = "";
    bool DirectoryPortOpen;
    Timer t;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        t = new Timer(async (obj) =>
        {
            DirectoryPortOpen = Directory.PortOpen;
            DirectoryStatus = Enum.GetName(typeof(DirectoryConnectionStatus), Directory.Status);
            await StateHasChangedAsync();
        }, null, 500, 2000);
    }
    public override void Dispose()
    {
        t.Dispose();
        base.Dispose();
    }
    [Parameter]
    public bool DrawerOpen { get; set; }
    [Parameter]
    public string Style { get; set; }


    async Task TestNotificationBroadcast()
    {
        await NotificationPublisher.PublishNotification(new NotificationMessage()
        {
            Level = NotificationLevel.Info,
            Message = "This is a test notification",
            Title = "Test"
        });
    }
    void SendTestNoification()
    {
        SnackBarService.Success("Test Notification " + Guid.NewGuid());

    }
    void SendTestBroadcast()
    {
        SnackbarBroadcastService.Success("Test Broadcast " + Guid.NewGuid(), "Test");

    }
    async Task RunTestJob()
    {
        var job = JobHelpers.TestJob;
        await job.ShowJobDetailsDialogAsync(MessageService);
        await job.RunAsync();
    }
}
@using System.Text
<MudPaper Elevation="Elevation" Class="@PaperClass" Style="@CombinedStyle">

    @{
        RenderFragment headerFragment =
        @<MudElement class="@HeaderWrapperClass">
            <MudElement class="@HeaderClass">
                <MudText Color="TextColor" Class="section-title-text">@Title</MudText>
            </MudElement>
        </MudElement>;
    }

    @if (IsHeaderAtTop)
    {
        @headerFragment
    }

    <MudStack Row="@(!Stack)" Spacing="1" Class=@(Stack==false?"flex-wrap gap-10":"")>
        @ChildContent
    </MudStack>


    @if (!IsHeaderAtTop)
    {
        @headerFragment
    }
</MudPaper>



@inherits AppComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@if (HttpContextAccessor.HttpContext is not null 
    && HttpContextAccessor.HttpContext.Request.Scheme.Equals("https", StringComparison.InvariantCultureIgnoreCase)
    && !TextToCopy.IsNullOrEmpty())
{
    <AppTooltip @ref=_tooltip ShowOnClick=false ShowOnFocus=false ShowOnHover=false Visible=_showTooltip>
        <TooltipContent>
            <MudAlert Severity="Severity.Info">
                @AppHelpLocalization[HelpLang.Text_Copied_To_Clipboard, TextToCopy]
            </MudAlert>
        </TooltipContent>
        <ChildContent>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@(async()=>{await CopyToClipboard();})" />
        </ChildContent>
    </AppTooltip>


}
@code {
    [Parameter]
    public string? TextToCopy{ get; set; }

    bool _showTooltip;
    AppTooltip? _tooltip;

    private async Task CopyToClipboard()
    {
        if(TextToCopy.IsNullOrEmpty())
            return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", TextToCopy);
        _showTooltip = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        _showTooltip = false;
        await InvokeAsync(StateHasChanged);

    }

}

@inherits AppComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@if (HttpContextAccessor.HttpContext is not null 
    && HttpContextAccessor.HttpContext.Request.Scheme.Equals("https", StringComparison.InvariantCultureIgnoreCase)
    && !TextToCopy.IsNullOrEmpty())
{
    <AppTooltip ShowOnClick=false ShowOnFocus=false ShowOnHover=false Visible=_showTooltip>
        <TooltipContent>
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                @AppHelpLocalization[HelpLang.Text_Copied_To_Clipboard, TextToCopy?.Length<40?TextToCopy:AppLocalization[Lang.Text]]
            </MudAlert>
        </TooltipContent>
        <ChildContent>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@(async()=>{await CopyToClipboard();})" />
        </ChildContent>
    </AppTooltip>


}
@code {
    [Parameter]
    public string? TextToCopy{ get; set; }

    bool _showTooltip;

    private async Task CopyToClipboard()
    {
        if(TextToCopy.IsNullOrEmpty())
            return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", TextToCopy);
        _showTooltip = true; 
        await StateHasChangedAsync();
        await Task.Delay(3000);
        _showTooltip = false;
        await StateHasChangedAsync();

    }

}

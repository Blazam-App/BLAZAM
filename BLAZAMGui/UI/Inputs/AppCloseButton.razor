@inherits AppIconButton


<AppIconButton Color="@Color"
               Disabled=@Disabled
               Size=@Size
               Style=@Style
               Tooltip=@Tooltip
               TooltipPlacement="@TooltipPlacement"
               OnClick="@OnClick"
               Tag=@Tag
               Icon="@(Icon==null?Icons.Material.Filled.Close:Icon)" />
@code {


    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Color == Color.Inherit || Color == Color.Default)
            Color = Color.Error;

    }

}
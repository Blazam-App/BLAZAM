@inherits AppIconButton

<AppIconButton Color="@Color"
               Disabled=@Disabled
               Size=@Size
               Style=@Style
               Tooltip=@Tooltip
               OnClick="@OnClick"
               Tag=@Tag
               Icon="@Icons.Material.Filled.Close" />
@code {


    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Color == Color.Inherit || Color == Color.Default)
            Color = Color.Error;

    }

}

<MudMenu Dense=true
         ActivationEvent=MouseEvent.RightClick>
    <ActivatorContent>
        <div class="pa-0 ma-0 " >
            @if (Text != null)
            {
                @Text
            }
            @ChildContent
        </div>
    </ActivatorContent>
    <ChildContent>
        @MenuContents

    </ChildContent>
</MudMenu>
@code { [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public string? Text { get; set; } = null;
    [Parameter]
    public RenderFragment MenuContents { get; set; }
}


@using System.Text
@inherits MudElement
@typeparam T

<MudStack Row=true>
    @if (Adornment == Adornment.Start)
    {

    }
    <MudMenu Dense=true
             Disabled="@Disabled"
             Style="@(Style+" min-width:100px;")"
             FullWidth=true
             @ref=_selectMenu
             Class=@(Class+" mud-width-full")
             ListClass="minw-max"
             MaxHeight="200"
             AnchorOrigin="Origin.BottomCenter"
             TransformOrigin="Origin.TopCenter"
             PopoverClass="minw-max">
        <ActivatorContent>
            <MudField Disabled="@Disabled"
                      HelperText="@HelperText"
                      Label="@Label"
                      @onclick="@(() => context.ToggleAsync())">
                <MudStack Row=true>
                    @if (Selected !=null && (Selected.Count() > 0 || !EqualityComparer<T>.Default.Equals(Value, default(T))))
                    {
                        <MudText>
                            @Text
                        </MudText>
                    }
                    else
                    {
                        <MudElement Class="grey-text">
                            @Placeholder
                        </MudElement>
                    }
                    <MudSpacer />
                    <MudIcon Class="align-end" Icon="@(_selectMenu?.Open == true ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)" />
                </MudStack>
            </MudField>
        </ActivatorContent>
        <ChildContent>
            @if (Options != null && Options.Count() > 0)
            {
                @foreach (var val in Options)
                {
                    <MudMenuItem Style="min-width:max-content;"
                                 Class="py-0 px-3 ma-0"
                                 OnClick="@(async ()=> await ToggleSelected(val))"
                                 AutoClose=@(!MultiSelection)>
                        <MudStack Class="pa-0 ma-0"
                                  Row=true
                                  Style="min-width:max-content;">
                            @if (MultiSelection)
                            {
                                <MudCheckBox T=bool
                                             ValueChanged="@(async ()=> await ToggleSelected(val))"
                                             Value="Selected.Contains(val)" />
                            }
                            @if (ToStringFunc != null)
                            {
                                <MudText Class="align-middle" Style="min-width:max-content;min-height:24px;">
                                    @ToStringFunc.Invoke(val)
                                </MudText>
                            }
                            else
                            {
                                <MudText Class="align-middle" Style="min-width:max-content;min-height:24px;">
                                    @val?.ToString()
                                </MudText>
                            }
                        </MudStack>
                    </MudMenuItem>
                }

            }
        </ChildContent>
    </MudMenu>
    @if (Adornment == Adornment.End)
    {
        if (!AdornmentIcon.IsNullOrEmpty())
        {
            <MudIconButton Ripple=@(OnAdornmentClick.HasDelegate ? true : false)
                           Icon="@AdornmentIcon"
                           Color="@AdornmentColor"
                           OnClick="@OnAdornmentClick"
                           aria-label="@AdornmentAriaLabel" />
        }
    }
</MudStack>

@code {
    private MudMenu? _selectMenu;

    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public Color AdornmentColor { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? AdornmentIcon { get; set; }

    [Parameter]
    public string? AdornmentAriaLabel { get; set; }

    [Parameter]
    public Adornment Adornment { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnAdornmentClick { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool MultiSelection { get; set; }

    [Parameter]
    public Func<T, string> ToStringFunc { get; set; }

    private T _value;

    [Parameter]
    public T Value
    {
        get => _value;
        set
        {
            _value = value;
            Selected = [_value];
        }
    }

    [Parameter]
    public EventCallback<T> ValueChanged { get; set; }


    private string? Text
    {
        get
        {
            var sb = new StringBuilder();
            if (Selected.Count() > 0)
            {
                int i = 0;
                foreach (var item in Selected)
                {
                    if (item != null)
                    {
                        if (i > 0)
                        {
                            sb.Append(", ");
                        }
                        if (ToStringFunc != null)
                        {
                            sb.Append(ToStringFunc?.Invoke(item));
                        }
                        else
                        {
                            sb.Append(item.ToString());

                        }
                        i++;

                    }
                }
            }
            return sb.ToString();
        }
    }

    [Parameter]
    public IEnumerable<T> Options { get; set; }


    [Parameter]
    public IEnumerable<T> Selected { get; set; } = Enumerable.Empty<T>();

    [Parameter]
    public EventCallback<IEnumerable<T>> SelectedChanged { get; set; }

    private async Task ToggleSelected(T item)
    {
        if (Selected.Contains(item))
        {
            if (MultiSelection)
            {
                Selected = Selected.Where(x => !x!.Equals(item)).ToList();
                await SelectedChanged.InvokeAsync(Selected);
            }
        }
        else
        {
            if (MultiSelection)
            {
                Selected = Selected.Append(item).ToList();
                await SelectedChanged.InvokeAsync(Selected);
            }
            else
            {
                Selected = new List<T>() { item };
                Value = item;
                await ValueChanged.InvokeAsync(item);
            }
        }
    }
}


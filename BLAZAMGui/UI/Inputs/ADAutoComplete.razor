@inherits AutoCompleteComponentBase

<MudAutocomplete Class="@Class"
                 Style="@Style"
                 Disabled=@Disabled
                 T="IDirectoryEntryAdapter"
                 Label="@Label"
                 AnchorOrigin="@AnchorOrigin"
                 TransformOrigin="@TransformOrigin"
                 @bind-Value="SelectedResult"
                 @bind-Text=@SearchTerm
                 @ref=AutoComplete
                 OnKeyUp="@((KeyboardEventArgs kea) => {
if(kea.Key== "Enter") 
SearchService.Search(SearchService.SearchTerm); 
})"
                 AutoFocus=@AutoFocus
                 SearchFunc="@GetResults"
                 DebounceInterval=500
                 ResetValueOnEmptyText="true"
                 MinCharacters=1
                 Validation="@Validation"
                 CoerceText="@(!AllowCustomInput)"
                 CoerceValue="false"
                 ItemDisabledFunc="@(CustomDisableFilter??((r)=>false))"
                 MaxItems=@MaxResults
                 Clearable=true
                 Dense=true
                 ShowProgressIndicator=true
                 ToStringFunc="item=>item?.CanonicalName"
                 AdornmentColor="Color.Tertiary"
                 ProgressIndicatorColor="Color.Secondary"
                 Adornment="@Adornment"
                 AdornmentText="@AdornmentText"
                 AdornmentIcon="@AdornmentIcon"
                 OnAdornmentClick="OnAdornmentClick"
                 Variant="@Variant">
    <ItemTemplate>

        <ADAutoCompleteResult Entry="context" />

    </ItemTemplate>
    <BeforeItemsTemplate>
        <MudText>

            @SearchResults.Count() @AppLocalization[Lang.Results]
        </MudText>

    </BeforeItemsTemplate>
    <NoItemsTemplate>
        @if (SearchTerm.IsNullOrEmpty())
        {
            <MudText>

                @AppLocalization[Lang.Start_typing_to_search]
            </MudText>

        }
        else
        {
            if (SearchTerm.Length < MinCharacters)
            {
                <MudText>
                    @AppLocalization[Lang.Sorry_try_typing_more]
                </MudText>
            }
            else
            {
                <MudText>
                    @AppLocalization[Lang.Sorry_no_result_were_found]
                </MudText>
            }

        }

    </NoItemsTemplate>
    <MoreItemsTemplate>

        <MudText>
            More results than shown...
        </MudText>
    </MoreItemsTemplate>
</MudAutocomplete>




@inherits AppComponentBase
@if (Entry is IAccountDirectoryAdapter account)
{
    <MudContextMenu>

        <ChildContent>

            @ChildContent

        </ChildContent>
        <MenuContents>
            @if(account.CanUnlock && account.LockedOut)
            {
                <MudMenuItem OnClick="(async()=>{await UnlockAccount(account);})" Icon="@Icons.Material.Outlined.LockOpen">
                    @AppLocalization[Lang.Unlock] @AppLocalization[account.ObjectType.ToString()]
                </MudMenuItem>

            }
            @if (account.Enabled)
            {
                <MudMenuItem OnClick="(async()=>{await DisableAccount(account);})" Icon="@Icons.Material.Outlined.Cancel">
                    @AppLocalization[Lang.Disable] @AppLocalization[account.ObjectType.ToString()]
                </MudMenuItem>
            }
            @if (account.Disabled)
            {
                <MudMenuItem OnClick="(async()=>{await EnableAccount(account);})" Icon="@Icons.Material.Outlined.Check">
                    @AppLocalization[Lang.Enable] @AppLocalization[account.ObjectType.ToString()]
                </MudMenuItem>
            }
        </MenuContents>
    </MudContextMenu>
}else{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public IDirectoryEntryAdapter Entry { get; set; }
    [Parameter]
    public EventCallback OnChanged { get; set; }
    async Task UnlockAccount(IAccountDirectoryAdapter userToUnlock)
    {
        if (userToUnlock.LockedOut)
        {

            userToUnlock.LockedOut = false;
            var changes = userToUnlock.Changes;

            var unlockJob = await userToUnlock.CommitChangesAsync();
            await AuditLogger.User.Changed(userToUnlock, changes);
            if (unlockJob.Result == JobResult.Passed)
            {

                SnackBarService.Success(userToUnlock.CanonicalName + " " + AppLocalization[Lang.unlocked]);
                await OnChanged.InvokeAsync();
            }
            else
            {
                SnackBarService.Error("Could not unlock: " + unlockJob.Exception?.Message);
            }
        }
    }

    async Task EnableAccount(IAccountDirectoryAdapter userToUnlock)
    {
        if (userToUnlock.Disabled)
        {

            userToUnlock.Enabled = true;
            var changes = userToUnlock.Changes;

            var unlockJob = await userToUnlock.CommitChangesAsync();
            await AuditLogger.User.Changed(userToUnlock, changes);
            if (unlockJob.Result == JobResult.Passed)
            {

                SnackBarService.Success(userToUnlock.CanonicalName +" " + AppLocalization[Lang.enabled]);
                await OnChanged.InvokeAsync();

            }
            else
            {
                SnackBarService.Error("Could not enable: " + unlockJob.Exception?.Message);
            }
        }
    }

    async Task DisableAccount(IAccountDirectoryAdapter userToUnlock)
    {
        if (userToUnlock.Enabled)
        {

            userToUnlock.Enabled = false;
            var changes = userToUnlock.Changes;

            var unlockJob = await userToUnlock.CommitChangesAsync();
            await AuditLogger.User.Changed(userToUnlock, changes);
            if (unlockJob.Result == JobResult.Passed)
            {

                SnackBarService.Success(userToUnlock.CanonicalName + " " + AppLocalization[Lang.disabled]);
                await OnChanged.InvokeAsync();

            }
            else
            {
                SnackBarService.Error("Could not disable: " + unlockJob.Exception?.Message);
            }
        }
    }
}

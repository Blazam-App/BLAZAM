@inherits MudField
@inject IStringLocalizer<AppLocalization> AppLocalization
@typeparam T

@switch (_type?.Name)
{
    case "int":
    case "Int32":
    case "double":
    case "long":
    case "float":
        <MudNumericField HelperText="@HelperText"
                         T=T
                         Class=@Class
                         Required=@Required
                         Label="@Label"
                         Immediate=@Immediate
                         HideSpinButtons="false"
                         @bind-Value="@Value"
                         ReadOnly=@ReadOnly
                         Clearable=@Clearable />
        break;

    case "String":
        <MudTextField Label="@Label"
                      T=T
                      Class=@Class
                      Required=@Required
                      HelperText="@HelperText"
                      Immediate=@Immediate
                      Clearable=@Clearable
                      ReadOnly=@ReadOnly
                      Value=Value
                      ValueChanged="@((changed)=>{Value =changed;})"
                      Disabled=@Disabled
                      InputType="@InputType" />
        break;
    case "Boolean":
        <MudStack>
            <MudSwitch Color=@Color
                       Class=@Class
                       Required=@Required
                       UncheckedColor=@UncheckedColor
                       T="T"
                       ReadOnly=@ReadOnly
                       Label=@Label
                       @bind-Value=@Value
                       Disabled=@Disabled />
            <MudText Typo="Typo.caption">@HelperText</MudText>
        </MudStack>
        break;
    case "DateTime":
        <MudDatePicker Clearable=@Clearable
                       Class=@Class
                       Required=@Required
                       HelperText="@HelperText"
                       ReadOnly=@ReadOnly
                       Label="@Label"
                       Date="@dateValue"
                       DateChanged=@((date) =>{dateValue = date;})
                       Disabled=@Disabled />
        break;
    case "List`1":
        <MudField Label="@Label"
                  Class=@Class
                  HelperText="@HelperText"
                  Disabled=@Disabled>
            <MudList Disabled=@Disabled
                     T="string"
                     Dense=true
                     Style="max-height:200px; overflow-y:auto;">
                @foreach (string val in StringValues)
                {

                    <MudListItem OnClick="@(() => { _selectedStringListItem = val; })">
                        <ChildContent>
                            <MudStack Row=true>
                                @if (_selectedStringListItem != null && _selectedStringListItem == val)
                                {
                                    <MudTextField T="string"
                                                  Value="@val"
                                                  Immediate=false
                                                  OnBlur="@(()=>{_selectedStringListItem = null;})"
                                                  ValueChanged="@((newVal)=>{UpdateListItem(val,newVal);})" />
                                }
                                else
                                {
                                    <MudText>@val</MudText>
                                }
                                <MudSpacer />
                                <MudIconButton Disabled=@Disabled
                                               Size="Size.Small"
                                               OnClick="@(async()=>{await RemoveListItem(val);})"
                                               Class="align-end align-middle"
                                               Color=Color.Error
                                               Icon="@Icons.Material.Filled.Close" />

                            </MudStack>
                        </ChildContent>
                    </MudListItem>

                }
                <MudListItem OnClick="@(() => { _selectedStringListItem = _newItem; })">
                    <ChildContent>
                        <MudStack Row=true>
                            @if (_newItem != null)
                            {
                                <MudTextField T="string"
                                              Placeholder="@AppLocalization[Lang.Enter_value_here]"
                                              AutoFocus="@(_newItem==String.Empty)"
                                              @bind-Value="@_newItem"
                                              Immediate=false
                                              OnBlur="@(()=>{_selectedStringListItem = null;})" />
                            }
                            else
                            {
                                <MudText>@_newItem</MudText>
                            }
                            <MudSpacer />
                            @if (_newItem == null)
                            {
                                <MudIconButton Disabled=@Disabled
                                               Size="Size.Small"
                                               OnClick="@(async()=>{_newItem=String.Empty;})"
                                               Class="align-end align-middle"
                                               Color=Color.Primary
                                               Icon="@Icons.Material.Filled.Add" />
                            }
                            else
                            {
                                <MudIconButton Disabled=@Disabled
                                               Size="Size.Small"
                                               OnClick="@(async()=>{await AddListItem(_newItem);})"
                                               Class="align-end align-middle"
                                               Color=Color.Success
                                               Icon="@Icons.Material.Filled.Save" />

                            }
                        </MudStack>
                    </ChildContent>
                </MudListItem>

            
            </MudList>
        </MudField>

        break;
    default:

        throw new AppException("The input type: " + _type?.Name + " could not be matched with a MudInput component");

}


@code {
    private string? _newItem = null;
    private T? _originalValue;
    private T? objValue;
    private string? _selectedStringListItem = null;
    private AppModal _listItemModal;
    [Parameter]
    public T? Value
    {
        get => objValue;
        set
        {
            if (objValue?.Equals(value) == true
            || (EqualityComparer<T?>.Default.Equals(objValue, default(T?))
            && EqualityComparer<T?>.Default.Equals(value, default(T?))))
            {
                return;
            }
            if (_originalValue == null)
            {
                _originalValue = value;
            }
            objValue = value;
            if (value is IEnumerable<string> selectedValues)
            {
                var same = true;
                var originalStrings = _originalValue as IEnumerable<string>;
                if (!originalStrings.All(val => StringValues.Contains(val)))
                {
                    same = false;
                }
                if (!StringValues.All(val => originalStrings.Contains(val)))
                {
                    same = false;
                }
               
                if (!same)
                {
                    ValueChanged.InvokeAsync(value);
                }
            }
            else
            {
                ValueChanged.InvokeAsync(value);
            }

            
        }
    }

    [Parameter]
    public EventCallback<T?> ValueChanged { get; set; }

    [Parameter]
    public Color Color { get; set; } = Color.Success;
    [Parameter]
    public Color UncheckedColor { get; set; } = Color.Error;


    /// <summary>
    /// Show clear button.
    /// </summary>
    [Parameter]
    public bool Clearable { get; set; }
    /// <summary>
    /// Will be a read only field if applicable
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Immediate { get; set; } = true;

    private DateTime? dateValue
    {
        get
        {
            if (Value is DateTime time && time != DateTime.MinValue)
                return time;
            return null;
        }
        set
        {

            if (value is T tValue)
                Value = tValue;
            else if (value is null)
                Value = default;
        }
    }
    [Parameter]
    public bool Required { get; set; }
    [Parameter]
    public InputType InputType { get; set; }

    private Type? _type;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _type = typeof(T);
        if (_type.IsGenericType && _type.GetGenericTypeDefinition() == typeof(Nullable<>))
        {
            _type = Nullable.GetUnderlyingType(_type);

        }
    }
    private IEnumerable<string> StringValues =>
        Value is IEnumerable<string> selectedValues
            ? selectedValues
            : Enumerable.Empty<string>();
    private async Task RemoveListItem(string item)
    {
        var workList = StringValues.ToList();
        workList.Remove(item);
        Value = (T?)(object)workList;
    }
    private async Task AddListItem(string item)
    {
        var workList = StringValues.ToList();
        workList.Add(item);
        Value = (T?)(object)workList;
        _newItem = null;
    }
    private async Task UpdateListItem(string existingItem, string newItem)
    {
        var workList = StringValues.ToList();
        var indexToReplace = workList.IndexOf(existingItem);
        workList.Insert(indexToReplace + 1, newItem);
        workList.RemoveAt(indexToReplace);
        Value = (T?)(object)workList;
    }
    private async Task OnStringListChanged(IEnumerable<string> selectedValues)
    {
        Value = (T?)(object)selectedValues;
    }
    public void DiscardChanges()
    {
        _selectedStringListItem = null;
        objValue = _originalValue;
    }
}

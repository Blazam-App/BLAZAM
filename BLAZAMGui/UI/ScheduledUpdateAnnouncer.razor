@inherits AppComponentBase

@if (AutoUpdateService.ScheduledUpdateTime != DateTime.MinValue)
{

    var timeLeft = (AutoUpdateService.ScheduledUpdateTime - DateTime.Now);
    @if (timeLeft.TotalMinutes <= 60)
    {

        <MudBadge Color="Color.Warning">
            Auto-update scheduled! The application will shutdown and update in @timeLeft.Minutes:@timeLeft.Seconds
        </MudBadge>

        Task.Delay(400).ContinueWith(async (s) => { await StateHasChangedAsync(); });
    }
}


@code {

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ApplicationEvents.OnAutoUpdateQueued.EventHandler += UpdateQueued;
        await StateHasChangedAsync();
    }
    public override void Dispose()
    {
        base.Dispose();
        ApplicationEvents.OnAutoUpdateQueued.EventHandler -= UpdateQueued;

    }
    private void UpdateQueued(object? sender, EventArgs e)
    {
        _ = StateHasChangedAsync();
    }
}
@inherits AppComponentBase
<MudElement @onmouseover="@(() => { Show = true; })"
            @onmouseout="@(() => { Show = false; })">
    @ActivatorContent
</MudElement>
<MudPopover AnchorOrigin=Origin.BottomCenter
            TransformOrigin=Origin.TopCenter
            Class="pa-2"
            Open="Show">
    @if (Show)
    {
        <MudElement @onmouseover="@(() => { Show = true; })"
                    Class="pa-2"
                    @onmouseout="@(() => { Show = false; })">
            @PopoverContent
        </MudElement>
    }
</MudPopover>
@code {
    private CancellationTokenSource showCancellationTokenSource = new();
    private bool _stagedShow;
    private bool _show;
    private bool Show
    {
        get => _show; set
        {
            if (_stagedShow == value) return;

            if (!showCancellationTokenSource.IsCancellationRequested)
            {
                showCancellationTokenSource.Cancel();
            }
            showCancellationTokenSource.Dispose();
            showCancellationTokenSource = new();
            _stagedShow = value;
            Task.Delay(500).ContinueWith((state) =>
            {

                _show = _stagedShow;
                _ = UpdateState();

            }, showCancellationTokenSource.Token);

        }
    }
    [Parameter]
    public RenderFragment? ActivatorContent { get; set; }
    [Parameter]
    public RenderFragment? PopoverContent { get; set; }

    public override void Dispose()
    {
        base.Dispose();
        showCancellationTokenSource.Dispose();
    }
}

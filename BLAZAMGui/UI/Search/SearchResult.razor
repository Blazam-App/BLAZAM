@inject IStringLocalizer<AppLocalization> AppLocalization

<MudCard @onclick=@(()=>{OnSelected.InvokeAsync();}) Class=@("cursor-pointer d-inline-flex pa-4 "+Class)>
    <MudCardContent Class="pa-0">
        <MudStack Spacing="0" Row=true>
            <DirectoryEntryTypeIcon Entry="@Entry" />
            <MudText>@Entry.CanonicalName</MudText>

        </MudStack>
        <MudText Typo="Typo.body2">@Entry.OU.ToPrettyOu()</MudText>
    </MudCardContent>
</MudCard>
@code {

    /// <summary>
    /// The directory entry of this search result
    /// </summary>
    [Parameter]
    public IDirectoryEntryAdapter Entry { get; set; }
    
    [Parameter]
    public string Class { get; set; }

    /// <summary>
    /// Called when the search result is selected for viewing
    /// </summary>
    [Parameter]
    public EventCallback OnSelected { get; set; }
}


@using BLAZAM.Global.Data
@using BLAZAM.Gui.Helpers
@using BLAZAM.Gui.UI.Groups
@using BLAZAM.Gui.UI.Users

@inherits TemplateComponent
@attribute [Authorize(Roles = UserRoles.CreateUsers)]

@if (newUser != null && !_userCreated)
{
    <AppNavLock />
}
<AppPageTitle>@AppLocalization[Lang.Create_User]</AppPageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudTabs PanelClass="mx-auto w-100"
    @ref=Tabs
    Elevation="0"
    Outlined="true"
    @bind-ActivePanelIndex="SelectedStep"
    Centered=true>

        <MudTabPanel>
            <TabContent>
                @AppLocalization[Lang.Template]
            </TabContent>
            <ChildContent>

                @if (TemplateCategories != null && Templates != null && Templates.Count(t => t.DeletedAt == null && t.Visible) > 0)
                {

                    <MudCarousel Style="height:50vh"
                    ShowArrows=false
                    ShowBullets=false
                    EnableSwipeGesture=false
                    AutoCycle=false
                    @bind-SelectedIndex=_templateCarouselIndex
                    TData="object">
                        <MudCarouselItem Class="pa-5">
                            <FlexContainer>

                                @foreach (var category in TemplateCategoriesUserCanUse)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Folder"
                                    OnClick=@(()=>{SelectedCategory=category; _templateCarouselIndex=1;})
                                    Variant="Variant.Filled"
                                    Color="Color.Secondary"
                                    Size="Size.Large">@category</MudButton>
                                }
                                @foreach (var uncategorizedTemplate in TemplatesUserCanUse.Where(t => t.Category.IsNullOrEmpty() && t.DeletedAt == null && t.Visible))
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.DynamicForm"
                                    OnClick=@(async()=>{await SetTemplate(uncategorizedTemplate);})
                                    Variant="Variant.Filled"
                                    Color="Color.Primary"
                                    Size="Size.Large">@uncategorizedTemplate.Name</MudButton>
                                }
                            </FlexContainer>
                        </MudCarouselItem>

                        <MudCarouselItem Class="pa-5">

                            <FlexContainer>
                                <MudFab StartIcon="@Icons.Material.Filled.ArrowBack"
                                Size="Size.Small"
                                OnClick="@(()=>{_templateCarouselIndex=0; SelectedCategory=null;})"
                                Color="Color.Primary" />
                                @foreach (var template in TemplatesUserCanUse.Where(t => t.DeletedAt == null && t.Visible))
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.DynamicForm"
                                    OnClick=@(async()=>{await SetTemplate(template);})
                                    Variant="Variant.Filled"
                                    Color="Color.Primary"
                                    Size="Size.Large">@template.Name</MudButton>

                                }
                            </FlexContainer>

                        </MudCarouselItem>
                    </MudCarousel>

                }
                else
                {
                    <MudPaper Width="300px">
                        <MudText>@AppLocalization["There are no templates available"]</MudText>
                        <AuthorizeView Roles="@UserRoles.SuperAdmin">
                            <MudLink Href="/templates">@AppLocalization[Lang.Create_One]</MudLink>

                        </AuthorizeView>
                    </MudPaper>
                }
                <MudButton Color=Color.Secondary
                OnClick="@(()=>{custom=true; newUser=null; SelectedTemplate=null; SelectedStep=5;})">
                    @AppLocalization[Lang.Custom]
                </MudButton>

            </ChildContent>

        </MudTabPanel>

        <MudTabPanel Class=@(SelectedTemplate!=null?"":"d-none")
        Disabled=@( SelectedTemplate==null)>
            <TabContent>
                @AppLocalization[Lang.Name]
            </TabContent>
            <ChildContent>


                <NewUserNameEntry @bind-NewUserName=@newUserName
                OnNext="CreateTemplateUser"
                OnBack="@(()=>{SelectedStep=0;})" />



            </ChildContent>

        </MudTabPanel>
        <MudTabPanel Class=@(SelectedTemplate!=null?"":"d-none")
        Disabled="@(newUser==null || _userCreated)">
            <TabContent>
                @AppLocalization[Lang.Username]
            </TabContent>
            <ChildContent>
                @{
                    Loggers.ActiveDirectoryLogger.Information("Checking for username conflicts for new user: {@NewUserName}", newUser?.SAMAccountName);
                    var conflictingEntry = Directory.Users.FindUserByUsername(newUser?.SAMAccountName, false, true);
                    bool conflictWarning = false;
                    if (conflictingEntry != null && conflictingEntry.SAMAccountName?.Equals(newUser?.SAMAccountName, StringComparison.InvariantCultureIgnoreCase) == true)
                    {


                        Loggers.ActiveDirectoryLogger.Information("Username conflict detected when creating user: {@NewUserName}{@ExistingUserDN}{@ExistingUserSamAccountName}", newUser?.SAMAccountName,conflictingEntry.DN, conflictingEntry.SAMAccountName);

                       _usernameStepValid = false;
                        conflictWarning = true;
                    }
                    else
                    {
                        Loggers.ActiveDirectoryLogger.Debug("No username conflict detected for new user: {@NewUserName}", newUser?.SAMAccountName);
                        if (newUser?.SAMAccountName.IsNullOrEmpty() == false)
                        {
                            _usernameStepValid = true;
                        }

                    }

                }
                <MudTextField Class="mt-5"
                Label="@AppLocalization[Lang.Username]"
                Immediate="true"
                Disabled=@(!CurrentUser.State.IsSuperAdmin && SelectedTemplate?.EffectiveAllowUsernameOverride!=true)
                T=string
                @bind-Value=@newUser!.SAMAccountName />
                @if (conflictWarning)
                {
                    <MudAlert Severity="Severity.Error">
                        @AppLocalization["An account with that name already exists!"]<br/>
                        @AppLocalization[Lang.User]: @conflictingEntry.SAMAccountName
                    </MudAlert>
                }
                <MudButton Disabled=LoadingData
                Color=Color.Primary
                OnClick="@(()=>{SelectedStep=1;})">
                    @AppLocalization[Lang.Back]
                </MudButton>
                <MudButton Color=Color.Success
                Disabled="@(conflictWarning)"
                OnClick="@(()=>{SelectedStep=3;})">
                    @AppLocalization[Lang.Next]
                </MudButton>

            </ChildContent>

        </MudTabPanel>
        <MudTabPanel Class=@(SelectedTemplate!=null?"":"d-none")
        Disabled="@(newUser==null || !_usernameStepValid || _userCreated)">
            <TabContent>
                @AppLocalization[Lang.Fields]
            </TabContent>
            <ChildContent>
                <NewTemplateUser NewUserName="newUserName"
                OnValidSubmit=@(()=>{SelectedStep=4;})
                Entry="@newUser"
                DirectoryTemplate="SelectedTemplate" />
                <MudButton Disabled=LoadingData
                Color=Color.Primary
                OnClick="@(()=>{SelectedStep=2;})">
                    @AppLocalization[Lang.Back]
                </MudButton>

            </ChildContent>

        </MudTabPanel>

        <MudTabPanel Class=@(SelectedTemplate!=null?"":"d-none")
        Disabled="@(newUser==null || !_usernameStepValid || _userCreated)">
            <TabContent>
                @AppLocalization[Lang.Groups]
            </TabContent>
            <ChildContent>
                <MemberOfList Target="_blank"
                AssignToClicked="@(async()=>{await _assignToModal!.ShowAsync();})"
                Disabled="@(SelectedTemplate?.EffectiveAllowCustomGroups!=true  && !CurrentUser.State.IsSuperAdmin)"
                Model="@newUser" />
                <AppModal @ref=_assignToModal>
                    <AssignToModalContent ModelChanged=@(async()=>{
                                            await StateHasChangedAsync();
                                          }) DirectoryModel="newUser" />
                </AppModal>
                <MudButton Disabled=LoadingData
                Color=Color.Primary
                OnClick="@(()=>{SelectedStep=3;})">
                    @AppLocalization[Lang.Back]
                </MudButton>
                <MudButton Color=Color.Success
                OnClick="@(()=>{SelectedStep=7;})">
                    @AppLocalization[Lang.Next]
                </MudButton>

            </ChildContent>

        </MudTabPanel>


        <MudTabPanel Class=@(custom==true?"":"d-none") Disabled="@(custom==false || _userCreated)">
            <TabContent>
                @AppLocalization[Lang.OU]
            </TabContent>
            <ChildContent>
                <ADTreeView ShowAllEntries=false AdditionalVisibilityFilters=@(AdditionalShow)
                            StartRootExpanded=true
                            SelectedEntryChanged="OUSelected" />

                <MudTextField Label="@AppLocalization[Lang.Display_Name]"
                @bind-Value="@customUserDisplayName" />



                <MudButton Color=Color.Primary
                OnClick="@(()=>{SelectedStep=0;})">
                    @AppLocalization[Lang.Back]
                </MudButton>
                <MudButton Disabled=@(customUserDisplayName.IsNullOrEmpty()|| selectedOU==null)
                Color=Color.Success
                OnClick="@(async()=>{
                                                await CreateCustomUser();
                                                selectedStep=6;
                                                })">
                    @AppLocalization[Lang.Next]
                </MudButton>


            </ChildContent>

        </MudTabPanel>
        <MudTabPanel Class=@(custom==true?"":"d-none")
        Disabled="@(newUser==null || !_usernameStepValid || _userCreated)">
            <TabContent>
                @AppLocalization[Lang.Details]
            </TabContent>
            <ChildContent>
                @*TODO: The following binding cause the next button to not update when validation is reached, updates are controlled from
                this element
                *@
                <ViewUser DirectoryEntry="@newUser"
                @bind-ConfirmPassword=@customConfirmPassword
                @bind-Password=customPassword />
                <MudButton Color=Color.Primary
                OnClick="@(()=>{SelectedStep=4;})">
                    @AppLocalization[Lang.Back]
                </MudButton>
                <MudButton Color=Color.Success
                OnClick="@(()=>{
                                            SelectedStep=7;
                                            if(newUser?.NewPassword==null || !newUser.NewPassword.Equals(customConfirmPassword))
                                                newUser?.StagePasswordChange(customConfirmPassword.ToSecureString());
                                            })"
                Disabled=@(customConfirmPassword.IsNullOrEmpty()||customPassword.IsNullOrEmpty()||!customPassword.Equals(customConfirmPassword))>
                    @AppLocalization[Lang.Next]
                </MudButton>
            </ChildContent>

        </MudTabPanel>


        <MudTabPanel Disabled=@(newUser==null || !_usernameStepValid)>
            <TabContent>

                @AppLocalization[Lang.Confirm]
            </TabContent>
            <ChildContent>
                <ConfirmNewUser User="@newUser"
                Confirmed="_userCreated"
                DirectoryTemplate="SelectedTemplate"
                OnConfirmed="UserConfirmed" />

            </ChildContent>

        </MudTabPanel>
    </MudTabs>

</MudContainer>





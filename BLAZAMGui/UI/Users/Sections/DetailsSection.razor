@inherits DirectoryModelComponentElement






<ViewSection Title="@AppLocalization["User Details"]" Stack=true FullWidth=false>

    <MudCard Elevation="2"
             Style="width:fit-content;height:fit-content"
             Class="relative mx-auto d-block p-1 mb-5"
             @onmouseenter=@(()=>{showRemoveThumbnail=true;})
             @onmouseleave=@(()=>{showRemoveThumbnail=false;})>

        @if (Contact?.ThumbnailPhoto != null)
        {
            <Base64Image Style="max-height:150px;max-width:150px;" Data="Contact.ThumbnailPhoto.ResizeRawImage(150)" />
            @if (showRemoveThumbnail && Contact.CanEditField(ActiveDirectoryFields.Thumbnail))
            {

                <MudIconButton OnClick=RemoveThumbnail
                               Style="position:absolute !important;width:40px;height:40px;padding:2px;top:10px;left:10px"
                               Color=Color.Error
                               Icon="@Icons.Material.Filled.Delete" />
            }

        }
        else if (User != null)
        {
            <MudIcon Style="height:150px;width:150px;" Icon="@Icons.Material.Filled.Person" />

        }
        else if (Contact != null)
        {
            <MudIcon Style="height:150px;width:150px;" Icon="@Icons.Material.Filled.Contacts" />

        }
        @if (showRemoveThumbnail && GroupableEntry?.CanEditField(ActiveDirectoryFields.Thumbnail) == true)
        {
            <MudIconButton OnClick=@(()=>{UploadThumbnailModal?.ShowAsync();})
                           Style="position:absolute !important;width:40px;height:40px;padding:2px;top:10px;right:10px"
                           Color=Color.Primary
                           Icon="@Icons.Material.Filled.Upload" />
        }
    </MudCard>

    <MudStack Row=true>
        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Created]:</MudText>
        <MudSpacer />
        <DateWithTimeTooltip DateTime="GroupableEntry?.Created" />

    </MudStack>

    <MudStack Row=true>

        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Last_Change]:</MudText>
        <MudSpacer />

        <DateWithTimeTooltip DateTime="GroupableEntry?.LastChanged" />

    </MudStack>
    @if (User != null)
    {
        <MudStack Row=true>

            <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Pass_Change]:</MudText>
            <MudSpacer />
            <DateWithTimeTooltip DateTime="User?.PasswordLastSet" />


        </MudStack>

        <MudStack Row=true>

            <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Last_Logon]:</MudText>
            <MudSpacer />
            <LastLogonTime Typo=Typo.caption DirectoryEntry="Account" />
        </MudStack>
        @if (Account?.LockedOut == true)
        {
            <MudStack Row=true>
                <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Lockout_Time]:</MudText>
                <MudSpacer />
                <DateWithTimeTooltip DateTime="Account?.LockoutTime" />
            </MudStack>
        }
    }
    <MudStack Row=true>
        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.OU]:</MudText>
        <MudSpacer />

        <MudText Style="text-align:end;"
                 Typo="Typo.caption">@GroupableEntry?.OU.ToPrettyOu()</MudText>
    </MudStack>





    <MudStack>
        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Groups]:</MudText>
        <MemberOfList AssignToClicked=@AssignToClicked Model="GroupableEntry" />
    </MudStack>

    @if (GroupableEntry is IADUser && Account.Disabled)
    {
        <MudAlert Severity="Severity.Error"
                  Class="mud-width-full">@AppLocalization[Lang.User_is_disabled]</MudAlert>

    }
    @if (GroupableEntry is IADUser && Account.LockedOut)
    {
        <MudAlert Severity="Severity.Warning"
                  Class="mud-width-full">@AppLocalization[Lang.User_is_locked_out]</MudAlert>
    }


    <PluginComponents Page="@PageType.User" Location="@PageLocation.Details" />

</ViewSection>

<AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Upload_Thumbnail_Photo] @ref=@UploadThumbnailModal>
    <UploadThumbnailModalContent DirectoryEntry="User" />
</AppModal>


@code {
    AppModal? UploadThumbnailModal { get; set; }


    [Parameter]
    public EventCallback AssignToClicked { get; set; }
    bool showRemoveThumbnail = false;

    async Task RemoveThumbnail()
    {

        Contact.ThumbnailPhoto = null;
        SnackBarService.Warning(GroupableEntry.DisplayName + " will have their thumbnail deleted on save.");


    }
}

@inherits DirectoryModelComponentElement

@if (Contact.CanReadField(ActiveDirectoryFields.HomePhone) ||
          Contact.CanReadField(ActiveDirectoryFields.StreetAddress) ||
          Contact.CanReadField(ActiveDirectoryFields.POBox) ||
          Contact.CanReadField(ActiveDirectoryFields.City) ||
          Contact.CanReadField(ActiveDirectoryFields.State) ||
          Contact.CanReadField(ActiveDirectoryFields.PostalCode)
          )
{
    <ViewSection Title=@AppLocalization[Lang.Contact_Info]>

        @if (Contact.CanReadField(ActiveDirectoryFields.HomePhone))
        {
            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.Home_Phone]"
                             @bind-Value="@Contact.HomePhone"
                             Disabled=@(!EditMode || !Contact.CanEditField(ActiveDirectoryFields.HomePhone)) />

        }
        @if (Contact.CanReadField(ActiveDirectoryFields.StreetAddress))
        {
            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.Street_Address]"
                             @bind-Value="@Contact.StreetAddress"
                             Disabled=@(!EditMode || !Contact.CanEditField(ActiveDirectoryFields.StreetAddress)) />
        }
        @if (Contact.CanReadField(ActiveDirectoryFields.POBox))
        {
            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.PO_Box]"
                             @bind-Value="@Contact.POBox"
                             Disabled=@(!EditMode || !Contact.CanEditField(ActiveDirectoryFields.POBox)) />
        }
        @if (Contact.CanReadField(ActiveDirectoryFields.City))
        {
            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.City]"
                             @bind-Value="@Contact.City"
                             Disabled=@(!EditMode || !Contact.CanEditField(ActiveDirectoryFields.City)) />
        }
        @if (Contact.CanReadField(ActiveDirectoryFields.State))
        {
            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.State]"
                             @bind-Value="@Contact.State"
                             Disabled=@(!EditMode || !Contact.CanEditField(ActiveDirectoryFields.State)) />
        }
        @if (Contact.CanReadField(ActiveDirectoryFields.PostalCode))
        {
            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.Zip_Code]"
                             @bind-Value="@Contact.Zip"
                             Disabled=@(!EditMode || !Contact.CanEditField(ActiveDirectoryFields.PostalCode)) />
        }

        <PluginComponents Page="@PageType.User" Location="@PageLocation.ContactInfo" />

    </ViewSection>
}


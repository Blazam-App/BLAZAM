@using BLAZAM.Services.Plugins
@inherits DirectoryModelComponentElement







@if (User != null)
{
    <ViewSection Title="@AppLocalization[Lang.Account]">




        <AppTooltip Disabled=@(!EditMode || GroupableEntry.NewEntry) Text=@AppHelpLocalization[HelpLang.Modify_Name_Redirect]>

            <MudStack Row=true Spacing="0">


                <DynamicMudInput T=string Label="@AppLocalization[Lang.Username]"
                                 @bind-Value="@User.SAMAccountName"
                                 Disabled=@(User?.NewEntry==false) />
                <AppCopyButton TextToCopy=@User.SAMAccountName />

            </MudStack>
        </AppTooltip>



        @if (GroupableEntry?.NewEntry == true)
        {
            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.Password]"
                             @bind-Value="@Password"
                             InputType="InputType.Password" />

            <DynamicMudInput T=string
                             Label="@AppLocalization[Lang.Confirm_Password]"
                             @bind-Value="@ConfirmPassword"
                             InputType="InputType.Password" />
        }

        <AppTooltip Disabled=@(!EditMode || GroupableEntry.NewEntry) Text=@AppHelpLocalization[HelpLang.Modify_Name_Redirect]>
            <MudStack Row=true Spacing="0">
                <DynamicMudInput T=string Label="@AppLocalization[Lang.Email_Address]"
                                 @bind-Value="@Contact.Email"
                                 Disabled=@(Contact?.NewEntry==false) />
                <AppCopyButton TextToCopy=@Contact.Email />

            </MudStack>
        </AppTooltip>

        @if (EditMode && !GroupableEntry.NewEntry)
        {


            <MudAlert Severity="Severity.Info">
                @AppHelpLocalization[HelpLang.Modify_Name_Redirect]
            </MudAlert>

        }

        @if (User.CanReadField(ActiveDirectoryFields.AccountExpires))
        {
            <DynamicMudInput T=DateTime?
                             Clearable=true
                             Label="@AppLocalization[Lang.Account_Expiration]"
                             Value="@User.ExpireTime?.ToLocalTime()"
                             ValueChanged="@((value)=>{User.ExpireTime=value;})"
                             Disabled=@(!EditMode || !User.CanEditField(ActiveDirectoryFields.AccountExpires)) />


        }

        <MudStack Row=true Spacing="3" Class="mx-auto">

            @if (User.CanReadField(ActiveDirectoryFields.LogOnTo))
            {
                <MudButton Variant="Variant.Filled"
                           Color="@(User.LogOnTo == null || User.LogOnTo == String.Empty?Color.Primary:Color.Warning)"
                           OnClick="@(()=>{LogOnToModal?.ShowAsync();})"
                           Disabled=@(!EditMode || !User.CanEditField(ActiveDirectoryFields.LogOnTo))>
                    @AppLocalization[Lang.Log_On_To]
                </MudButton>

            }

            @if (User.CanReadField(ActiveDirectoryFields.LogonHours))
            {
                <MudButton Variant="Variant.Filled"
                           Color="@(Color.Primary)"
                           OnClick="@(()=>{LogonHoursModal?.ShowAsync();})"
                           Disabled=@(!EditMode || !User.CanEditField(ActiveDirectoryFields.LogonHours))>
                    @AppLocalization[Lang.Logon_Hours]
                </MudButton>

            }
            @if (Account.CanSetPassword)
            {
                <MudSwitch T=bool
                           Color=Color.Success
                           ThumbIconColor="@(Account.RequirePasswordChange==true?Color.Success:Color.Default)"
                           Label=@AppLocalization[Lang.Require_Password_Change]
                           Value=@Account.RequirePasswordChange
                           Disabled=@true />

            }
        </MudStack>
        @if (CurrentUser.State.IsSuperAdmin)
        {

            @if (showFailedLogons)
            {
                <UserFailedLogons />
            }
            else
            {
                <MudText Class="mud-width-full" Align="Align.Center">
                    <MudButton Color=Color.Primary
                               Variant=Variant.Filled
                               OnClick="@(()=>{showFailedLogons=true;})">
                        Show Failed Logons
                    </MudButton>
                </MudText>
            }
        }

        @foreach(var pluginComponent in accountPluginComponents)
        {
            <DynamicComponent Type="@pluginComponent" />
        }
    


    </ViewSection>

    <AppModal Title=@AppLocalization[Lang.Log_On_To] @ref=@LogOnToModal>
        @if (LogOnToModal?.IsShown == true)
        {
            <LogOnToModalContent Entry="User" />
        }
    </AppModal>
    <AppModal Title=@AppLocalization[Lang.Logon_Hours]
              @ref=@LogonHoursModal
              Options=@(new DialogOptions(){CloseButton=true, FullWidth=true,MaxWidth=MaxWidth.ExtraExtraLarge})>
        @if (LogonHoursModal?.IsShown == true)
        {
            <LogonHoursModalContent Entry="User" />
        }
    </AppModal>

}

@code {


    AppModal? LogonHoursModal { get; set; }
    AppModal? LogOnToModal { get; set; }

    string password;
    bool showFailedLogons;

    [Parameter]
    public string Password
    {
        get => password; set
        {
            if (password == value) return;
            password = value;
            PasswordChanged.InvokeAsync(password);
        }
    }

    [Parameter]
    public EventCallback<string> PasswordChanged { get; set; }


    string confirmPassword;
    [Parameter]
    public string ConfirmPassword
    {
        get => confirmPassword; set
        {
            if (confirmPassword == value) return;
            confirmPassword = value;
            ConfirmPasswordChanged.InvokeAsync(confirmPassword);
        }
    }
    [Parameter]
    public EventCallback<string> ConfirmPasswordChanged { get; set; }

    List<Type> accountPluginComponents = new List<Type>();
    protected override void OnInitialized()
    {
        base.OnInitialized();
        accountPluginComponents = PluginManager.GetPluginTypeForPageAndLocation(Plugins.PageType.User, Plugins.PageLocation.Account);

    }
}

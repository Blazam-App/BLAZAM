@using BLAZAM.Database.Models.Templates;
@using BLAZAM.Global.Data
@inherits DirectoryModelComponent
@if (_initialized)
{
    <MudElement Class="mx-auto">
        <MudForm Model="@Entry" @bind-IsValid=IsValid>
            <CascadingValue Value="GroupableEntry">
                <CascadingValue Value="Entry">
                    <CascadingValue Value="DirectoryTemplate">


                        @{
                            if (IsAdmin)
                            {
                                <MudAlert Class="mud-alert-info">
                                    All fields are editable because you are an admin.
                                </MudAlert>
                            }
                        }
                        @if (InDirectoryTemplate(ActiveDirectoryFields.Thumbnail)){
                            <ContactThumbnailPhoto Contact=Contact
                                                   Required=@(DirectoryTemplate.IsRequiredField(ActiveDirectoryFields.Thumbnail))
                                Disabled=@(!IsAdmin && !DirectoryTemplate.IsEditableField(ActiveDirectoryFields.Thumbnail)) />
                         }
                        @if (InDirectoryTemplate(ActiveDirectoryFields.LogonHours) ||
                                            InDirectoryTemplate(ActiveDirectoryFields.LogOnTo) ||
                                            InDirectoryTemplate(ActiveDirectoryFields.AccountExpires)
                                            )
                        {

                            <ViewSection Title=@AppLocalization[Lang.Account]>
                                @if (InDirectoryTemplate(ActiveDirectoryFields.AccountExpires))
                                {
                                    <DynamicMudInput T=DateTime?
                                                     Clearable=true
                                                     Label="@AppLocalization[Lang.Account_Expiration]"
                                                     Value="@User.ExpireTime?.ToLocalTime()"
                                                     ValueChanged="@((value)=>{User.ExpireTime=value;})"
                                                     Disabled=@(!IsAdmin && !DirectoryTemplate.IsEditableField(ActiveDirectoryFields.AccountExpires)) />
                                }
                                <MudStack Row=true>
                                    @if (InDirectoryTemplate(ActiveDirectoryFields.LogOnTo))
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="@(User.LogOnTo == null || User.LogOnTo == String.Empty?Color.Primary:Color.Warning)"
                                                   OnClick="@(()=>{_logOnToModal?.ShowAsync();})"
                                                   Disabled=@(!IsAdmin && !DirectoryTemplate.IsEditableField(ActiveDirectoryFields.LogOnTo))>
                                            @AppLocalization[Lang.Log_On_To]
                                        </MudButton>

                                        <AppModal Title=@AppLocalization[Lang.Log_On_To] @ref=@_logOnToModal>
                                            @if (_logOnToModal?.IsShown == true)
                                            {
                                                <LogOnToModalContent Entry="User" />
                                            }
                                        </AppModal>



                                    }
                                    @if (InDirectoryTemplate(ActiveDirectoryFields.LogonHours))
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="@(Color.Primary)"
                                                   OnClick="@(()=>{_logonHoursModal?.ShowAsync();})"
                                                   Disabled=@(!IsAdmin && !DirectoryTemplate.IsEditableField(ActiveDirectoryFields.LogonHours))>
                                            @AppLocalization[Lang.Logon_Hours]
                                        </MudButton>

                                        <AppModal Title=@AppLocalization[Lang.Logon_Hours]
                                                  @ref=@_logonHoursModal
                                                  Options=@(new DialogOptions(){CloseButton=true, FullWidth=true,MaxWidth=MaxWidth.ExtraExtraLarge})>
                                            @if (_logonHoursModal?.IsShown == true)
                                            {
                                                <LogonHoursModalContent Entry="User" />
                                            }
                                        </AppModal>
                                    }

                                </MudStack>


                            </ViewSection>
                        }

                        <OrganizationSection />

                        <ContactInfoSection />


                        @if (InDirectoryTemplate(ActiveDirectoryFields.Site))
                        {

                            <MudTextField Immediate=true
                                          Label="@AppLocalization[Lang.Site]"
                                          @bind-Value="@Contact.Site"
                                          Disabled=@(!IsAdmin && !DirectoryTemplate.IsEditableField(ActiveDirectoryFields.Site))
                                          Required=@(DirectoryTemplate.IsRequiredField(ActiveDirectoryFields.Site)) />

                        }

                        <ProfileSection />

                        @if (Entry.CanReadAnyCustomFields)
                        {
                            <ViewSection Title=@AppLocalization[Lang.Additional_Fields]>
                                @foreach (var field in DirectoryTemplate.EffectiveFieldValues.Where(f => f.CustomField != null && f.DeletedAt == null))
                                {
                                    @if (field.CustomField != null)
                                    {
                                        <DynamicMudInput Immediate=true
                                                         Required=@(field.Required)
                                                         Label="@field.FieldDisplayName"
                                                         Value="@Entry.NewEntryProperties[field.CustomField.FieldName].ToString()"
                                                         ValueChanged="@((string val) => { Entry.NewEntryProperties[field.CustomField.FieldName] = val; })"
                                                         Disabled=@(!IsAdmin && !DirectoryTemplate.IsEditableField(field.CustomField)) />
                                    }
                                }
                            </ViewSection>
                        }




                        <MudButton Color=Color.Success
                                   Disabled=@(!IsValid)
                                   OnClick="@(()=>{OnValidSubmit.InvokeAsync();})">
                            @AppLocalization[Lang.Next]
                        </MudButton>



                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </MudForm>
    </MudElement>
}
<LoadingData Loading=@(!_initialized) />




@code {
    private AppModal? _logOnToModal;
    private AppModal? _logonHoursModal;

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }
    [Parameter]
    public DirectoryTemplate DirectoryTemplate { get; set; }
    [Parameter]
    public NewUserName NewUserName { get; set; }

    [Parameter]
    public new bool IsValid { get; set; }

    bool _initialized = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        DirectoryTemplate.PopulateFields(User, NewUserName);
        _initialized = true;
        await StateHasChangedAsync();
    }

    bool InDirectoryTemplate(IActiveDirectoryField field)
    {
        return DirectoryTemplate.EffectiveFieldValues.Any(f => (f.Field != null && f.Field.FieldName == field.FieldName) || (f.CustomField != null && f.CustomField.FieldName == field.FieldName));
    }



    bool ValidateCustomField(DirectoryTemplateFieldValue field)
    {

        if (field.Required && Entry.NewEntryProperties[field.CustomField.FieldName] != null
        && Entry.NewEntryProperties[field.CustomField.FieldName].ToString() != "")
        {
            return true;
        }
        else
        {
            return false;
        }

    }


}

@using BLAZAM.Common.Data.Database
@inherits DirectoryEntryViewBase
@{
    string _fieldMudStackClasses = "flex-wrap gap-10";
}
@if (Account?.NewEntry == true)
{
    EditMode = true;

}
@if (Account != null)
{
    <AppPageTitle>@Account?.SamAccountName</AppPageTitle>

    <EditForm OnValidSubmit=SaveChanges Model="Account">
        <CascadingValue Value="EditMode">

            @if (Account?.NewEntry == false)
            {
                <SetSubHeader @ref="SubHeader">

                    <DirectoryEntryViewHeader EditMode="@EditMode"
                                              DirectoryEntry="@Account"
                                              OnAssignTo="@(()=>{AssignToModal?.ShowAsync();})"
                                              OnChangeThumbnail="@(()=>{UploadThumbnailModal?.ShowAsync();})"
                                              OnDelete="@DeleteUser"
                                              OnDisable="@(async()=>{Account.Enabled=false; await RefreshEntryComponents();})"
                                              OnEnable="@(async()=>{Account.Enabled=true; await RefreshEntryComponents();})"
                                              OnMove="@(()=>{MoveToModal?.ShowAsync();})"
                                              OnRename="@(()=>{RenameModal?.ShowAsync();})"
                                              OnResetPassword="@(()=>{ChangePasswordModal?.ShowAsync();})"
                                              OnToggleEditMode="ToggleEditMode"
                                              OnShowHistory="@(()=>{ChangeHistoryModal?.ShowAsync();})"
                                              OnShowPermissions="@(()=>{EffectivePermissionsModal?.ShowAsync();})"
                                              OnUnlock="@Unlock" />
                    <LoadingData Loading=SavingChanges />



                </SetSubHeader>
            }
            <CascadingValue Value="Account">

                <AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Upload_Thumbnail_Photo] @ref=@UploadThumbnailModal>
                    <UploadThumbnailModalContent ModelChanged=@RefreshEntryComponents DirectoryModel="User" />
                </AppModal>
                <AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Assign_To] @ref=@AssignToModal>
                    <AssignToModalContent ModelChanged=@RefreshEntryComponents DirectoryModel="Contact" />
                </AppModal>
                <AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Move_To] @ref=@MoveToModal>
                    @if (MoveToModal?.IsShown == true)
                    {
                        <MoveToOUModalContent ModelChanged=@RefreshEntryComponents DirectoryModel="Account" />
                    }
                </AppModal>
                <AppModal Title=@AppLocalization[Lang.Rename_User] @ref=@RenameModal>
                    @if (RenameModal?.IsShown == true)
                    {
                        <RenameUserModalContent DirectoryModelRenamed=@((renamedUser)=>{Renamed(renamedUser);}) Entry="User" />
                    }
                </AppModal>
                <AppModal Title=@AppLocalization[Lang.Reset_Password] @ref=@ChangePasswordModal>
                    @if (ChangePasswordModal?.IsShown == true)
                    {
                        <ChangeUserPasswordModalContent Entry="User" />
                    }
                </AppModal>
                <AppModal Title=@AppLocalization[Lang.Log_On_To] @ref=@LogOnToModal>
                    @if (LogOnToModal?.IsShown == true)
                    {
                        <LogOnToModalContent Entry="User" />
                    }
                </AppModal>
                <AppModal Title=@AppLocalization[Lang.Logon_Hours]
                          @ref=@LogonHoursModal
                          Options=@(new DialogOptions(){CloseButton=true, FullWidth=true,MaxWidth=MaxWidth.ExtraExtraLarge})>
                    @if (LogonHoursModal?.IsShown == true)
                    {
                        <LogonHoursModalContent Entry="User" />
                    }
                </AppModal>

                <MudGrid>
                    <MudItem xs="12" md="3">

                        <Section FullWidth=false>

                            <MudCard Elevation="2"
                                     Style="width:fit-content;height:fit-content"
                                     Class="relative mx-auto d-block p-1 mb-5"
                                     @onmouseenter=@(()=>{showRemoveThumbnail=true;})
                                     @onmouseleave=@(()=>{showRemoveThumbnail=false;})>

                                @if (Contact?.ThumbnailPhoto != null)
                                {
                                    <Base64Image Style="max-height:150px;max-width:150px;" Data="Contact.ThumbnailPhoto.ReizeRawImage(150)" />
                                    @if (showRemoveThumbnail && CanEditField(ActiveDirectoryFields.Thumbnail))
                                    {

                                        <MudIconButton OnClick=RemoveThumbnail
                                                       Style="position:absolute !important;width:40px;height:40px;padding:2px;top:10px;left:10px"
                                                       Color=Color.Error
                                                       Icon="@Icons.Material.Filled.Delete" />
                                    }

                                }
                                else
                                {
                                    <MudIcon Style="height:150px;width:150px;" Icon="@Icons.Material.Filled.Person" />

                                }
                                @if (showRemoveThumbnail && Account?.CanEditField(ActiveDirectoryFields.Thumbnail) == true)
                                {
                                    <MudIconButton OnClick=@(()=>{UploadThumbnailModal?.ShowAsync();})
                                                   Style="position:absolute !important;width:40px;height:40px;padding:2px;top:10px;right:10px"
                                                   Color=Color.Primary
                                                   Icon="@Icons.Material.Filled.Upload" />
                                }
                            </MudCard>

                            <MudStack Row=true>
                                <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Created]:</MudText>
                                    <MudSpacer />
                                    <DateWithTimeTooltip DateTime="Account?.Created" />

                                </MudStack>

                                <MudStack Row=true>

                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Last_Change]:</MudText>
                                    <MudSpacer />

                                    <DateWithTimeTooltip DateTime="Account?.LastChanged" />

                                </MudStack>
                                @if (User!=null)
                            {
                                <MudStack Row=true>

                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Pass_Change]:</MudText>
                                        <MudSpacer />
                                        <DateWithTimeTooltip DateTime="User?.PasswordLastSet" />


                                    </MudStack>

                                <MudStack Row=true>

                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Last_Logon]:</MudText>
                                        <MudSpacer />
                                        <LastLogonTime Typo=Typo.caption DirectoryEntry="Account" />
                                    </MudStack>
                                @if (Account?.LockedOut == true)
                                {
                                    <MudStack Row=true>
                                        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Lockout_Time]:</MudText>
                                            <MudSpacer />
                                            <DateWithTimeTooltip DateTime="Account?.LockoutTime" />
                                        </MudStack>
                                }
                            }
                            <MudStack Row=true>
                                <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.OU]:</MudText>
                                    <MudSpacer />

                                    <MudText Style="text-align:end;"
                                             Typo="Typo.caption">@Account?.OU.ToPrettyOu()</MudText>
                                </MudStack>





                                <MudStack>
                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Groups]:</MudText>
                                    <MemberOfList AssignToClicked=@(()=>{AssignToModal?.ShowAsync();}) Model="Account" />
                                </MudStack>

                                @if (Account is IADUser && Account.Disabled)
                            {
                                <MudAlert Severity="Severity.Error"
                                          Class="mud-width-full">@AppLocalization[Lang.User_is_disabled]</MudAlert>
                            }
                            @if (Account is IADUser && Account.LockedOut)
                            {
                                <MudAlert Severity="Severity.Warning"
                                          Class="mud-width-full">@AppLocalization[Lang.User_is_locked_out]</MudAlert>
                            }



                        </Section>
                    </MudItem>
                    <MudItem xs=12 md="9">
                        <MudStack>

                            <Section FullWidth=false Title=@AppLocalization[Lang.Name]>


                                <MudStack Row Class="@_fieldMudStackClasses">


                                     <DynamicMudInput T=string
                                                      Label="@AppLocalization[Lang.First_Name]"
                                                      @bind-Value="@Contact.GivenName"
                                                      Disabled=!Contact.NewEntry />

                                     <DynamicMudInput T=string
                                                      Label="@AppLocalization[Lang.Middle_Name]"
                                                      @bind-Value="@Contact.MiddleName"
                                                      Disabled=!Contact.NewEntry />

                                     <DynamicMudInput T=string
                                                      Label="@AppLocalization[Lang.Last_Name]"
                                                      @bind-Value="@Contact.Surname"
                                                      Disabled=!Contact.NewEntry />

                                     <DynamicMudInput T=string
                                                      Label="@AppLocalization[Lang.Display_Name]"
                                                      @bind-Value="@Contact.DisplayName"
                                                      Disabled=!Contact.NewEntry />


                                 </MudStack>
                                 @if (EditMode && Account?.NewEntry == false)
                                {
                                    <MudText>
                                        @AppHelpLocalization[HelpLang.Modify_Name_Redirect]
                                    </MudText>
                                }
                            </Section>


                            @if (User != null)
                            {
                                <Section Title="@AppLocalization[Lang.Account]">

                                    <MudStack Row Class="@_fieldMudStackClasses">




                                     <MudStack Row=true Spacing="0">


                                         <DynamicMudInput T=string Label="@AppLocalization[Lang.Username]"
                                                          @bind-Value="@User.SamAccountName"
                                                          Disabled=@(User?.NewEntry==false) />
                                         <AppCopyButton TextToCopy=@User.SamAccountName />

                                     </MudStack>



                                     @if (Account?.NewEntry == true)
                                        {
                                            <DynamicMudInput T=string
                                                             Label="@AppLocalization[Lang.Password]"
                                                             @bind-Value="@Password"
                                                             InputType="InputType.Password" />

                                            <DynamicMudInput T=string
                                                             Label="@AppLocalization[Lang.Confirm_Password]"
                                                             @bind-Value="@ConfirmPassword"
                                                             InputType="InputType.Password" />
                                        }


                                        <MudStack Row=true Spacing="0">
                                            <DynamicMudInput T=string Label="@AppLocalization[Lang.Email_Address]"
                                                             @bind-Value="@User.Email"
                                                             Disabled=@(User?.NewEntry==false) />
                                            <AppCopyButton TextToCopy=@User.Email />

                                        </MudStack>



                                        @if (CanReadField(ActiveDirectoryFields.AccountExpires))
                                        {
                                            <DynamicMudInput T=DateTime?
                                                             Clearable=true
                                                             Label="@AppLocalization[Lang.Account_Expiration]"
                                                             @bind-Value="@User.ExpireTime"
                                                             Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.AccountExpires)) />


                                        }

                                        <MudStack Row=true Spacing="3" Class="mx-auto">

                                            @if (CanReadField(ActiveDirectoryFields.LogOnTo))
                                            {
                                                <MudButton Variant="Variant.Filled"
                                                           Color="@(User.LogOnTo == null || User.LogOnTo == String.Empty?Color.Primary:Color.Warning)"
                                                           OnClick="@(()=>{LogOnToModal?.ShowAsync();})"
                                                           Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.LogOnTo))>
                                                    @AppLocalization[Lang.Log_On_To]
                                                </MudButton>

                                            }

                                            @if (CanReadField(ActiveDirectoryFields.LogonHours))
                                            {
                                                <MudButton Variant="Variant.Filled"
                                                           Color="@(Color.Primary)"
                                                           OnClick="@(()=>{LogonHoursModal?.ShowAsync();})"
                                                           Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.LogonHours))>
                                                    @AppLocalization[Lang.Logon_Hours]
                                                </MudButton>

                                            }
                                            @if (Account.CanSetPassword)
                                            {
                                                <MudSwitch T=bool
                                                           Color=Color.Success
                                                           ThumbIconColor="@(Account.RequirePasswordChange==true?Color.Success:Color.Default)"
                                                           Label=@AppLocalization[Lang.Require_Password_Change]
                                                           Value=@Account.RequirePasswordChange
                                                           Disabled=@true />

                                            }
                                        </MudStack>
                                        @if (CurrentUser.State.IsSuperAdmin)
                                        {
                                            <UserFailedLogons />
                                        }

                                    </MudStack>
                                    @if (EditMode && !Account.NewEntry)
                                    {


                                        <MudText Class="py-4">
                                            @AppHelpLocalization[HelpLang.Modify_Name_Redirect]
                                        </MudText>

                                    }

                                </Section>
                            }


                        </MudStack>

                    </MudItem>
                </MudGrid>



                @if (CanReadField(ActiveDirectoryFields.EmployeeId) ||
            CanReadField(ActiveDirectoryFields.Department) ||
            CanReadField(ActiveDirectoryFields.Company) ||
            CanReadField(ActiveDirectoryFields.Title) ||
            CanReadField(ActiveDirectoryFields.PhysicalDeliveryOffice)
            )
                {
                    <Section Title=@AppLocalization[Lang.Organization]>
                        <MudStack Row Class="@_fieldMudStackClasses">

                         @if (CanReadField(ActiveDirectoryFields.Description))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Description]" @bind-Value="@Contact.Description" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.Description)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.EmployeeId))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Employee_Id]" @bind-Value="@Contact.EmployeeId" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.EmployeeId)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.Department))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Department]" @bind-Value="@Contact.Department" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.Department)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.Company))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Company]" @bind-Value="@Contact.Company" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.Company)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.Title))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Job_Title]" @bind-Value="@Contact.Title" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.Title)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.PhysicalDeliveryOffice))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Office]" @bind-Value="@Contact.PhysicalDeliveryOfficeName" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.PhysicalDeliveryOffice)) />
                            }
                        </MudStack>
                    </Section>
                }

                @if (CanReadField(ActiveDirectoryFields.HomePhone) ||
            CanReadField(ActiveDirectoryFields.StreetAddress) ||
            CanReadField(ActiveDirectoryFields.POBox) ||
            CanReadField(ActiveDirectoryFields.City) ||
            CanReadField(ActiveDirectoryFields.State) ||
            CanReadField(ActiveDirectoryFields.PostalCode)
            )
                {
                    <Section Title=@AppLocalization[Lang.Contact_Info]>
                        <MudStack Row Class="@_fieldMudStackClasses">

                         @if (CanReadField(ActiveDirectoryFields.HomePhone))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Home_Phone]" @bind-Value="@Contact.HomePhone" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.HomePhone)) />

                            }
                            @if (CanReadField(ActiveDirectoryFields.StreetAddress))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Street_Address]" @bind-Value="@Contact.StreetAddress" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.StreetAddress)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.POBox))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.PO_Box]" @bind-Value="@Contact.POBox" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.POBox)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.City))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.City]" @bind-Value="@Contact.City" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.City)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.State))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.State]" @bind-Value="@Contact.State" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.State)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.PostalCode))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Zip_Code]" @bind-Value="@Contact.Zip" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.PostalCode)) />
                            }
                        </MudStack>

                    </Section>
                }


                @if (User != null &&
            (CanReadField(ActiveDirectoryFields.HomeDirectory) ||
            CanReadField(ActiveDirectoryFields.HomeDrive) ||
            CanReadField(ActiveDirectoryFields.ScriptPath) ||
            CanReadField(ActiveDirectoryFields.ProfilePath))
            )
                {
                    <Section Title=@AppLocalization[Lang.Profile]>
                        <MudStack Row Class="@_fieldMudStackClasses">

                         @if (CanReadField(ActiveDirectoryFields.HomeDirectory))
                            {
                                <MudStack Row=true Spacing="0">

                                    <DynamicMudInput T=string Label="@AppLocalization[Lang.Home_Directory]"
                                                     @bind-Value="@User.HomeDirectory"
                                                     Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.HomeDirectory)) />
                                    @if (!User.HomeDirectory.IsNullOrEmpty())
                                    {

                                        <MudIcon Class="align-middle" Icon="@(homeDirectoryExists?Icons.Material.Filled.Check:Icons.Material.Filled.Error)"
                                                 Color="@(homeDirectoryExists?Color.Success:Color.Error)" />
                                    }
                                    <AppCopyButton TextToCopy=@User.HomeDirectory />
                                </MudStack>
                            }
                            @if (CanReadField(ActiveDirectoryFields.HomeDrive))
                            {
                                <HomeDriveSelect Label="@AppLocalization[Lang.Home_Drive]" @bind-DriveLetter="@User.HomeDrive" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.HomeDrive)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.ScriptPath))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Script_Path]" @bind-Value="@User.ScriptPath" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.ScriptPath)) />
                            }
                            @if (CanReadField(ActiveDirectoryFields.ProfilePath))
                            {
                                <DynamicMudInput T=string Label="@AppLocalization[Lang.Profile_Path]" @bind-Value="@User.ProfilePath" Disabled=@(!EditMode || !CanEditField(ActiveDirectoryFields.ProfilePath)) />
                            }
                        </MudStack>

                    </Section>
                }

                @if (Account.CanReadAnyCustomFields && CustomFields != null && CustomFields.Count > 0)
                {
                    <Section Title=@AppLocalization[Lang.Additional_Fields]>

                        @foreach (var field in CustomFields)
                        {
                            @if (CanReadField(field))
                            {
                                <CustomDirectoryField Disabled=@(!EditMode || !CanEditField(field)) Entry="Account" Field="@field" />

                            }
                        }


                    </Section>
                }




            </CascadingValue>
        </CascadingValue>

    </EditForm>
    @if ((Account.CanEdit || CurrentUser.State.CanAssign) && Account.HasUnsavedChanges && !Account.NewEntry)
    {

        <UnsavedChangesPrompt SaveChanges="SaveChanges" DiscardChanges="DiscardChanges" />
    }
    <LoadingData Loading=SavingChanges />


}





@using System.Security
@using BLAZAM.Common.Data.Database
@using BLAZAM.EmailMessage.Email
@using BLAZAM.EmailMessage.Email.Messages
@inherits DirectoryModelComponent
@inject IJSRuntime JSRuntime
@inject NotificationGenerationService NotificationGenerationService


<AppPageTitle>@AppLocalization[Lang.Confirm_User_Creation]</AppPageTitle>


@if (DirectoryTemplate != null)
{
    if (DirectoryTemplate.InTemplate(ActiveDirectoryFields.Thumbnail))
    {
        <ContactThumbnailPhoto Contact=Contact
                               Disabled=true />
    }
}

<MudTextField Label="@AppLocalization[Lang.OU]"
              Value="@Contact.OU.ToPrettyOu()"
              Disabled=true />

<MudTextField Label="@AppLocalization[Lang.First_Name]"
              Value="@Contact.GivenName"
              Disabled=true />

<MudTextField Label="@AppLocalization[Lang.Middle_Name]"
              Value="@Contact.MiddleName"
              Disabled=true />

<MudTextField Label="@AppLocalization[Lang.Last_Name]"
              Value="@Contact.Sn"
              Disabled=true />

<MudTextField Label="@AppLocalization[Lang.Display_Name]"
              Value="@Contact.DisplayName"
              Disabled=true />

<MudTextField Label="@AppLocalization[Lang.Username]"
              Value="@User?.SAMAccountName"
              Disabled=true />



<MudTextField Label="@AppLocalization[Lang.Password]"
              Value="@User?.NewPassword.ToPlainText()"
              Disabled=true />

<CascadingValue Value="GroupableEntry">
    <CascadingValue Value="Entry">
        <CascadingValue Value="DirectoryTemplate">
            <OrganizationSection Disabled=true />
            
            <ContactInfoSection Disabled=true />

           
            <ProfileSection Disabled=true />


            <ViewSection Title=@AppLocalization[Lang.Groups]>
                @if (User?.IsAGroupMember==true)
                {
                    <MudText Class="mud-width-full" Align="Align.Center">
                        <MemberOfList AllowNavigation="false" Model="@User" Disabled=true />
                    </MudText>

                }

            </ViewSection>

            @if (GroupableEntry?.CanReadAnyCustomFields == true && CustomFields != null && CustomFields.Count > 0)
            {
                <ViewSection Title=@AppLocalization[Lang.Additional_Fields]>

                    @foreach (var field in CustomFields)
                    {
                        @if (DirectoryTemplate?.InTemplate(field) == true)
                        {
                            <CustomDirectoryField Disabled=@(true) Entry="GroupableEntry" Field="@field" />


                        }
                    }


                </ViewSection>
            }
        </CascadingValue>
    </CascadingValue>
</CascadingValue>
@if (!Confirmed)
{
    <MudButton Disabled=@disableCreateUserButton
               Color="Color.Success"
               OnClick="ConfirmUser">@AppLocalization[Lang.Create_User]</MudButton>

}
else
{
    <MudButton Color="Color.Primary"
               OnClick="@(()=>{Nav.NavigateTo(Contact.SearchUri);})">@AppLocalization[Lang.Go_To_User]</MudButton>
    <MudButton Color="Color.Success"
               OnClick="@(()=>{Nav.NavigateTo(Nav.Uri,true);})">@AppLocalization[Lang.Create_Another]</MudButton>

}
<MudButton StartIcon="@Icons.Material.Filled.Print"
           Color="Color.Info"
           OnClick="Print">@AppLocalization[Lang.Print]</MudButton>


<AppModal @ref=SendWelcomeModal
          Title="@AppLocalization[Lang.Send_login_credentials]">
    <SendNewUserWelcomeToModalContent OnSubmitEmail="SendWelcomeEmail" />
</AppModal>
@code {
    [Parameter]
    public DirectoryTemplate? DirectoryTemplate { get; set; }

    AppModal? SendWelcomeModal;
    [Parameter]
    public EventCallback<IADUser> OnConfirmed { get; set; }


    [Parameter]
    public bool Confirmed { get; set; }
    bool disableCreateUserButton = false;
    SecureString? _userPassword;
    string? _username;
    /// <summary>
    /// Triggered when the user confirms the creation of this
    /// Active Directory User
    /// </summary>
    /// <returns></returns>
    async Task ConfirmUser()
    {
        try
        {
            if (User is null && Contact is not null)
            {
                disableCreateUserButton = true;
                await StateHasChangedAsync();

                var createContactJob = new Job(AppLocalization[Lang.Create_Contact]);
                createContactJob.StopOnFailedStep = false;



                await createContactJob.ShowJobDetailsDialogAsync(MessageService);


                var result = await Contact.CommitChangesAsync(createContactJob);

                disableCreateUserButton = false;
                await StateHasChangedAsync();

                if (result.FailedSteps.Count == 0)
                {
                    Contact = (IADContact?)Directory.GetDirectoryEntryByDN(Contact.DN)!;
                    SnackBarService.Success(AppHelpLocalization[HelpLang.Created, AppLocalization[Lang.Contact]]);
                    Confirmed = true;
                    await OnConfirmed.InvokeAsync();
                    Contact = (IADContact?)Directory.GetDirectoryEntryByDN(Contact.DN)!;
                    ActiveDirectoryEvents.DirectoryEntryEvent.Invoke(new()
                    {
                        EventType = ApplicationEventType.Create,
                        Entry = Contact,
                        Actor = CurrentUser.State

                    });
                    
                }
             
            }
            else if(User is not null)
            {
                disableCreateUserButton = true;
                await StateHasChangedAsync();

                var createUserJob = new Job(AppLocalization[Lang.Create_User]);
                createUserJob.StopOnFailedStep = false;

                _username = User.SAMAccountName;
                _userPassword = User.NewPassword;


                await createUserJob.ShowJobDetailsDialogAsync(MessageService);


                var result = await User.CommitChangesAsync(createUserJob);

                disableCreateUserButton = false;
                await StateHasChangedAsync();

                if (result.FailedSteps.Count == 0)
                {
                    User = (IADUser?)Directory.GetDirectoryEntryByDN(User.DN)!;
                    User.NewPassword = _userPassword;
                    SnackBarService.Success(AppHelpLocalization[HelpLang.Created, AppLocalization[Lang.User]]);
                    Confirmed = true;
                    await OnConfirmed.InvokeAsync();
                    User = (IADUser?)Directory.GetDirectoryEntryByDN(User.DN)!;
                    ActiveDirectoryEvents.DirectoryEntryEvent.Invoke(new()
                    {
                        EventType = ApplicationEventType.Create,
                        Entry = User,
                        Actor = CurrentUser.State

                    });
                    try
                    {
                        if (DirectoryTemplate?.EffectiveSendWelcomeEmail == true)
                        {
                            if (DirectoryTemplate.EffectiveAskForAlternateEmail == true || User.Email.IsNullOrEmpty())
                            {
                                await SendWelcomeModal!.ShowAsync();
                            }
                            else
                            {
                                await SendWelcomeEmail(User.Email!);
                            }
                        }
                    }
                    catch
                    {

                    }
                }
            }
        }
        catch (AppException ex)
        {
            await MessageService.Error(ex.Message);
        }


    }
    async Task SendWelcomeEmail(string to)
    {
        try
        {
            NewUserWelcomeEmailMessage message = new NewUserWelcomeEmailMessage();
            message.Domain = Entry.Directory.ConnectionSettings?.FQDN;
            message.Username = _username;
            message.Password = _userPassword;
            var html = message.Render();
            await EmailService.SendMessage(AppLocalization["New Account Details"], message, to);
            SnackBarService.Info(AppLocalization["Welcome Email Sent to "] + to);
            if (SendWelcomeModal != null)
            {
                await SendWelcomeModal.CloseAsync();
            }
        }
        catch (Exception ex)
        {
            Loggers.SystemLogger.Error(ex, "Error sending welcome email");
            SnackBarService.Error(ex.Message);
        }
        //emailPreview = EmailService.PrepareHTMLForEmail(html);
    }
    async Task Print()
    {
        await JSRuntime.InvokeVoidAsync("printPage", null);
    }


}
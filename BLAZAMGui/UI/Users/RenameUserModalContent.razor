@inherits AppModalContent
@if (Entry != null)
{
    if (_privateEntryInstance != null)
    {
        <MudStack Class="px-7">
            <MudTextField AutoFocus=true
                          Label="@AppLocalization[Lang.First_Name]"
                          @bind-Value="@_privateEntryInstance.GivenName" />

            <MudTextField Label="@AppLocalization[Lang.Middle_Name]"
                          @bind-Value="@_privateEntryInstance.MiddleName" />

            <MudTextField Label="@AppLocalization[Lang.Last_Name]"
                          @bind-Value="@_privateEntryInstance.Sn" />

            <MudTextField T="string"
                          Label="@AppLocalization[Lang.Display_Name]"
                          Text="@_privateEntryInstance.DisplayName"
                          TextChanged="DisplayNameChanged" />

            @if (User != null)
            {
                var _privateUser = _privateEntryInstance as IADUser;
                @if (Contact.CanEditField(ActiveDirectoryFields.SAMAccountName))
                {
                    <MudTextField Label="@AppLocalization[Lang.Username]"
                                  @bind-Value="@_privateUser.SAMAccountName" />
                }
            }
            @if (Entry.CanEditField(ActiveDirectoryFields.Mail))
            {
                <MudTextField Label="@AppLocalization[Lang.Email_Address]"
                              @bind-Value="@_privateEntryInstance.Email" />

            }

        </MudStack>
    }
}
else
{
    <MudProgressCircular Indeterminate="true"
                         Color="Color.Primary" />
}
<MudAlert Severity="Severity.Info">@AppLocalization[HelpLang.Discard_Other_Changes_Warning]</MudAlert>
@code {

    private IADContact _privateEntryInstance;

    [Parameter]
    public EventCallback<IDirectoryEntryAdapter> DirectoryModelRenamed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (User != null)
        {
            _privateEntryInstance = Directory.Users.FindUserBySID(User.SID.ToSidString());
        }
        else if (Contact != null)
        {
            _privateEntryInstance = Directory.Contacts.FindContactsByGUID(Contact.Guid);

        }

        SaveDisabled = false;
        Modal.SetOnYes(SaveChanges);
        Modal.SetYesText(AppLocalization[Lang.Rename_User]);
        Modal.Title = AppLocalization[Lang.Rename_User];
        await StateHasChangedAsync();
    }

    void DisplayNameChanged(string newName)
    {

        _privateEntryInstance.DisplayName = newName;

    }
    private async Task SaveChanges()
    {
        var possibleConflictingMatch = Directory.Users.FindUsersByContainerName(_privateEntryInstance.DisplayName, false, false);
        if (possibleConflictingMatch == null || possibleConflictingMatch.Equals(_privateEntryInstance))
        {
            SaveDisabled = true;
            LoadingData = true;
            _privateEntryInstance.Rename(_privateEntryInstance.DisplayName);

            await _privateEntryInstance.CommitChangesAsync();
            SnackBarService.Success("User has been renamed.");
            Entry.DirectoryEntry = null;

            await DirectoryModelRenamed.InvokeAsync(_privateEntryInstance);
            Close();
        }
        else
        {
            SnackBarService.Error("That name already exists. Please choose a different Display Name");
        }
        LoadingData = false;

        SaveDisabled = false;
    }

}

@if (!_loadingLogonTime)
{
    <AppTooltip Text="@userLastLogonTime?.ToLocalTime().TimeOfDay.ToString()">

        <MudText Style="text-align:end;" Typo="@Typo">@userLastLogonTime?.ToLocalTime().ToShortDateString()</MudText>
    </AppTooltip>
}
else
{
    <MudProgressLinear Color="Color.Primary" Style="max-width:100px;" Indeterminate=true />
}
@code {
    bool _loadingLogonTime = true;
    int polledDCs;
    DateTime? userLastLogonTime;
    [Parameter]
    public IAccountDirectoryAdapter DirectoryEntry { get; set; }
    [Parameter]
    public Typo Typo { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await InvokeAsync(StateHasChanged);

        await Task.Run(() =>
         {

             var userLastLogon = DirectoryEntry?.LastLogonTime;
             var userLastLogonTimestamp = DirectoryEntry?.LastLogonTimestamp;

             if(userLastLogon!=null && userLastLogonTimestamp != null)
             {
                 if (userLastLogon > userLastLogonTimestamp)
                 {
                     userLastLogonTime = userLastLogon;
                 }
                 else
                 {
                     userLastLogonTime = userLastLogonTimestamp;

                 }
             }
             else
             {
                 if (userLastLogon != null)
                 {
                     userLastLogonTime = userLastLogon;
                 }
                 else
                 if (userLastLogonTimestamp != null)
                 {
                     userLastLogonTime = userLastLogonTimestamp;
                 }
             }

             _loadingLogonTime = false;

             InvokeAsync(StateHasChanged);

         });
    }
}

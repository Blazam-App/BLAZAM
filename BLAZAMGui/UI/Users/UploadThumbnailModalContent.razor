@using Microsoft.AspNetCore.Components.Forms;
@inherits AppModalContent
    @if (newThumbnail != null)
    {
        <Base64Image Data="newThumbnail" />

    }
    <MudText>
        @AppLocalization[Lang.Upload_Thumbnail_Photo]
    </MudText>
    <MudFileUpload T="IBrowserFile" FilesChanged="LoadIcon">
            <MudButton HtmlTag="label"
            Variant="Variant.Filled"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.CloudUpload"

            Disabled=LoadingData>
                @AppLocalization[Lang.Upload_File]
            </MudButton>
    </MudFileUpload>
@code {
    byte[]? newThumbnail;
    [Parameter]
    public IADUser DirectoryEntry { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Modal.SetOnYes(SaveChanges);
        Modal.SetYesText(AppLocalization[Lang.Save_Photo]);
        Modal.Title = AppLocalization[Lang.Change_Thumbnail];
        await StateHasChangedAsync();
    }
    private async void LoadIcon(IBrowserFile e)
    {
        try
        {
            using (var stream = e.OpenReadStream(5000000))
            {
                using (var memoryStream = new MemoryStream())
                {
                    await stream.CopyToAsync(memoryStream);
                    newThumbnail = memoryStream.ToArray().ResizeRawImage(250);
                }
            }
        }
        catch(IOException ex){
            SnackBarService.Error(ex.Message);
        }
        catch(Exception ex){
            Loggers.SystemLogger.Error(ex, "Error uploading thumbnail image.");
        }
        await StateHasChangedAsync();

    }


    Task SaveChanges()
    {
        try
        {
            DirectoryEntry.ThumbnailPhoto = newThumbnail;

            SnackBarService.Warning("Thumbnail changed for " + DirectoryEntry.DisplayName + " but changes need to be saved.");
        }
        catch
        {
            SnackBarService.Error(AppHelpLocalization[HelpLang.Unexpected_Error_Occurred]);

        }
        Close();
        return Task.CompletedTask;
    }
    protected override bool IsValid => newThumbnail != null;


}

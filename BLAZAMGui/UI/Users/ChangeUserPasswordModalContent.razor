@inherits AppModalContent
@inject NotificationGenerationService OUNotificationService
<MudContainer MaxWidth="MaxWidth.Large">
    <MudTextField Label="@AppLocalization[Lang.Username]"
                  @bind-Value="@User.SAMAccountName"
                  Disabled=true />



    @*
    <MudTextField Label="@AppLocalization[Lang.Email_Address]" @bind-Value="@User.Email" Disabled=true />
    *@

    <MudTextField AutoFocus=true
                  Immediate=true
                  Validation="@(newPassword.IsNullOrEmpty()==false)"
                  Label="@AppLocalization[Lang.New_Password]"
                  InputType="InputType.Password"
                  @bind-Value="@newPassword" />


    <MudTextField Immediate=true
                  Validation="@(newPasswordConfirm.Equals(newPassword))"
                  Label="@AppLocalization[Lang.Confirm_New_Password]"
                  InputType="InputType.Password"
                  @bind-Value="@newPasswordConfirm" />
    @if (AdminReset)
    {
        <AppTooltip Text=@AppHelpLocalization[HelpLang.Require_Password_Change]>
            <MudSwitch T="bool"
                   UncheckedColor="Color.Error"
                   Color="Color.Success"
                   @ref=requireChangeSwitch>@AppLocalization[Lang.Require_change]</MudSwitch>
    </AppTooltip>
    }
</MudContainer>
@code {
    [Parameter]
    public bool AdminReset { get; set; } = true;
    string newPassword = "";
    string newPasswordConfirm = "";
    MudSwitch<bool>? requireChangeSwitch;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Modal.SetOnYes(SaveChanges);
        Modal.SetYesText(AppLocalization[Lang.Change_Password]);
        Modal.SetTitle(AppLocalization[Lang.Change_Password]);

    }


    public async Task SaveChanges()
    {
        Modal.LoadingData = true;
        await StateHasChangedAsync();
        await Task.Run(async () =>

        {
            try
            {
                if (User.SetPassword(newPassword.ToSecureString(), requireChangeSwitch?.Value??false))
                {

                    if (requireChangeSwitch?.Value==true)
                    {
                        User.RequirePasswordChange = true;
                        var job = await Entry.CommitChangesAsync();
                        if (job.Result != JobResult.Passed)
                        {

                            Loggers.ActiveDirectoryLogger.Error("Could not set password change required when setting password.");

                        }
                    }

                    SnackBarService.Success(AppLocalization[Lang.Password_Changed]);
                    ActiveDirectoryEvents.DirectoryEntryEvent.Invoke(new()
                        {
                            EventType = ApplicationEventType.PasswordChange,
                            Entry = User,
                            Actor = CurrentUser.State


                        });
                    await InvokeAsync(async()=>{await EntryChanged.InvokeAsync(User);});
                    await InvokeAsync(Close);


                }
                else
                {
                    SnackBarService.Error("Unable to set password for " + User.DisplayName);

                }
            }
            catch (Exception ex)
            {
                SnackBarService.Error(ex.Message + " " + ex.InnerException?.Message);
            }

        });

        Modal.LoadingData = false;
        await StateHasChangedAsync();
    }

    bool PasswordsValid
    {
        get
        {

            if (newPassword != null && newPassword != "")
                return newPassword == newPasswordConfirm;
            return false;
        }
    }
    protected override bool IsValid => (!newPassword.IsNullOrEmpty()
            && !newPasswordConfirm.IsNullOrEmpty()
            && newPassword.Equals(newPasswordConfirm));




}

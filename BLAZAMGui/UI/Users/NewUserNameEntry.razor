@using BLAZAM.Global.Data
@inherits AppComponentBase
<EditForm Model="NewUserName">

    <ViewSection Title=@AppLocalization[Lang.Name]>



        <MudTextField AutoFocus=true Label="@AppLocalization[Lang.First_Name]" @bind-Value="@NewUserName.GivenName" />





        <MudTextField Label="@AppLocalization[Lang.Middle_Name]" @bind-Value="@NewUserName.MiddleName" />





        <MudTextField Label="@AppLocalization[Lang.Last_Name]" @bind-Value="@NewUserName.Surname" />




    </ViewSection>
</EditForm>
<MudButton Color=Color.Primary
           OnClick="OnBack">
    @AppLocalization[Lang.Back]
</MudButton>
<MudButton Color="Color.Success"
           OnClick="OnNext"
           Disabled=@(newUserName is null || (newUserName.Surname.IsNullOrEmpty() && newUserName.GivenName.IsNullOrEmpty()))>
    @AppLocalization[Lang.Next]
</MudButton>


@code {

    NewUserName newUserName;

    [Parameter]
    public NewUserName NewUserName
    {
        get => newUserName; set
        {
            if (value == newUserName) return;
            newUserName = value;
            NewUserNameChanged.InvokeAsync(newUserName);

        }
    }

    [Parameter]
    public EventCallback<NewUserName> NewUserNameChanged { get; set; }
    [Parameter]
    public EventCallback OnNext { get; set; }
    [Parameter]
    public EventCallback OnBack { get; set; }
}

@using BLAZAM.Global.Data
@inherits ValidatedForm
<MudForm @ref=Form Model="NewUserName">

    <ViewSection Title=@AppLocalization[Lang.Name]>



        <MudTextField AutoFocus=true
                      Validation=IsValid
                      Required=true
                      Immediate=true
                      Label="@AppLocalization[Lang.First_Name]"
                      @bind-Value="@NewUserName.GivenName" />





        <MudTextField Label="@AppLocalization[Lang.Middle_Name]"
                      @bind-Value="@NewUserName.MiddleName" />





        <MudTextField Label="@AppLocalization[Lang.Last_Name]"
                      Validation=IsValid
                      Required=true
                      Immediate=true
                      @bind-Value="@NewUserName.Surname" />




    </ViewSection>
</MudForm>
<MudButton Color=Color.Primary
           OnClick="OnBack">
    @AppLocalization[Lang.Back]
</MudButton>
<MudButton Color="Color.Success"
           OnClick="OnNext"
           Disabled=@(newUserName is null || (newUserName.Surname.AppTrim().IsNullOrEmpty() || newUserName.GivenName.AppTrim().IsNullOrEmpty()))>
    @AppLocalization[Lang.Next]
</MudButton>


@code {

    NewUserName newUserName;

    [Parameter]
    public NewUserName NewUserName
    {
        get => newUserName; set
        {
            if (value == newUserName) return;
            newUserName = value;
            NewUserNameChanged.InvokeAsync(newUserName);

        }
    }
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            Form?.Validate();
            StateHasChanged();
        }
    }
    [Parameter]
    public EventCallback<NewUserName> NewUserNameChanged { get; set; }
    [Parameter]
    public EventCallback OnNext { get; set; }
    [Parameter]
    public EventCallback OnBack { get; set; }

    private string? IsValid(string field)
    {
        if (field.AppTrim().IsNullOrEmpty())
        {
            return AppHelpLocalization[HelpLang.Missing_First_Or_Last_Name];
        }
        return null;
    }
}

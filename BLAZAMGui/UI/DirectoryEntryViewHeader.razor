@using BLAZAM.Gui.UI.Chat
@inherits DirectoryEntryViewBase

@if (LoadingData)
{

    <MudStack Row=true Class="mud-width-full">

        <MudStack Spacing="1">
            <MudSkeleton Height="25px" Width="200px" />
            <MudSkeleton Width="200px" />
        </MudStack>
        <MudSkeleton Class="ms-5 my-auto" SkeletonType="SkeletonType.Circle" Height="25px" Width="25px"/>
        <MudSkeleton Class="my-auto" SkeletonType="SkeletonType.Circle" Height="25px" Width="25px"/>
        <MudSkeleton Class="my-auto" SkeletonType="SkeletonType.Circle" Height="25px" Width="25px" />
    </MudStack>

}
else
{

    IAccountDirectoryAdapter? accountEntry;
    accountEntry = DirectoryEntry as IAccountDirectoryAdapter;


    IGroupableDirectoryAdapter? groupableEntry;
    groupableEntry = DirectoryEntry as IGroupableDirectoryAdapter;


    <MudStack Row=true Class="mud-width-full">

        <MudStack Spacing="1">
            @if (groupableEntry != null && DirectoryEntry is not IADComputer && !groupableEntry.DisplayName.IsNullOrEmpty())
            {
                <MudText Class="align-middle">
                    @groupableEntry.DisplayName
                </MudText>
            }
            else
            {
                <MudText Class="align-middle">
                    @DirectoryEntry.CanonicalName
                </MudText>
            }
            @if (DirectoryEntry.OU != null)
            {
                <OUBreadcrumbs Entry="DirectoryEntry" />

            }


        </MudStack>


        @if (accountEntry?.LockedOut == true)
        {
            <MudIconButton Disabled=@(!accountEntry.CanUnlock)
                           OnClick=OnUnlock
                           Icon=@Icons.Material.Filled.Lock />
        }
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudToolBar Class="align-middle"
                        Style="height:32px"
                        Gutters=false
                        Dense=true>
                @if (accountEntry != null && (accountEntry is IADUser ||accountEntry is IADComputer) )
                {
                    <AppTooltip Text="@AppLocalization[accountEntry.Enabled?"Disable":"Enable"]">

                        <MudToggleIconButton @bind-Toggled="@accountEntry.Enabled"
                                             Icon="@Icons.Material.Filled.PersonOff"
                                             Color="Color.Error"
                                             Disabled=@(!(accountEntry.Enabled && accountEntry.CanDisable) && !(accountEntry.Disabled && accountEntry.CanEnable))
                                             ToggledIcon="@Icons.Material.Filled.Person"
                                             ToggledColor="Color.Success" />
                    </AppTooltip>
                }



                <AppTooltip Text="@(EditMode?AppLocalization[Lang.End_Edit]:AppLocalization[Lang.Edit])">

                    <MudToggleIconButton Toggled=EditMode
                                         ToggledChanged="@(async(state)=>{await ToggleEditMode(state);})"
                                         Icon="@Icons.Material.Filled.Edit"
                                         ToggledIcon="@Icons.Material.Filled.EditOff"
                                         ToggledColor="Color.Error"
                                         Disabled=@(!DirectoryEntry.CanEdit && (accountEntry!=null)) />

                </AppTooltip>

                @if (accountEntry != null && accountEntry is not IADContact && accountEntry.LockedOut)
                {
                    <AppTooltip Text="@AppLocalization[Lang.Unlock]">

                        <MudIconButton OnClick="OnUnlock"
                                       Icon="@Icons.Material.Filled.LockOpen"
                                       Disabled=@(!accountEntry.CanUnlock)
                                       aria-label="unlock" />
                    </AppTooltip>
                }
                @if (groupableEntry != null)
                {
                    <AppTooltip Text="@AppLocalization[Lang.Assign_To]">

                        <MudIconButton OnClick="@OnAssignTo"
                                       Disabled="@(CurrentUser.State?.CanAssign!=true)"
                                       Icon="@Icons.Material.Filled.GroupAdd"
                                       aria-label="assign to" />
                    </AppTooltip>

                }
                @if (accountEntry != null && accountEntry is IADUser)
                {
                    <AppTooltip Text="@AppLocalization[Lang.Change_Password]">
                        <MudIconButton OnClick="@OnResetPassword"
                                       Disabled=@(!accountEntry.CanSetPassword)
                                       Icon="@Icons.Material.Filled.Password"
                                       aria-label="change password" />
                    </AppTooltip>
                }
                <AppTooltip Text="@AppLocalization[Lang.Rename]">

                    <MudIconButton OnClick="@OnRename"
                                   Disabled=@(!DirectoryEntry.CanRename || (DirectoryEntry is IADComputer computer && computer.IsOnline!=true))
                                   Icon="@Icons.Material.Filled.DriveFileRenameOutline"
                                   aria-label="rename" />

                </AppTooltip>

                <AppTooltip Text="@AppLocalization[Lang.Move]">

                    <MudIconButton OnClick="@OnMove"
                                   Disabled=@(!DirectoryEntry.CanMove)
                                   Icon="@Icons.Material.Filled.DriveFileMove"
                                   aria-label="move" />
                </AppTooltip>
                @if (DirectoryEntry is IADComputer)
                {
                    <AppTooltip Text="@AppLocalization[Lang.Reboot_Shutdown]">

                        <MudIconButton OnClick="@OnRebootOrShutdown"
                                       Disabled=@(!CurrentUser.State.IsSuperAdmin||ApplicationInfo.InDemoMode || (DirectoryEntry is IADComputer computer && computer.IsOnline!=true))
                                       Icon="@Icons.Material.Filled.RestartAlt"
                                       aria-label="restart" />
                    </AppTooltip>
                }
                <AppTooltip Text="@AppLocalization[Lang.Delete]">

                    <MudIconButton OnClick="@OnDelete"
                                   Color="Color.Error"
                                   Disabled=@(!DirectoryEntry.CanDelete)
                                   Icon="@Icons.Material.Filled.Delete"
                                   aria-label="change password" />
                </AppTooltip>

                @if (IsAdmin)
                {

                    <AppTooltip Text="@AppLocalization[Lang.Change_History]">
                        <MudIconButton OnClick="@OnShowHistory"
                                       Disabled=@(!DirectoryEntry.CanEdit)
                                       Icon="@Icons.Material.Filled.History" />
                    </AppTooltip>

                    <AppTooltip Text="@AppLocalization[Lang.Effective_Permissions]">
                        <MudIconButton OnClick="@OnShowPermissions"
                                       Icon="@Icons.Material.Filled.RunCircle" />
                    </AppTooltip>
                }
                @if (_showRequestButton)
                {
                    <AppTooltip Text="@AppLocalization[Lang.Request_Access]">
                        <MudIconButton OnClick="@(()=>{_requestAccessModal?.ShowAsync();})"
                                       Icon="@Icons.Material.Filled.PlaylistAdd" />
                    </AppTooltip>
                }
                <AppTooltip Text="@AppLocalization[IsFavorite?Lang.Remove_from_favorites : Lang.Add_to_favorites]">
                    <MudIconButton OnClick="@ToggleFavorite"
                                   Icon="@(IsFavorite?Icons.Material.Filled.Star:Icons.Material.TwoTone.Star)"
                                   Color="@(IsFavorite?Color.Warning:Color.Default)" />
                </AppTooltip>
                @if (IsAdmin && ApplicationInfo.InDebugMode)
                {
                    <AppTooltip Text="Application Event Toolkit">
                        <MudIconButton OnClick="@(()=>{_appEventModal?.ShowAsync();})"
                                       Icon="@(IsFavorite?Icons.Material.Filled.Star:Icons.Material.TwoTone.Star)"
                                       Color="@(IsFavorite?Color.Warning:Color.Default)" />
                    </AppTooltip>
                }

                <PluginComponents Page="@PageType.AllEntryTypes" Location="@PageLocation.SubHeader" />
            </MudToolBar>
        </MudHidden>
        <MudSpacer />
        <EntrySpecificChat Entry="DirectoryEntry" />
        <MudHidden Breakpoint="Breakpoint.SmAndUp">

            <MudMenu Class="align-self-end"
                     IconColor="@Color.Tertiary"
                     Icon="@Icons.Material.Filled.Settings">

                @if (accountEntry != null && accountEntry is not IADContact && ((accountEntry.Enabled && accountEntry.CanDisable) || (accountEntry.Disabled && accountEntry.CanEnable)))
                {
                    <MudMenuItem>
                        <MudSwitch T=bool
                                   Color=Color.Success
                                   Label=@AppLocalization[Lang.Account_Enabled]
                                   @bind-Value=@accountEntry.Enabled
                                   Disabled=@((accountEntry.Disabled && !accountEntry.CanEnable)||(accountEntry.Enabled && !accountEntry.CanDisable)) />

                    </MudMenuItem>
                }


                @if (DirectoryEntry.CanEdit)
                {
                    <MudMenuItem OnClick="(async()=>{await ToggleEditMode(!EditMode);})">@(AppLocalization[EditMode ? Lang.End_Edit : Lang.Edit])</MudMenuItem>
                }
                @if (accountEntry != null && accountEntry is not IADContact && accountEntry.LockedOut && accountEntry.CanUnlock)
                {
                    <MudMenuItem OnClick="@OnUnlock">@AppLocalization[Lang.Unlock]</MudMenuItem>
                }
                <MudMenuItem OnClick="@OnAssignTo">@AppLocalization[Lang.Assign_To]</MudMenuItem>
                @if (accountEntry?.CanSetPassword == true && accountEntry is not IADComputer)
                {
                    <MudMenuItem OnClick="@OnResetPassword">@AppLocalization[Lang.Change_Password]</MudMenuItem>
                }
                @if (DirectoryEntry.CanRename)
                {
                    <MudMenuItem OnClick="@OnRename">@AppLocalization[Lang.Rename]</MudMenuItem>
                }
                @if (DirectoryEntry.CanMove)
                {
                    <MudMenuItem OnClick="@OnMove">@AppLocalization[Lang.Move]</MudMenuItem>
                }
                @if (DirectoryEntry is IADComputer)
                {
                    <MudMenuItem Disabled=@(!CurrentUser.State.IsSuperAdmin||ApplicationInfo.InDemoMode)
                                 OnClick="@OnRebootOrShutdown">
                        @AppLocalization[Lang.Reboot_Shutdown]
                    </MudMenuItem>
                }
                @if (DirectoryEntry.CanDelete)
                {
                    <MudMenuItem OnClick="@OnDelete">@AppLocalization[Lang.Delete]</MudMenuItem>
                }

                @if (IsAdmin)
                {
                    <MudMenuItem OnClick="@OnShowHistory">@AppLocalization[Lang.Change_History]</MudMenuItem>

                    <MudMenuItem OnClick="@OnShowPermissions">@AppLocalization[Lang.Effective_Permissions]</MudMenuItem>
                }
                @if (_showRequestButton)
                {
                    <MudMenuItem OnClick="@(()=>{_requestAccessModal?.ShowAsync();})">@AppLocalization[Lang.Request_Access]</MudMenuItem>
                }
                <MudMenuItem Icon="@(IsFavorite?Icons.Material.Filled.Star:Icons.Material.TwoTone.Star)"
                             IconColor="@(IsFavorite?Color.Warning:Color.Default)"
                             OnClick="@ToggleFavorite">
                    @AppLocalization[IsFavorite ? Lang.Remove_from_favorites : Lang.Add_to_favorites]
                </MudMenuItem>

                <PluginComponents Page="@PageType.AllEntryTypes" Location="@PageLocation.SubHeaderMobile" />


            </MudMenu>
        </MudHidden>
    </MudStack>
    @if (_showRequestButton)
    {
        <AppModal @ref=_requestAccessModal Title="@AppLocalization[Lang.Request_Access]">
            <RequestAccessModalContent Entry="@DirectoryEntry" />
        </AppModal>
    }
    <AppModal @ref=_appEventModal Title="Application Event Toolkit">
        <AppEventToolkitModalContent DirectoryEntry="@DirectoryEntry" />
    </AppModal>
}

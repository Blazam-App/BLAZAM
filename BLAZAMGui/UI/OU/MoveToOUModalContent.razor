@using BLAZAM.Global.Events
@inherits AppModalContent
@inject NotificationGenerationService OUNotificationService

<MudText>Choose OU</MudText>

<OUTreeView @bind-StartingSelectedOU=@StartingOU @bind-SelectedEntry=@SelectedOU />




@code {

    [Parameter]
    public IDirectoryEntryAdapter DirectoryModel { get; set; }

    IDirectoryEntryAdapter SelectedOU { get; set; }
    IADOrganizationalUnit StartingOU { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        StartingOU = (IADOrganizationalUnit)DirectoryModel.GetParent();
        Modal.SetOnYes(MoveTo);
        Modal.SetYesText(AppLocalization[Lang.Move]);
        Modal.Title = AppLocalization[Lang.Move_To];

    }

    async Task MoveTo()
    {
        if (SelectedOU.DN.Equals(DirectoryModel.OU))
        {
            SnackBarService.Warning(DirectoryModel.CanonicalName + " is already in that OU.");
            return;
        }
        if (SelectedOU is IADOrganizationalUnit ouToMoveTo)
        {


          

            var ouMovedFrom = await DirectoryModel.GetParentAsync() as IADOrganizationalUnit;
            DirectoryModel.MoveTo(ouToMoveTo);

            SnackBarService.Warning(DirectoryModel.CanonicalName + " has been moved to " + ouToMoveTo.CanonicalName + ", but changes need to be saved.");
            ApplicationEvents.DirectoryEntryEvent.Invoke(new()
                {
                    EventType = ApplicationEventType.Move,
                    Entry = DirectoryModel,
                    Target=ouToMoveTo,
                    Origin = ouMovedFrom,
                    Actor = CurrentUser.State

                });

             await ModelChanged.InvokeAsync();
            Close();
            return;

        }

    }
    protected override bool IsValid => SelectedOU != null;


}

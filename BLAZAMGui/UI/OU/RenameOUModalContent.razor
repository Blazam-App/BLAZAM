@inherits AppModalContent
<ViewSection Title=@AppLocalization[Lang.OU]>


    @if (OU.CanReadField(ActiveDirectoryFields.CanonicalName))
    {


            <MudTextField AutoFocus=true Label="@AppLocalization[Lang.Name]" @bind-Value="@OU.CanonicalName" />

            
        
    }
    
    
</ViewSection>


    <MudButton Color=Color.Primary OnClick="SaveChanges">@AppLocalization[Lang.Save_Changes]</MudButton>
@code {

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await UpdateState();
        Modal.SetOnYes(SaveChanges);
        Modal.SetYesText(AppLocalization[Lang.Save_Changes]);
        Modal.Title = AppLocalization[Lang.Rename_OU];
    }


    Task SaveChanges()
    {
        SnackBarService.Warning("The ou has been renamed but changes must be saved.");
        Close();
        return Task.CompletedTask;

    }
    protected override bool IsValid=> !OU.CanonicalName.IsNullOrEmpty();
        
    

}

@using System.Security.Claims
@inherits AppComponentBase

@if (!CurrentUser.State.Cache.Get<bool>(cacheKey) && _passwordExpirationDateTime.HasValue && _passwordExpirationDateTime.Value < DateTime.UtcNow.AddDays(30))
{
    <MudAlert Severity=Severity.Warning
              Class="mb-2 rounded-t-0"
              ShowCloseIcon=true
              CloseIconClicked="@(()=>{CurrentUser.State.Cache.Set(cacheKey,true);})"
              Elevation="3"
              Dense=true
              Variant="Variant.Filled">


        @AppHelpLocalization[HelpLang.Your_password_expires_in_X_days,[(int)((_passwordExpirationDateTime-DateTime.UtcNow).Value.TotalDays)]]

    </MudAlert>
}


@code {
    const string cacheKey = "passwordExpiringSoonAlertClosed";
    bool _successful;
    bool _closed;
    DateTime? _passwordExpirationDateTime;
    AppModal? _expiredPasswordModal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            _passwordExpirationDateTime = GetExpiredOrRequiredPasswordUser();
            InvokeStateHasChanged();
        }
    }

  

    private DateTime? GetExpiredOrRequiredPasswordUser()
    {
        var user = Directory.Users.FindUserByUsername(CurrentUser.State.Username, true, true);
        return user?.PasswordExpirationTime;
       
    }

    private void HandlePasswordModalResult(DialogResult? result)
    {
        if (result?.Canceled == true)
        {
            SnackBarService.Warning("Password change deferred.");
        }
        else if (!_successful)
        {
            SnackBarService.Success("Your password could not be updated.");
        }
    }
}

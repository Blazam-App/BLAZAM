@inherits AppComponentBase
<ViewSection Title=@AppLocalization[Lang.BitLocker]>

    <MudStack Row=true Class="@Class">
        <MudDataGrid T=IADBitLockerRecovery Items="_recoveries">
            <Columns>
                <PropertyColumn Property="x=>x.RecoveryId" Title="@AppLocalization[Lang.Recovery_Id]" />
                <PropertyColumn Property="x=>x.RecoveryPassword" Title="@AppLocalization[Lang.Recovery_Password]" />
            </Columns>
        </MudDataGrid>

    </MudStack>
</ViewSection>

@code{
    [Parameter]
    public string? Class { get; set; } = null;

    private IADComputer _computer;
    [Parameter]
    public IADComputer Computer{ get=>_computer; set
        {
            if (_computer == value) return;
            _computer = value;
            _=GetRecoveries();

        } }

    List<IADBitLockerRecovery> _recoveries = new();

    protected override async Task OnInitializedAsync(){
        await base.OnInitializedAsync();


    }
    private async Task GetRecoveries(){
        if (Computer == null) return;
        var recs = await Computer.GetBitLockerRecoveryAsync();
        if (recs != null)
            _recoveries = recs;

        await InvokeAsync(StateHasChanged);
    }
}
@if (_items.Count > 0)
{
    <AppBreadcrumbs Style="padding:0px;" Items="_items">
        <ItemTemplate>
            <MudLink Typo="Typo.caption"
                     Color="Color.Tertiary"
                     Class="align-middle"
                     Href="@context.Href">@context.Text</MudLink>
        </ItemTemplate>
        <SeparatorTemplate>
            <MudText Typo="Typo.caption"
                     Class="align-middle">
                /
            </MudText>
        </SeparatorTemplate>
    </AppBreadcrumbs>
}




@code {
    private readonly object _lock = new();

    [Parameter]
    public IDirectoryEntryAdapter? Entry { get; set; }
    private List<BreadcrumbItem> _items = new();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Entry != null)
        {
            try
            {
                var ou = await Entry.GetParentAsync() as IADOrganizationalUnit;
                var items = new List<BreadcrumbItem>();
                if (ou is not null)
                {
                    IADOrganizationalUnit? ouCursor = ou;
                    // lock (_lock)
                    // {
                        do
                        {
                            if (ouCursor.Name is not null)
                            {
                                items.Add(new BreadcrumbItem(ouCursor.Name, ouCursor.SearchUri));
                            }
                            else
                            {
                                Loggers.ActiveDirectoryLogger.Information("OU with null name found in breadcrumb generation for {@Entry}", Entry.DN);
                            }
                            ouCursor = (await ouCursor.GetParentAsync()) as IADOrganizationalUnit;

                        } while (ouCursor != null);
                    //}
               
                }
                items.Reverse();
                _items = items;
            }
            catch (ObjectDisposedException ex)
            {
                Loggers.ActiveDirectoryLogger.Information(ex, "Object was disposed while building OU Breadcrumb for {@Entry}", Entry.DN);
            }
            catch (Exception ex)
            {
                Loggers.ActiveDirectoryLogger.Error(ex, "Error generating OU Breadcrumbs");
            }
        }
        await InvokeAsync(StateHasChanged);

    }
}
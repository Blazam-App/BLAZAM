@inherits DatabaseComponentBase
@switch (Field.FieldType)
{
    case ActiveDirectoryFieldType.Text:
        if (_customStringList != null)
        {
            <StringListAutocomplete StringList="_customStringList"
                                    Disabled="@Disabled"
                                    Label="@Field.DisplayName"
                                    Value="@((string)_value)"
                                    ValueChanged="@((val) => SetValue(val))" />
        }
        else
        {
            <DynamicMudInput T="string"
                             Disabled=@Disabled
                             Label="@Field.DisplayName"
                             Value="(string)_value"
                             ValueChanged="@((val)=>{SetValue(val);})" />
        }
        break;
    case ActiveDirectoryFieldType.Date:
        <DynamicMudInput T="DateTime?"
                         Disabled=@Disabled
                         Label="@Field.DisplayName"
                         Value="(DateTime?)_value"
                         ValueChanged="@((val)=>{SetValue(val);})" />
        break;
    case ActiveDirectoryFieldType.StringList:
        <DynamicMudInput T="List<string>"
                         @ref="_stringListDynamicInput"           
                         Disabled=@Disabled
                         Label="@Field.DisplayName"
                         Value="(List<string>?)_value"
                         ValueChanged="@((val)=>{SetValue(val);})" />
        break;


}

@code {

    private DynamicMudInput<List<string>>? _stringListDynamicInput;
    private CustomStringList? _customStringList;

    [Parameter]
    public IDirectoryEntryAdapter Entry { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public CustomActiveDirectoryField Field { get; set; }

    [CascadingParameter]
    public DirectoryTemplate? Template { get; set; }

    private object? _value = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (Template != null)
        {
            var fv = Template.EffectiveFieldValues.FirstOrDefault(f =>
                f.CustomFieldId == Field.Id || (f.CustomField != null && f.CustomField.FieldName == Field.FieldName));
            if (fv?.CustomStringList != null)
            {
                _customStringList = fv.CustomStringList;
            }
        }

        if (_customStringList == null && Context != null && Field != null)
        {
            var listField = await Context.CustomStringListFields
                .Include(f => f.CustomStringList)
                    .ThenInclude(l => l.Values)
                .FirstOrDefaultAsync(f => f.CustomFieldId == Field.Id && f.CustomStringList.DeletedAt == null);
            _customStringList = listField?.CustomStringList;
        }

        Entry.OnChangesDiscarded.Delegate += DiscardChanges;
        GetValue();
    }
    public override void Dispose()
    {
        base.Dispose();
        Entry?.OnChangesDiscarded.Delegate -= DiscardChanges;
    }

    private void DiscardChanges(object? sender = null, object? args = null)
    {
        _stringListDynamicInput?.DiscardChanges();
        GetValue();
    }

    private void GetValue()
    {
        switch (Field.FieldType)
        {
            case ActiveDirectoryFieldType.Text:
                _value = Entry.GetCustomProperty<string>(Field.FieldName);
                break;
            case ActiveDirectoryFieldType.Date:
                _value = Entry.GetDateTimeAttribute(Field.FieldName);
                break;
            case ActiveDirectoryFieldType.StringList:
                _value = Entry.GetCustomProperty<List<string>>(Field.FieldName);
                break;


        }
    }

    void SetValue(object? newValue)
    {

        Entry.SetCustomProperty(Field.FieldName, newValue);
        _value = newValue;
    }
}
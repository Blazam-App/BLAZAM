@inherits AppComponentBase
@inject BLAZAM.Services.Analytics AnalyticsService
<MudCard Class="py-3" Elevation="2">
    <MudStack Row=true Class="px-4">
        <MudIcon Icon="@Icons.Material.Outlined.EventNote"
        Color="Color.Info"/>
        <MudStack>
            @if (!Notification.Notification.Title.IsNullOrEmpty())
            {
                <MudText Typo="Typo.subtitle2">@Notification.Notification.Title</MudText>
            }
            <MudText Typo="Typo.caption">
                @((MarkupString)Notification.Notification.Message)
            </MudText>
        </MudStack>
        <MudSpacer />
        @if (!Notification.IsRead)
        {
            <AppCloseButton TooltipPlacement="Placement.Left" Tooltip="@AppLocalization[Lang.Dismiss]" OnClick="@(async () =>
        {
            await CurrentUser.State.MarkRead(Notification);
            await AnalyticsService.NotificationDismissed(Notification.Notification.MessageType.ToString());
            await InvokeAsync(StateHasChanged);
        })" />
        }
    </MudStack>
   
</MudCard>

@code {
    [Parameter]
    public UserNotification Notification { get; set; }
}

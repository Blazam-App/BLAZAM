@inherits AppComponentBase

@if (ApplicationInfo.InDemoMode && !CurrentUser.Username.Equals("admin", StringComparison.InvariantCultureIgnoreCase))
{
    <MudText Typo="@Typo" Style="@(Style + " filter:blur(4px);")">
        10.20.30.40
    </MudText>
}
else
{
    <MudText Typo="@Typo" Style="@Style">
        @ChildContent
    </MudText>
}

@code {
    [Parameter]
    public RenderFragment ChildContent{ get; set; }


    [Parameter]
    public string? Style{ get; set; }


    [Parameter]
    public Typo Typo{ get; set; }
}

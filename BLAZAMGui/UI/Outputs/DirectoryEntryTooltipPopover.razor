@inherits DirectoryModelComponent
@if (Entry != null && !Entry.IsDeleted)
{
    <AppTooltipPopover>
        <ActivatorContent>
            @ChildContent
        </ActivatorContent>
        <PopoverContent>
            <MudElement Class="pa-1">
                
                <MudText Align=Align.Center><MudLink Href="@Entry?.SearchUri">@Entry?.CanonicalName</MudLink></MudText>
                @if (GroupableEntry?.Description.IsNullOrEmpty()==false)
                {
                    <MudText Align=Align.Center>
                        <MudText Typo=Typo.caption Align=Align.Center>@GroupableEntry.Description</MudText>
                    </MudText>
                }

                
              
                @if (User?.ThumbnailPhoto != null)
                {
                    <MudCard Elevation="2"
                             Style="width:fit-content;height:fit-content"
                             Class="relative mx-auto d-block p-1 mb-5">
                        <Base64Image Style="max-height:100px;max-width:100px;" Data="User.ThumbnailPhoto.ResizeRawImage(100)" />
                    </MudCard>


                }


                <MudStack Row=true>
                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Created]:</MudText>
                    <MudSpacer />
                    <DateWithTimeTooltip DateTime="Entry?.Created" />

                </MudStack>

                <MudStack Row=true>

                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Last_Change]:</MudText>
                    <MudSpacer />

                    <DateWithTimeTooltip DateTime="Entry?.LastChanged" />

                </MudStack>
                @if (User != null)
                {
                    <MudStack Row=true>

                        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Pass_Change]:</MudText>
                        <MudSpacer />
                        <DateWithTimeTooltip DateTime="User.PasswordLastSet" />

                     
                    </MudStack>
                
                    <MudStack Row=true>

                        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Last_Logon]:</MudText>
                        <MudSpacer />
                        <LastLogonTime Typo=Typo.caption DirectoryEntry="User" />
                    </MudStack>
                    @if (User.LockedOut == true)
                    {
                        <MudStack Row=true>
                            <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Lockout_Time]:</MudText>
                            <MudSpacer />
                            <DateWithTimeTooltip DateTime="User.LockoutTime" />
                        </MudStack>
                    }
                }
                <MudStack Row=true>
                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.OU]:</MudText>
                    <MudSpacer />

                    <OUBreadcrumbs Entry="Entry" />
                </MudStack>

               
            
        
            </MudElement>
        </PopoverContent>
    </AppTooltipPopover>
}
else
{

    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
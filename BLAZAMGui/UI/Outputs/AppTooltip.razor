@inherits MudTooltip
@if (!Text.IsNullOrEmpty() || TooltipContent != null)
{
    <MudTooltip Color=@Color
                Arrow=@Arrow
                Class="@Class"
                Delay="@Delay"
                Disabled=@Disabled
                Duration="@Duration"
                Inline=@Inline
                Placement="@Placement"
                RootClass="@RootClass"
                RootStyle="@RootStyle"
                ShowOnClick=@ShowOnClick
                ShowOnFocus=@ShowOnFocus
                ShowOnHover=@ShowOnHover
                Style=@(TooltipContent==null?Style:"background-color:#0000")
                Tag="@Tag"
                UserAttributes="@UserAttributes"
                Visible=@Visible
                VisibleChanged="@VisibleChanged">
        <TooltipContent>
            @if (Text.IsNullOrEmpty())
            {
                @TooltipContent
            }
            else
            {
                <MudText Typo=Typo.caption
                         Color="@TextColor">@Text</MudText>
            }
        </TooltipContent>
        <ChildContent>
            @ChildContent

        </ChildContent>
    </MudTooltip>
}else{
    @ChildContent
}

@code {

    [Parameter]
    public Color TextColor { get; set; }
}

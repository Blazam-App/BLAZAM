@using BLAZAM.Database.Models.Audit
@inherits AppComponentBase
<MudChart ChartType="ChartType.Line"
          ChartSeries="@LoginSeries"
          XAxisLabels="@(allDates.Select(d=>d.ToLocalTime().ToString("M/d")).ToArray())"
          Width="100%"
          Height=@Height
          ChartOptions="@ChartOptions"></MudChart>
@*
<MudFab Icon="@Icons.Material.Filled.ShowChart" OnClick="ToggleLineMode" />*@
@code {


    [Parameter]
    public ChartOptions ChartOptions { get; set; } = new()
        {
            InterpolationOption = InterpolationOption.Straight
        };


    [Parameter]
    public DateTime? EndDate { get; set; } = DateTime.Today;

    [Parameter]
    public DateTime? StartDate { get; set; } = DateTime.Today.AddDays(-14); // Adding StartDate parameter


    /// <summary>
    /// The height of the chart
    /// </summary>
    /// <remarks>
    /// Default is "350px"
    /// </remarks>
    [Parameter]
    public string Height { get; set; } = "350px";



    List<ChartSeries> LoginSeries = new();


    List<LogonAuditLog> logonEntries = new();
    IEnumerable<DateTime> allDates;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        GenerateLoginSeries();
    }
    public async Task GenerateLoginSeries()
    {
        LoginSeries.Clear();
        ChartSeries loginChart = new() { Name = AppLocalization[Lang.Daily_Logins] };
        ChartSeries uniqueUsersChart = new() { Name = AppLocalization[Lang.Daily_Users] };

        // 1. Determine date range and calculate step size
        var start = StartDate ?? DateTime.Today.AddDays(-14);
        var end = EndDate ?? DateTime.Today;
        var totalDays = (int)(end - start).TotalDays + 1;

        // Ensure at least 1 day
        if (totalDays < 1) totalDays = 1;

        // Calculate step to limit to max 30 points
        int maxPoints = 15;
        int step = (int)Math.Ceiling((double)totalDays / maxPoints);
        if (step < 1) step = 1;

        // 2. Generate the bucket start dates for X-Axis
        var bucketDates = new List<DateTime>();
        for (int i = 0; i < totalDays; i += step)
        {
            bucketDates.Add(start.AddDays(i));
        }
        allDates = bucketDates;

        using (var context = await DbFactory.CreateDbContextAsync())
        {
            // 3. Fetch only relevant logs from DB (Optimization)
            var dbStart = start.Date;
            var dbEnd = end.Date.AddDays(1);

            logonEntries = await context.LogonAuditLog
                .Where(l => l.Timestamp >= dbStart && l.Timestamp < dbEnd)
                .ToListAsync();

            var loginCounts = new List<double>();
            var uniqueLoginCounts = new List<double>();

            // 4. Aggregate data into buckets
            foreach (var date in bucketDates)
            {
                var windowStart = date.Date;
                var windowEnd = date.Date.AddDays(step);

                var windowEntries = logonEntries
                    .Where(ae => ae.Action == "Login" &&
                                 ae.Timestamp.Date >= windowStart &&
                                 ae.Timestamp.Date < windowEnd);

                loginCounts.Add((double)windowEntries.Count());
                uniqueLoginCounts.Add((double)windowEntries.DistinctBy(g => g.Username).Count());
            }

            loginChart.Data = loginCounts.ToArray();
            uniqueUsersChart.Data = uniqueLoginCounts.ToArray();

            LoginSeries.Add(loginChart);
            LoginSeries.Add(uniqueUsersChart);
            InvokeStateHasChanged();
        }
    }
    public async Task GenerateLoginSeries2()
    {
        LoginSeries.Clear();
        ChartSeries loginChart = new() { Name = AppLocalization[Lang.Daily_Logins] };
        ChartSeries uniqueUsersChart = new() { Name = AppLocalization[Lang.Daily_Users] };
        allDates = Enumerable.Range(0, (int)(EndDate.Value - StartDate.Value).TotalDays + 1)
                                 .Select(d => StartDate.Value.AddDays(d));
        using (var context = await DbFactory.CreateDbContextAsync())
        {

            logonEntries = await context.LogonAuditLog.ToListAsync();





            var loginCounts = from date in allDates
                              join ae in logonEntries.Where(ae => ae.Action == "Login")
                              on date equals ae.Timestamp.Date into grp
                              select (double)grp.Count();

            var uniqueLoginCounts = from date in allDates
                                    join ae in logonEntries.Where(ae => ae.Action == "Login")
                                    on date equals ae.Timestamp.Date into grp
                                    select (double)grp.DistinctBy(g => g.Username).Count();


            loginChart.Data = loginCounts.ToArray();
            uniqueUsersChart.Data = uniqueLoginCounts.ToArray();



            LoginSeries.Add(loginChart);
            LoginSeries.Add(uniqueUsersChart);
            InvokeStateHasChanged();
        }
}
}

@inherits AppComponentBase
<MudText Typo="Typo.caption">@AppLocalization[Lang.Start_Time]: @StartTime </MudText>


@code {
    [Parameter]
    public IJobStep Step { get; set; }

    private string StartTime {
        get{
            if (Step.StartTime == null || !Step.StartTime.HasValue) return AppLocalization[Lang.Not_started];
            return Step.StartTime.Value.ToShortTimeString();
        }
    }
}
@using System.Text
@inherits MudBreadcrumbs
<MudStack Row=true Spacing="1">
    @if (Items != null)
    {
        // Limit breadcrumbs to max 3: show first and last 2 if over limit
        List<BreadcrumbItem> displayItems = new(Items);
        var hiddenItems = new List<BreadcrumbItem>();
        if (Items.Count() > 3)
        {

            hiddenItems = Items
                           .Skip(1)
                           .Take(Items.Count - 3)
                           .ToList();

            displayItems = new List<BreadcrumbItem>
            {
                Items.First()
            };

            displayItems.Add(new BreadcrumbItem("...", null));
            displayItems.AddRange(Items.TakeLast(2));
        }

        var firstItem = true;
        foreach (var item in displayItems)
        {
            if (!firstItem)
            {
                @SeparatorTemplate
            }
            if (item?.Text == "...")
            {
                string tooltipText = "";
                StringBuilder s = new StringBuilder();
                var first = true;
                @foreach (var hiddenItem in hiddenItems)
                {
                    if (!first)
                    {
                        s.Append("/");

                    }
                    s.Append(hiddenItem.Text);
                    first = false;
                }
                tooltipText = s.ToString();
                <AppTooltip Text="@tooltipText">
                        <span class="cursor-pointer">...</span>
                </AppTooltip>
            }
            else
            {
                @ItemTemplate(item)
            }
            firstItem = false;
        }
    }
</MudStack>

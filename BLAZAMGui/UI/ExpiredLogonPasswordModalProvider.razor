@using System.Security.Claims
@inherits AppComponentBase

<AppModal @ref=_expiredPasswordModal
          Title=@AppLocalization["Password expired"]
          AllowClose="@(_user?.RequirePasswordChange==false)">
    <ExpiredLogonPasswordModalContent Entry="@_user" @bind-Successful=_successful />
</AppModal>

@code {
    bool _successful;
    IADUser? _user;
    AppModal? _expiredPasswordModal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!ShouldShowPasswordModal(firstRender))
            return;

        _user = GetExpiredOrRequiredPasswordUser();
        if (_user == null || _expiredPasswordModal == null)
            return;

        try
        {
            var result = await (await _expiredPasswordModal.ShowAsync()).Result.WaitAsync(CancellationToken.None);
            HandlePasswordModalResult(result);
        }
        catch (Exception ex)
        {
            Loggers.SystemLogger.Error(ex, "Unexpected error attempting to show expired password reset prompt.");
        }
    }

    private bool ShouldShowPasswordModal(bool firstRender)
    {
        return firstRender &&
               CurrentUser.State.User.Identity?.AuthenticationType == AppAuthenticationTypes.ActiveDirectoryAuthentication;
    }

    private IADUser? GetExpiredOrRequiredPasswordUser()
    {
        var user = Directory.Users.FindUserByUsername(CurrentUser.State.Preferences.Username, true, true);
        var passwordExpTime = user?.PasswordExpirationTime;
        if ((passwordExpTime != null && passwordExpTime < DateTime.UtcNow) || (user?.RequirePasswordChange == true))
        {
            return user;
        }
        return null;
    }

    private void HandlePasswordModalResult(DialogResult? result)
    {
        if (result?.Canceled == true)
        {
            SnackBarService.Warning("Password change deferred.");
        }
        else if (!_successful)
        {
            SnackBarService.Success("Your password could not be updated.");
        }
    }
}

@implements IDisposable
<MudText>Ldap Count: @_count</MudText>
@code{
    int _count = 0;
    protected override void OnInitialized()
    {
        _count = ApplicationStatistics.LdapConnectionCount;
        ApplicationStatistics.OnLdapCountChanged.Delegate += Refresh;
    }

    private void Refresh(object sender, int count)
    {
        _count = count;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ApplicationStatistics.OnLdapCountChanged.Delegate -= Refresh;
    }
}
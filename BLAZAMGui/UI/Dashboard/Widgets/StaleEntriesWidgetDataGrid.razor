@inherits MudDataGrid<T>
@inject IStringLocalizer<AppLocalization> AppLocalization
@typeparam T where T : IAccountDirectoryAdapter

<MudDataGrid T="@T"
             Items=Items
             Dense=true
             Filterable=true
             RowsPerPage="@RowsPerPage"
             FilterMode="DataGridFilterMode.Simple"
             Loading=@Loading
             Square=true
             ColumnResizeMode="ResizeMode.Column"
             Virtualize=true
             RowClass="cursor-pointer"
             RowClick=@RowClick
             RowsPerPageChanged="@RowsPerPageChanged"
             Class="py-0"
             SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Title=@AppLocalization[Lang.Name]>
            <CellTemplate>

                <DirectoryEntryTooltipPopover Entry="@context.Item">
                    <DirectoryEntryContextMenu Entry="@context.Item"
                                               OnChanged="OnChanged">
                        <MudText>@context.Item?.CanonicalName</MudText>
                    </DirectoryEntryContextMenu>
                </DirectoryEntryTooltipPopover>

            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title=@AppLocalization[Lang.Last_Logon]>
            <CellTemplate>
                @if (context.Item?.Created != null)
                {
                    <LastLogonTime DirectoryEntry="@context.Item" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager PageSizeOptions=@([5, 10, 25, 50, 100]) T="@T" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>@AppLocalization[Lang.No_matching_results]</MudText>
    </NoRecordsContent>
</MudDataGrid>


@code {
#nullable disable warnings

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task<string> GetLastLogonTime(T item)
    {
        return await Task.Run(() =>
        {
            return item.LastLogonTime?.ToLocalTime().ToString();
        });
    }
}
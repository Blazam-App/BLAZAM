@inherits TimeFrameWidget
@attribute [Authorize]
<MudTimeFramePicker TimeFrame=@_timeFrame
                    TimeFrameChanged=SetTimeFrame
                    Disabled="@(!CurrentUserDashboardWidgets.EditMode)"
                    Class="mx-3" />
<MudDataGrid T="IDirectoryEntryAdapter"
             Items="LockedUsers"
             RowClick="@RowClicked"
             RowClass="cursor-pointer"
             Dense=true
             Filterable=true
             RowsPerPage="@ItemsPerPage"
             RowsPerPageChanged="@SetRowsPerPage"
             FilterMode="DataGridFilterMode.Simple"
             Loading=@LoadingData
             Square=true
             RowContextMenuClick="@RowContextMenuClicked"
             ColumnResizeMode="ResizeMode.Column"
             Virtualize=true
             Class="py-0"
             SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Title=@AppLocalization[Lang.Name]>
            <CellTemplate>
                <DirectoryEntryLink Entry="@context.Item" OnChanged="RefreshDataAsync" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title=@AppLocalization[Lang.Password_changed]>
            <CellTemplate>
                <WidgetTimestamp Timestamp="((IADUser)context.Item).PasswordLastSet" />

                
            </CellTemplate>
        </TemplateColumn>

    </Columns>
    <PagerContent>
        <MudDataGridPager PageSizeOptions=@([5, 10, 25, 50, 100]) T="IDirectoryEntryAdapter" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>@AppLocalization[Lang.No_matching_results]</MudText>
    </NoRecordsContent>
</MudDataGrid>
<DirectoryEntryContextMenu @ref="_contextMenu" OnChanged="@(() => { InvokeStateHasChanged(); })" />


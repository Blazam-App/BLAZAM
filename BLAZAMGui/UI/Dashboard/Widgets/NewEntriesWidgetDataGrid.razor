@inherits MudDataGrid<T>
@inject IStringLocalizer<AppLocalization> AppLocalization
@typeparam T where T : IDirectoryEntryAdapter

<MudDataGrid T="@T"
             Items="@Items"
             Dense=true
             Filterable=true
             RowsPerPage="@RowsPerPage"
             FilterMode="DataGridFilterMode.Simple"
             Loading=@Loading
             Square=true
             ColumnResizeMode="ResizeMode.Column"
             Virtualize=false
             RowClass="cursor-pointer"
             RowClick=@RowClick
             RowsPerPageChanged="@RowsPerPageChanged"
             Class="py-0"
             SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Title=@AppLocalization[Lang.Name]>
            <CellTemplate>
                <DirectoryEntryLink Entry="@context.Item" OnChanged="OnChanged"/>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title=@AppLocalization[Lang.Created]>
            <CellTemplate>
                @if (context.Item?.Created != null)
                {

                    <MudText>@context.Item.Created.Value.ToLocalTime()</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager PageSizeOptions=@([5, 10, 25, 50, 100]) T="@T" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>@AppLocalization[Lang.No_matching_results]</MudText>
    </NoRecordsContent>
</MudDataGrid>


@code {

    [Parameter]
    public EventCallback OnChanged { get; set; }
}
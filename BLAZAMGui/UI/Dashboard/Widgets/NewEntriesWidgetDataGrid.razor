@inherits MudDataGrid<T>
@inject IStringLocalizer<AppLocalization> AppLocalization
@typeparam T where T : IDirectoryEntryAdapter

<MudDataGrid T="@T"
             Items="@Items"
             Dense=true
             Filterable=true
             RowsPerPage="@RowsPerPage"
             FilterMode="DataGridFilterMode.Simple"
             Loading=@Loading
             Square=true
             ColumnResizeMode="ResizeMode.Column"
             Virtualize=false
             RowClass="cursor-pointer"
             RowClick=@RowClick
             RowsPerPageChanged="@RowsPerPageChanged"
             Class="py-0"
             SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Title=@AppLocalization["Name"]>
            <CellTemplate>
                <MudContextMenu>

                    <ChildContent>

                        @* <AppTooltip Text="@context.Item?.OU.ToPrettyOu()">
                            <MudText>@context.Item?.CanonicalName</MudText>
                            </AppTooltip> *@
                            
                            <AppTooltipPopover>
                                <ActivatorContent>
                                    <MudText>@context.Item?.CanonicalName</MudText>
                                </ActivatorContent>
                                <PopoverContent>
                                    @{
                                    var User = context.Item as IADUser;
                                }
                                <MudText Align=Align.Center><MudLink Href="@User?.SearchUri">@User.CanonicalName</MudLink></MudText>
                                    <MudCard Elevation="2"
                                             Style="width:fit-content;height:fit-content"
                                             Class="relative mx-auto d-block p-1 mb-5">

                                        @if (User?.ThumbnailPhoto != null)
                                    {
                                        <Base64Image Style="max-height:150px;max-width:150px;" Data="User.ThumbnailPhoto.ReizeRawImage(150)" />


                                    }
                                    else
                                    {
                                        <MudIcon Style="height:150px;width:150px;" Icon="@Icons.Material.Filled.Person" />

                                    }

                                </MudCard>

                                <MudStack Row=true>
                                    <MudText Typo="Typo.subtitle2">@AppLocalization["Created"]:</MudText>
                                        <MudSpacer />
                                        <DateWithTimeTooltip DateTime="User?.Created" />

                                    </MudStack>

                                    <MudStack Row=true>

                                        <MudText Typo="Typo.subtitle2">@AppLocalization["Last Change"]:</MudText>
                                        <MudSpacer />

                                        <DateWithTimeTooltip DateTime="User?.LastChanged" />

                                    </MudStack>

                                    <MudStack Row=true>

                                        <MudText Typo="Typo.subtitle2">@AppLocalization["Pass Change"]:</MudText>
                                        <MudSpacer />
                                        <DateWithTimeTooltip DateTime="User?.PasswordLastSet" />


                                    </MudStack>

                                    <MudStack Row=true>

                                        <MudText Typo="Typo.subtitle2">@AppLocalization["Last Logon"]:</MudText>
                                        <MudSpacer />
                                        <LastLogonTime DirectoryEntry="User" />
                                    </MudStack>
                                    @if (User?.LockedOut == true)
                                {
                                    <MudStack Row=true>
                                        <MudText Typo="Typo.subtitle2">@AppLocalization["Lockout Time"]:</MudText>
                                            <MudSpacer />
                                            <DateWithTimeTooltip DateTime="User?.LockoutTime" />
                                        </MudStack>
                                }
                                <MudStack Row=true>
                                    <MudText Typo="Typo.subtitle2">@AppLocalization["OU"]:</MudText>
                                        <MudSpacer />

                                        <MudText Style="text-align:end;"
                                                 Typo="Typo.caption">@User?.OU.ToPrettyOu()</MudText>
                                    </MudStack>
                                </PopoverContent>
                            </AppTooltipPopover>
                        </ChildContent>
                        <MenuContents>

                            <DirectoryEntryContextMenuItems Entry="@context.Item" />

                        </MenuContents>
                    </MudContextMenu>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title=@AppLocalization["Created"]>
                <CellTemplate>
                    @if (context.Item?.Created != null)
                {

                    <MudText>@context.Item.Created.Value.ToLocalTime()</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager PageSizeOptions=[5,10,25,50,100] T="@T" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>@AppLocalization["No matching entries"]</MudText>
        </NoRecordsContent>
    </MudDataGrid>


    @code {
#nullable disable warnings
}
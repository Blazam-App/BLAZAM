@inherits TimeFrameWidget
@attribute [Authorize]
@if(CurrentUserDashboardWidgets.EditMode){
<MudTimeFramePicker TimeFrame=@_timeFrame
                    TimeFrameChanged=SetTimeFrame
                    Disabled="@(!CurrentUserDashboardWidgets.EditMode)"
                    Class="mx-3" />
}
@if(NewUsers.Count>0){
<NewEntriesWidgetDataGrid Items="@NewUsers"
                          RowsPerPage="@ItemsPerPage"
                          RowsPerPageChanged="@SetRowsPerPage"
                          RowClick=@GoTo
                          T="IADUser"
                          OnChanged="RefreshDataAsync"
                          Loading=LoadingData />
}
else
{
    <MudText Align="Align.Center" Class="mb-4">@AppLocalization[Lang.No_matching_results]</MudText>

}
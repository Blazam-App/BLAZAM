@inherits Widget
@attribute [Authorize]
<div>

    <h3>Disabled users changed in the last 90 days</h3>

    <div Overflow="Overflow.Auto" Style="max-height:350px;">
        @foreach (var user in DisabledUsers)
        {

            <MudCard @onclick="@(()=>{Nav.NavigateTo(user.SearchUri);})">


                @user.DisplayName <br>
                @user.SamAccountName <br>
                @user.OU.ToPrettyOu() <br>

                @user.LastChanged <br>
            </MudCard>

        }
    </div>
</div>
@code {
    List<IADUser> DisabledUsers
    {
        get => CurrentUser.State.Cache.Get<List<IADUser>>(this.GetType());
        set => CurrentUser.State.Cache.Set(this.GetType(), value);
    }
    


    protected override async Task RefreshData()
    {
        LoadingData = true;
        DisabledUsers = (await Directory.Users.FindChangedUsersAsync(false)).Where(u => u.Disabled).ToList();

        LoadingData = false;

    }
}

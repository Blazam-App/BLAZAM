@inherits Widget
@attribute [Authorize]

<MudDataGrid T="IADUser"
             Items="@LockedUsers.Where(u=>u.LockedOut)"
             Dense=true
             Filterable=true
             RowsPerPage="@ItemsPerPage"
             RowsPerPageChanged="@SetRowsPerPage"
             FilterMode="DataGridFilterMode.Simple"
             Loading=@LoadingData
             Square=true
             ColumnResizeMode="ResizeMode.Column"
             Virtualize
             RowClass="cursor-pointer"
             RowClick=@GoTo
             RowContextMenuClick="@RowContextMenuClicked"
             Class="py-0"
             SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Title=@AppLocalization[Lang.Name]>
            <CellTemplate>
                <DirectoryEntryLink Typo="Typo.caption"
                                    Entry="@context.Item"
                                    OnChanged="RefreshDataAsync" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title=@AppLocalization[Lang.Locked_Out]>
            <CellTemplate>
                @if (context.Item?.LockoutTime != null)
                {
                    <DateWithTimeTooltip DateTime="@context.Item.LockoutTime.Value" />
                }
            </CellTemplate>
        </TemplateColumn>

    </Columns>
    <PagerContent>
        <MudDataGridPager PageSizeOptions=@([5, 10, 25, 50, 100]) T="IADUser" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>@AppLocalization[Lang.No_user_are_locked_out]</MudText>
    </NoRecordsContent>
</MudDataGrid>
<DirectoryEntryContextMenu @ref="_contextMenu" OnChanged="@(() => { InvokeStateHasChanged(); })" />



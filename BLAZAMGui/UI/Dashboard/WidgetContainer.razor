@using BLAZAM.Gui.UI.Dashboard.Widgets
@inherits AppComponentBase
@if (Widget != null)
{
    <MudCard Class="my-5 " Elevation="1">
        <MudCardHeader>
            <MudText Typo="Typo.h6">@AppLocalization[Widget.Title]</MudText>
                <MudSpacer />
                <AppIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Tooltip=@AppLocalization["Refresh"]
                               OnClick="@(async()=>{await OnRefresh.InvokeAsync(Widget);})" />


                <AppCloseButton Disabled="!_editMode"
                                Tooltip=@AppLocalization["Remove"]
                                OnClick=@(async()=>{await OnRemove.InvokeAsync(Widget);}) />

            </MudCardHeader>
            <CascadingValue Value="this">

                <DynamicComponent Parameters="@(new Dictionary<string,object>(){
                                    {"ItemsPerPage",Widget.ItemsPerPage>5?Widget.ItemsPerPage:5},
                                    {"WidgetType",Widget.WidgetType}
                                 })"
                                  Type="@Widget.GetType()" />
            </CascadingValue>

        </MudCard>
}
@code {
    bool _editMode;
    [Parameter]
    public Widget Widget { get; set; }
    [Parameter]
    public EventCallback<Widget> OnRemove { get; set; }
    [Parameter]
    public EventCallback<Widget> OnRefresh { get; set; }
    [Parameter]
    public CurrentUserDashboardWidgets Dashboard { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
       
    }


}

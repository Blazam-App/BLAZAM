@using BLAZAM.Database.Models.Audit;
@using BLAZAM.Services.Audit;
@using System.Security.Cryptography.X509Certificates
@inherits AppModalContent
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    <MudSelectList Label=@AppLocalization[Lang.Certificate_Type] Values="@(new List<string> { "PFX", "Crt and Key" })" @bind-Value=SelectedCertType />
    @if (SelectedCertType == "PFX")
    {
        <MudFileUpload T="IBrowserFile" FilesChanged="LoadPFX" Accept=".pfx">
            <ActivatorContent>
                <MudButton HtmlTag="label"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    @AppLocalization[Lang.Upload] PFX
                </MudButton>
            </ActivatorContent>
            <SelectedTemplate>
                @if (context != null)
                {
                    <MudText>@context.Name</MudText>
                }
                else
                {
                    <MudText>@AppLocalization[Lang.No_File]</MudText>
                }
            </SelectedTemplate>
        </MudFileUpload>
        <MudTextField Label="@AppLocalization[Lang.Password]"
                      name="Password"
                      InputType="InputType.Password"
                      @bind-Value=pfxPassword />

    }
    else
    {
        <MudFileUpload T="IBrowserFile"
                       FilesChanged="LoadCert"
                       Accept=".pem, .crt">
            <ActivatorContent>
                <MudButton HtmlTag="label"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    @AppLocalization[Lang.Upload_Certificate]
                </MudButton>
            </ActivatorContent>
            <SelectedTemplate>
                @if (context != null)
                {
                    <MudText>@context.Name</MudText>
                }
                else
                {
                    <MudText>@AppLocalization[Lang.No_File]</MudText>
                }
            </SelectedTemplate>
        </MudFileUpload>

        <MudFileUpload T="IBrowserFile" FilesChanged="LoadKey" Accept=".pem, .key">
            <ActivatorContent>
                <MudButton HtmlTag="label"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    @AppLocalization[Lang.Upload_Key]
                </MudButton>
            </ActivatorContent>
            <SelectedTemplate>
                @if (context != null)
                {
                    <MudText>@context.Name</MudText>
                }
                else
                {
                    <MudText>@AppLocalization[Lang.No_File]</MudText>
                }
            </SelectedTemplate>
        </MudFileUpload>
    }
</MudContainer>

@code {
    string SelectedCertType = "PFX";
    string pfxPassword = "";
    byte[] pfxBytes;
    byte[] crtBytes;
    byte[] keyBytes;

    [Parameter]
    public AppSettings AppSettings { get; set; }
    protected override async Task OnInitializedAsync()
    {
        Modal.SetYesText(AppLocalization[Lang.Upload]);
        Modal.SetOnYes(Import);
        await base.OnInitializedAsync();

    }


    public Task Import()
    {
        try
        {
            switch (SelectedCertType)
            {
                case "PFX":
                    var cert = new X509Certificate2(pfxBytes, pfxPassword, X509KeyStorageFlags.UserKeySet | X509KeyStorageFlags.Exportable | X509KeyStorageFlags.PersistKeySet);
                    var rawCert2 = cert.Export(X509ContentType.Pkcs12);
                    var cert2 = new X509Certificate2(rawCert2);
                    if (rawCert2 != null)
                    {
                        var cipher = rawCert2?.Encrypt();
                        AppSettings.SSLCertificateCipher = cipher;


                        Close();
                    }
                    else
                    {
                        SnackBarService.Warning(AppHelpLocalization[HelpLang.Invalid_Cert_Type]);
                    }
                    break;
                case "Crt and Key":
                    if (crtBytes != null && keyBytes != null)
                    {
                        try
                        {
                            var certPem = System.Text.Encoding.UTF8.GetString(crtBytes);
                            var keyPem = System.Text.Encoding.UTF8.GetString(keyBytes);

                            var cert = X509Certificate2.CreateFromPem(certPem, keyPem);

                            var rawCert = cert.Export(X509ContentType.Pkcs12);
                            if (rawCert != null)
                            {
                                var cipher = rawCert.Encrypt();
                                AppSettings.SSLCertificateCipher = cipher;
                                Close();
                            }
                            else
                            {
                                SnackBarService.Warning(AppHelpLocalization[HelpLang.Invalid_Cert_Type]);
                            }
                        }
                        catch (Exception ex)
                        {
                            SnackBarService.Warning(ex.Message);
                        }
                    }
                    else
                    {
                        SnackBarService.Warning("Certificate or key not uploaded.");
                    }
                    break;
            }
        }
        catch (Exception ex)
        {
            SnackBarService.Warning(ex.Message);
        }
        return Task.CompletedTask;

    }

    private async void LoadPFX(IBrowserFile e)
    {
        pfxBytes = await e.ReadByteArrayAsync(5000000);
        await StateHasChangedAsync();


    }


    private async void LoadCert(IBrowserFile e)
    {
        crtBytes = await e.ReadByteArrayAsync(5000000);
        await StateHasChangedAsync();


    }

    private async void LoadKey(IBrowserFile e)
    {
        var bytes = await e.ReadByteArrayAsync(5000000);
        if (bytes != null)
        {
            keyBytes = bytes;
        }
        await StateHasChangedAsync();


    }
}

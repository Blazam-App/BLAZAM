@using BLAZAM.Database.Models.Audit;
@using BLAZAM.Services.Audit;
@using System.Security.Cryptography.X509Certificates
@inherits AppModalContent
<MudTabs @bind-ActivePanelIndex=_tabIndex>
    <MudTabPanel Text="PFX">
        <MudStack Class="py-5 align-center">
            <MudFileUpload T="IBrowserFile" FilesChanged="LoadPFX" Accept=".pfx">
                <ActivatorContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        @AppLocalization[Lang.Upload] PFX
                    </MudButton>
                </ActivatorContent>
                <SelectedTemplate>
                    @if (context != null)
                    {
                        <MudText Align="Align.Center">@context.Name</MudText>
                    }
                    else
                    {
                        <MudText Align="Align.Center">@AppLocalization[Lang.No_File]</MudText>
                    }
                </SelectedTemplate>
            </MudFileUpload>
            <MudTextField Label="@AppLocalization[Lang.Password]"
                          name="Password"
                          InputType="InputType.Password"
                          @bind-Value=pfxPassword />

        </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="CRT and KEY">
        <MudStack Class="py-5 align-center">

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="LoadCert"
                           Accept=".pem, .crt">
                <ActivatorContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        @AppLocalization[Lang.Upload_Certificate]
                    </MudButton>
                </ActivatorContent>
                <SelectedTemplate>
                    @if (context != null)
                    {
                        <MudText Align="Align.Center">@context.Name</MudText>
                    }
                    else
                    {
                        <MudText Align="Align.Center">@AppLocalization[Lang.No_File]</MudText>
                    }
                </SelectedTemplate>
            </MudFileUpload>

            <MudFileUpload T="IBrowserFile" FilesChanged="LoadKey" Accept=".pem, .key">
                <ActivatorContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        @AppLocalization[Lang.Upload_Key]
                    </MudButton>
                </ActivatorContent>
                <SelectedTemplate>
                    @if (context != null)
                    {
                        <MudText Align="Align.Center">@context.Name</MudText>
                    }
                    else
                    {
                        <MudText Align="Align.Center">@AppLocalization[Lang.No_File]</MudText>
                    }
                </SelectedTemplate>
            </MudFileUpload>

        </MudStack>
    </MudTabPanel>
</MudTabs>
<LoadingData Loading=@LoadingData />

@code {
    int _tabIndex;
    string pfxPassword = "";
    byte[] pfxBytes;
    byte[] crtBytes;
    byte[] keyBytes;

    [Parameter]
    public AppSettings AppSettings { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Modal.SetYesText(AppLocalization[Lang.Upload]);
        Modal.SetOnYes(Import);
        Modal.YesEnabled = () => !LoadingData;
        LoadingData = false;

    }

    [Parameter]
    public EventCallback OnSSLCertifcateChanged { get; set; }

    public async Task Import()
    {
        try
        {
            LoadingData = true;
            switch (_tabIndex)
            {
                case 0:
                    try
                    {
                        using var cert = new X509Certificate2(pfxBytes, pfxPassword, X509KeyStorageFlags.UserKeySet | X509KeyStorageFlags.Exportable | X509KeyStorageFlags.PersistKeySet);
                        var rawCert = cert.Export(X509ContentType.Pkcs12);
                        if (rawCert != null)
                        {
                            var cipher = await rawCert?.EncryptAsync();
                            AppSettings.SSLCertificateCipher = cipher;
                            await OnSSLCertifcateChanged.InvokeAsync();
                            Close();
                        }
                        else
                        {
                            SnackBarService.Warning(AppHelpLocalization[HelpLang.Invalid_Cert_Type]);
                        }
                    }
                    catch (Exception ex)
                    {
                        SnackBarService.Warning(ex.Message);
                    }

                    break;
                case 1:
                    if (crtBytes != null && keyBytes != null)
                    {
                        try
                        {
                            var certPem = System.Text.Encoding.UTF8.GetString(crtBytes);
                            var keyPem = System.Text.Encoding.UTF8.GetString(keyBytes);

                            using var cert3 = X509Certificate2.CreateFromPem(certPem, keyPem);

                            var rawCert2 = cert3.Export(X509ContentType.Pkcs12);
                            if (rawCert2 != null)
                            {
                                var cipher = await rawCert2.EncryptAsync();
                                AppSettings.SSLCertificateCipher = cipher;

                                await OnSSLCertifcateChanged.InvokeAsync();
                                Close();
                            }
                            else
                            {
                                SnackBarService.Warning(AppHelpLocalization[HelpLang.Invalid_Cert_Type]);
                            }
                        }
                        catch (Exception ex)
                        {
                            SnackBarService.Warning(ex.Message);
                        }
                    }
                    else
                    {
                        SnackBarService.Warning("Certificate or key not uploaded.");
                    }
                    break;
            }
        }
        catch (Exception ex)
        {
            SnackBarService.Warning(ex.Message);
        }
        finally
        {
            LoadingData = false;

        }

    }

    private async void LoadPFX(IBrowserFile e)
    {
        pfxBytes = await e.ReadByteArrayAsync(5000000);
        await StateHasChangedAsync();


    }


    private async void LoadCert(IBrowserFile e)
    {
        crtBytes = await e.ReadByteArrayAsync(5000000);
        await StateHasChangedAsync();


    }

    private async void LoadKey(IBrowserFile e)
    {
        var bytes = await e.ReadByteArrayAsync(5000000);
        if (bytes != null)
        {
            keyBytes = bytes;
        }
        await StateHasChangedAsync();


    }
}

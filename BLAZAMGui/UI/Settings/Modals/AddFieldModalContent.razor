@inherits AppModalContent
<MudForm @ref=Form 
@bind-IsValid=IsValid
Model="newField">
    <MudTextField For=@(()=>newField.DisplayName) T=string @bind-Value=newField.DisplayName Label="Display Name" />
    <MudTextField For=@(()=>newField.FieldName) T=string @bind-Value=newField.FieldName Label="Field Name" />
    <FieldTypeSelect For=@(()=>newField.FieldType) @bind-Value=newField.FieldType />
    @foreach (var objectType in assignedObjectTypes)
    {
        <MudCheckBox T=bool Label="@objectType.Key.ToString()" ValueChanged="@((bool val)=>{ToggleObjectType(val, objectType.Key);})" />

    }
</MudForm>
@code {
    private readonly CustomActiveDirectoryField newField = new();



    private readonly Dictionary<ActiveDirectoryObjectType, bool> assignedObjectTypes = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Modal.SetOnYes(Add);
        Modal.SetYesText(AppLocalization[Lang.Add]);
        foreach (var objectType in Enum.GetValues<ActiveDirectoryObjectType>().Where(ot => ot != ActiveDirectoryObjectType.All))
        {
            assignedObjectTypes.Add(objectType, false);
        }
    }
    [Parameter]
    public EventCallback<CustomActiveDirectoryField> FieldCreated { get; set; }

    async Task Add()
    {
        if (Context != null)
        {
            try
            {
                
                Context.CustomActiveDirectoryFields.Add(newField);
                await Context.SaveChangesAsync();
                foreach (var objectType in assignedObjectTypes)
                {
                    if (objectType.Value)
                    {
                        newField.ObjectTypes.Add(new()
                            {
                                ObjectType = objectType.Key,
                                ActiveDirectoryFieldId = newField.Id
                            });
                    }
                }
                await Context.SaveChangesAsync();

                SnackBarService.Success("Field created");
                await FieldCreated.InvokeAsync(newField);
                await StateHasChangedAsync();
                Close();

            }
            catch (Exception ex)
            {
                SnackBarService.Error(ex.Message);
            }
        }
    }
    private void ToggleObjectType(bool value, ActiveDirectoryObjectType objectType)
    {
        assignedObjectTypes[objectType] = value;
    }
}
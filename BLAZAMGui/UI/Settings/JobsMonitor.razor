@inherits AppComponentBase
@if (JobMonitor.AllJobs.Count > 0)
{

    <MudDataGrid T="IJob"
        Height="450px"
                 Dense=true
                 Virtualize="true"
                 Items="JobMonitor.AllJobs.Where(x=>!x.NestedJob).OrderByDescending(x=>x.StartTime)"
                 RowClick="ShowJobDetails"
                 RowClass="cursor-pointer">
        <Columns>
            <PropertyColumn Title="@AppLocalization[Lang.Name]" Property="x=>x.Name" />
            <PropertyColumn Title="@AppLocalization[Lang.User]" Property="x=>x.User" />
            <PropertyColumn Title="@AppLocalization[Lang.Start_Time]" Property="x=>x.StartTime" />
            <PropertyColumn Title="@AppLocalization[Lang.Steps]" Property="x=>x.Steps.Count" />
            <PropertyColumn Title="@AppLocalization[Lang.Progress]" Property="x=>x.Progress" />
                <TemplateColumn Title="@AppLocalization[Lang.Result]">
                    <CellTemplate>
                        <MudElement>@(context.Item.Result==JobResult.Passed?AppLocalization[Lang.No_errors]:context.Item.Result.ToString())</MudElement>
                    </CellTemplate>
                </TemplateColumn>
        </Columns>
    </MudDataGrid>

}

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        JobMonitor.OnUpdate += async () => { await StateHasChangedAsync(); };
    }
    private void ShowJobDetails(DataGridRowClickEventArgs<IJob> rowClickEventArgs)
    {
        var job = rowClickEventArgs.Item;
        if (job != null)
        {
            MessageService.ShowMessage<JobResultDialog>(job.ToDialogParameters(), AppLocalization[job.Name]);

        }
    }
}
@inherits AppComponentBase
@if (JobMonitor.AllJobs.Count > 0)
{

    <MudDataGrid T="IJob"
        Height="450px"
                 Dense=true
                 Virtualize="true"
                 Items="JobMonitor.AllJobs.Where(x=>!x.NestedJob).OrderByDescending(x=>x.StartTime)"
                 RowClick="ShowJobDetails"
                 RowClass="cursor-pointer">
        <Columns>
            <PropertyColumn Title="@AppLocalization["Name"]" Property="x=>x.Name" />
            <PropertyColumn Title="@AppLocalization["User"]" Property="x=>x.User" />
            <PropertyColumn Title="@AppLocalization["Start Time"]" Property="x=>x.StartTime" />
            <PropertyColumn Title="@AppLocalization["Steps"]" Property="x=>x.Steps.Count" />
            <PropertyColumn Title="@AppLocalization["Progress"]" Property="x=>x.Progress" />
                <TemplateColumn Title="@AppLocalization["Result"]">
                    <CellTemplate>
                        <MudElement>@(context.Item.Result==JobResult.Passed?AppLocalization["No errors"]:context.Item.Result.ToString())</MudElement>
                    </CellTemplate>
                </TemplateColumn>
        </Columns>
    </MudDataGrid>

}

@code {
    IJob _selectedJob;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        JobMonitor.OnUpdate += async () => { await InvokeAsync(StateHasChanged); };
    }
    private void ShowJobDetails(DataGridRowClickEventArgs<IJob> rowClickEventArgs)
    {
        var job = rowClickEventArgs.Item;
        if (job != null)
        {
            MessageService.ShowMessage<JobResultDialog>(job.ToDialogParameters(), AppLocalization[job.Name]);

        }
    }
}
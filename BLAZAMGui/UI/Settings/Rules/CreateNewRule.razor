@inherits AppComponentBase
@using BLAZAM.Database.Models.Rules
<MudTextField @bind-Value=@newRule.Name Label="@AppLocalization[Lang.Name]" />
<MudSwitch @bind-Value=newRule.Enabled Label="@AppLocalization[Lang.Enabled]" />
<MudDatePicker Clearable="true" @bind-Date=newRule.ExpirationDate Label="@AppLocalization[Lang.Expires]" />
<MudText>Trigger: @Trigger.ToString()</MudText>
    <MudDivider />
    <MudText>Filters</MudText>
    <MudStack Row="true">

        <MudStack Class="mud-width-full">
            @{
            bool first = true;
        }
        @foreach (var orFilter in newRule.Filters)
        {
            @if (!first)
            {
                <MudSpacer />
                <MudText>Or</MudText>
                <MudSpacer />
            }
            else
            {
                first = false;
            }
            <MudStack Row="true">

                <MudStack Row="true">
                    <MudStack Class="mud-width-full">
                        @foreach (var andFilter in orFilter.AndFilters)
                        {
                            <MudStack Row="true">

                                <MudText>And Filter</MudText>
                                <EditAndFitler Filter="andFilter" />
                                <MudSpacer />
                                <MudFab OnClick="@(()=>{RemoveAndFilter(orFilter,andFilter);})"
                                        Color="Color.Error"
                                        StartIcon="@Icons.Material.Filled.Remove" />
                            </MudStack>

                        }
                    </MudStack>

                </MudStack>
                <MudSpacer />

                <MudFab OnClick="@(()=>{RemoveOrFilter(orFilter);})"
                        Color="Color.Error"
                        StartIcon="@Icons.Material.Filled.Remove" />
            </MudStack>
            <MudStack Row="true">

                <MudSpacer />
                <MudFab OnClick="@(()=>{AddAndFilter(orFilter);})"
                        Color="Color.Success"
                        StartIcon="@Icons.Material.Filled.Add" />

            </MudStack>

        }
        <MudSpacer />

    </MudStack>

</MudStack>
<MudStack Row="true">

    <MudSpacer />
    <MudFab OnClick="AddOrFilter"
            Color="Color.Success"
            StartIcon="@Icons.Material.Filled.Add" />
</MudStack>



<MudDivider />
<MudText>Actions</MudText>
<MudStack Row="true">
    <MudStack>

        @foreach (var action in newRule.Actions)
        {
            <EditRuleAction Action=action />
            <MudSpacer />

            <MudFab OnClick="@(()=>{RemoveAction(action);})"
                    Color="Color.Error"
                    StartIcon="@Icons.Material.Filled.Remove" />

        }
    </MudStack>
    <MudSpacer />
    <MudFab OnClick="AddAction"
            Color="Color.Success"
            StartIcon="@Icons.Material.Filled.Add" />

</MudStack>
<AppModal>
    <NewAutomationTrigger Rule="newRule" />
</AppModal>
@code {

    [Parameter]
    public NotificationType Trigger { get; set; }
    private AutomationRule newRule = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

    }

    private void AddAndFilter(AutomationRuleOrFilter orFilter)
    {
        var newFilter = new AutomationRuleAndFilter();
        newFilter.FilterGuid = Guid.NewGuid();
        orFilter.AndFilters.Add(newFilter);
    }
    private void AddAction()
    {
        var newAction = new AutomationRuleAction();
        newAction.ActionGuid = Guid.NewGuid();
        newRule.Actions.Add(newAction);
    }
    private void RemoveAndFilter(AutomationRuleOrFilter orFilter, AutomationRuleAndFilter andFilter)
    {

        orFilter.AndFilters.Remove(andFilter);
    }

    private void RemoveAction(AutomationRuleAction action)
    {

        newRule.Actions.Remove(action);
    }

    private void AddOrFilter()
    {
        if (newRule != null)
        {
            var newFilter = new AutomationRuleOrFilter();
            newFilter.FilterGuid = Guid.NewGuid();
            newRule.Filters.Add(newFilter);
        }
    }

    private void RemoveOrFilter(AutomationRuleOrFilter orFilter)
    {
        if (newRule != null)
        {
            newRule.Filters.Remove(orFilter);
        }
    }
}
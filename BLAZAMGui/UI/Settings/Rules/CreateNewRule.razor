@inherits AppComponentBase
@using BLAZAM.Database.Models.Rules
<MudStack>
    <MudTextField T="string" Disabled="true" Label="Trigger" Value="Trigger.ToString()" />

    <MudTextField @bind-Value=@newRule.Name Label="@AppLocalization[Lang.Name]" />
    <MudSwitch @bind-Value=newRule.Enabled Label="@AppLocalization[Lang.Enabled]" />
    <MudDatePicker Clearable="true" @bind-Date=newRule.ExpirationDate Label="@AppLocalization[Lang.Expires]" />
    <MudDivider />
    <MudText Typo="Typo.h6">Filters</MudText>
    <MudStack Row="true">

        <MudStack Class="mud-width-full">
            @{
                bool first = true;
            }
            @if (newRule.Filters.Count==0){
                <MudText>These rules will be fired each time a {0} is {1}</MudText>
            }
            @foreach (var orFilter in newRule.Filters)
            {
                @if (!first)
                {
                    <MudStack Row="true" Class="my-4">
                        <MudSpacer />
                        <MudText Typo="Typo.h6">@AppLocalization[Lang.or]</MudText>
                        <MudSpacer />
                    </MudStack>
                }
                else
                {
                    first = false;
                }
                <EditRuleOrFilter Filter="orFilter" RemoveClicked="@(()=>{RemoveOrFilter(orFilter);})" />
                <MudStack Row="true">

                    <MudSpacer />
                    <MudButton OnClick="@(()=>{AddAndFilter(orFilter);})"
                    Color="Color.Success"
                    StartIcon="@Icons.Material.Filled.Add">Add And Filter</MudButton>

                </MudStack>

            }
            <MudSpacer />

        </MudStack>

    </MudStack>
    <MudStack Row="true">

        <MudSpacer />
        <MudButton OnClick="AddOrFilter"
        Color="Color.Success"
        StartIcon="@Icons.Material.Filled.Add">Add Or Filter</MudButton>
    </MudStack>



    <MudDivider />
    <MudText Typo="Typo.h6">Actions</MudText>
    <MudStack Row="true">
        <MudStack>

            @foreach (var action in newRule.Actions)
            {
                <EditRuleAction RemovedClicked="@(()=>{RemoveAction(action);})" Action=action />
                <MudSpacer />



            }
        </MudStack>
        <MudSpacer />
        <MudButton OnClick="AddAction"
        Color="Color.Success"
        StartIcon="@Icons.Material.Filled.Add">Add Action</MudButton>

    </MudStack>
</MudStack>
<AppModal>
    <NewAutomationTrigger Rule="newRule" />
</AppModal>
@code {

    [Parameter]
    public NotificationType Trigger { get; set; }
    private AutomationRule newRule = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        newRule.Actions.Add(new() { ActionGuid = Guid.NewGuid() });
    }

    private void RemoveAction(AutomationRuleAction action)
    {

        newRule.Actions.Remove(action);
    }
    private void AddAndFilter(AutomationRuleOrFilter orFilter)
    {
        var newFilter = new AutomationRuleAndFilter();
        newFilter.FilterGuid = Guid.NewGuid();
        orFilter.AndFilters.Add(newFilter);
    }
    private void AddAction()
    {
        var newAction = new AutomationRuleAction();
        newAction.ActionGuid = Guid.NewGuid();
        newRule.Actions.Add(newAction);
    }




    private void AddOrFilter()
    {
        if (newRule != null)
        {
            var newFilter = new AutomationRuleOrFilter();
            newFilter.FilterGuid = Guid.NewGuid();
            newRule.Filters.Add(newFilter);
        }
    }

    private void RemoveOrFilter(AutomationRuleOrFilter orFilter)
    {
        if (newRule != null)
        {
            newRule.Filters.Remove(orFilter);
        }
    }
}
@inherits AppModalContent
@using BLAZAM.Database.Models.Rules
@inject BLAZAM.Services.Analytics AnalyticsService
<MudForm @ref=Form Model="_workingRule">
    @if (_workingRule != null)
    {
        <MudGrid>
            <MudItem xs="6" sm="4" md="3" lg="2" xl="1">
                <MudSelectList Label="@AppLocalization[Lang.Object_Type]"
                               Values="_adObjectTypes"
                               For="@(() => _workingRule.ActiveDirectoryObjectType)"
                               @bind-Value=_workingRule.ActiveDirectoryObjectType />
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2" xl="1">
                <MudSelectList Label="@AppLocalization[Lang.Triggers]"
                               For="@(() => _workingRule.Trigger)"
                               Values="_workingRule.ActiveDirectoryObjectType.GetNotificationTypes()"
                               @bind-Value=_workingRule.Trigger />
            </MudItem>
            <MudItem xs="6" sm="4" md="6" lg="8" xl="10">
                <MudTextField @bind-Value=@_workingRule.Name
                              Immediate=true
                              For="@(() => _workingRule.Name)"
                              Label="@AppLocalization[Lang.Name]" />
            </MudItem>

        </MudGrid>
        <MudSwitch Color="Color.Success"
                   UncheckedColor="Color.Error"
                   @bind-Value=_workingRule.Enabled
                   Label="@AppLocalization[Lang.Enabled]" />

        <MudDatePicker Clearable="true"
                       @bind-Date=_workingRule.ExpirationDate
                       Label="@AppLocalization[Lang.Expires]" />
        <MudDivider Class="py-3" />

        @if (_workingRule.Trigger == NotificationType.Scheduled)
        {
            <MudText Typo="Typo.h6">@AppLocalization[Lang.Execution_Schedule]</MudText>

            <AppTooltip Text="This feature is still under construction">
                <MudSelectList T=ScheduleInterval?
                               Values="_scheduleTypes"
                               @bind-Value=Rule.ScheduleInterval
                               Disabled="true" />
            </AppTooltip>

            <MudTimePicker Editable="true"
                           MinuteSelectionStep="5"
                           ShowToolbar=true
                           Clearable="false"
                           @bind-Time=_workingRule.ScheduledRunTime
                           Label="@AppLocalization[Lang.Time]" />
            <MudDivider Class="py-3" />
        }

        <MudText Typo="Typo.h6">Filters</MudText>

        <MudStack Row="true">

            <MudStack Class="mud-width-full">
                @{
                    bool first = true;
                }
                @if (_workingRule.Filters.Count == 0)
                {
                    <MudText>
                        @AppHelpLocalization[HelpLang.Rule_No_Filter_Warning, AppLocalization[Rule.ActiveDirectoryObjectType.ToString()], AppLocalization[Rule.Trigger.ToString()]]
                    </MudText>
                }
                @foreach (var orFilter in _workingRule.Filters)
                {
                    @if (!first)
                    {
                        <MudStack Row="true" Class="my-4">
                            <MudSpacer />
                            <MudText Typo="Typo.h6">@AppLocalization[Lang.or]</MudText>
                            <MudSpacer />
                        </MudStack>
                    }
                    else
                    {
                        first = false;
                    }
                    <EditRuleOrFilter Filter="orFilter"
                                      RemoveClicked="@(()=>{RemoveOrFilter(orFilter);})" />


                }
                <MudSpacer />

            </MudStack>

        </MudStack>
        <MudStack Row="true">

            <MudSpacer />
            <MudButton OnClick="AddOrFilter"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Add">Add Or Filter</MudButton>
            <MudSpacer />

        </MudStack>

        <MudDivider />

        <MudText Typo="Typo.h6">Actions</MudText>
        <MudStack Row="true">

            <MudStack>

                @foreach (var action in _workingRule.Actions)
                {
                    <EditRuleAction RemovedClicked="@(() => { RemoveAction(action); })" Action=action />
                    <MudSpacer />
                }
            </MudStack>

            <MudSpacer />
            <MudButton OnClick="AddAction"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Add">Add Action</MudButton>

        </MudStack>
        <MudField Label="@AppLocalization[Lang.After_Executing]">
            <MudSwitch Color="Color.Error"
                       UncheckedColor="Color.Success"
                       @bind-Value=_workingRule.StopOnThisRule
                       Label=@(AppHelpLocalization[_workingRule.StopOnThisRule ? HelpLang.Stop_On_Rule : HelpLang.Continue_Processing_Rules]) />
        </MudField>
    }
</MudForm>
@code {
    [Parameter]
    public EventCallback<AutomationRule> RuleChanged { get; set; }

    [Parameter]
    public RuleViewFilter ViewFilter { get; set; }


    [Parameter]
    public AutomationRule Rule { get; set; } = new();

    private AutomationRule _workingRule;

    readonly List<NotificationType> _triggerTypes = new();
    readonly List<ActiveDirectoryObjectType> _adObjectTypes = new();
    readonly List<ScheduleInterval?> _scheduleTypes = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Modal.SetYesText(AppLocalization[Rule.Id == 0 ? Lang.Add : Lang.Save_Changes]);
        Modal.SetOnYes(SaveRule);

        if (Rule.Id == 0)
        {
            Rule.Actions.Add(new() { ActionGuid = Guid.NewGuid() });
            Rule.Trigger = ViewFilter.Trigger;
            Rule.ActiveDirectoryObjectType = ViewFilter.ObjectType;
            Rule.ScheduleInterval = ScheduleInterval.Daily;
            _workingRule = Rule;

        }
        else
        {
            Modal.SetCancelText(AppLocalization[Lang.Delete]);
            Modal.SetCancelColor(Color.Error);
            Modal.SetOnCancel(DeleteRule);
            _workingRule = await Context.AutomationRules.FirstAsync(r => r.Id.Equals(Rule.Id));
        }

        foreach (NotificationType enu in Enum.GetValues(typeof(NotificationType)))
        {
            _triggerTypes.Add(enu);
        }
        foreach (ScheduleInterval enu in Enum.GetValues(typeof(ScheduleInterval)))
        {
            _scheduleTypes.Add(enu);
        }
        foreach (ActiveDirectoryObjectType enu in Enum.GetValues(typeof(ActiveDirectoryObjectType)))
        {
            _adObjectTypes.Add(enu);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            Form?.Validate();
        }
    }


    private async Task DeleteRule()
    {
        if (await MessageService.Confirm(AppLocalization[Lang.Confirm_deletion]))
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var matchingRule = await context.AutomationRules.FirstOrDefaultAsync(r => r.Id.Equals(_workingRule.Id));
            if (matchingRule != null)
            {
                matchingRule.DeletedAt = DateTime.UtcNow;
                var result = await context.SaveChangesAsync();
                if (result > 0)
                {
                    RuleChanged.InvokeAsync(Rule);

                    SnackBarService.Success(Lang.Deleted);
                    await Modal.CloseAsync();

                    return;
                }
            }
            SnackBarService.Error(Lang.Error);
        }
    }


    private async Task SaveRule()
    {
        await UpdateFiltersAsync();
        await UpdateActionsAsync();

        var newRule = false;
        if (_workingRule.Id == 0)
        {
            Context.AutomationRules.Add(_workingRule);
            newRule = true;
            await AnalyticsService.RuleCreated(_workingRule.Name);
        }
        var result = await Context.SaveChangesAsync();
        if (result > 0)
        {
            SnackBarService.Success(AppLocalization[newRule ? Lang.Created : Lang.Changed]);
            await RuleChanged.InvokeAsync(Rule);
            await Modal.CloseAsync();
        }
        else
        {
            SnackBarService.Error(Context.LastSaveError?.Message);
        }
    }

    private async Task UpdateFiltersAsync()
    {
        if (_workingRule.Filters.Count == 0) return;

        foreach (var orFilter in _workingRule.Filters)
        {
            foreach (var andFilter in orFilter.AndFilters)
            {
                if (andFilter.Field != null)
                {
                    andFilter.FieldId = andFilter.Field.Id;
                    andFilter.Field = await Context.ActiveDirectoryFields.FirstAsync(f => f.Id == andFilter.Field.Id);
                }
                if (andFilter.CustomField != null)
                {
                    andFilter.CustomFieldId = andFilter.CustomField.Id;
                    andFilter.CustomField = await Context.CustomActiveDirectoryFields.FirstAsync(f => f.Id == andFilter.CustomField.Id);
                }
            }
        }
    }

    private async Task UpdateActionsAsync()
    {
        var actionsWithFields = _workingRule.Actions.Where(a => a.FieldValues.Count > 0);
        foreach (var action in actionsWithFields)
        {
            foreach (var fieldValue in action.FieldValues)
            {
                if (fieldValue.CurrentField is ActiveDirectoryField)
                {
                    fieldValue.CurrentField = await Context.ActiveDirectoryFields.FirstAsync(f => f.Id == fieldValue.CurrentFieldId);
                }
                else if (fieldValue.CurrentField is CustomActiveDirectoryField)
                {
                    fieldValue.CurrentField = await Context.CustomActiveDirectoryFields.FirstAsync(f => f.Id == fieldValue.CurrentFieldId);
                }
            }
        }
    }
    private void RemoveAction(AutomationRuleAction action)
    {

        _workingRule.Actions.Remove(action);
    }
    private void AddAndFilter(AutomationRuleOrFilter orFilter)
    {
        var newFilter = new AutomationRuleAndFilter();
        newFilter.FilterGuid = Guid.NewGuid();
        orFilter.AndFilters.Add(newFilter);
    }
    private void AddAction()
    {
        var newAction = new AutomationRuleAction();
        newAction.ActionGuid = Guid.NewGuid();
        _workingRule.Actions.Add(newAction);
    }




    private void AddOrFilter()
    {
        if (_workingRule != null)
        {
            var newFilter = new AutomationRuleOrFilter();

            newFilter.FilterGuid = Guid.NewGuid();
            AddAndFilter(newFilter);
            _workingRule.Filters.Add(newFilter);
        }
    }

    private void RemoveOrFilter(AutomationRuleOrFilter orFilter)
    {
        if (_workingRule != null)
        {
            _workingRule.Filters.Remove(orFilter);
        }
    }
}
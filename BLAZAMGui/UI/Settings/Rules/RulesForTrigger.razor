@using BLAZAM.Database.Models.Rules
@inherits DatabaseComponentBase


<MudDropContainer T="AutomationRule"
                  @ref=dropContainer
                  Items="rules"
                  ItemDropped="ItemDropped"
                  ItemsSelector="@((item,dropzone) => (item.DeletedAt == null))"
                  DraggingClass="mud-alert-text-warning"
                  ItemDraggingClass="mud-alert-text-warning"
                  Class="d-flex flex-wrap flex-grow-1">
    <ChildContent>
        <MudDropZone T="AutomationRule"
                     AllowReorder=true
                     DraggingClass="mud-alert-text-warning"
                     ItemDraggingClass="mud-alert-text-warning"
                     Class="rounded mud-background-gray px-4 flex-grow-1"
                     Identifier="rules">

        </MudDropZone>

    </ChildContent>
    <ItemRenderer>
        <RulePreview CompactView="CompactView"
                     Rule="context"
                     ReloadEvent="_reloadEvent"
                     EditClicked="@(()=>{ selectedRule = context;_=createRuleModal?.ShowAsync();   })" />
    </ItemRenderer>

</MudDropContainer>

<MudButton Color="Color.Primary"
           OnClick="@CreateNewRule">@AppLocalization[Lang.Create_Rule]</MudButton>



<AppModal @ref=createRuleModal
          Title="@AppLocalization[Lang.Create_Rule]"
          Options="new(){ MaxWidth=MaxWidth.Large, FullWidth=true,CloseButton=true}">
    <EditRule RuleChanged="@GetRulesAsync"
              Rule="selectedRule"
              ViewFilter="ViewFilter" />
</AppModal>

@code {
    EditRule? editRuleContent;
    MudDropContainer<AutomationRule>? dropContainer;
    [CascadingParameter]
    public RuleViewFilter ViewFilter { get; set; }

    [Parameter]
    public RulesSettings RulesSettings { get; set; }
    bool _compactView;
    [Parameter]
    public bool CompactView
    {
        get => _compactView; set
        {
            if (_compactView == value) return;
            _compactView = value;
            dropContainer.Refresh();
        }
    }
    AppEvent _reloadEvent = new();
    AppModal? createRuleModal;
    AutomationRule selectedRule = new();
    private List<AutomationRule> rules = new();




    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = GetRulesAsync();
        ViewFilter.ObjectTypeChanged += ReloadRules;
        ViewFilter.TriggerChanged += ReloadRules;
        RulesSettings.CreateRule += OnCreateNewRule;
    }

    public override void Dispose()
    {
        base.Dispose();
        ViewFilter.ObjectTypeChanged -= ReloadRules;
        ViewFilter.TriggerChanged -= ReloadRules;
        RulesSettings.CreateRule -= OnCreateNewRule;
    }

    private void ReloadRules()
    {
        _ = GetRulesAsync();
    }

    private void OnCreateNewRule()
    {
        CreateNewRule();
    }
    private void CreateNewRule()
    {
        selectedRule = new();
        selectedRule.Order = rules.Count - 1;

        _ = createRuleModal.ShowAsync();


    }
    /// <summary>
    ///
    /// </summary>
    /// <param name="rule">If null, will reload all rules</param>
    /// <returns></returns>
    public async Task GetRulesAsync(AutomationRule? rule = null)
    {
        LoadingData = true;
        Context.ChangeTracker.Clear();
        if (rule == null || !rules.Any(r => r.Id == rule.Id))
        {
            rules.Clear();
            var allrule = await Context.AutomationRules.ToListAsync();
            rules = await Context.AutomationRules.Where(r => r.Trigger == ViewFilter.Trigger && r.ActiveDirectoryObjectType == ViewFilter.ObjectType).OrderBy(r => r.Order).ToListAsync();
        }
        else
        {
            rules[rules.FindIndex(r => r.Id == rule.Id)] = await Context.AutomationRules.Where(r => r.Id == rule.Id).FirstAsync();

        }
        if (dropContainer != null)
        {
            dropContainer.Items = rules;
        }

        dropContainer?.Refresh();
        _reloadEvent.Invoke();

        LoadingData = false;
    }

    private async Task ItemDropped(MudItemDropInfo<AutomationRule>
    dropItem)
    {
        if (dropItem.Item == null) return;
        if (CurrentUser.State != null)
        {
            // Find the dropped widget
            var droppedRule = await Context.AutomationRules.FirstOrDefaultAsync(r => r.Id == dropItem.Item.Id);

            if (droppedRule != null)
            {

                // **6. Remove from the NEW slot**
                rules.Remove(droppedRule);

                // **7. Insert into the NEW slot**
                rules.Insert(dropItem.IndexInZone, droppedRule);

                // **8. Reorder widgets in the NEW slot**
                for (int i = 0; i < rules.Count; i++)
                {
                    rules[i].Order = i;
                }

                var results = await Context.SaveChangesAsync();
                if (results > 0)
                {
                    SnackBarService.Success(Lang.Changed);
                }

            }
        }

    }
}

@inherits DatabaseComponentBase
@using BLAZAM.Database.Models.Rules
<MudPaper Elevation="1" Class="pa-4 my-4">
    <MudStack>
        <MudStack Row=true>
            <MudText Typo="Typo.body2"
                     Color="Color.Tertiary"
                     Class="align-middle">@Rule.Name</MudText>
            @if (CompactView)
            {
                <MudStack Class="my-0" Row=true>

                    <MudText Typo="Typo.body2"
                             Class="align-middle">
                        Last Triggered: <DateWithTimeTooltip NullText=@AppLocalization[Lang.Never]
                                                             DateTime="@Rule.LastTriggered" />
                    </MudText>
                </MudStack>
            }
            <MudSpacer />
            <MudSwitch Label="@AppLocalization[Lang.Enabled]"
                       Color="Color.Success"
                       UncheckedColor="Color.Error"
                       Value="@Rule.Enabled"
                       ValueChanged="@(async(bool val)=>{await ChangeEnabled(Rule, val);})" />
            <AppIconButton Color="Color.Primary"
                           Icon="@Icons.Material.Filled.Edit"
                           OnClick="@(EditClicked)" />
            @* <AppIconButton Icon="@Icons.Material.Filled.CopyAll"
                           OnClick="@(CopyClicked)" /> *@

        </MudStack>
        @if (!CompactView)
        {
            <MudStack Row=true>

                <MudText Typo="Typo.body2">
                    Last Triggered: <DateWithTimeTooltip NullText=@AppLocalization[Lang.Never]
                                                         DateTime="@Rule.LastTriggered" />
                </MudText>
                <MudText Typo="Typo.body2">
                    Last Executed: <DateWithTimeTooltip NullText=@AppLocalization[Lang.Never]
                                                        DateTime="@Rule.LastExcecuted" />
                </MudText>
            </MudStack>

            <MudText Class="mt-1">
                <MudIcon Style=@($"color:{Colors.Yellow.Darken2};" )
                         Icon="@Icons.Material.Outlined.ElectricBolt" />@($"Triggers on '{AppLocalization[Rule.Trigger.ToString()]}'")
            </MudText>
            @if (Rule.Trigger == NotificationType.Scheduled)
            {
                <MudText>
                    <MudIcon Color="Color.Info"
                             Icon="@Icons.Material.Outlined.Schedule" /> At '@Rule.ScheduledRunTime.ToString()'
                </MudText>
            }
            <MudText Class="mt-2"><MudIcon Color="Color.Warning" Icon="@Icons.Material.Outlined.FilterAlt" /> If</MudText>
          
            <RulePreviewFilters Rule="Rule"/>
            
            <MudText Class="mt-2"><MudIcon Color="Color.Success" Icon="@Icons.Material.Filled.Login" /> Then</MudText>

            var firstAction = true;

            @foreach (var action in Rule.Actions)
            {
                @if (!firstAction)
                {
                    <MudText Align="Align.Center">@AppLocalization[Lang.And]</MudText>

                }
                else
                {
                    firstAction = false;
                }
                <MudStack Row=true>
                    <MudTextField T="string"
                                  ReadOnly="true"
                                  Label="@AppLocalization[Lang.Action]"
                                  Value=@action.ActionType.ToString() />

                    @if (action.Data != null)
                    {
                        <MudTextField T="string"
                                      ReadOnly="true"
                                      Label="@AppLocalization[Lang.Data]"
                                      Value=@action.Data?.ToString() />
                    }
                    @if (action.FieldValues.Count > 0)
                    {
                        <MudTextField T="string"
                                      ReadOnly="true"
                                      Label="@AppLocalization[Lang.Field]"
                                      Value=@action.FieldValues[0].CurrentField.DisplayName />
                        <MudTextField T="string"
                                      ReadOnly="true"
                                      Label="@AppLocalization[Lang.Value]"
                                      Value=@action.FieldValues[0].Value?.ToString() />
                    }
                    @if (action.GroupSids.Count > 0)
                    {
                        <MudTextField T="string"
                                      ReadOnly="true"
                                      Label="@AppLocalization[Lang.Group]"
                                      Value=@action.GroupSids.FirstOrDefault()?.GroupSid.ToString() />
                        <MudTextField T="string"
                                      ReadOnly="true"
                                      Label="@AppLocalization[Lang.Assign]"
                                      Value=@action.GroupSids.FirstOrDefault()?.Assigned.ToString() />
                    }
                </MudStack>
            }
            <MudField Label="After Executing">
                <StatusCheck Text="@AppHelpLocalization[Rule.StopOnThisRule?HelpLang.Stop_On_Rule:HelpLang.Continue_Processing_Rules]"
                             Status="@(!Rule.StopOnThisRule)" />
            </MudField>

            <MudButton Disabled="_loadingFilteredEntries"
                       Color="Color.Primary"
                       OnClick="@(()=>{_matchedPopoverOpen = !_matchedPopoverOpen;})">
                Matches: @filteredEntries.Count
            </MudButton>

            @if (_matchedPopoverOpen)
            {
                <MudStack Class="mb-4 mud-width-full">
                    @foreach (var entry in filteredEntries)
                    {
                            <MudLink Target="_blank" Href="@entry.SearchUri">
                                <SearchResult Entry="@entry" Class="mud-width-full"/>
                                </MudLink>

                    }
                </MudStack>
            }

            @if (Rule.Trigger == NotificationType.Scheduled)
            {
                <MudButton Color="Color.Primary"
                           OnClick="@(()=>{RulesProcessor.ProcessScheduledRule(Rule);})">
                    Run Now
                </MudButton>
            }
        }
    </MudStack>
</MudPaper>

@code {
    private bool _matchedPopoverOpen;
    private bool _loadingFilteredEntries;
    private List<IDirectoryEntryAdapter> filteredEntries = new();
    [Parameter]
    public AutomationRule Rule { get; set; }

    bool _compactView;
    [Parameter]
    public bool CompactView
    {
        get => _compactView; set
        {
            if (_compactView == value) return;
            _compactView = value;
            _ = InvokeAsync(StateHasChanged);
        }
    }
    [Inject]
    public RulesProcessor RulesProcessor { get; set; }

    [Parameter]
    public EventCallback EditClicked { get; set; }

    [Parameter]
    public EventCallback CopyClicked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = Task.Run(async () =>
        {


            _loadingFilteredEntries = true;
            await InvokeAsync(StateHasChanged);

            filteredEntries = RulesProcessor.GetFilteredEntries(Rule);
            _loadingFilteredEntries = false;

            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ChangeEnabled(AutomationRule rule, bool value)
    {
        rule.Enabled = value;
        using var context = await DbFactory.CreateDbContextAsync();
        var r = await context.AutomationRules.FirstAsync(r => r.Id == rule.Id);
        r.Enabled = value;
        var results = await context.SaveChangesAsync();
        if (results > 0)
        {
            SnackBarService.Success(Lang.Changed);
        }
        else
        {
            SnackBarService.Error(Lang.Error);
        }
    }
}
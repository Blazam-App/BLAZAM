@inherits DatabaseComponentBase
@using BLAZAM.Database.Models.Rules
<MudPaper Elevation="1" Class="pa-4 my-4">
    <MudStack>
        <MudStack Row=true>
            <MudText Typo="Typo.body2" Color="Color.Tertiary">@Rule.Name</MudText>
            <MudSpacer />
            <MudSwitch Label="@AppLocalization[Lang.Enabled]"
                       Color="Color.Success"
                       UncheckedColor="Color.Error"
                       Value="@Rule.Enabled"
                       ValueChanged="@(async(bool val)=>{await ChangeEnabled(Rule, val);})" />
            <AppIconButton Icon="@Icons.Material.Filled.Edit"
                           OnClick="@(EditClicked)" />
            @* <AppIconButton Icon="@Icons.Material.Filled.CopyAll"
                           OnClick="@(CopyClicked)" /> *@
        </MudStack>
        <MudStack Row=true>

        <MudText Typo="Typo.body2">Last Triggered: <DateWithTimeTooltip DateTime="@Rule.LastTriggered" /></MudText>
        <MudText Typo="Typo.body2">Last Executed: <DateWithTimeTooltip DateTime="@Rule.LastExcecuted" /></MudText>
        </MudStack>

        <MudText Class="mt-1"><MudIcon Icon="@Icons.Material.Outlined.ElectricBolt" /> Triggers on '@Rule.Trigger.ToString()'</MudText>
        <MudText Class="mt-2"><MudIcon Icon="@Icons.Material.Outlined.FilterAlt" /> If</MudText>
        @if (Rule.Filters.Count > 0)
        {
            var firstOr = true;
            @foreach (var orFilters in Rule.Filters)
            {
                @if (!firstOr)
                {
                    <MudText Align="Align.Center">@AppLocalization[Lang.Or]</MudText>
                }
                else
                {
                    firstOr = false;
                }
                <MudStack Row>

                    @if (orFilters.AndFilters.Count > 0)
                    {

                        <MudStack>
                            @{
                                var firstAnd = true;
                            }
                            @foreach (var andFilter in orFilters.AndFilters)
                            {
                                var str = andFilter.Field?.DisplayName;
                                @if (!firstAnd)
                                {
                                    <MudText Class="align-self-center" Align="Align.Center">@AppLocalization[Lang.And]</MudText>

                                }
                                else
                                {
                                    firstAnd = false;
                                }
                                <MudStack Row=true>

                                    <MudTextField T="string"
                                                  ReadOnly="true"
                                                  Label="@AppLocalization[Lang.Field]"
                                                  Value=@str />
                                    @if (andFilter.Field.FieldType != ActiveDirectoryFieldType.Boolean)
                                    {
                                        <MudTextField T="string"
                                                      ReadOnly="true"
                                                      Label="@AppLocalization[Lang.Operator]"
                                                      Value=@andFilter.Operator.ToString() />
                                        @if (andFilter.Value != null)
                                        {
                                            <MudTextField T="string"
                                                          ReadOnly="true"
                                                          Label="@AppLocalization[Lang.Value]"
                                                          Value=@andFilter.Value?.ToString() />
                                        }
                                    }
                                    <MudTextField T="string"
                                                  ReadOnly="true"
                                                  Label="@AppLocalization[Lang.Negate]"
                                                  Value=@andFilter.Negate.ToString() />
                                </MudStack>

                            }
                        </MudStack>

                    }
                </MudStack>

            }

        }
        else
        {
            <MudText>This rules will be fired each time a {0} is {1}</MudText>
        }
        <MudText Class="mt-2"><MudIcon Icon="@Icons.Material.Filled.Login" /> Then</MudText>
        @{
            var firstAction = true;
        }
        @foreach (var action in Rule.Actions)
        {
            @if (!firstAction)
            {
                <MudText Align="Align.Center">@AppLocalization[Lang.And]</MudText>

            }
            else
            {
                firstAction = false;
            }
            <MudStack Row=true>
                <MudTextField T="string"
                              ReadOnly="true"
                              Label="@AppLocalization[Lang.Action]"
                              Value=@action.ActionType.ToString() />

                @if (action.Data != null)
                {
                    <MudTextField T="string"
                                  ReadOnly="true"
                                  Label="@AppLocalization[Lang.Data]"
                                  Value=@action.Data?.ToString() />
                }
                @if (action.FieldValues.Count > 0)
                {
                    <MudTextField T="string"
                                  ReadOnly="true"
                                  Label="@AppLocalization[Lang.Field]"
                                  Value=@action.FieldValues.FirstOrDefault()?.ToString() />
                }
                @if (action.GroupSids.Count > 0)
                {
                    <MudTextField T="string"
                                  ReadOnly="true"
                                  Label="@AppLocalization[Lang.Group]"
                                  Value=@action.GroupSids.FirstOrDefault()?.GroupSid.ToString() />
                    <MudTextField T="string"
                                  ReadOnly="true"
                                  Label="@AppLocalization[Lang.Assign]"
                                  Value=@action.GroupSids.FirstOrDefault()?.Assigned.ToString() />
                }
            </MudStack>
        }
        @if (Rule.Trigger == NotificationType.Scheduled)
        {
            <MudButton Disabled="_loadingFilteredEntries" Color="Color.Primary" OnClick="@(()=>{})">Matches: @filteredEntries.Count</MudButton>
            <MudButton Color="Color.Primary" OnClick="@(()=>{RulesProcessor.ProcessScheduledRule(Rule);})">Run Now</MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    private bool _loadingFilteredEntries;
    private List<IDirectoryEntryAdapter> filteredEntries = new();
    [Parameter]
    public AutomationRule Rule { get; set; }

    [Inject]
    public RulesProcessor RulesProcessor { get; set; }

    [Parameter]
    public EventCallback EditClicked { get; set; }

    [Parameter]
    public EventCallback CopyClicked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = Task.Run(async () =>
        {


            _loadingFilteredEntries = true;
            await InvokeAsync(StateHasChanged);

            filteredEntries = RulesProcessor.GetFilteredEntries(Rule);
            _loadingFilteredEntries = false;

            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ChangeEnabled(AutomationRule rule, bool value)
    {
        rule.Enabled = value;
        using var context = await DbFactory.CreateDbContextAsync();
        var r = await context.AutomationRules.FirstAsync(r => r.Id == rule.Id);
        r.Enabled = value;
        var results = await context.SaveChangesAsync();
        if (results > 0)
        {
            SnackBarService.Success(Lang.Changed);
        }
        else
        {
            SnackBarService.Error(Lang.Error);
        }
    }
}
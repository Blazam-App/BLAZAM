@using BLAZAM.Database.Models.Rules
<MudStack Row="true">
    <FlexContainer>
        @for (int x = 0; x < Filter.AndFilters.Count; x++)
        {
                var andFilter = Filter.AndFilters[x];
            
            @if (x > 0)
            {
                <MudText Class="align-self-center" Align="Align.Center">And</MudText>

            }
            <EditAndFitler RemoveClicked="@(()=>{
                                                _=RemoveAndFilter(Filter, andFilter);
                                                })" Filter="andFilter" />
            <MudSpacer />
        }
        <MudButton OnClick="@(()=>{AddAndFilter();})"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   Style="height:max-content;"
                   StartIcon="@Icons.Material.Filled.Add">Add And Filter</MudButton>
    </FlexContainer>

    <MudSpacer />

    <MudButton OnClick="@RemoveClicked"
               Color="Color.Error"
               StartIcon="@Icons.Material.Filled.Remove">Remove Or Filter</MudButton>
</MudStack>
@code {
    [Parameter]
    public EventCallback RemoveClicked { get; set; }
    [Parameter]
    public AutomationRuleOrFilter Filter { get; set; }

    private async Task RemoveAndFilter(AutomationRuleOrFilter orFilter, AutomationRuleAndFilter andFilter)
    {

        orFilter.AndFilters.Remove(andFilter);
        await InvokeAsync(StateHasChanged);
    }
    private void AddAndFilter()
    {
        var newFilter = new AutomationRuleAndFilter();
        newFilter.FilterGuid = Guid.NewGuid();
        Filter.AndFilters.Add(newFilter);
    }
}
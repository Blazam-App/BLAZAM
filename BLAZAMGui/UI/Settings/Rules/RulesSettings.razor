@inherits AppComponentBase
<MudText Typo="Typo.h4">@AppLocalization[Lang.Rules] <AppDocumentationButton Page="/admin/settings/application" /></MudText>

<MudText>Rules is a concept for automation within Blazam. It would allow automated actions based on filtered event triggers.</MudText>

<MudGrid Class="border-1">
    <MudItem xs="12" sm="4" md="3" lg="2">
        Triggers
        <RuleTriggers @bind-SelectedTrigger=selectedTrigger/>
    </MudItem>

    <MudItem xs="12" sm="8" md="9" lg="10">
        Rules
        <RulesForTrigger Trigger="selectedTrigger"/>
    </MudItem>
</MudGrid>

@code {
    private NotificationType selectedTrigger;
}

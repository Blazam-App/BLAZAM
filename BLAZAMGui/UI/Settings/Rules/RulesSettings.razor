@inherits AppComponentBase
<MudText Typo="Typo.h4">@AppLocalization[Lang.Rules] <AppDocumentationButton Page="/admin/settings/application" /></MudText>

<MudText>Rules is a concept for automation within Blazam. It would allow automated actions based on filtered event triggers.</MudText>

<MudGrid Class="border-1">
    <MudItem xs="12" sm="4" md="3" lg="2">
        <MudStack>
            <MudCard>
                <MudText Typo="Typo.h6" Class="my-3 ps-3">Object Type</MudText>
                <MudDivider />

                <RuleObjectTypes @bind-SelectedObjectType=selectedObjectType />
            </MudCard>
            <MudCard>
                <MudText Typo="Typo.h6" Class="my-3 ps-3">Triggers</MudText>
                <MudDivider />
                <RuleTriggers @bind-SelectedTrigger=selectedTrigger SelectedObjectType=selectedObjectType />
            </MudCard>
        </MudStack>
    </MudItem>

    <MudItem xs="12" sm="8" md="9" lg="10">
        <MudCard>

            Rules
            <RulesForTrigger Trigger="selectedTrigger" />
        </MudCard>

    </MudItem>
</MudGrid>

@code {
    private NotificationType selectedTrigger{
        get;
        set;
    }
    private ActiveDirectoryObjectType _selectedObjectType;
    private ActiveDirectoryObjectType selectedObjectType
    {
        get => _selectedObjectType;
        set {
            if (_selectedObjectType == value) return;
            _selectedObjectType=value;
            if (triggerTypes.Count > 0)
            {
                if (!triggerTypes.Where(t => t.IsNotificationAppropriateForObject(_selectedObjectType)).Any(t => t.Equals(value)))
                {
                    selectedTrigger = triggerTypes.First(t => t.IsNotificationAppropriateForObject(_selectedObjectType));
                    _=InvokeAsync(StateHasChanged);
                }
            }
        }
    }
    List<NotificationType> triggerTypes = new();


    protected override void OnInitialized()
    {
        base.OnInitialized();
        foreach (NotificationType type in Enum.GetValues(typeof(NotificationType)))
        {
            triggerTypes.Add(type);
        }
        triggerTypes = triggerTypes.OrderBy(t => t.ToString()).ToList();

    }
}

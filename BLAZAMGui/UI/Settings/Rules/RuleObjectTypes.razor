@inherits AppComponentBase
<MudList Color="Color.Tertiary"
         Dense=true
         T="ActiveDirectoryObjectType"
         @bind-SelectedValue=SelectedObjectType>
    @foreach (var objectType in objectTypes)
    {
        <MudListItem Icon="@objectType.TypeIcon()" Value="objectType">@AppLocalization[objectType.ToString()]</MudListItem>
    }
</MudList>


@code {
    private ActiveDirectoryObjectType _selectedObjectType;
    [Parameter]
    public ActiveDirectoryObjectType SelectedObjectType
    {
        get => _selectedObjectType; set
        {
            if (_selectedObjectType == value) return;
            _selectedObjectType = value;
            SelectedObjectTypeChanged.InvokeAsync(value);


        }
    }

    [Parameter]
    public EventCallback<ActiveDirectoryObjectType> SelectedObjectTypeChanged { get; set; }

    private List<ActiveDirectoryObjectType> objectTypes = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        foreach (ActiveDirectoryObjectType type in Enum.GetValues(typeof(ActiveDirectoryObjectType)))
        {
            objectTypes.Add(type);
        }
        objectTypes = objectTypes.OrderBy(t => t.ToString()).ToList();
        SelectedObjectType = objectTypes.First();
    }
}
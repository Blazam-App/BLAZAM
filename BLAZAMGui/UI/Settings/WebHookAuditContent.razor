 @inherits DatabaseComponentBase
<MudDataGrid Virtualize=true
             Height="600px"
             ColumnResizeMode="ResizeMode.Container"
             FixedHeader=true
             Hideable=true
             Items="@_attempts.OrderByDescending(ae=>ae.LastAttemptTimestamp)"
             Filterable="true"
             SortMode="@SortMode.Multiple"
             Groupable="false">
    <Columns>
        <TemplateColumn Title=@AppLocalization[Lang.Message_Id]
                        Filterable="true"
                        Sortable="true"
                        SortBy="x=>x.MessageGuid">
            <CellTemplate>
                <MudText>
                    @context.Item.MessageGuid.ToString()
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title=@AppLocalization[Lang.Last_Attempt_Timestamp]
                        Filterable="true"
                        Sortable="true"
                        SortBy="x=>x.LastAttemptTimestamp">
            <CellTemplate>
                <MudText>
                    @context.Item.LastAttemptTimestamp.ToLocalTime()
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Uri" />
        <TemplateColumn Title=@AppLocalization[Lang.Delivered]
                        Filterable="true"
                        Sortable="true"
                        SortBy="x=>x.Delivered">
            <CellTemplate>
                <StatusCheck Status="context.Item.Delivered" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title=@AppLocalization[Lang.Event_Timestamp]
                        Filterable="true"
                        Sortable="true"
                        SortBy="x=>x.EventTimestamp">
            <CellTemplate>
                <MudText>
                    @context.Item.EventTimestamp.ToLocalTime()
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Title=@AppLocalization[Lang.Response_Code]
                        Property="x => x.ResponseCode"
                        Sortable="true" />
        <PropertyColumn Title=@AppLocalization[Lang.Error_Message]
                        Property="x => x.ResponseMessage" />
        <PropertyColumn Title=@AppLocalization[Lang.Retry_Count]
                        Property="x => x.RetryCount"
                        Sortable="true" />

    </Columns>
</MudDataGrid>

@code {
    private List<WebHookAttempt> _attempts = new();
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = GetAttempts();
    }
    private async Task GetAttempts()
    {
        _attempts = await Context.WebHookAttempts.ToListAsync();
        await StateHasChangedAsync();
    }
}


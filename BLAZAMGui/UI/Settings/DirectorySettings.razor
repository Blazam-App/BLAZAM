@inherits SettingsComponents



<MudText Typo="Typo.h4">@AppLocalization[Lang.Active_Directory_Settings] <AppDocumentationButton Page="/admin/settings/activeDirectory/" /></MudText>

<MudForm @ref=Form @bind-IsValid="IsValid">
    <MudGrid>

        <MudItem xs=12 lg="9">

            <MudStack Spacing="5">
                <SettingsField Label="@AppLocalization[Lang.Server]">



                        <MudTextField Label="@AppLocalization[Lang.Server]"
                                      AutoFocus=true
                                      Immediate=true
                                      HelperText="Can be your domain name in most environments"
                                      For="(() => settings.ServerAddress)"
                                      @bind-Value="@(settings.ServerAddress)"/>


                </SettingsField>
                <SettingsField Label="@AppLocalization[Lang.Port]">



                    @*
                    TODO Add this as a popover
                    <AppTooltip Display="Display.InlineBlock" Multiline Style="max-width:300px" Text="The application will automatically use an SSL
                    connection if the server's CA Certificate is a trusted CA on this web server. Using port 636 can work,
                    but may lead to unexpected behaviour of other services that listen to Active Directory changes.">
                    <MudIcon Icon="IconName.QuestionCircle" Color="Color.Info" />
                    </AppTooltip>*@

                  

                        <MudNumericField Immediate=true
                                         Label="@AppLocalization[Lang.Port]"
                                         HideSpinButtons="true"
                                         For="(() => settings.ServerPort)"
                                         @bind-Value="@settings.ServerPort" />









                </SettingsField>



                <SettingsField Label="@AppLocalization[Lang.Username]">


                    <MudTextField For="(() => settings.Username)"
                                  Immediate=true
                                  Label="@AppLocalization[Lang.Username]"
                                  name="username"
                                  @bind-Value="@settings.Username">



                    </MudTextField>

                </SettingsField>



                <SettingsField Label="@AppLocalization[Lang.Password]">

                    <MudTextField For="(() => settings.Password)"
                                  Immediate=true
                                  Label="@AppLocalization[Lang.Password]"
                                  name="password"
                                  InputType="InputType.Password"
                                  @bind-Value="@settings.Password">



                    </MudTextField>

                </SettingsField>



                <SettingsField Label="@AppLocalization[Lang.Use_TLS]">

                    <MudSwitch For="(() => settings.UseTLS)"
                               Color="Color.Success"
                               Label="@AppLocalization[Lang.Use_TLS]"
                               @bind-Value="@settings.UseTLS" />

                </SettingsField>



                <SettingsField Label="@AppLocalization[Lang.FQDN]">

                    <MudTextField For="(() => settings.FQDN)"
                                  Immediate=true
                                  Label="@AppLocalization[Lang.FQDN]"
                                  name="fqdn"
                                  @bind-Value="@settings.FQDN" />

                </SettingsField>



                <SettingsField Label="@AppLocalization[Lang.Base_DN]">

                    <MudTextField For="(() => settings.ApplicationBaseDN)"
                                  Immediate=true
                                  Label="@AppLocalization[Lang.Base_DN]"
                                  name="baseDN"
                                  @bind-Value="@settings.ApplicationBaseDN" />

                </SettingsField>


                <SettingsField>

                    <MudButton Disabled="!IsValid"
                               OnClick="Save"
                               Color="Color.Success">
                        @AppLocalization[Lang.Save_Changes]
                    </MudButton>

                </SettingsField>
            </MudStack>
        </MudItem>
        @if (ShowStatusPanel)
        {
            <MudItem xs=12 lg="3">


                <ActiveDirectoryStatusPanel @ref=statusPanel />

            </MudItem>
        }
    </MudGrid>



</MudForm>
@code {

    ADSettings settings = new ADSettings();
    ActiveDirectoryStatusPanel? statusPanel;
    bool _insert;

    [Parameter]
    public bool ShowStatusPanel { get; set; } = true;
    string passwordInDb;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        originalSettings = await Context.ActiveDirectorySettings.AsNoTracking().FirstOrDefaultAsync();

        var set = await Context.ActiveDirectorySettings.FirstOrDefaultAsync();
        if (set != null)
        {
            settings = set;
            passwordInDb = settings?.Password;

        }
        else
        {
            settings.Id = 1;
            _insert = true;
        }
        LoadingData = false;

    }
    protected override async Task Save()
    {

        if (!settings.Password.Equals(passwordInDb))
        {
            settings.Password = settings.Password.Encrypt();
            passwordInDb = settings.Password;
        }
        if (_insert)
        {
            Context.ActiveDirectorySettings.Add(settings);
            _insert = false;
        }
        await AuditLogger.System.SettingsChanged("Active Directory", settings.GetChanges(originalSettings));
        await base.Save();
        await SettingsSaved.InvokeAsync();
        if (ShowStatusPanel)
        {
            statusPanel?.RefreshStatuses();
        }

    }

}





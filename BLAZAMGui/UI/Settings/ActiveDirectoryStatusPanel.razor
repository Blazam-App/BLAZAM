@using System.DirectoryServices;
@inherits AppComponentBase
<MudCard Class="ma-5 mx-auto pa-3">
    <MudCardHeader>
        <MudText Class="w-100"
        Align="Align.Center"
        Typo="@Typo.h6">
            @AppLocalization[Lang.Active_Directory_Connection_Status]
        </MudText>
    </MudCardHeader>

    <MudGrid Spacing="0" Class="mx-auto mud-container-maxwidth-xs">
        <MudItem xs="8">
            @AppLocalization[Lang.Server_Port_Open]
        </MudItem>
        <MudItem xs="4">
            <StatusCheck Status="_portStatus" />
        </MudItem>

        <MudItem xs="8">
            @AppLocalization[Lang.Credentials_OK]

        </MudItem>
        <MudItem xs="4">
            <StatusCheck Status="_credStatus" />
        </MudItem>

        <MudItem xs="8">
            @AppLocalization[Lang.Connected]
        </MudItem>
        <MudItem xs="4">
            <StatusCheck Status="Directory.Status==DirectoryConnectionStatus.OK" />
        </MudItem>


        <MudItem xs="8">
            @AppLocalization[Lang.Connection_Type]
        </MudItem>
        <MudItem xs="4">
            <StatusCheck Status=@GetConnectionTypeStatus()
            Text="@GetConnectionType()" />
        </MudItem>
    </MudGrid>
    @if (Directory.Status != DirectoryConnectionStatus.OK && Directory.Status != DirectoryConnectionStatus.Connecting)
    {
        <MudChip Color="Color.Warning" Size="Size.Small" T="string" Text="@AppLocalization[Directory.Status.ToString()]" />
    }
    @if (Directory.ConnectionException != null)
    {
        var exception = Directory.ConnectionException;

        <MudAlert Severity="Severity.Error">

            <MudText Inline="false">@AppLocalization[Lang.Error]:</MudText>
            <br />
            <MudText Inline="false" Class="mt-3" Typo="Typo.caption">@exception.Message</MudText>

            @if (exception is DirectoryServicesCOMException comException)
            {
                <br />

                <br />
                <MudText Inline="false" Class="mt-3" Typo="Typo.caption">@comException.ExtendedErrorMessage</MudText>
            }
        </MudAlert>
    }
    <MudButton OnClick="@(RefreshStatuses)"
    Color="Color.Primary">
        @AppLocalization[Lang.Refresh]
    </MudButton>
    @if (showProgress)
    {
        <MudStack Row=true>
            <MudProgressLinear Indeterminate=true />

        </MudStack>
    }

</MudCard>

@code {
    #nullable disable warnings

    [Parameter]
    public EventCallback DirectoryConnected { get; set; }

    bool _monitoring = false;
    bool _portStatus;
    bool? _credStatus=null;
    bool showProgress = true;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        ResetStatus();
        Directory.OnStatusChanged += (async (state) => { await UpdateStatus(state); });
        UpdateStatus(null);

    }
    public override void Dispose()
    {
        base.Dispose();
        _monitoring = false;
    }
    public async Task RefreshStatuses()
    {
        await Directory.CancelConnection();
        ResetStatus();
        _ = Directory.ConnectAsync();
    }
    public void ResetStatus()
    {
        //Directory = DirectoryFactory.CreateActiveDirectoryContext();
        Directory.ConnectAsync();
        _portStatus = false;
        _credStatus = null;
        showProgress = true;
        StateHasChanged();
    }


    public async Task UpdateStatus(object? state)
    {
        await Task.Run(async () =>
        {
            if (_monitoring == false)
            {
                _monitoring = true;
                while (_monitoring == true)
                {

                    if (Directory.Status == DirectoryConnectionStatus.Connecting)
                    {
                        showProgress = true;
                        await InvokeAsync(StateHasChanged);

                    }

                    if (Directory.PortOpen)
                    {
                        _portStatus = true;
                        await InvokeAsync(StateHasChanged);
                        if (Directory.Status == DirectoryConnectionStatus.OK)
                        {
                            _credStatus = true;

                            showProgress = false;
                            // Directory.DomainControllers.ForEach(async dc =>
                            // {
                            //     try
                            //     {
                            //         if (dc.Domain != null)
                            //         {
                            //             if (dc.Domain.DomainMode != null)
                            //             {
                            //                 _domain = dc.Domain;
                            //             }
                            //         }
                            //     }catch(Exception ex)
                            //     {
                            //         Loggers.ActiveDirectryLogger.Information("Unable to contact domain from domain controller. {@Error}", ex);
                            //     }
                            // });

                            await InvokeAsync(DirectoryConnected.InvokeAsync);

                        }
                        else
                        {
                            _credStatus = false;
                        }
                    }
                    else
                    {
                        _portStatus = false;
                    }


                    if (Directory.Status == DirectoryConnectionStatus.Connecting)
                    {
                        showProgress = true;

                    }
                    else
                    {

                        showProgress = false;
                    }

                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000);
                }
            }

        });

    }
    private bool? GetConnectionTypeStatus()
    {
        if (Directory.Status != DirectoryConnectionStatus.OK) return false;
        if (Directory.AppRootDirectoryEntry == null) return false;
        var authType = Directory.AppRootDirectoryEntry.AuthenticationType;
        if (authType.Equals(AuthenticationTypes.Encryption) ||
            authType.Equals(AuthenticationTypes.SecureSocketsLayer) ||
            authType.Equals(AuthenticationTypes.Secure)) return true;
        return authType.Equals(AuthenticationTypes.Secure | AuthenticationTypes.SecureSocketsLayer);
    }
    private string? GetConnectionType()
    {

        if (Directory.Status != DirectoryConnectionStatus.OK) return null;
        return Directory.AppRootDirectoryEntry?.AuthenticationType.ToString();
    }
}

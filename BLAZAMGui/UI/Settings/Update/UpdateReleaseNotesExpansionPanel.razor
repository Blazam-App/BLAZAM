@using BLAZAM.Update
@inherits AppComponentBase
<MudExpansionPanels Elevation=0>
    <MudExpansionPanel @bind-Expanded=_expanded Text="@AppLocalization[Lang.Release_Notes]">
        @if (_expanded)
        {
            <AppMarkdown Value="@Update.Release.ReleaseNotes" />
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter]
    public ApplicationUpdate Update { get; set; }

    private bool _expanded;

    
}
@using BLAZAM.Update;
@using System.Security.Principal;
@inherits SettingsComponents



<MudText Typo="Typo.h4">@AppLocalization[Lang.Update_Settings] <AppDocumentationButton Page="/update/auto/" /></MudText>
<MudForm @onsubmit="Save">
    <MudStack Spacing="5">

        @if (settings != null)
        {

            if (updateCredential.HasValue)
            {
                @switch (updateCredential.Value)
                {
                    case UpdateCredential.Application:
                        <MudAlert Icon="@Icons.Material.Filled.Warning" Class="mud-alert-filled-warning">
                            @AppHelpLocalization[HelpLang.Update_Credential_Is_Application]
                        </MudAlert>
                        break;
                    case UpdateCredential.Active_Directory:
                        <MudAlert Icon="@Icons.Material.Filled.Check" Class="mud-alert-filled-success">
                            @AppHelpLocalization[HelpLang.Update_Credential_Is_AD]
                        </MudAlert>

                        break;
                    case UpdateCredential.Custom:
                        <MudAlert Icon="@Icons.Material.Filled.Check" Class="mud-alert-filled-success">
                            @AppHelpLocalization[HelpLang.Update_Credential_Is_Custom]
                        </MudAlert>

                        break;
                    case UpdateCredential.None:
                        <MudAlert Icon="@Icons.Material.Filled.Error" Class="mud-alert-filled-error">
                            @AppHelpLocalization[HelpLang.Update_Credential_Is_Invalid]
                        </MudAlert>
                        break;


                }

            }
            if (UpdateService.IncompatibleUpdates.Count > 0)
            {
                var latestIncompatibleUpdate = UpdateService.IncompatibleUpdates.Where(x => x.Newer).OrderByDescending(x => x.Release.ReleaseTime).FirstOrDefault();
                if (latestIncompatibleUpdate != null)
                {
                    <MudAlert Icon="@Icons.Material.Filled.Error" Class="mud-alert-filled-error">
                        @AppLocalization["Unable to update!"]
                        <MudText>@(latestIncompatibleUpdate.PrequisiteMessage)</MudText>

                    </MudAlert>
                }
            }
            <SettingsField Label="@AppLocalization[Lang.Application_Credentials]">

                <MudTextField T="string"
                              Label="@AppLocalization[Lang.Application_Credentials]"
                              Disabled=true
                              Value="@Environment.UserName" />
            </SettingsField>

            <SettingsField Label="@AppLocalization[Lang.Update_Credential_Source]">

                <MudTextField T="string"
                              Label="@AppLocalization[Lang.Update_Credential_Source]"
                              Disabled=true
                              Value="@updateCredential?.ToString().Replace('_',' ')" />
            </SettingsField>

            <SettingsField Label="@AppLocalization[Lang.Update_Credentials]">

                <MudSwitch @bind-Value=@settings.UseUpdateCredentials
                           Color="Color.Success"
                           UncheckedColor="Color.Error"
                           Label="@AppLocalization[Lang.Use_Custom_Credentials]" />
                @if (settings.UseUpdateCredentials)
                {
                    <MudText>Configure custom update credentials.</MudText>

                    <MudCard>
                        <SettingsField Label="@AppLocalization[Lang.Domain]">

                            <MudTextField Label="@AppLocalization[Lang.Domain]" @bind-Value="settings.UpdateDomain" />
                        </SettingsField>

                        <SettingsField Label="@AppLocalization[Lang.Username]">

                            <MudTextField Label="@AppLocalization[Lang.Username]" @bind-Value="settings.UpdateUsername" />
                        </SettingsField>

                        <SettingsField Label="@AppLocalization[Lang.Password]">

                            <MudTextField Label="@AppLocalization[Lang.Password]"
                                          InputType="InputType.Password"
                                          @bind-Value="newUpdatePassword" />
                        </SettingsField>
                    </MudCard>
                }


            </SettingsField>
            <SettingsField Label="@AppLocalization[Lang.Update_Branch]">

                <MudSelect Label="@AppLocalization[Lang.Update_Branch]"
                           @bind-Value=@settings.UpdateBranch
                           HelperText="@AppHelpLocalization[HelpLang.Upate_Branch_Definition]">
                    @foreach (var val in updateBranches)
                    {
                        <MudSelectItem Value="@val">@val</MudSelectItem>
                    }
                </MudSelect>



            </SettingsField>



            <SettingsField Label="@AppLocalization[Lang.Update]">

                <FieldLabel>
                    <MudText>
                        @AppLocalization[Lang.Update]
                    </MudText>
                    <MudIconButton Color="Color.Primary"
                                   OnClick=@(async()=>{await appUpdateComponent!.GetLatestUpdate();})
                                   Icon="@Icons.Material.Filled.Refresh" />

                </FieldLabel>
                <ChildContent>



                </ChildContent>

            </SettingsField>

            <ManualApplicationUpdater @ref=appUpdateComponent />

            <SettingsField Label="@AppLocalization[Lang.Enable_Auto_Update]">
                <MudStack Row=true>
                    <MudSwitch Label="@AppLocalization[Lang.Enable_Auto_Update]"
                               Color="Color.Success"
                               UncheckedColor="Color.Error"
                               @bind-Value=@(settings.AutoUpdate) />
                    <AppDocumentationButton Page="/update/auto/" />

                </MudStack>

            </SettingsField>


            @if (settings.AutoUpdate)
            {
                <SettingsField Label="@AppLocalization[Lang.Auto_Update_Time]">

                    <MudTimePicker HelperText=@AppHelpLocalization[HelpLang.Auto_Update_Time_Definition]
                                   @bind-Time="@settings.AutoUpdateTime" />


                </SettingsField>


            }

        }
        <SettingsField>

            <MudButton Disabled="SaveDisabled"
                       ButtonType="ButtonType.Submit"
                       Color="Color.Success">
                @AppLocalization[Lang.Save_Changes]
            </MudButton>

        </SettingsField>

        <LoadingData Loading=LoadingData />
    </MudStack>
</MudForm>
@code {
    string? newUpdatePassword;
    string? updatePasswordInDb;
    UpdateCredential? updateCredential = null;
    ManualApplicationUpdater? appUpdateComponent;
    AppSettings? settings = new AppSettings();
    readonly List<string> updateBranches = new() { ApplicationReleaseBranches.Net8ReleasePrefix, ApplicationReleaseBranches.NightlyPrefix, ApplicationReleaseBranches.DevPrefix, ApplicationReleaseBranches.Net10ReleasePrefix };
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Context != null)
        {
            originalSettings = await Context.AppSettings.AsNoTracking().FirstOrDefaultAsync();

            settings = await Context.AppSettings.FirstOrDefaultAsync();
            await StateHasChangedAsync();

            //Pull encrypted update pass and store encrypted value
            await Task.Run(() =>

            {
                updatePasswordInDb = settings?.UpdatePassword;
                newUpdatePassword = updatePasswordInDb;
                updateCredential = UpdateService.UpdateCredential;
            });


        }
        LoadingData = false;

    }

    protected override async Task Save()
    {



        if (settings != null)
        {
            if (newUpdatePassword != null && !newUpdatePassword.Equals(updatePasswordInDb))
            {
                settings.UpdatePassword = await newUpdatePassword.EncryptAsync();

                updatePasswordInDb = settings.UpdatePassword;
            }
            await base.Save();
            await AuditLogger.System.SettingsChanged("Update", settings.GetChanges(originalSettings));

        }

        await StateHasChangedAsync();

    }


}


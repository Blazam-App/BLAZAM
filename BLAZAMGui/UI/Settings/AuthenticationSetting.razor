@using BLAZAM.Services.Duo
@inherits SettingsComponents
@inject IDuoClientProvider Duo



<MudText Typo="Typo.h4">@AppLocalization[Lang.Authentication_Settings] <AppDocumentationButton Page="/admin/settings/authentication" /></MudText>

<MudForm @ref=Form
         @bind-IsValid=IsValid
         Model="settings">
    <MudStack Spacing="5">

        <SettingsField Label="@AppLocalization[Lang.Admin_Password]">

            <MudTextField Label="@AppLocalization[Lang.Admin_Password]"
                          InputType="InputType.Password"
                          @bind-Value="newAdminPassword" />
        </SettingsField>

        <SettingsField Label="@AppLocalization[Lang.Session_Timeout]">

            <MudNumericField Label="@AppLocalization[Lang.Session_Timeout]"
                             HelperText=@AppLocalization[Lang.Time_in_minutes]
                             T="int?"
                             @bind-Value="@settings.SessionTimeout" />

        </SettingsField>
        <MudDivider Class="my-6" />


        <SettingsField Label="@AppLocalization[Lang.MFA_Type]">
            <MudRadioGroup Value="settings.MFAType" ValueChanged="@((MFAType type)=>{MFATypeChanged(type);})">
                <MudRadio Value="MFAType.CiscoDuo">
                    @AppLocalization[Lang.Cisco_Duo]
                </MudRadio>
                <MudRadio Value="MFAType.GoogleAuthenticator">
                    @AppLocalization[Lang.Google_Authenticator]
                </MudRadio>

            </MudRadioGroup>


        </SettingsField>
        @if (settings.MFAType == MFAType.CiscoDuo)
        {
            <SettingsField Label="@AppLocalization[Lang.Duo_Security_MFA]">

                <StatusCheck Status=duoHealthCheckResult Text="@AppLocalization[Lang.Duo_Health_Check]" />
            </SettingsField>
            <SettingsField Label="@AppLocalization[Lang.Duo_Enabled]">

                <MudSwitch Label=@AppLocalization[Lang.Duo_Enabled]
                           T="bool" @bind-Value="@settings.DuoEnabled"
                           UncheckedColor="Color.Error"
                           Color="Color.Success"
                           Disabled=@((settings.DuoEnabled!=true && duoHealthCheckResult!=true)||(settings.DuoEnabled && settings.RequireMFA)) />

            </SettingsField>
            <SettingsField Label="@AppLocalization[Lang.Duo_Unreachable_Behavior]">

                <MudSwitch Label=@AppLocalization[settings.DuoUnreachableBehavior.ToString()]
                           T="DuoUnreachableBehavior"
                           Converter=@(new BehaviorConverter())
                           @bind-Value="@settings.DuoUnreachableBehavior"
                           UncheckedColor="Color.Error"
                           Color="Color.Success"
                           Disabled=@(duoHealthCheckResult!=true) />

            </SettingsField>
            <SettingsField Label=@AppLocalization[Lang.Duo_ClientID]>

                <MudTextField Label=@AppLocalization[Lang.Duo_ClientID] InputType="InputType.Text" @bind-Value="@settings.DuoClientId" />

            </SettingsField>
            <SettingsField Label=@AppLocalization[Lang.Duo_ClientSecret]>

                <MudTextField Label=@AppLocalization[Lang.Duo_ClientSecret] InputType="InputType.Password" @bind-Value="@settings.DuoClientSecret" />

            </SettingsField>
            <SettingsField Label=@AppLocalization[Lang.Duo_ApiHost]>

                <MudTextField Label=@AppLocalization[Lang.Duo_ApiHost] InputType="InputType.Text" @bind-Value="@settings.DuoApiHost" />

            </SettingsField>

        }


        <SettingsField Label="@AppLocalization[Lang.Force_MFA]">

            <MudSwitch Label=@AppLocalization[Lang.Force_MFA]
                       T="bool" @bind-Value="@settings.RequireMFA"
                       Disabled="settings.MFAType==MFAType.CiscoDuo && duoHealthCheckResult!=true"
                       UncheckedColor="Color.Error"
                       Color="Color.Success" />

        </SettingsField>
        <SettingsField>

            <MudButton Disabled="SaveDisabled"
                       OnClick="Save"
                       Color="Color.Success">
                @AppLocalization[Lang.Save_Changes]
            </MudButton>

        </SettingsField>

    </MudStack>

</MudForm>
@code {

    AuthenticationSettings settings = new AuthenticationSettings();
    string newAdminPassword;
    string adminPasswordInDb;
    bool? duoHealthCheckResult = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = Task.Run(async () =>
        {
            LoadingData = true;

            originalSettings = await Context.AuthenticationSettings.AsNoTracking().FirstOrDefaultAsync();

            settings = await Context.AuthenticationSettings.FirstOrDefaultAsync();

            //Pull encrypted admin pass and store encrypted value
            adminPasswordInDb = settings?.AdminPassword;
            newAdminPassword = adminPasswordInDb;
            await DoDuoHealthCheck();
            LoadingData = false;

        });


    }
    private void MFATypeChanged(MFAType type)
    {
        settings.MFAType = type;
        if (type == MFAType.CiscoDuo && !settings.DuoSettingsValid)
        {
            settings.RequireMFA = false;
        }
    }
    private async Task DoDuoHealthCheck()
    {
        duoHealthCheckResult = null;
        await StateHasChangedAsync();
        try
        {
            duoHealthCheckResult = await Duo.DoHealthCheckAsync();
        }
        catch
        {

        }
        await StateHasChangedAsync();
    }

    protected override async Task Save()
    {
        var decryptedPass = adminPasswordInDb.Decrypt<string>();
        if (!newAdminPassword.Equals(adminPasswordInDb) || decryptedPass.Equals(adminPasswordInDb))
        {

            settings.AdminPassword = newAdminPassword.Encrypt();

            adminPasswordInDb = settings.AdminPassword;

        }

        await AuditLogger.System.SettingsChanged("Authentication", settings.GetChanges(originalSettings));
        await base.Save();
        await StateHasChangedAsync();
    }

    public class BehaviorConverter : BoolConverter<DuoUnreachableBehavior>
    {

        public BehaviorConverter()
        {
            SetFunc = OnSet;
            GetFunc = OnGet;
        }

        private DuoUnreachableBehavior OnGet(bool? value)
        {
            try
            {
                return (value == true) ? DuoUnreachableBehavior.Bypass : DuoUnreachableBehavior.Block;
            }
            catch (Exception e)
            {
                UpdateGetError("Conversion error: " + e.Message);
                return default;
            }
        }

        private bool? OnSet(DuoUnreachableBehavior arg)
        {

            try
            {
                return (int)arg == 1;

            }
            catch (FormatException e)
            {
                UpdateSetError("Conversion error: " + e.Message);
                return null;
            }
        }

    }
    private bool? DuoUnreachableBehaviorConverter(DuoUnreachableBehavior val)
    {
        return (int)val == 1;
    }
}

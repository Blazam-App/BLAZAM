@inherits DatabaseComponentBase
<MudDataGrid Items="_subscriptions"
Virtualize=true
Dense="true"
Breakpoint="Breakpoint.Md">
    <Columns>

        <TemplateColumn Title="@AppLocalization["Id"]">
            <CellTemplate>
                <MudText Class="px-6">
                    @context.Item.Id
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        @foreach (var type in Enum.GetValues(typeof(NotificationType)))
        {
            var originalEnum = (NotificationType)type;
            <TemplateColumn Title="@AppLocalization[originalEnum.ToString()]">
                <CellTemplate>
                    <MudSwitch Value="@(context.Item.NotificationTypes.FirstOrDefault(x=>x.NotificationType==originalEnum)!=null)"
                    Color="Color.Success"
                    UncheckedColor="Color.Error"
                    ValueChanged=@((bool val)=>{ToggleType(context.Item,originalEnum,val);}) />
                </CellTemplate>
            </TemplateColumn>

        }
        <TemplateColumn Title="@AppLocalization[Lang.HTTP_Method]">
            <CellTemplate>
                <MudSelect @bind-Value=context.Item.WebHookMethod>
                    @* <MudSelectItem Value="WebHookMethod.GET">GET</MudSelectItem> *@
                    <MudSelectItem Value="WebHookMethod.POST">POST</MudSelectItem>
                </MudSelect>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Style="min-width:100px" Title="@AppLocalization[Lang.URL]">
            <CellTemplate>
                <MudTextField T="string" @bind-Value=context.Item.URL />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization[Lang.Ignore_SSL_Verification]">
            <CellTemplate>
                <MudSwitch Color="Color.Warning"
                T="bool" @bind-Value=context.Item.IgnoreSSLVerification />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization[Lang.Authorization_Type]">
            <CellTemplate>
                <MudSelect @bind-Value=context.Item.WebHookAuthorization>
                    <MudSelectItem Value="WebHookAuthorization.None">@AppLocalization[Lang.None]</MudSelectItem>
                    <MudSelectItem Value="WebHookAuthorization.Basic">Basic</MudSelectItem>
                    <MudSelectItem Value="WebHookAuthorization.Bearer">Bearer</MudSelectItem>
                </MudSelect>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@AppLocalization[Lang.Authorization_Token]">
            <CellTemplate>

                <MudTextField Disabled="context.Item.WebHookAuthorization==WebHookAuthorization.None" T="string" @bind-Value=context.Item.AuthorizationToken />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization[Lang.Last_Message_Status]">
            <CellTemplate>
                <LastMessageStatus Subscription="context.Item" />
                @* <StatusCheck StatusFunc="(()=>{return GetLastMessageStatus(context.Item);})"/> *@
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization[Lang.Delete]">
            <CellTemplate>

                <MudFab StartIcon="@Icons.Material.Filled.Delete"
                Color="Color.Error"
                Size="Size.Small"
                IconSize="Size.Small"
                OnClick="@(async()=>{await Delete(context.Item);})" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AppLocalization[Lang.Save]">
            <CellTemplate>

                <MudFab StartIcon="@Icons.Material.Filled.Save"
                Size="Size.Small"
                IconSize="Size.Small"
                Color="Color.Success"
                OnClick="Save" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>@AppLocalization["There are no Webhook subscriptions."]</MudText>
    </NoRecordsContent>
</MudDataGrid>
<AppTooltip Text="@AppLocalization["Add new subscription"]">
    <MudFab StartIcon="@Icons.Material.Filled.Add"
    Class="right mt-5"
    Color="Color.Success"
    OnClick="@(()=>{webhookModal?.ShowAsync();})" />
</AppTooltip>
<AppModal @ref=webhookModal
Options="new(){ CloseButton=true, MaxWidth=MaxWidth.Medium}"
Title="@AppLocalization["Add new Webhook Subscription"]">
    <NewWebHookModalContent OnCreateNewSubscription="AddSubscription" />
</AppModal>

@code {
    AppModal? webhookModal;
    [Parameter]
    public AppUser User { get; set; }
    Analytics Analytics;
    private List<WebHookSubscription> _subscriptions = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Analytics = new Analytics(DbFactory, JS);
        _ = GetSubscriptions();
    }
    private async Task AddSubscription(WebHookSubscription _newSubscription)
    {
        try
        {
            Context.WebHookSubscriptions.Add(_newSubscription);
            await Context.SaveChangesAsync();

            await Analytics.WebhookCreated(_newSubscription.URL); // Or _newSubscription.Id.ToString() if preferred

            await GetSubscriptions();
        }
        catch (Exception ex)
        {
            Loggers.SystemLogger.Warning(ex, "Error while adding webhook subscription");
            SnackBarService.Error(ex.Message);
        }
    }
    private async Task<bool> GetLastMessageStatus(WebHookSubscription sub)
    {
        using var dbContext = await DbFactory.CreateDbContextAsync();
        var lastAttempt = await dbContext.WebHookAttempts
                                        .Where(x => x.WebHookSubscriptionId == sub.Id)
                                        .OrderByDescending(x => x.LastAttemptTimestamp)
                                        .FirstOrDefaultAsync();
        if (lastAttempt != null)
        {
            return lastAttempt.Delivered;
        }
        return false;
    }
    private async Task Save()
    {
        try
        {
            await Context.SaveChangesAsync();
            SnackBarService.Success(AppLocalization["Changes saved successfully"]);

            await GetSubscriptions();
        }
        catch (Exception ex)
        {
            Loggers.SystemLogger.Warning(ex, "Error while saving webhook subscriptions");
            SnackBarService.Error(ex.Message);
        }
    }
    private async Task Delete(WebHookSubscription subscription)
    {
        if (await MessageService.Confirm(AppLocalization["Are you sure you want to delete this webhook subscription?"]))
        {


            try
            {
                subscription.DeletedAt = DateTime.UtcNow;
                await Context.SaveChangesAsync();
                SnackBarService.Success(AppLocalization["Changes saved successfully"]);

                await GetSubscriptions();
            }
            catch (Exception ex)
            {
                Loggers.SystemLogger.Warning(ex, "Error while saving webhook subscriptions");
                SnackBarService.Error(ex.Message);
            }
        }
    }

    private async Task GetSubscriptions()
    {
        LoadingData = true;
        _subscriptions = await Context.WebHookSubscriptions.Where(x => x.DeletedAt == null)
        .Include(x => x.NotificationTypes)
        .ToListAsync();
        LoadingData = false;
    }

    private async Task ouChanged(IDirectoryEntryAdapter entry)
    {
        var ou = (IADOrganizationalUnit)entry;
        if (ou != null)
        {
            await StateHasChangedAsync();            
        }
    }
    private void ToggleType(WebHookSubscription subscription, NotificationType type, bool value)
    {
        if (!value)
        {
            subscription.NotificationTypes.RemoveAll(x => x.NotificationType == type);
        }
        else
        {
            if (!subscription.NotificationTypes.Any(x => x.NotificationType == type))
            {
                SubscriptionWebHookType notificationType = new();
                notificationType.NotificationType = type;
                subscription.NotificationTypes.Add(notificationType);
            }
        }
    }
}
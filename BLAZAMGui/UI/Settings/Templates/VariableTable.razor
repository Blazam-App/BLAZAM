<MudSimpleTable Elevation=0
                Dense=true>
    <thead>
        <tr>
            <th>@AppLocalization["Expression"]</th>
            <th>@AppLocalization[Lang.Description]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>{fn}</td>
            <td>Returns the whole first name</td>
        </tr>
        <tr>
            <td>{fn[1]} or {fi}</td>
            <td>Returns the first initial</td>
        </tr>
        <tr>
            <td>{fn:l[2]}</td>
            <td>Returns the first two characters of the first name in lower case</td>
        </tr>
        <tr>
            <td>{fn:du}</td>
            <td>Returns the whole first name with diacritics removed and in upper case. Modifiers can be chained.</td>
        </tr>
        <tr>
            <td>{ln:regex[^(.{3})(.*Jr)$]}</td>
            <td>A regex search on the last name pulling the first 3 characters and includes Jr if the last name ends in Jr</td>
        </tr>
    </tbody>
</MudSimpleTable>
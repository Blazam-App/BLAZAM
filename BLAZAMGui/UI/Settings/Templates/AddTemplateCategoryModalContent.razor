@inherits AppModalContent
<MudForm>
    <MudTextField T="string" @bind-Value=newCategory Validation="!newCategory.IsNullOrEmpty()"/>
</MudForm>
@code {
    string newCategory;

    [Parameter]
    public IEnumerable<string> Categories { get; set; }

    [Parameter]
    public EventCallback<string> CategoryAdded{ get; set; }
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Modal.OnYes = Submit;
        Modal.YesText = AppLocalization[Lang.Add];
        _=Modal.RefreshView();
    }
    private async Task Submit()
    {
        if (Categories.Contains(newCategory))
        {
            SnackBarService.Warning(AppHelpLocalization[HelpLang.Duplicate_Name_Conflict]);
        }
        await CategoryAdded.InvokeAsync(newCategory);
        
        Close();
    }
}

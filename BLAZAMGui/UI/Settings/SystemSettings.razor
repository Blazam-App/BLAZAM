@inherits SettingsComponents
<MudText Typo="Typo.h4">@AppLocalization[Lang.System_Settings]</MudText>
 <MudForm @onsubmit="Save">
    <MudStack Spacing="5">
        @if (settings != null)
        {
            <MudText Typo="Typo.h6">@AppLocalization[Lang.Manage_Web_Application]</MudText>
            <SettingsField Label="@AppLocalization[Lang.Restart_Web_Application]">

                <MudButton Color="Color.Error" Variant=Variant.Outlined OnClick=RestartApplication>@AppLocalization[Lang.Restart_Web_Application]</MudButton>


            </SettingsField>
            <SettingsField Label="@AppLocalization[Lang.Google_Analytics_ID]">
                <MudText>@AppHelpLocalization[HelpLang.GA4_Instructions]</MudText>
                <MudTextField Label="@AppLocalization[Lang.Google_Analytics_ID]"
                              @bind-Value="@settings.AnalyticsId" />

            </SettingsField>

            <SettingsField Label="@AppLocalization[Lang.Encryption_Seed_String]">

                <MudTextField Label="@AppLocalization[Lang.Encryption_Seed_String]"
                              ReadOnly=true
                              Value="@(ApplicationInfo.InDemoMode&&CurrentUser.Username=="Demo"?AppLocalization[Lang.Private]:Encryption.Instance?.KeySeedString)" />

            </SettingsField>



            <MudDivider Class="my-6" />
            <MudText Typo="Typo.h6">@AppLocalization[Lang.Data_Collection_Settings]</MudText>




            <SettingsField Label="@AppLocalization[Lang.Developer_Logs]">
                <MudText>
                    @AppHelpLocalization[HelpLang.Developer_Logs_Suggestion]
                </MudText>
                <MudSwitch Label="@AppLocalization[Lang.Enabled]"
                           UncheckedColor="Color.Error"
                           Color="Color.Success"
                           @bind-Value="@settings.SendLogsToDeveloper" />

            </SettingsField>

            <SettingsField Label="@AppLocalization[Lang.Developer_Analytics]">
                <MudText>
                    @AppHelpLocalization[HelpLang.Developer_Analytics_Suggestion]
                </MudText>
                <MudSwitch Label="@AppLocalization[Lang.Enabled]"
                           UncheckedColor="Color.Error"
                           Color="Color.Success"
                           @bind-Value="@settings.SendDeveloperAnalytics" />

            </SettingsField>
        }
        <MudDivider Class="my-6" />
        <MudText Typo="Typo.h6">@AppLocalization[Lang.Logging]</MudText>


        <SettingsField Label="@AppLocalization[Lang.Installation_Id]">

            <MudTextField ReadOnly=true Label="@AppLocalization[Lang.Installation_Id]" Value="@ApplicationInfo.InstallationId" />
        </SettingsField>

        <SettingsField Label=@AppLocalization[Lang.Logs]>


            <MudLink Href="/download/logs" Target="Target.Blank">
                <MudButton Variant=Variant.Outlined
                           Color="Color.Primary">@AppLocalization[Lang.Download_Logs]</MudButton>
            </MudLink>
            <MudText>@AppLocalization[Lang.Log_Directory]: @Loggers.LogPath</MudText>

        </SettingsField>



        <MudDivider Class="my-6" />
        <MudText Typo="Typo.h6">@AppLocalization[Lang.Resource_Usage]</MudText>


         <ViewApplicationStatistics /> 

        <MudDivider Class="my-6" />
        <MudText Typo="Typo.h6">@AppLocalization[Lang.Jobs_Monitor]</MudText>

        <JobsMonitor />


        <MudDivider Class="my-6" />

        


        <SettingsField>

            <MudButton ButtonType="ButtonType.Submit"
                       Color="Color.Success">
                @AppLocalization[Lang.Save_Changes]
            </MudButton>

        </SettingsField>
    </MudStack>
</MudForm> 
@code {

    AppSettings? settings = new AppSettings();

    protected override async Task OnInitializedAsync()
    {
        originalSettings = await Context.AppSettings.AsNoTracking().FirstOrDefaultAsync();

        settings = await Context.AppSettings.FirstOrDefaultAsync();
        LoadingData = false;
    }

    [Inject] ApplicationManager applicationManager { get; set; }


    async Task RestartApplication()
    {
        if (await MessageService.Confirm("Are you sure you want to restart the application? All connected users will be disconnected.", "Restart Application"))
        {
            if (ApplicationInfo.InDemoMode && !UserStateService.CurrentUsername.Equals("admin", StringComparison.OrdinalIgnoreCase))
            {
                SnackBarService.Warning("Restarting the application is not allowed in the demo");
                return;
            }
            applicationManager.Restart();
        }
    }

    protected override async Task Save()
    {
        _ = AuditLogger.System.SettingsChanged("Application", settings.GetChanges(originalSettings));
        await base.Save();
    }

}

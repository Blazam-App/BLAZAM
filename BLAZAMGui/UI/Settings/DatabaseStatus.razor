@using System.IO.Compression
@inherits SettingsComponents




<MudText Typo="Typo.h4">@AppLocalization[Lang.Database_Status]</MudText>
<MudForm>
    <MudStack Spacing="5">
        <MudText>@AppLocalization["To change these settings, modify appsettings.json in the application directory."]</MudText>
        <SettingsField Label="@AppLocalization[Lang.DB_Type]">
            <MudTextField Disabled=true Label="@AppLocalization[Lang.DB_Type]" Value="@Context?.ConnectionString?.DatabaseType" />
        </SettingsField>
        <SettingsField Label="@AppLocalization[Lang.Server]">
            <MudTextField Disabled=true Label="@AppLocalization[Lang.Server]" Value="@Context?.ConnectionString?.GetServerAddress()" />
        </SettingsField>
        <SettingsField Label="@AppLocalization[Lang.Port]">
            <MudTextField Disabled=true Label="@AppLocalization[Lang.Port]" Value="@Context?.ConnectionString?.GetServerPort()" />
        </SettingsField>
        <SettingsField Label="@AppLocalization[Lang.Database]">
            <MudTextField Disabled=true Label="@AppLocalization[Lang.Database]" Value="@Context?.ConnectionString?.GetDatabase()" />
        </SettingsField>
        <SettingsField Label="@AppLocalization[Lang.Export_Database]">

            <MudButton Href="/download/dbexport" Target="_blank" Color="Color.Success">@AppLocalization[Lang.Export]</MudButton>

        </SettingsField>
    </MudStack>
    <DatabaseStats />
</MudForm>
@code {

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();



        LoadingData = false;
    }

}

@inherits DatabaseComponentBase
<MudText Typo="Typo.h4">
    @AppLocalization[Lang.Manage_Notifications] <AppDocumentationButton Page="/admin/notifications" />
</MudText>

<MudAutocomplete @bind-Value=_selectedUser
MaxItems="50"
SearchFunc="SearchUsers"
T="AppUser"
Label="@AppLocalization[Lang.User]" />
@if (_selectedUser != null)
{
    <NotificaionSubscriptionEditor User=_selectedUser />
}
@code {
    IList<AppUser> Users = new List<AppUser>();
    AppUser? _selectedUser = null;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Users = await Context.UserSettings.ToListAsync();
    }
    private async Task<IEnumerable<AppUser>> SearchUsers(string value, CancellationToken token)
    {
        if (token.IsCancellationRequested) return new List<AppUser>();
        if (value == null) value = String.Empty;
        return Users.Where(x => x.Username?.Contains(value)==true).OrderBy(x => x.Username);
    }




}

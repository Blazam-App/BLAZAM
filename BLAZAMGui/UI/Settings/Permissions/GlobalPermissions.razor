@inherits SettingsComponents
<MudText Typo="Typo.h4">@AppLocalization[Lang.Global_Permission_Settings]<AppDocumentationButton Page="/admin/permissions" /></MudText>
<MudForm @ref=Form @bind-IsValid=IsValid Model="settings">
    <MudStack Spacing="5">

        <SettingsField Label="@AppLocalization[Lang.Allow_action_access_requests]">

            <MudSwitch @bind-Value=settings.AllowActionAccessRequest
                       T=bool
                       Class="mt-0"
                       Color="Color.Success"
                       Label=@AppLocalization[Lang.Allow_action_access_requests] />
        </SettingsField>
        @if (settings.AllowActionAccessRequest)
        {
            <SettingsField Label="@AppLocalization[Lang.Actions]">



                <MudStack Class="ms-4">
                    <MudSwitch Value="@globalPermissionRequestActions.Any(x => x.ObjectAction == ActiveDirectoryObjectAction.Assign)"
                               ValueChanged="@(async (bool val) => { await AddAction(ActiveDirectoryObjectAction.Assign); })"
                               Color="Color.Success">
                        @AppLocalization[Lang.Assign]
                    </MudSwitch>
                    <MudSwitch Value="@globalPermissionRequestActions.Any(x => x.ObjectAction == ActiveDirectoryObjectAction.Unassign)"
                               ValueChanged="@(async (bool val) => { await AddAction(ActiveDirectoryObjectAction.Unassign); })"
                               Color="Color.Success">
                        @AppLocalization[Lang.Unassign]
                    </MudSwitch>
                    <MudSwitch Value="@globalPermissionRequestActions.Any(x => x.ObjectAction == ActiveDirectoryObjectAction.Unlock)"
                               ValueChanged="@(async (bool val) => { await AddAction(ActiveDirectoryObjectAction.Unlock); })"
                               Color="Color.Success">
                        @AppLocalization[Lang.Unlock]
                    </MudSwitch>
                </MudStack>


            </SettingsField>
        }
        <SettingsField Label="@AppLocalization[Lang.Allow_field_access_requests]">

            <MudSwitch @bind-Value=settings.AllowFieldAccessRequest
                       T=bool
                       Class="mt-0"
                       Color="Color.Success"
                       Label=@AppLocalization[Lang.Allow_field_access_requests] />
        </SettingsField>
        @if (settings.AllowFieldAccessRequest)
        {
            <SettingsField Label="@AppLocalization[Lang.Fields]">
                <MudStack Row=true>
                    <MudSelectList T="IActiveDirectoryField"
                                   @bind-Value="@_selectedField"
                                   Values=@_allFields.Where(x => !settings.RequestableFields.Any(y => (y.Field!=null && y.Field.Equals(x))||(y.CustomField!=null && y.CustomField.Equals(x)))) />
                    <AppIconButton Icon="@Icons.Material.Filled.Add"
                                   Disabled="@(_selectedField==null)"
                                   Color="Color.Success"
                                   OnClick="@(() => { AddRequestableField(); })" />
                </MudStack>
                <MudStack>
                    @foreach (var requestableField in settings.RequestableFields)
                    {
                        <MudStack Row=true>
                            <MudText>@AppLocalization[(requestableField.Field != null ? requestableField.Field.DisplayName : requestableField.CustomField?.DisplayName)]</MudText>
                            <MudSwitch @bind-Value=requestableField.AllowEdit
                                       T=bool
                                       Class="mt-0"
                                       Color="Color.Success"
                                       Label=@AppLocalization[Lang.Editable] />
                            <AppIconButton Icon="@Icons.Material.Filled.Remove"
                                           Color="Color.Error"
                                           OnClick="@(() => { RemoveRequestableField(requestableField); })" />
                        </MudStack>
                    }
                </MudStack>
            </SettingsField>
        }
        <SettingsField Label="@AppLocalization[Lang.Allow_self_edit]">

            <MudSwitch @bind-Value=settings.AllowSelfModification
                       T=bool
                       Class="mt-0"
                       Color="Color.Success"
                       Label=@AppLocalization[Lang.Allow_self_edit] />
            @if (settings.AllowSelfModification)
            {
                <EditAccessLevel Self=true
                                 Model="selfAccessLevel" />
            }
        </SettingsField>
        <MudDivider />
        <SettingsField>
            <MudButton Disabled="@(!IsValid || (settings.AllowSelfModification && selfAccessLevel.Id == 0))"
                       OnClick="Save"
                       Color="Color.Success">
                @AppLocalization[Lang.Save_Changes]
            </MudButton>
        </SettingsField>


    </MudStack>
</MudForm>
<LoadingData Loading=LoadingData />

@code {
    IActiveDirectoryField? _selectedField;
    List<IActiveDirectoryField> _allFields = [];
    GlobalPermissionSettings settings = new GlobalPermissionSettings();
    List<GlobalPermissionRequestAction> globalPermissionRequestActions = new List<GlobalPermissionRequestAction>();
    AccessLevel selfAccessLevel = new();
    protected override async Task OnInitializedAsync()
    {
        originalSettings = await Context.GlobalPermissionSettings
        .AsNoTracking()
        .FirstOrDefaultAsync();

        var dbData = await Context.GlobalPermissionSettings
        .FirstOrDefaultAsync();

        _allFields = (await Context.ActiveDirectoryFields.ToListAsync()).Cast<IActiveDirectoryField>().ToList();
        _allFields.AddRange((await Context.CustomActiveDirectoryFields.Where(x => x.DeletedAt == null).ToListAsync()).Cast<IActiveDirectoryField>());
        _allFields = _allFields.OrderBy(x => x.DisplayName).ToList();

        if (dbData != null)
        {
            settings = dbData;
            globalPermissionRequestActions = await Context.GlobalPermissionRequestActions.ToListAsync();
        }

        var dbSelfAccessLevel = await Context.AccessLevels.FirstOrDefaultAsync(x => x.Name == AccessLevel.SelfAccessLevelName);
        if (dbSelfAccessLevel != null)
        {
            selfAccessLevel = dbSelfAccessLevel;
        }
        else
        {
            selfAccessLevel.Name = AccessLevel.SelfAccessLevelName;
        }
        LoadingData = false;

    }
    private async Task RemoveRequestableField(GlobalPermissionRequestField requestableField)
    {
        settings.RequestableFields.Remove(settings.RequestableFields.First(x => x.Id == requestableField.Id));
    }
    private async Task AddRequestableField()
    {
        if (_selectedField == null) return;
        var requestableField = new GlobalPermissionRequestField();
        if (_selectedField is ActiveDirectoryField adField)
        {
            requestableField.Field = adField;
        }
        if (_selectedField is CustomActiveDirectoryField customField)
        {
            requestableField.CustomField = customField;
        }
        settings.RequestableFields.Add(requestableField);
        _selectedField = null;
    }
    private async Task AddAction(ActiveDirectoryObjectAction action)
    {

        if (settings.AllowActionAccessRequest)
        {
            if (!await Context.GlobalPermissionRequestActions.AnyAsync(x => x.ObjectAction == action))
            {

                var requestAction = new GlobalPermissionRequestAction() { ObjectAction = action };
                if (requestAction != null)
                {
                    var ctx = await DbFactory.CreateDbContextAsync();
                    globalPermissionRequestActions.Add(requestAction);
                    await ctx.GlobalPermissionRequestActions.AddAsync(requestAction);
                    await ctx.SaveChangesAsync();
                }

            }
            else
            {
                var requestAction = await Context.GlobalPermissionRequestActions.FirstOrDefaultAsync(x => x.ObjectAction == action);
                if (requestAction != null)
                {

                    var ctx = await DbFactory.CreateDbContextAsync();

                    ctx.GlobalPermissionRequestActions.Remove(requestAction);
                    globalPermissionRequestActions.Remove(requestAction);
                    await ctx.SaveChangesAsync();

                }
            }
            await StateHasChangedAsync();
        }


    }
    protected override async Task Save()
    {
        if (settings.Id == 0)
        {
            await Context.GlobalPermissionSettings.AddAsync(settings);
        }




        await AuditLogger.System.SettingsChanged("Global Permissions", settings.GetChanges(originalSettings));
        if (Context != null)
        {
            try
            {

                var result = await Context.SaveChangesAsync();
                SnackBarService.Success("Settings have been saved");
            }
            catch (Exception ex)
            {
                SnackBarService.Error(ex.Message);

            }
            await StateHasChangedAsync();
        }
        else
        {
            SnackBarService.Success("Database not available");

        }

    }
}

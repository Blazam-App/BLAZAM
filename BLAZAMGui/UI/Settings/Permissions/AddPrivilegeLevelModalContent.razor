@inherits AppModalContent

<MudStack Row=true>

    <ADAutoComplete Label=@(AppLocalization[Lang.User] + " "+ AppLocalization[Lang.or] + " "+ AppLocalization[Lang.Group])
    SearchObjectType="ActiveDirectoryObjectType.All"
    @bind-SelectedResult=@selectedDelegate
    CustomResultsFilter="@((result)=>{
return result.ObjectType==ActiveDirectoryObjectType.User|| result.ObjectType==ActiveDirectoryObjectType.Group;
})" />




    <DynamicMudInput HelperText=@AppHelpLocalization[HelpLang.Super_User_Definition]
                     Label=@AppLocalization[Lang.Super_User]
    @bind-Value="@NewPermissionDelegate.IsSuperAdmin"
    Disabled=ApplicationInfo.InDemoMode />

</MudStack>


@code {

    IDirectoryEntryAdapter? selectedDelegate;
    [Parameter]
    public EventCallback DelegateAdded { get; set; }

    PermissionDelegate NewPermissionDelegate = new PermissionDelegate();
    public async Task AddGroup()
    {
        try
        {
            if (Context == null) return;
            if (selectedDelegate != null)
            {
                if (await Context.PermissionDelegate.AnyAsync(pd => pd.DelegateSid == selectedDelegate.SID))
                {
                    var confilctingDelegate = await Context.PermissionDelegate.Where(pd => pd.DelegateSid == selectedDelegate.SID).FirstOrDefaultAsync();
                    if (confilctingDelegate != null)
                        if (confilctingDelegate.DeletedAt == null)
                            SnackBarService.Error(AppHelpLocalization[HelpLang.Duplicate_Delegate]);
                        else
                            SnackBarService.Error(AppHelpLocalization[HelpLang.Duplicate_Deleted_Delegate]);
                    return;
                }
                NewPermissionDelegate.DelegateSid = selectedDelegate.SID;
                Context.PermissionDelegate.Add(NewPermissionDelegate);
                await Context.SaveChangesAsync();
                NewPermissionDelegate = new PermissionDelegate();
                await DelegateAdded.InvokeAsync();

                await Modal.CloseAsync();
            }
            return;
        }
        
        catch (Exception ex)
        {

            Loggers.ActiveDirectoryLogger.Error(ex,"Error attempting to add delegate {@Delegate}", selectedDelegate?.CanonicalName);
            SnackBarService.Error(AppHelpLocalization[HelpLang.Unexpected_Error_Occurred]);
        }
    }
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Modal.SetOnYes(AddGroup);
    }

}
@using BLAZAM.Database.Interfaces
@using BLAZAM.Global.Events
@inherits ValidatedForm
<MudExpansionPanel Dense Text="">
    <TitleContent>
        <MudStack Row=true>
            <MudText Typo="Typo.h6">
                @Delegate.DelegateName

            </MudText>

            <MudSwitch T=bool
                       UncheckedColor="Color.Error"
                       Color="Color.Success"
                       Label=@AppLocalization[Lang.Super_User]
                       Value="Delegate.IsSuperAdmin"
                       Disabled=true />
        </MudStack>


    </TitleContent>
    <ChildContent>
        <MudStack>
            <MudStack Row=true>
                <ADAutoComplete Label="@AppLocalization[Lang.Delgate_Name]"
                                SearchObjectType="ActiveDirectoryObjectType.All"
                                @bind-SelectedResult=@_delegateEntry
                                CustomResultsFilter="(result)=>result.ObjectType==ActiveDirectoryObjectType.User|| result.ObjectType==ActiveDirectoryObjectType.Group" />
                @*<ADGroupAutoComplete @bind-SelectedGroup="@Group"/>*@





                <MudSwitch T=bool
                           UncheckedColor="Color.Error"
                           Color="Color.Success"
                           Label=@AppLocalization[Lang.Super_User]
                           Disabled=@(ApplicationInfo.InDebugMode && UserStateService.CurrentUsername !="admin")
                           @bind-Value="Delegate.IsSuperAdmin" />




                @if (_delegateEntry is IADGroup delegateGroup)
                {
                    <MudButton Variant="Variant.Outlined"
                               OnClick="@(()=>{_groupMembersShown=true;})"
                               Color="Color.Info">
                        @AppLocalization[Lang.Show_All_Members]
                    </MudButton>

                }

                <MudButton Variant="Variant.Outlined"
                           @onclick="Save"
                           Color="Color.Success">
                    @AppLocalization[Lang.Save_Changes]
                </MudButton>

                <AppCloseButton @onclick="DeleteDelegate"
                                Tooltip=@AppLocalization[Lang.Remove]
                                Color="Color.Error" />
            </MudStack>
            <MudSwitch @bind-Value="Delegate.AllowPasswordReset"
                       UncheckedColor="Color.Error"
                       Color="Color.Success"
                       Label="@AppLocalization[Lang.Allow_password_reset]" />
            @if (Delegate.AllowPasswordReset)
            {
                <MudContainer>
                    <MudSwitch @bind-Value="Delegate.RequireEmailOnPasswordReset"
                               UncheckedColor="Color.Error"
                               Color="Color.Success"
                               Label="@AppLocalization[Lang.Required_email]" />
                    <MudStack Row=true>
                        <MudSwitch @bind-Value="Delegate.RequirePINOnPasswordReset"
                               UncheckedColor="Color.Error"
                               Color="Color.Success"
                               Label="@AppLocalization[Lang.Required_PIN]" />
            
                        @if (Delegate.RequirePINOnPasswordReset)
                        {
                            <MudNumericField @bind-Value="Delegate.MinimumPINLength"
                                             Label="@AppLocalization[Lang.Minimum_length]" />
                        }
                    </MudStack>

                    <MudSwitch @bind-Value="Delegate.RequireQAOnPasswordReset"
                               UncheckedColor="Color.Error"
                               Color="Color.Success"
                               Label="@AppLocalization[Lang.Required_QA]" />
                </MudContainer>
            }
        </MudStack>
        @if (_groupMembersShown)
        {
            <MudDivider />
            <GroupMembersPopover Group="@(_delegateEntry as IADGroup)"
                                 IncludeNested=true />

        }

    </ChildContent>
</MudExpansionPanel>


@code {
    bool _groupMembersShown;

    IDirectoryEntryAdapter? _delegateEntry;
    [Parameter]
    public PermissionDelegate Delegate { get; set; }
    [Parameter]
    public new IDatabaseContext Context { get; set; }

    [Parameter]
    public EventCallback DelegateDeleted { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _delegateEntry = Directory.FindGlobalEntryBySid(Delegate.DelegateSid);
        if (_delegateEntry != null)
        {
            if (Delegate.DelegateName != _delegateEntry.CanonicalName)
            {
                Delegate.DelegateName = _delegateEntry.CanonicalName;
                var result = await Context.SaveChangesAsync();
            }
        }
        else
        {
            Delegate.DelegateName = ("(" + Delegate.DelegateSid.ToSidString() + ")").Trim();
            var result = await Context.SaveChangesAsync();
        }
    }


    async Task DeleteDelegate()
    {
        Delegate.DeletedAt = DateTime.UtcNow;
        await Context.SaveChangesAsync();
        SnackBarService.Success(AppLocalization[Lang.Delegate_removed]);
        await DelegateDeleted.InvokeAsync();
        ApplicationEvents.PermissionsChanged.Invoke();

    }
    protected async override Task Save()
    {
        Delegate.DelegateSid = _delegateEntry.SID;
        await Context.SaveChangesAsync();
        await StateHasChangedAsync();
        _ = Analytics.PermissionDelegateChanged(_delegateEntry.ObjectType);
        ApplicationEvents.PermissionsChanged.Invoke();

    }
}

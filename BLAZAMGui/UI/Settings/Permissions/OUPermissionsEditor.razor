@inherits ValidatedForm

<MudCard>
    <MudCardHeader>
        @Node?.CanonicalName
    </MudCardHeader>
    @if (inheritedMappings.Count() > 0)
    {
        <MudExpansionPanel Text="@AppLocalization[Lang.Inherited_Permissions]">

            @foreach (var map in inheritedMappings)
            {
                <MudCard>
                    <PermissionMapEditor MappingsChanged=@InvokeMappingsChanged Map="map" ReadOnly=true />
                </MudCard>
            }
        </MudExpansionPanel>

    }
    @foreach (var map in appliedMappings)
    {
        <PermissionMapEditor MappingsChanged="InvokeMappingsChanged" Map="map" />
    }
    @if (NewMapping != null)
    {
        <PermissionMapEditor MappingsChanged="InvokeMappingsChanged" Map="NewMapping" />
    }else
    {
        <MudButton OnClick="AddNewMapping" Color="Color.Success">Add new mapping</MudButton>
    }
</MudCard>


@code {
    #nullable disable warnings

    IDirectoryEntryAdapter _node;
    [Parameter]
    public IDirectoryEntryAdapter Node
    {
        get => _node; set
        {
            if (_node == value) return;
            _node = value;
            _=OnOUChanged(_node);

        }
    }

    [Parameter]
    public EventCallback MappingsChanged{ get; set; }

    private PermissionMapping? NewMapping;
    IEnumerable<PermissionMapping> appliedMappings { get; set; } = new List<PermissionMapping>();
    IEnumerable<PermissionMapping> inheritedMappings { get; set; } = new List<PermissionMapping>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await OnOUChanged(Node);
    }

    async Task OnOUChanged(IDirectoryEntryAdapter? newOU)
    {
        if (Context != null && newOU != null)
        {
            await RefreshData();
        }
    }


    async Task InvokeMappingsChanged()
    {
        await RefreshData();
        await InvokeAsync(StateHasChanged);
        await MappingsChanged.InvokeAsync();
    }
    async Task RefreshData()
    {
        appliedMappings = Node.DirectPermissionMappings;
        inheritedMappings = Node.InheritedPermissionMappings;
        NewMapping = null;
        await InvokeAsync(StateHasChanged);
    }
    void AddNewMapping()
    {
        NewMapping = new() { OU = Node.DN };
    }
}
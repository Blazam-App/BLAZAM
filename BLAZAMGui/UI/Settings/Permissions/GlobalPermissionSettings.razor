@inherits SettingsComponents
<MudText Typo="Typo.h3">@AppLocalization["Global Permission Settings"]<AppDocumentationButton Page="/admin/permissions" /></MudText>
 <EditForm Context="editContext" OnValidSubmit="Save" Model="settings"> 
    <MudStack Spacing="5">

        <SettingsField Label="@AppLocalization["Allow access requests"]">

            <MudSwitch T=bool Class="mt-0" Label=@AppLocalization["Allow access requests"]  />

        </SettingsField>
        <SettingsField Label="@AppLocalization["Allow self edit"]">

        <MudSwitch T=bool Class="mt-0" Label=@AppLocalization["Allow self edit"] />

        </SettingsField>


    </MudStack>
</EditForm> 
<MudOverlay Visible="LoadingData" DarkBackground="true" Absolute="true">
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
</MudOverlay>


@code {
    AppSettings settings = new AppSettings();

    protected override async Task OnInitializedAsync()
    {
        originalSettings = await Context.AppSettings.AsNoTracking().FirstOrDefaultAsync();

        settings = await Context.AppSettings.FirstOrDefaultAsync();
        LoadingData = false;
        await InvokeAsync(StateHasChanged);

    }
}

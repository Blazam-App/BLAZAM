@using Microsoft.EntityFrameworkCore;

@inherits DatabaseComponentBase

<MudText Typo="Typo.h4">
    @AppLocalization[Lang.Delegates] <AppDocumentationButton Page="/admin/permissions" />
    </MudText>
<MudText>@AppHelpLocalization[HelpLang.Delegate_Definition]</MudText>
<MudText>@AppHelpLocalization[HelpLang.Delegate_Function]</MudText>

<MudStack Row=true>
    <MudTextField Placeholder=@AppLocalization[Lang.Filter_Delegates]
                  @bind-Value="@DelegateFilter" />
    <MudSpacer />
    <MudButton Color=Color.Secondary
               OnClick="(()=>{_=trashModal?.ShowAsync();})">
        <MudIcon Icon=@Icons.Material.Filled.RestoreFromTrash />
    </MudButton>
</MudStack>



@if (AllDelegates.Count > 0)
{
    var delegates = AllDelegates.Where(l => l.DeletedAt == null);
    @foreach (var pl in delegates)
    {
        <DelegateListItem Delegate="pl" 
            Context="Context" 
            DelegateDeleted="DelegatesChanged" />
    }
}

<MudButton Color=Color.Success 
OnClick="@(()=>{addGroupModal?.ShowAsync();})">
    @AppLocalization[Lang.Create_New_Delegation_Target]
</MudButton>

<AppModal @ref=@trashModal
    Title="Deleted Delegates">
    @foreach (var deleg in AllDelegates.Where(l => l.DeletedAt != null))
    {
        var model = Directory.FindGlobalEntryBySid(deleg.DelegateSid);
        <MudContainer>
            <b>@model?.ObjectType</b><br />
            <MudText>@model?.CanonicalName</MudText>
            <MudText>@deleg.DeletedAt</MudText>
            <MudButton Float="Float.End" 
            Color="Color.Primary" 
            OnClick="(async()=>{await RestoreDelegate(deleg);})">
                @AppLocalization[Lang.Restore]
        </MudButton>

        </MudContainer>
    }
</AppModal>
<AppModal @ref=@addGroupModal
          Title=@AppLocalization[Lang.Add_Delegate]
          YesText=@AppLocalization[Lang.Add]>
    <AddPrivilegeLevelModalContent DelegateAdded=@(()=>{SnackBarService.Success(AppLocalization[Lang.Delegate_added]); DelegatesChanged();}) />
</AppModal>

@{

}
@code {

    string _DelegateFilter = "";
    string DelegateFilter
    {
        get => _DelegateFilter; set
        {
            if (_DelegateFilter == value) return;
            _DelegateFilter = value;
            _ = StateHasChangedAsync();
        }
    }
    AppModal? trashModal;
    AppModal? addGroupModal;
    List<PermissionDelegate> AllDelegates { get; set; } = new List<PermissionDelegate>();
    DbSet<PermissionDelegate> settings;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();


        settings = Context.PermissionDelegate;
        await RefreshDelegates();
        await StateHasChangedAsync();

    }

    private async Task RefreshDelegates()
    {
        LoadingData = true;

        AllDelegates.Clear();
        AllDelegates = await settings.ToListAsync();
        LoadingData = false;


    }

    async Task RestoreDelegate(PermissionDelegate delegateToRestore)
    {
        delegateToRestore.DeletedAt = null;
        await Context.SaveChangesAsync();
        SnackBarService.Success(AppLocalization[Lang.Delegate_restored]);
        if (AllDelegates.Count(l => l.DeletedAt != null) < 1)
        {
            await trashModal.CloseAsync();
        }
        DelegatesChanged();
    }
    private async void DelegatesChanged()
    {

        await RefreshDelegates();
        await StateHasChangedAsync();

    }

}

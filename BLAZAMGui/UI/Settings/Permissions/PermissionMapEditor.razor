@using BLAZAM.Global.Events
@inherits ValidatedForm
@if (Mapping != null)
{

    <MudElement Class="py-3">
        <EditForm Model="Mapping" OnValidSubmit="@Save">

            @if (!ReadOnly && _permissionDelegates != null)
            {
                <MudSelectList Validation="@(_permissionDelegates.Count > 0)"
                               Values=@_permissionDelegates
                               Placeholder=@AppLocalization["Choose or Search..."]
                               T="PermissionDelegate"
                               ToStringFunc=DelegateToString
                               Label="@AppLocalization[Lang.Delegates]"
                               MultiSelection=true
                               @bind-Text=@selectedPermissionDelegateNames
                               @bind-SelectedValues=@Mapping.PermissionDelegates />



                <MudSelectList Validation="@(_permissionDelegates.Count > 0)"
                               Values=@_accessLevels
                               Placeholder=@AppLocalization["Choose or Search..."]
                               T="AccessLevel"
                               ToStringFunc="item=>item?.Name"
                               Label="@AppLocalization[Lang.Access_Levels]"
                               @bind-Text=@selectedAccessLevelNames
                               MultiSelection="true"
                               @bind-SelectedValues=@Mapping.AccessLevels />

                <MudButton Color=Color.Success
                           Disabled=SaveDisabled
                           ButtonType="ButtonType.Submit">Save Mapping</MudButton>
                <AppCloseButton OnClick="DeleteMapping"
                                Tooltip=@AppLocalization[Lang.Remove] />
            }
            else
            {
                <MudStack Row=true>
                    @if (selectedPermissionDelegateNames != null)
                    {
                        @foreach (var pd in selectedPermissionDelegateNames.Split(SELECTION_DELIMITER))
                        {
                            <MudButton Disabled="true"
                                       Color="Color.Secondary">@pd</MudButton>
                        }
                    }
                    @if (Mapping?.AccessLevels != null)
                    {
                        @foreach (var al in Mapping.AccessLevels)
                        {
                            <MudButton Disabled="true"
                                       Color="Color.Secondary">@al.Name</MudButton>
                        }
                    }
                </MudStack>
            }
        </EditForm>
    </MudElement>
}
@code {
    const string SELECTION_DELIMITER = ", ";


    [Parameter]
    public PermissionMapping? Mapping { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await RefreshData();
    }

    [Parameter]
    public EventCallback MappingsChanged { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; } = false;



    List<AccessLevel> _accessLevels;
    List<PermissionDelegate> _permissionDelegates;
    string selectedAccessLevelNames;
    string selectedPermissionDelegateNames;
    protected override async Task OnInitializedAsync()
    {
        //Wait for a database connection
        await base.OnInitializedAsync();
        LoadingData = false;
        await RefreshData();

    }
    public override void Dispose()
    {
        base.Dispose();
        _semaphore.Dispose();
    }
    private readonly SemaphoreSlim _semaphore = new SemaphoreSlim(1, 1); // Limits to 1 concurrent access

    async Task RefreshData()
    {
        if (!LoadingData)
        {
            await _semaphore.WaitAsync();
            try
            {
                if (Mapping == null) return;

                LoadingData = true;

                if (Context != null)
                {
                    if (Mapping.Id > 0 && !Context.EntityIsTracked(Mapping))
                    {
                        Mapping = await Context.PermissionMap.Include(m => m.PermissionDelegates).Where(pm => pm.Id == Mapping.Id).FirstOrDefaultAsync();
                    }
                    _accessLevels = await Context.AccessLevels.Where(x => x.DeletedAt == null && !x.Name.Equals(AccessLevel.SelfAccessLevelName)).ToListAsync();
                    _permissionDelegates = await Context.PermissionDelegate.Where(p => !p.IsSuperAdmin && p.DeletedAt == null).ToListAsync();
                    if (Mapping?.Id != 0)
                    {
                        ConcatenateStrings();
                    }
                }


            }
            finally
            {
                LoadingData = false;
                _semaphore.Release();

            }

        }

    }

    void ConcatenateStrings()
    {
        string concatenated = "";

        Mapping?.AccessLevels.Select(a => a.Name).ToList().ForEach(s =>
        {
            concatenated += s + SELECTION_DELIMITER;

        });
        if (!concatenated.IsNullOrEmpty())

            concatenated = concatenated.Substring(0, concatenated.Length - 2);

        selectedAccessLevelNames = concatenated;
        concatenated = "";
        var sids = Mapping?.PermissionDelegates.Select(a => a.DelegateSid).ToList();
        if (sids != null)
        {
            foreach (var sid in sids)
            {
                try
                {
                    concatenated += Directory.FindEntryBySID(sid)?.CanonicalName + SELECTION_DELIMITER;
                }
                catch (Exception)
                {
                    concatenated += sid.ToSidString() + SELECTION_DELIMITER;
                }
            }
        }

        if (!concatenated.IsNullOrEmpty())
            concatenated = concatenated.Substring(0, concatenated.Length - 2);

        selectedPermissionDelegateNames = concatenated;
    }

    async Task DeleteMapping()
    {
        if (await MessageService.Confirm(AppLocalization[Lang.Confirm_deletion], AppLocalization[Lang.Delete_permission_mapping]))
        {


            if (Mapping?.Id == 0)
            {
                Mapping = null;
            }

            else if (Mapping != null)
            {



                Context.PermissionMap.Remove(Mapping);
                await Context.SaveChangesAsync();
            }
            await StateHasChangedAsync();
            SnackBarService.Success("Mapping deleted");
            await MappingsChanged.InvokeAsync();
            _ = Analytics.PermissionMappingDeleted();
            ApplicationEvents.PermissionsChanged.Invoke();
        }
    }

    string? DelegateToString(PermissionDelegate deleg)
    {
        return deleg?.DelegateName;

    }
    new async Task Save()
    {
        if (Mapping?.Id == 0)
        {
            Context.PermissionMap.Add(Mapping);
            _ = Analytics.PermissionMappingCreated(Mapping.PermissionDelegates.Count());
        }
        var result = await Context.SaveChangesAsync();
        await StateHasChangedAsync();
        SnackBarService.Success("Mapping saved");
        await MappingsChanged.InvokeAsync();
        _ = Analytics.PermissionMappingChanged(Mapping?.PermissionDelegates.Count() ?? -1);
        ApplicationEvents.PermissionsChanged.Invoke();

    }
}
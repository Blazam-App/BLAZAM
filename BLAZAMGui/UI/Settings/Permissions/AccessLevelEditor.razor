@inherits DatabaseComponentBase
<MudText Typo="Typo.h4">@AppLocalization[Lang.Access_Levels] <AppDocumentationButton Page="/admin/permissions" /></MudText>
<MudText Typo="Typo.h6">
    @AppLocalization[Lang.Access_Levels]
</MudText>
<p>@AppHelpLocalization[HelpLang.Access_Level_Definition]</p>

@if (CurrentAccessLevels != null)
{
    @foreach (AccessLevel ap in CurrentAccessLevels)
    {

        <ShowAccessLevel Model="ap" />
    }
}

<MudExpansionPanel Text="@AppLocalization[Lang.Add_New_Access_Level]">

    <EditAccessLevel LevelsChanged="Update" />


</MudExpansionPanel>

@code {
    List<AccessLevel> CurrentAccessLevels = new();
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Update();

    }
    async void Update()
    {
        LoadingData = true;
        if (Context != null)
        {
            var selfAccessLevel = await Context.AccessLevels.FirstOrDefaultAsync(x => x.Name == AccessLevel.SelfAccessLevelName);
      
            CurrentAccessLevels = await Context.AccessLevels.Where(al => al.DeletedAt == null && al.Name != AccessLevel.SelfAccessLevelName).ToListAsync();
        }

            LoadingData = false;
    }
}
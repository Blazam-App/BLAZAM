@inherits AppComponentBase
@inject NotificationGenerationService NotificationGenerationService

<AppPageTitle>@AppLocalization[Lang.Confirm_Group_Creation]</AppPageTitle>

@if (Group != null)
{
    <MudCard>
        @Group.ADSPath

    </MudCard>
    <MudButton Disabled=@disableCreateGroupButton Color=Color.Success OnClick="CommitChanges">
        @AppLocalization[Lang.Create]
    </MudButton>
}
<LoadingData Loading="LoadingData" />

@code {


    private bool disableCreateGroupButton = false;

    [Parameter]
    public EventCallback<IADGroup> Confirmed { get; set; }

    [Parameter]
    public IADGroup Group { get; set; }

    async Task CommitChanges()
    {
        if (await MessageService.Confirm(AppHelpLocalization[HelpLang.Confirm_Group_Creation], AppLocalization[Lang.Create_Group]))
        {
            LoadingData = true;

            var assignTo = Group.MembersToAdd;
            disableCreateGroupButton = true;
            await StateHasChangedAsync();
            var createGroupJob = new Job(AppLocalization[Lang.Create_Group]);
            createGroupJob.StopOnFailedStep = true;
            createGroupJob.ShowJobDetailsDialog(MessageService);
            var result = await Group.CommitChangesAsync(createGroupJob);

            if (result.FailedSteps.Count == 0)
            {
                SnackBarService.Success(AppLocalization[Lang.Group_created]);
                await Confirmed.InvokeAsync(Group);
            }
            else
            {
                disableCreateGroupButton = false;
            }
            LoadingData = false;
        }
    }
}
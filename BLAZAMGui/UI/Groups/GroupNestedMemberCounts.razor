@inherits AppComponentBase
<MudText Align="Align.End">
    @AppLocalization[Lang.Nested_Members]
</MudText>
@if (LoadingData)
{
 <MudContainer Class="pt-10 align-items-end relative">
     <LoadingData Loading=LoadingData DarkBackground=false/>
 </MudContainer>
 
}
else
{
    <MudText Align="Align.End" Typo="Typo.body2">
        @AppLocalization[Lang.Members]: @Members.Count()
    </MudText>
    @if (Members.Any(m => m is IADGroup))
    {

        <MudText Align="Align.End" Typo="Typo.body2">
            @AppLocalization[Lang.Groups]: @Members.Count(m => m is IADGroup)
        </MudText>
    }
    @if (Members.Any(m => m is IADUser))
    {

        <MudText Align="Align.End" Typo="Typo.body2">
            @AppLocalization[Lang.Users]: @Members.Count(m => m is IADUser)
        </MudText>
    }
    @if (Members.Any(m => m is IADComputer))
    {

        <MudText Align="Align.End" Typo="Typo.body2">
            @AppLocalization[Lang.Computers]: @Members.Count(m => m is IADComputer)
        </MudText>
    }
    @if (Members.Any(m => m is IADPrinter))
    {

        <MudText Align="Align.End" Typo="Typo.body2">
            @AppLocalization[Lang.Printers]: @Members.Count(m => m is IADPrinter)
        </MudText>
    }
    @if (Members.Any(m => m is IADContact && m is not IADUser))
    {

        <MudText Align="Align.End" Typo="Typo.body2">
            @AppLocalization[Lang.Contacts]: @Members.Count(m => m is IADContact && m is not IADUser)
        </MudText>
    }
}
@code {
    [Parameter]
    public IADGroup Group { get; set; }

    private IEnumerable<IGroupableDirectoryAdapter> Members { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (Group != null)
        {
            Task.Run(async() =>
            {
                LoadingData = true;
                Members = await Group.GetNestedMembersAsync();
                LoadingData = false;
            });
        }
    }
}
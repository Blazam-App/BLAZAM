@inherits AppModalContent

<MudStack Row=true>
    <MudStack>
        @{
            var count = additionalGroups.Count;
            var x = 1;

        }
        <MudStack Row=true>
            <ADAutoComplete AutoFocus="true"
                            Class=""
                            Disabled=@(copyFrom!=null)
                            Label=@AppLocalization[Lang.Group_Name]
                            CustomResultsFilter="(result)=>result is IADGroup group && group.CanRead"
                            SearchObjectType="ActiveDirectoryObjectType.Group"
                            @bind-SelectedResult=@Group
                            CustomDisableFilter=@((result)=>{
                            if(result is IADGroup group && group.CanAssign){
                            return DirectoryModel.MemberOf.Contains(group) || !group.CanAssign ;
                            }
                            return true
                            ;
                            }) />
            @if (count == 0)
            {
                <MudIconButton Icon=@Icons.Material.Filled.PlusOne OnClick=@AddGroupInput />
            }

        </MudStack>

        @foreach (var group in additionalGroups)
        {

            <MudStack Row=true>
                <ADAutoComplete AutoFocus="true"
                                Class=""
                                Disabled=@(copyFrom!=null)
                                Label=@AppLocalization[Lang.Group_Name]
                                CustomResultsFilter="(result)=>result is IADGroup group && group.CanRead"
                                SelectedResult=@group.Value
                                SelectedResultChanged="@((newValue)=>{additionalGroups[group.Key]=newValue;})"
                                SearchObjectType="ActiveDirectoryObjectType.Group"
                                CustomDisableFilter=@((result)=>{
                            if(result is IADGroup group && group.CanAssign){
                            return DirectoryModel.MemberOf.Contains(group) || !group.CanAssign ;
                            }
                            return true
                            ;
                            }) />



                <MudIconButton Icon=@Icons.Material.Filled.Delete OnClick=@(()=>{additionalGroups.Remove(group.Key);}) />
                @{
                    if (count == x)
                    {
                        <MudIconButton Icon=@Icons.Material.Filled.PlusOne OnClick=@AddGroupInput />

                    }
                    x++;

                }
            </MudStack>

        }
        <MudText Class="my-3" Align="Align.Center">@AppLocalization[Lang.or]</MudText>
            <ADAutoComplete Disabled=@(Group!=null)
                            Label=@AppLocalization[Lang.Copy_Memberships_From]
                            SearchObjectType="ActiveDirectoryObjectType.All"
                            @bind-SelectedResult=@CopyFrom
                            SearchDisabled=_searchDisabled
                            CustomResultsFilter="(result)=>result is IGroupableDirectoryAdapter" />


        </MudStack>
        @if (CopyFrom != null)
    {
        <MudStack>

            @if (CopyFromMember?.MemberOf.Any(g => DirectoryModel.MemberOf.Contains(g) && g.CanRead) == true)
            {
                <MudText>@AppLocalization[Lang.Already_a_member_of]</MudText>
                <MudList T="string"
                         Dense=true
                         Style="max-height:200px;"
                         Class="overflow-auto">
                    @foreach (var group in CopyFromMember.MemberOf.Where(g => DirectoryModel.MemberOf.Contains(g) && g.CanRead))
                    {
                        <MudListItem>

                            <MudIcon Color=Color.Success Icon=@Icons.Material.Filled.PlaylistAddCheck />


                            @group.GroupName

                        </MudListItem>
                    }
                </MudList>
            }
            @if (CopyFromMember?.MemberOf.Any(g => !DirectoryModel.MemberOf.Contains(g) && g.CanRead && g.CanAssign) == true)
            {

                <MudText>@AppLocalization[Lang.Will_be_added_to]</MudText>
                <MudDataGrid Items="CopyFromMember.MemberOf.Where(g => !DirectoryModel.MemberOf.Contains(g) && g.CanRead && g.CanAssign)"
                             SelectedItems="_selectedGroups"
                             SelectOnRowClick="true">
                    <Header>
                    </Header>
                    <Columns>
                        <SelectColumn T="IADGroup" />
                        <PropertyColumn Property="g=>g.GroupName" />
                    </Columns>
                </MudDataGrid>

            }
            @if (CopyFromMember?.MemberOf.Any(g => !DirectoryModel.MemberOf.Contains(g) && g.CanRead && !g.CanAssign) == true)
            {
                <MudText>Can't assign to...</MudText>
                <MudList T="string"
                         Dense=true
                         Style="max-height:200px;"
                         Class="overflow-auto">

                    @foreach (var group in CopyFromMember.MemberOf.Where(g => !DirectoryModel.MemberOf.Contains(g) && g.CanRead && !g.CanAssign))
                    {
                        <MudListItem>



                            <MudIcon Color=Color.Error Icon="@Icons.Material.Filled.Cancel" />

                            @group.GroupName

                        </MudListItem>

                    }
                </MudList>
            }
        </MudStack>
    }
</MudStack>



@code {

    private HashSet<IADGroup>? _selectedGroups;

    /// <summary>
    /// The directory entry that we are assigning
    /// </summary>
    [Parameter]
    public IGroupableDirectoryAdapter DirectoryModel { get; set; }
    bool _searchDisabled;
    private Dictionary<int, IDirectoryEntryAdapter?> additionalGroups = new Dictionary<int, IDirectoryEntryAdapter?>();
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Modal.SetOnYes(AssignToGroup);
        Modal.SetYesText(AppLocalization[Lang.Assign]);
        Modal.Title = AppLocalization[Lang.Assign_To];
        _searchDisabled = CurrentUser.State.CanSearchDisabled(ActiveDirectoryObjectType.User);
    }


    IDirectoryEntryAdapter? copyFrom;
    IDirectoryEntryAdapter? CopyFrom
    {
        get => copyFrom; set
        {
            if (copyFrom == value) return;
            copyFrom = value;
            if (value != null)
            {
                var missingGroups = CopyFromMember.MemberOf.Where(g => !DirectoryModel.MemberOf.Contains(g) && g.CanRead && g.CanAssign).ToList();
                _selectedGroups = missingGroups.ToHashSet();
            }
        }
    }
    IGroupableDirectoryAdapter? CopyFromMember => CopyFrom as IGroupableDirectoryAdapter;
    new IDirectoryEntryAdapter Group { get; set; }
    async void AddGroupInput()
    {
        additionalGroups.Add(additionalGroups.Count, null);
        await UpdateState();
    }
    async Task AssignToGroup()
    {

        if (Group is IADGroup group)
        {
            DirectoryModel.AssignTo(group);
            if (additionalGroups.Count > 0)
            {
                foreach (var g in additionalGroups)
                {
                    if (g.Value is IADGroup gr)
                        DirectoryModel.AssignTo(gr);
                }
            }
            SnackBarService.Warning(DirectoryModel.CanonicalName + " has been assigned to the selected group(s) but changes must be saved.");
            await ModelChanged.InvokeAsync();

            Close();

        }
        if (CopyFrom != null)
        {
            foreach (var g in _selectedGroups)
            {
                DirectoryModel.AssignTo(g);

            }
            SnackBarService.Warning(DirectoryModel.CanonicalName + " has been assigned to the selected groups but changes must be saved.");
            await ModelChanged.InvokeAsync();

            Close();
        }
    }

    protected override bool IsValid => (CopyFrom != null || Group != null);

}

@inherits AppComponentBase
@if (Members != null)
{
    <MudDataGrid Elevation=0
                 Items="@Members.Where(m=>m.CanRead).OrderBy(m=>m.ObjectType).ThenBy(m=>m.CanonicalName)"
                 Filterable="false"
                 Dense=true
                 Loading=@LoadingData
                 Virtualize=true
                 Height="300px"
                 FixedHeader=true
                 SortMode="@SortMode.None"
                 Groupable="false">
        <Columns>
            <TemplateColumn Context="templateContext" Title=@AppLocalization[Lang.Type]>
                <CellTemplate Context="cellContext">
                    <DirectoryEntryTypeIcon Entry=cellContext.Item />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title=@AppLocalization[Lang.Name] Sortable=true Filterable=true Context="templateContext">
              
                <CellTemplate Context="cellContext">
                    <MudLink Href="@cellContext.Item.SearchUri">
                        @if (cellContext.Item is IADGroup group)
                        {
                            <GroupWithDescriptionTooltip Group="group" />
                        }
                        else
                        {
                            <MudElement>
                                @cellContext.Item.CanonicalName
                            </MudElement>
                        }
                    </MudLink>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable=true Filterable=true Context="templateContext">
                <HeaderTemplate>
                    @AppLocalization[Lang.OU]
                </HeaderTemplate>
                <CellTemplate Context="cellContext">
                    <MudText>
                        @cellContext.Item.OU.ToPrettyOu()
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title=@AppLocalization[Lang.Remove_Member] Context="templateContext">
                <CellTemplate Context="cellContext">
                    <AppTooltip ShowOnClick=@(!cellContext.Item.CanUnassign)
                                ShowOnHover=@(!cellContext.Item.CanUnassign)
                                Text=@AppHelpLocalization[HelpLang.Lacks_Group_Member_Remove_Permission]>
                        <MudButton Disabled=@(!Group.CanUnassign)
                                   Color="Color.Error"
                                   OnClick="(()=>{Group.UnassignMember(cellContext.Item);InvokeAsync(OnInitializedAsync);})">
                            @AppLocalization[Lang.Remove]
                        </MudButton>
                    </AppTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    <MudText Align="Align.End">
        @AppLocalization[Lang.Members]: @Members.Count
    </MudText>
    @if (Members.Any(m => m is IADGroup))
    {

        <MudText Align="Align.End">
            @AppLocalization[Lang.Groups]: @Members.Where(m => m is IADGroup).Count()
        </MudText>
    }
    @if (Members.Any(m => m is IADUser))
    {

        <MudText Align="Align.End">
            @AppLocalization[Lang.Users]: @Members.Where(m => m is IADUser).Count()
        </MudText>
    }
    @if (Members.Any(m => m is IADComputer))
    {

        <MudText Align="Align.End">
            @AppLocalization[Lang.Computers]: @Members.Where(m => m is IADComputer).Count()
        </MudText>
    }
    @if (Members.Any(m => m is IADPrinter))
    {

        <MudText Align="Align.End">
            @AppLocalization[Lang.Printers]: @Members.Where(m => m is IADPrinter).Count()
        </MudText>
    }
    if (Members.Where(m => !m.CanRead).Count() > 0)
    {
        <MudAlert Class="mud-alert-filled-info">
            @AppHelpLocalization[HelpLang.Lacks_Group_Member_Read_Permission]
        </MudAlert>
    }
    @if (Group.CanAssign)
    {

        <MudButton Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.GroupAdd"
                   OnClick="@(()=>{_=AssignMemberModal?.ShowAsync();})">@AppLocalization[Lang.Add_Member]</MudButton>
    }
    <AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Add_Member] @ref=@AssignMemberModal>
        <AddMemberModalContent ModelChanged=@(()=>{InvokeAsync(OnInitializedAsync);}) Group="Group" />
    </AppModal>
}
else
{
    <LoadingData Loading=LoadingData />
}


@code {
    [Parameter]
    public IADGroup Group { get; set; }
    /// <summary>
    /// Number of members per page
    /// </summary>
    /// <remarks>
    /// Default value is 25
    /// </remarks>
    [Parameter]
    public int PageSize { get; set; } = 25;

    List<IGroupableDirectoryAdapter> Members { get; set; }


    AppModal AssignMemberModal;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RefreshData();
        Group.OnModelChanged += () =>
        {
            RefreshData();
        };
        await InvokeAsync(StateHasChanged);

    }
    private void RefreshData()
    {
        Task.Run(() =>
        {
            LoadingData = true;
            Members = Group.Members;
            LoadingData = false;
        });

    }
}
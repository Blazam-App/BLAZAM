@inherits AppModalContent

<MudStack>
    <MudRadioGroup @bind-Value=_reboot>
        <MudRadio Value="true">@AppLocalization[Lang.Reboot]</MudRadio>
            <MudRadio Value="false">@AppLocalization[Lang.Shutdown]</MudRadio>
        </MudRadioGroup>
        <MudTextField @bind-Value=_message Label="@AppLocalization[Lang.Message]" />

        <MudTabs>
            <MudTabPanel Text="@AppLocalization[Lang.Delay]">
                <MudNumericField Min="0" @bind-Value=_delay Label="@AppLocalization[Lang.Delay_in_seconds]" />
            </MudTabPanel>
            <MudTabPanel Text="@AppLocalization[Lang.Timestamp]">
                <MudTimePicker Label="@AppLocalization[Lang.Time]" @bind-Time=_time />
                <MudDatePicker Label="@AppLocalization[Lang.Date]" @bind-Date=_date />
            </MudTabPanel>
        </MudTabs>

    </MudStack>



    @code {
    TimeSpan? _time;
    DateTime? _date;
    bool _reboot = true;
    int _delay;
    string? _message;
    /// <summary>
    /// The computer to reboot or shutdown
    /// </summary>
    [Parameter]
    public IADComputer DirectoryModel { get; set; }


    protected override void OnInitialized()
    {
        base.OnInitialized();
        Modal.OnYes = Execute;
        Modal.Title = AppLocalization[Lang.Reboot_Shutdown];
    }

    private async Task Execute()
    {
        if (await MessageService.Confirm(AppLocalization[Lang.Reboot_Shutdown_Confirmation], AppLocalization[Lang.Confirm]))
        {
            if (_date.HasValue && _date.Value > DateTime.MinValue)
            {
                _date = DateTime.Parse(_time.ToString() + " " + _date.Value.ToLongDateString());
                _delay = (int)(_date.Value - DateTime.Now).TotalSeconds;
            }
            if(await Computer.ShutdownAsync(_delay, _message, true, _reboot))
            {
                SnackBarService.Success(AppLocalization[Lang.Reboot_Shutdown_Success]);
                this.Close();

            }
            else
            {
                SnackBarService.Success(AppLocalization[Lang.Reboot_Shutdown_Failure]);

            }
        }
    }


    protected override bool IsValid => true;

}

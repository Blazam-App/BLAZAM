@using System.Diagnostics;
@using BLAZAM.Common.Exceptions;
@using BLAZAM.Global.Exceptions
@inherits ComputerViewBase

@implements IDisposable
@if (Computer.IsOnline == true)
{
    if (sessionsErrorMessage == null)
    {
        <MudDataGrid HorizontalScrollbar=true Elevation=0 Items="Sessions">
            <Columns>
                <PropertyColumn Title="@AppLocalization[Lang.User]" Property="x=>x.User" />
                <PropertyColumn Title="@AppLocalization[Lang.State]" Property="x=>x.ConnectionState" />
                <PropertyColumn Title="@AppLocalization[Lang.IP_Address]" Property="x=>x.ClientIPAddress" />
                <TemplateColumn Title="@AppLocalization[Lang.Connected]">
                    <CellTemplate>
                        @if (context.Item.ConnectTime != null)
                        {
                            <MudText>@context.Item.ConnectTime.Value.ToLocalTime()</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Title="@AppLocalization[Lang.Idle_Time]" Property="x=>x.IdleTime" />
                <TemplateColumn Title="@AppLocalization[Lang.Message]">
                    <CellTemplate>
                        @if (context.Item.ConnectionState.ToString() == "Active")
                        {
                            <MudButton Color="Color.Info" OnClick=@(()=>{
                           sessionToMessage=context.Item;
                           sessionMessageModal?.ShowAsync();
                           })>Send Message</MudButton>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="@AppLocalization[Lang.Manage]">
                    <CellTemplate>
                        @if (context.Item.ConnectionState.ToString() == "Active")
                        {
                            <MudButton Color="Color.Warning" OnClick=@(async()=>{await DisconnectSession(context.Item);})>@AppLocalization[Lang.Disconnect]</MudButton>
                        }
                        <MudButton Color="Color.Error" OnClick=@(async()=>{await LogoffSession(context.Item);})>Logoff</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>   <AppModal @ref=@sessionMessageModal AllowClose=true Title=@AppLocalization[Lang.Send_Message]>
            <SendMessageModalContent Session="@sessionToMessage" />
        </AppModal>

    }
    else
    {
        <div>
            @sessionsErrorMessage
        </div>
    }
}
else
{
    <MudText>@AppLocalization[Lang.Computer_not_reachable]</MudText>
}



@code {
    IRemoteSession? _selectedSession;
    IRemoteSession? selectedSession
    {
        get => _selectedSession; set

        {
            if (_selectedSession == value) return;
            _selectedSession = value;


        }
    }
    IRemoteSession? sessionToMessage;
    AppModal? sessionMessageModal;







    string? sessionsErrorMessage;
    Timer? t;
    List<IRemoteSession> Sessions {get; set;}


    protected override void OnInitialized()
    {
        base.OnInitialized();
        t = new Timer(RefreshSessions, null, 1000, 10000);

    }
    async Task LogoffSession(IRemoteSession session)
    {

        if (await MessageService.Confirm("Are you sure you want to log off " + session.User.ToString(), "Logoff User"))
        {
            session.Logoff();
            Sessions.Remove(session);
        }

        await StateHasChangedAsync();
    }

    async Task DisconnectSession(IRemoteSession session)
    {
        if (await MessageService.Confirm("Are you sure you want to disconnect " + session.User.ToString(), "Disconnect User"))
        {
            session.Disconnect();

        }
        await StateHasChangedAsync();
    }

    async void RefreshSessions(object? state)
    {
        try
        {
            if (Computer != null && Computer.IsOnline == true)
            {
                var newSessions = await Computer.GetRemoteSessionsAsync();
                Sessions?.ForEach(s =>
                {
                    s.OnSessionDown -= OnSessionDown;
                    s.OnSessionUpdated -= OnSessionUpdated;
                });
                Sessions = newSessions;
                Sessions.ForEach(s =>
                {
                    s.OnSessionDown += OnSessionDown;
                    s.OnSessionUpdated += OnSessionUpdated;

                });
                sessionsErrorMessage = null;
            }

        }
        catch (AuthenticationException ex)
        {
            sessionsErrorMessage = ex.Message;
        }

        await StateHasChangedAsync();
    }
    private void OnSessionDown(IRemoteSession s)
    {
        Sessions.Remove(s);
        InvokeAsync(StateHasChanged);
    }

    private async void OnSessionUpdated(IRemoteSession s)
    {
        await StateHasChangedAsync();
    }

    public override void Dispose()
    {
        base.Dispose();
        t?.Dispose();
        Sessions?.ForEach(s =>
        {
            s.OnSessionDown -= OnSessionDown;
            s.OnSessionUpdated -= OnSessionUpdated;
            s?.Dispose();
        });
    }
}
@using Microsoft.AspNetCore.Components.Forms;
@inherits AppModalContent
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mud-width-full pa-0">
    <MudTabs @bind-ActivePanelIndex="activePanel" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Shared Printers">
            <MudDataGrid @bind-SelectedItems=selectedPrinters
                         Elevation=0
                         Items="Printers.Where(p=>p.ADPrinter==null)"
                         HorizontalScrollbar=true
                         MultiSelection=true>
                <Columns>
                    <SelectColumn />
                    <PropertyColumn Property="x=>x.ShareName" />
                    <PropertyColumn Property="x=>x.Location" />
                    <PropertyColumn Property="x=>x.Comment" />
                    <TemplateColumn>
                        <CellTemplate>
                            <MudButton OnClick="@(()=>{activePanel=1;})">@AppLocalization[Lang.Next]</MudButton>
                        </CellTemplate>
                    </TemplateColumn>

                </Columns>
            </MudDataGrid>
        </MudTabPanel>
        <MudTabPanel Text="@AppLocalization[Lang.OU]">
            <OUTreeView SelectedEntry="destinationOU" SelectedEntryChanged="destinationOUChanged" StartingSelectedOU="null" StartRootExpanded=true />
        </MudTabPanel>

    </MudTabs>


</MudContainer>
@code {
    int activePanel = 0;
    IADOrganizationalUnit? destinationOU;
    [Parameter]
    public List<SharedPrinter> Printers { get; set; }
    public HashSet<SharedPrinter> selectedPrinters { get; set; }

    protected override void OnInitialized()
    {
        Modal.SetYesText(AppLocalization[Lang.Next]);
        Modal.SetTitle(AppLocalization[Lang.Register_Printers]);
        Modal.SetOnYes(async() => { 
            activePanel = 1; 
            await StateHasChangedAsync(); 
        });
        base.OnInitialized();


    }


    private async Task RegisterSelectedPrinters()
    {
        if(destinationOU == null)
        {
            return;
        }
        foreach (var printer in selectedPrinters.Where(p => p.ADPrinter == null))
        {
            IJob registerJob = new Job(AppLocalization[Lang.Register_Printers], CurrentUser.State.AuditUsername);
            var newPrinter = destinationOU.CreatePrinter(printer);
            registerJob = await newPrinter.CommitChangesAsync(registerJob);
            if (registerJob.FailedSteps.Count == 0)
            {
                SnackBarService.Success(AppLocalization[Lang.Printers_registered_to_Active_Directory]);
                this.Close();

            }
            else
            {
                await MessageService.ShowMessage<JobResultDialog>(registerJob.ToDialogParameters(), registerJob.Name);
                return;
            }




        }




    }

    private void destinationOUChanged(IDirectoryEntryAdapter newDst)
    {
        if (newDst is IADOrganizationalUnit newDestinationOU)
        {
            if (destinationOU == newDestinationOU) return;
            destinationOU = newDestinationOU;
            if (selectedPrinters != null && selectedPrinters.Count > 0)
            {
                Modal.SetYesText(AppLocalization[Lang.Register]);
                Modal.SetOnYes(RegisterSelectedPrinters);
                _=Modal.RefreshView();
            }
            else
            {
                Modal.SetYesText(AppLocalization[Lang.Next]);
                Modal.SetOnYes(async () => {
                    activePanel = 1;
                    await StateHasChangedAsync();
                });
                _=Modal.RefreshView();

            }
        }
    }

}

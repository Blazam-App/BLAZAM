@using BLAZAM.Common.Data.Database
@using BLAZAM.Global.Events

@inherits DirectoryEntryViewBase
@{
    string _fieldMudStackClasses = "flex-wrap gap-10";
}
<AppPageTitle>@Computer?.CanonicalName</AppPageTitle>
@if (Computer != null)
{
    <EditForm OnValidSubmit=SaveChanges Context="editContext" Model="Computer">

        <SetSubHeader>

            <DirectoryEntryViewHeader EditMode="@EditMode"
                                      DirectoryEntry="@Computer"
                                      OnAssignTo="@(()=>{AssignToModal?.ShowAsync();})"
                                      OnDelete="@DeleteComputer"
                                      OnDisable="@(async()=>{Computer.Enabled=false; await RefreshEntryComponents();})"
                                      OnEnable="@(async()=>{Computer.Enabled=true; await RefreshEntryComponents();})"
                                      OnMove="@(()=>{MoveToModal?.ShowAsync();})"
                                      OnRename="@(()=>{RenameModal?.ShowAsync();})"
                                      OnResetPassword="@(()=>{ChangePasswordModal?.ShowAsync();})"
                                      OnToggleEditMode="ToggleEditMode"
                                      OnRebootOrShutdown="@(()=>{_rebootModal?.ShowAsync();})"
                                      OnUnlock="@Unlock"
                                      OnShowHistory="@(()=>{ChangeHistoryModal?.ShowAsync();})"
                                      OnShowPermissions="@(()=>{EffectivePermissionsModal?.ShowAsync();})" />
            <LoadingData Loading=SavingChanges />


        </SetSubHeader>

        <CascadingValue Value="EditMode">
            <CascadingValue Value="Computer">
                <FlexContainer>


                    <AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Assign_To] @ref=@AssignToModal>
                        <AssignToModalContent ModelChanged=@RefreshEntryComponents DirectoryModel="Computer" />
                    </AppModal>
                    <AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Reboot_Shutdown] @ref=@_rebootModal>
                        <RebootModalContent ModelChanged=@RefreshEntryComponents Computer="Computer" />
                    </AppModal>
                    <AppModal Color="Color.Dark" Title=@AppLocalization[Lang.Move_To] @ref=@MoveToModal>
                        @if (MoveToModal?.IsShown == true)
                        {
                            <MoveToOUModalContent ModelChanged=@RefreshEntryComponents DirectoryModel="Computer" />
                        }
                    </AppModal>
                    <AppModal Title=@AppLocalization[Lang.Rename] @ref=@RenameModal>
                        @if (RenameModal?.IsShown == true)
                        {
                            <RenameComputerModalContent DirectoryModelRenamed=@((renamedUser) => { Renamed(null,renamedUser); }) Computer="Computer" />
                        }
                    </AppModal>

                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <ViewSection Stack=true FullWidth=false>
                                <MudCard Elevation="2"
                                         Style="width:fit-content;height:fit-content"
                                         Class="relative mx-auto d-block p-1 mb-5">

                                    <MudIcon Style="min-width:150px;" Icon="@Icons.Material.Filled.Computer" />
                                </MudCard>

                                <MudStack Row=true>
                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Name]:</MudText>
                                    <MudSpacer />
                                    <MudText>@Computer.CanonicalName</MudText>

                                </MudStack>

                                @if (Computer.CanReadField(ActiveDirectoryFields.Manager))
                                {
                                    <ADAutoComplete SearchObjectType="ActiveDirectoryObjectType.User"
                                                    Label="@AppLocalization[Lang.Manager]"
                                                    SelectedResult=Computer.Manager
                                                    SelectedResultChanged="@((user)=>{Computer.Manager=user as IADUser;})"
                                                    Disabled=@(!EditMode || !Computer.CanEditField(ActiveDirectoryFields.Manager)) />
                                }
                                @if (Computer.CanReadField(ActiveDirectoryFields.OperatingSystem))
                                {
                                    <MudStack Row=true>
                                        <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Operating_System]:</MudText>
                                        <MudSpacer />
                                        <MudText>@Computer.OperatingSystem</MudText>

                                    </MudStack>
                                }

                                <MudStack Row=true>
                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Online]:</MudText>
                                    <MudSpacer />
                                    <MudText>
                                        <StatusCheck Status="@(Computer.IsOnline == true)" />
                                    </MudText>
                                </MudStack>

                                <MudStack Row=true>
                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Last_Logon]:</MudText>
                                    <MudSpacer />
                                    <LastLogonTime Typo=Typo.caption DirectoryEntry="Computer" />

                                </MudStack>

                                <MudStack>
                                    <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Groups]:</MudText>
                                    <MemberOfList AssignToClicked=@(() => { AssignToModal?.ShowAsync(); }) Model="Computer" />
                                </MudStack>
                                @if (Computer.Disabled)
                                {
                                    <MudAlert Severity="Severity.Error" Class="mud-width-full">@AppLocalization[Lang.Computer_is_disabled]</MudAlert>
                                }
                                @if (Computer.LockedOut)
                                {
                                    <MudAlert Severity="Severity.Warning" Class="mud-width-full">@AppLocalization[Lang.Computer_is_locked_out]</MudAlert>
                                }
                                <PluginComponents Page="@PageType.Computer" Location="@PageLocation.Details" />
                            </ViewSection>
                        </MudItem>
                        <MudItem xs=12 md="9">
                            <MudStack>

                                <ViewSection Title=@AppLocalization[Lang.Live_Stats]>

                                    <MudStack Row=true Class="@_fieldMudStackClasses">
                                        @if (Computer.IsOnline == true)
                                        {
                                            <ComputerResourceCharts Computer="Computer" />


                                        }
                                        else
                                        {
                                            <MudText>@AppLocalization[Lang.Computer_not_reachable]</MudText>

                                        }
                                    </MudStack>
                                </ViewSection>


                             
                                @if (Computer.CanReadBitLocker)
                                {
                                    <BitLockerViewer Computer="Computer" />
                                }

                                <ViewSection Title="LAPS">

                                    <DynamicMudInput T=string Label="@AppLocalization[Lang.Username]"
                                                     Value="@Computer.LapsUsername.ToPlainText()"
                                                     ReadOnly="true" />

                                    <DynamicMudInput T=string Label="@AppLocalization[Lang.Password]"
                                                     Value="@Computer.LapsPassword.ToPlainText()"
                                                     ReadOnly="true" />

                                    <DynamicMudInput T=DateTime? Label="@AppLocalization[Lang.Expires]"
                                                     @bind-Value="@Computer.LapsPasswordExpiration"
                                                     Disabled=@(!EditMode|| !Computer.CanEditField(ActiveDirectoryFields.LapsPassword)) />

                                    <MudButton Color="Color.Secondary"
                                               Variant="Variant.Filled"
                                               OnClick="ExpireLapsPassword"
                                               Disabled="@(!Computer.CanEditField(ActiveDirectoryFields.LapsPassword))">Expire Now</MudButton>


                                </ViewSection>


                            </MudStack>

                        </MudItem>
                    </MudGrid>







                    <ViewSection Title=@AppLocalization[Lang.Services]>

                        <MudStack Row=true Class="@_fieldMudStackClasses">
                            @if (Computer.IsOnline == true)
                            {
                                <ComputerServices Computer="Computer" />
                            }
                            else
                            {
                                <MudText>@AppLocalization[Lang.Computer_not_reachable]</MudText>

                            }

                        </MudStack>
                    </ViewSection>



                    @if (OperatingSystem.IsWindows() && CurrentUser.State.IsSuperAdmin)
                    {
                        <ViewSection Title=@AppLocalization[Lang.Drive_Details]>
                            <MudStack Row=true Class="@_fieldMudStackClasses">
                                @if (Computer.IsOnline == true)
                                {
                                    <ComputerDriveDetails Computer="Computer" />
                                }
                                else
                                {
                                    <MudText>@AppLocalization[Lang.Computer_not_reachable]</MudText>

                                }

                            </MudStack>
                        </ViewSection>
                    }






                    @if (OperatingSystem.IsWindows() && CurrentUser.State.IsSuperAdmin)
                    {
                        <ViewSection Title=@AppLocalization[Lang.Sessions]>

                            <MudStack Row=true Class="@_fieldMudStackClasses">
                                @if (Computer.IsOnline == true)
                                {
                                    if (CurrentUser.State.IsSuperAdmin)
                                    {
                                        <ComputerSessions Computer="Computer" />
                                    }
                                }
                                else
                                {
                                    <MudText>
                                        @AppLocalization[Lang.Computer_not_reachable]
                                    </MudText>

                                }


                            </MudStack>

                        </ViewSection>
                    }

                    @if (OperatingSystem.IsWindows() && CurrentUser.State.IsSuperAdmin)
                    {
                        <ViewSection Title=@AppLocalization[Lang.Printers]>

                            <MudStack Row=true Class="@_fieldMudStackClasses">
                                @if (Computer.IsOnline == true)
                                {
                                    <ComputerSharedPrinters Computer="Computer" />
                                }
                                else
                                {
                                    <MudText>@AppLocalization[Lang.Computer_not_reachable]</MudText>

                                }
                            </MudStack>

                        </ViewSection>
                    }

                    @if (Computer.CanReadAnyCustomFields && CustomFields != null && CustomFields.Count > 0)
                    {
                        <ViewSection Title=@AppLocalization[Lang.Additional_Fields]>

                            @foreach (var field in CustomFields)
                            {
                                @if (Computer.CanReadField(field))
                                {
                                    <CustomDirectoryField Disabled=@(!EditMode || !Computer.CanEditField(ActiveDirectoryFields.ProfilePath)) Entry="Computer" Field="@field" />

                                }
                            }


                        </ViewSection>
                    }



                    <PluginComponents Page="@PageType.Computer" Location="@PageLocation.NewSection" />

                </FlexContainer>
            </CascadingValue>
        </CascadingValue>

    </EditForm>
    @if (Computer.HasUnsavedChanges && !Computer.NewEntry)
    {
        <UnsavedChangesPrompt SaveChanges="SaveChanges" DiscardChanges="DiscardChanges" />
    }
}
<LoadingData Loading=SavingChanges />











@using BLAZAM.Gui.UI.Computers
@using BLAZAM.FileSystem
@inherits ComputerViewBase
@inject IStringLocalizer<AppLocalization> AppLocalization

<MudToolBar Dense="true">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="@(currentPath == null || currentPath.ParentDirectory == null || !currentPath.ParentDirectory.Exists)"></MudIconButton>
    <MudTextField T="string" Value="currentPath?.FullPath" ReadOnly="true" Variant="Variant.Text" Class="flex-grow-1"></MudTextField>
</MudToolBar>
<MudDataGrid T="FileSystemBase" Items="items" Hover="true" @ref="_dataGrid" FixedHeader="true" Height="400px">
    <Columns>
        <TemplateColumn Title="" Sortable="false">
            <CellTemplate>
                <MudIcon Icon="@(context.Item is SystemDirectory ? Icons.Material.Filled.Folder : Icons.Material.Filled.Article)" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Name" Title="@AppLocalization[Lang.Name]" />

        <TemplateColumn Title="@AppLocalization[Lang.Actions]" Sortable="false" Class="d-flex justify-end">
            <CellTemplate>
               
                       
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="FileSystemBase" />
    </PagerContent>
</MudDataGrid>

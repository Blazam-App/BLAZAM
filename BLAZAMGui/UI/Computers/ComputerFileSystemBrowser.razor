@using BLAZAM.Gui.UI.Computers
@using BLAZAM.FileSystem
@inherits ComputerViewBase
@inject IStringLocalizer<AppLocalization> AppLocalization

@if (Computer?.IsOnline == true)
{
    <MudDataGrid T="IFileSystemObject"
                 Items="items"
                 RowClick="RowClicked"
                 Hover="true"
                 @ref="_dataGrid"
                 FixedHeader="true"
                 Height="400px">
        <Header>
            <MudToolBar Dense="true">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                               OnClick="GoUpOneDirectory"
                               Disabled="@CanGoUp"></MudIconButton>
                <MudTextField T="string"
                              Value="currentPath?.FullPath"
                              ReadOnly="true"
                              Variant="Variant.Text"
                              Class="flex-grow-1"></MudTextField>
            </MudToolBar>
        </Header>
        <Columns>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudIcon Icon="@(context.Item is SystemDirectory ? Icons.Material.Filled.Folder : Icons.Material.Filled.Article)" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Name" Title="@AppLocalization[Lang.Name]" />

            <TemplateColumn Title="@AppLocalization[Lang.Actions]" Sortable="false">
                <CellTemplate>

                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="FileSystemBase" />
        </PagerContent>
    </MudDataGrid>
}
else
{
    <MudText>@AppLocalization[Lang.Computer_not_reachable]</MudText>
}
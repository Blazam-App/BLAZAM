@inherits AppModalContent
<MudStack>
    <MudTextField T=string Label=@AppLocalization[Lang.Message] @bind-Text=messageTextField />

</MudStack>

@code{
    string messageTextField="";
    [Parameter]
    public IRemoteSession? Session{ get; set; }
    protected override void OnInitialized()
    {
        base.OnInitialized();

        Modal.SetYesText("Send");
        Modal.SetOnYes(SendMessage);

    }

    private async Task SendMessage()
    {
        if(Session == null)
        {
            SnackBarService.Error("Session lost");
            return;
        }   
        Session.SendMessage(messageTextField);

        SnackBarService.Success("Message sent");
        messageTextField = "";
        await UpdateState();
    }
}
@inherits AppModalContent
<MudStack>
    <MudTextField T=string Label=@AppLocalization[Lang.Message] @bind-Text=messageTextField />

</MudStack>

@code{
    string messageTextField;
    [Parameter]
    public IRemoteSession Session{ get; set; }
    protected override void OnInitialized()
    {
        base.OnInitialized();

        Modal.YesText = "Send";
        Modal.OnYes = SendMessage;

    }

    private async Task SendMessage()
    {
        Session.SendMessage(messageTextField);

        SnackBarService.Success("Message sent");
        messageTextField = "";
        await InvokeAsync(StateHasChanged);
    }
}
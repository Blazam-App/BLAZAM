@inherits AppModalContent
@if (Computer != null && _privateComputerInstance != null)
{
    <ViewSection Title=@AppLocalization[Lang.Name]>
        @if (Computer.IsOnline == true)
        {
            <MudTextField Value="_privateComputerInstance.CanonicalName" ValueChanged="((string val)=>{newName=val;})" />
        }
        else if (Computer.IsOnline == false)
        {
            <MudAlert Class="mud-theme-info">The computer must be online to changed its name.</MudAlert>
        }
        else
        {
            <MudProgressCircular Indeterminate=true />
        }


    </ViewSection>
    <ViewSection>

        <MudCheckBox @bind-Value=_rebootAfterRename Label="@AppLocalization[Lang.Reboot]"/>
        @if (_rebootAfterRename)
        {
            <MudDateTimePicker @bind-DateTime=_date />
        }
    </ViewSection>

}
else
{
    <MudProgressCircular Indeterminate Color="Color.Primary" />
}
@code {
    bool _rebootAfterRename;
    DateTime? _date;
    private IADComputer _privateComputerInstance;
    private string newName;
    [Parameter]
    public EventCallback<IDirectoryEntryAdapter> DirectoryModelRenamed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _privateComputerInstance = Directory.FindEntryBySid(Computer.SID.ToSidString()) as IADComputer;
        _privateComputerInstance.OnOnlineChanged += ((state) => { InvokeAsync(StateHasChanged); });
        SaveDisabled = false;
        Modal.SetOnYes(SaveChanges);
        Modal.SetYesText(AppLocalization[Lang.Rename_Computer]);
        Modal.SetTitle(AppLocalization[Lang.Rename_Computer]);

        await InvokeAsync(StateHasChanged);
    }

    void DisplayNameChanged(string newName)
    {

        _privateComputerInstance.DisplayName = newName;

    }
    async Task SaveChanges()
    {
        var possibleConflictingMatch = await Directory.Computers.FindByStringAsync(newName);
        if (Computer.IsOnline != true)
        {
            SnackBarService.Error(AppLocalization[Lang.Computer_not_reachable]);
            return;
        }
        if (possibleConflictingMatch == null || possibleConflictingMatch.Any(m => m.CanonicalName.Equals(newName)))
        {
            SnackBarService.Error(AppHelpLocalization[HelpLang.Duplicate_Name_Conflict]);

            return;

        }
        SaveDisabled = true;
        LoadingData = true;
        if(await Computer.RenameAsync(newName))
        {
            if (_rebootAfterRename)
            {
                var delay = (int)(_date.Value - DateTime.Now).TotalSeconds;
                if (await Computer.ShutdownAsync(delay, AppHelpLocalization[HelpLang.Rename_Reboot_Message, delay], true, true))
                {
                    SnackBarService.Success(AppLocalization[Lang.Computer_renamed]);

                }
                SnackBarService.Warning(AppLocalization[Lang.Computer_renamed]);

            }
            else
            {
                SnackBarService.Success(AppLocalization[Lang.Computer_renamed]);
            }
            Close();

        }
        else
        {
            SnackBarService.Error(AppHelpLocalization[HelpLang.Unexpected_Error_Occurred]);

        }
        

        LoadingData = false;

        SaveDisabled = false;
    }
    

}



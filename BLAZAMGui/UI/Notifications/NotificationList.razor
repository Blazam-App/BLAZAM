@inherits DatabaseComponentBase

<MudStack Class="pa-3 mud-height-full">

    <LoadingData Loading="LoadingData" />

    @if (messages.Count(m => !m.IsRead) < 1 || messages.Where(m => !m.IsRead) == null)
    {
        <MudCard Class="py-3" Elevation="2">
            <MudStack Row=true Class="px-4">
                <MudIcon Color="Color.Success" Icon="@Icons.Material.Outlined.Check" />
                <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.No_unread_notifications]</MudText>
            </MudStack>
        </MudCard>
    }
    else
    {
        foreach (var message in messages.Where(m => !m.IsRead).ToList())
        {
            @if (message.Notification.MessageType == MessageType.AccessRequest)
            {
                <RequestNotificationMessageListItem Notification="@message" />
            }
            else
            {
                <NotificationMessageListItem Notification="@message" />
            }
        }
    }

    @if (messages.Count(m => m.IsRead) > 0)
    {
        <MudCard Class="py-3 cursor-pointer" Elevation="2" @onclick=@(()=>{_showRead = !_showRead; })>
            <MudStack Row=true Class="px-4">
                <MudIcon Color="Color.Success"
                         Icon="@(_showRead? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)" />
                <MudText Typo="Typo.subtitle2">@AppLocalization[Lang.Read_Notifications]</MudText>
            </MudStack>
        </MudCard>
        @if (_showRead)
        {
            <Virtualize TItem="UserNotification" Items="@messages.Where(m => m.IsRead).ToList()">
                <ItemContent>
                    <NotificationMessageListItem Notification="@context" />
                </ItemContent>
            </Virtualize>
        }

    }



</MudStack>
@code {

    [Parameter]
    public IApplicationUserState UserState { get; set; }


    bool _showRead;

    private IList<UserNotification> messages = new List<UserNotification>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RetrieveMessages();

        UserState.OnSettingsChanged.Delegate += RetrieveMessagesAsync;
        NotificationPublisher.OnNotificationPublished.Delegate +=  RetrieveMessagesAsync;
        NotificationPublisher.OnNotificationDeleted.Delegate += RetrieveMessagesAsync;

    }
    public override void Dispose()
    {
        base.Dispose();
        if (UserState != null)
        {
            UserState.OnSettingsChanged.Delegate -= RetrieveMessagesAsync;

        }
        NotificationPublisher.OnNotificationPublished.Delegate -= RetrieveMessagesAsync;
        NotificationPublisher.OnNotificationDeleted.Delegate -= RetrieveMessagesAsync;
    }
    private void RetrieveMessagesAsync(object state, object args) => _ = RetrieveMessages();
    private async Task RetrieveMessages()
    {
        await Task.Run(async () =>
        {
            if (messages == null || messages.Count == 0)
            {
                LoadingData = true;
            }
            var context = await DbFactory.CreateDbContextAsync();

            messages = await context.UserNotifications
            .Where(un => un.User.Id == UserState.Id)
            .OrderByDescending(un => un.Notification.Created)
            .ToListAsync();
            LoadingData = false;
        });


    }
    public override async Task StateHasChangedAsync()
    {
        await RetrieveMessages();

    }

}
@inherits DatabaseComponentBase
@{
    var notifs = Notifications.Where(n => !n.IsRead);
}
<MudBadge Color=Color.Error
          Visible="@(notifs.Any())"
          Overlap=true
          BadgeClass="badge-repos cursor-pointer"
          Content="@Notifications.Count(n=>!n.IsRead)"
          OnClick="@ToggleNotifications">
    <AppTooltip Text=@(AppLocalization[Lang.Notifications])>
        <AppIconButton Size="Size.Large"
                       OnClick="@ToggleNotifications"
                       Icon="@(notifs.Any()?Icons.Material.Filled.NotificationImportant:Icons.Material.Filled.Notifications)"
                       Color="@(notifs.Any()?Color.Warning:Color.Info)" />
    </AppTooltip>
</MudBadge>


@code {

    [CascadingParameter]
    public MainLayout mainLayout { get; set; }
    IList<UserNotification> Notifications = new List<UserNotification>();
    private IApplicationUserState UserState;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await StateHasChangedAsync();


        UserState = CurrentUser.State;
        await StateHasChangedAsync();
        if (UserState != null)
        {
            UserState.OnSettingsChanged.Delegate += LoadNotificaions; 
            Notifications = await Context.UserNotifications.Where(un => un.User.Id == UserState.Id && !un.IsRead).ToListAsync();

        }
        NotificationPublisher.OnNotificationPublished.Delegate += NotificationPublished;

        NotificationPublisher.OnNotificationDeleted.Delegate += LoadNotificaions;

        await StateHasChangedAsync();
    }

    public override void Dispose()
    {
        base.Dispose();
        if (UserState != null)
        {
            UserState.OnSettingsChanged.Delegate -= LoadNotificaions;
        }
        NotificationPublisher.OnNotificationPublished.Delegate -= NotificationPublished;

        NotificationPublisher.OnNotificationDeleted.Delegate -= LoadNotificaions;
    }
    private void LoadNotificaions(object? state, object? args)
    {
        _ = LoadNotificationsAsync();
    }
    private void NotificationPublished(object? state, List<UserNotification> notifications)
    {
        if (notifications != null && notifications.Select(n => n.User).Contains(UserState.Preferences))
        {
            _ = LoadNotificationsAsync();

        }
    }
    private void ToggleNotifications()
    {
        mainLayout.NotificationsOpen = !mainLayout.NotificationsOpen;
    }
    private async Task LoadNotificationsAsync()
    {
        var context = await DbFactory.CreateDbContextAsync();

        Notifications = await context.UserNotifications.Where(un => un.User.Id == UserState.Id && !un.IsRead).ToListAsync();

        await StateHasChangedAsync();
    }
}
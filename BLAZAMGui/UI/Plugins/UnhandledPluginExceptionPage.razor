@code {
    private Exception? _error;
    private List<string> StackTrace { get; set; } = new();
    [Parameter]
    public LoadedPlugin? Plugin { get; set; }   
    [Parameter]
    public Exception? Error
    {
        get => _error; set

        {
            if (value == _error) return;
            _error = value;
            if (_error != null)
            {
                try{
                    Loggers.PluginLogger.Fatal(_error,"Unhandled exception in plugin. {@PluginName} {@PluginPath}",Plugin.PluginBase.Name,Plugin.Assembly.Location);
                }
                catch
                {
                    
                }
            }
        }
    }
}
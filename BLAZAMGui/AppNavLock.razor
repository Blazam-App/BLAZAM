@page "/nav-lock"
@using Microsoft.AspNetCore.Components.Routing
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<AppLocalization> AppLocalization
@inject IStringLocalizer<AppHelpLocalization> AppHelpLocalization
@inject NavigationManager Navigation
@if (Lock)
{

    <NavigationLock ConfirmExternalNavigation="true"
                    OnBeforeInternalNavigation="OnBeforeInternalNavigation" />
}

@code {
    [Parameter]
    public bool Lock { get; set; } = true;

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm",
        AppLocalization[Lang.You_have_unsaved_changes] + ". " + AppHelpLocalization[HelpLang.Navigate_Away_Confirmation].ToString());

        if (!isConfirmed)
        {
            context.PreventNavigation();
        }
    }
}
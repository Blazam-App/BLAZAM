@inherits DatabaseComponentBase


<MudMenu AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         ListClass="py-0">
    <ActivatorContent>

        <AppTooltip Text="@CurrentUser.Username">
            <CurrentUserAvatarIcon OnClick="@(() => context.ToggleAsync())" UserState="@_userState" />
        </AppTooltip>
    </ActivatorContent>
    <ChildContent>
        <MudText Typo=Typo.body2
                 Color="Color.Info"
                 Align=Align.Center
                 Class="py-3 w-100 "
                 Style="text-align:center; background-color: var(--mud-palette-drawer-background);">
            @CurrentUser.Username
        </MudText>
        <MudDivider />

        <MudMenuItem OnClick="@(()=>{profileModal?.ShowAsync();})"
                     Icon="@Icons.Material.Filled.Settings">
            @AppLocalization[Lang.Profile_Settings]
        </MudMenuItem>
        @if (_eprp.CanResetPassword)
        {
             <MudMenuItem OnClick="@(()=>{recoveryModal?.ShowAsync();})"
                     Icon="@Icons.Material.Filled.Password">
            @AppLocalization[Lang.Password_Reset_Settings]
        </MudMenuItem>
        }
        <MudMenuItem Href="https://docs.blazam.org"
                     Target="_blank"
                     Icon="@Icons.Material.Filled.Book">
            @AppLocalization[Lang.Documentation]
        </MudMenuItem>
        <AuthorizeView Roles="@UserRoles.SuperAdmin">
            <MudMenuItem OnClick="@(()=>{apiModal?.ShowAsync();})"
                         Icon="@Icons.Material.Filled.Api">
                @AppLocalization[Lang.API]
            </MudMenuItem>
        <PluginComponents Page="@PageType.UserMenu" Location="@PageLocation.MenuItem" />
        </AuthorizeView>
        @if (_userState?.Impersonator == null)
        {
            <MudMenuItem OnClick="@(()=>{Nav.NavigateTo("/logout",true);})" Icon="@Icons.Material.Filled.Logout">
                @AppLocalization[Lang.Sign_Out]
            </MudMenuItem>
        }
        else
        {
            <MudMenuItem OnClick="@(()=>{Nav.NavigateTo("/unimpersonate",true);})" Icon="@Icons.Material.Filled.PersonOff">

                @AppLocalization[Lang.Stop_It]
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>
<AppModal @ref=profileModal
          Title=@AppLocalization[Lang.Profile_Settings]>
    <CascadingValue Value="mainLayout">
        <AppUserProfileModalContent />
    </CascadingValue>
</AppModal>
<AppModal @ref=recoveryModal
          Title=@AppLocalization[Lang.Password_Reset_Settings]>
    <CascadingValue Value="mainLayout">
        <AppUserRecoverySettingsModalContent />
    </CascadingValue>
</AppModal>
<AppModal @ref=apiModal
          Options="new(){
         MaxWidth=MaxWidth.Large,
        CloseButton=true
        }"
          Title=@AppLocalization[Lang.API_Tokens]>
    <CascadingValue Value="mainLayout">
        <AppUserApiModalContent />
    </CascadingValue>
</AppModal>
@code {
    AppModal? profileModal;
    AppModal? recoveryModal;
    AppModal? apiModal;

    [CascadingParameter]
    public MainLayout? mainLayout { get; set; }

    private IApplicationUserState? _userState;
    private EffectivePasswordResetPolicy? _eprp;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await StateHasChangedAsync();
        _userState = CurrentUser.State;
        _eprp = new EffectivePasswordResetPolicy(_userState.PermissionDelegates);
        if (_userState != null)
            _userState.OnSettingsChanged.Delegate += InvokeStateHasChanged;
        await StateHasChangedAsync();
    }

    public override void Dispose()
    {
        base.Dispose();
        
        if (_userState != null)
            _userState.OnSettingsChanged.Delegate -= InvokeStateHasChanged;
    }
}
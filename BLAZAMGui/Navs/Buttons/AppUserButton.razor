@inherits DatabaseComponentBase

@* <UserNotificationPopover UserState="@UserState" @bind-Open="@NotificationsOpen" /> *@

<MudMenu @ref=@_userMenu
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         ListClass="py-0">
    <ActivatorContent>

        <AppTooltip Text="@CurrentUser.Username">
            <CurrentUserAvatarIcon UserState="@UserState" />
        </AppTooltip>
    </ActivatorContent>
    <ChildContent>
        <MudText Typo=Typo.body2
                 Color="Color.Info"
                 Align=Align.Center
                 Class="py-3 w-100 "
                 Style="text-align:center; background-color: var(--mud-palette-drawer-background);">
            @CurrentUser.Username
        </MudText>
        <MudDivider />

        <MudMenuItem OnClick="@(()=>{profileModal?.ShowAsync();})"
                     Icon="@Icons.Material.Filled.Settings">
            @AppLocalization["Profile Settings"]
        </MudMenuItem>

        <MudMenuItem Href="https://docs.blazam.org"
                     Target="_blank"
                     Icon="@Icons.Material.Filled.Book">
            @AppLocalization["Documentation"]
        </MudMenuItem>
        <AuthorizeView Roles="@UserRoles.SuperAdmin">
            <MudMenuItem OnClick="@(()=>{apiModal?.ShowAsync();})"
                         Icon="@Icons.Material.Filled.Api">
                @AppLocalization["API"]
            </MudMenuItem>
@*             <MudMenuItem OnClick="@(async()=>{await JS.InvokeAsync<object>("openFeatureRequestDialog");})"
                         Icon="@Icons.Material.Filled.RequestPage">
                @AppLocalization["Feature Request"]
            </MudMenuItem> *@
        </AuthorizeView>
        @if (UserState?.Impersonator == null)
        {
            <MudMenuItem OnClick="@(()=>{Nav.NavigateTo("/logout",true);})" Icon="@Icons.Material.Filled.Logout">
                @AppLocalization["Sign Out"]
            </MudMenuItem>
        }
        else
        {
            <MudMenuItem OnClick="@(()=>{Nav.NavigateTo("/unimpersonate",true);})" Icon="@Icons.Material.Filled.PersonOff">

                @AppLocalization["Stop It"]
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>
<AppModal @ref=profileModal
          Title="Profile Settings">
    <CascadingValue Value="mainLayout">
        <AppUserProfileModalContent />
    </CascadingValue>
</AppModal>
<AppModal @ref=apiModal
            Options="new(){
     MaxWidth=MaxWidth.Large,
CloseButton=true
}"
          Title="API Tokens">
    <CascadingValue Value="mainLayout">
        <AppUserApiModalContent />
    </CascadingValue>
</AppModal>
@code {
    AppModal? profileModal;
    AppModal? apiModal;
    MudMenu? _userMenu;
    [CascadingParameter]
    public MainLayout mainLayout { get; set; }
    private IApplicationUserState UserState;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await InvokeAsync(StateHasChanged);


        UserState = CurrentUser.State;
        await InvokeAsync(StateHasChanged);
        if (UserState != null)
            UserState.OnSettingsChanged += async () =>
        {

            await InvokeAsync(StateHasChanged);
        };


        await InvokeAsync(StateHasChanged);


    }




}
@using BLAZAM.Gui.Navs.Buttons
@using BLAZAM.Gui.UI.Notifications

@inject IStringLocalizer<AppLocalization> AppLocalization
@inject IApplicationUserStateService UserStateService
@inject NavigationManager Nav


<MudAppBar Color=Color.Default Elevation="1">
    <MudBreakpointProvider>
        @if (mainLayout != null)
        {
            <MudHidden Breakpoint="@(mainLayout.BrowseExpanded?Breakpoint.None:Breakpoint.XlAndUp)">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="@((e) => {mainLayout.DrawerOpen = !mainLayout.DrawerOpen; })" />
            </MudHidden>
        }
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudLink Href="/">
                <MudImage Class="app-icon"
                          Src="@StaticAssets.ApplicationIconUri" />
            </MudLink>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndUp"
                   Invert=true>
            @if (DatabaseCache.ApplicationSettings?.AppName != DatabaseCache.ApplicationSettings?.AppAbbreviation)
            {
                <AppTooltip Text="@DatabaseCache.ApplicationSettings?.AppName">
                    <MudText Align="Align.Center"
                             Class="px-3 align-middle">
                        @DatabaseCache.ApplicationSettings?.AppAbbreviation
                    </MudText>
                </AppTooltip>
            }
            else
            {
                <MudText Align="Align.Center"
                         Class="px-3 align-middle">
                    @DatabaseCache.ApplicationSettings?.AppAbbreviation
                </MudText>
            }
        </MudHidden>
    </MudBreakpointProvider>
    <MudSpacer />

    @if (mainLayout?.Header != null)
    {
        @mainLayout.Header.ChildContent
    }
    else
    {
        <SearchPageHeader />
    }
    <MudSpacer />
    <AuthorizeView Roles="@UserRoles.SuperAdmin">
        <ApplicationNewsProvider />
    </AuthorizeView>
    <UserNotificationsProvider />
    <AppUserButton />
</MudAppBar>


@code {

    [CascadingParameter]
    public MainLayout? mainLayout { get; set; }


}
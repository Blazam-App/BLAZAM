@using System.Diagnostics
@using BLAZAM.Global.Data
@inherits AppComponentBase
<MudStack Row=true
          Class=@("relative mud-width-full "+Class)>

    <Copyright OnClick="(()=>{_=aboutModal?.ShowAsync();})" />
    @if (AutoUpdateService.IsUpdatedScheduled)
    {
        <AuthorizeView Roles="@UserRoles.SuperAdmin">
            <Authorized>
                <AppTooltip @onclick=@((c)=>{Nav.NavigateTo("/settings/update");})
                            Class="mud-theme-info"
                            Style="width:max-content"
                            Text=@(AppLocalization[Lang.An_automatic_update_is_scheduled]+" "+AppLocalization[Lang.Click_for_details])>
                    <MudIcon Color="@Color.Success"
                             Icon=@Icons.Material.Filled.ArrowCircleUp />
                </AppTooltip>
            </Authorized>
            <NotAuthorized>
                <AppTooltip Class="mud-theme-info"
                            Style="width:max-content"
                            Text=@AppLocalization[Lang.An_automatic_update_is_scheduled]>

                    <MudIcon Color="@Color.Success"
                             Icon=@Icons.Material.Filled.ArrowCircleUp />
                </AppTooltip>
            </NotAuthorized>
        </AuthorizeView>

    }
    <MudSpacer />

</MudStack>
<AppModal @ref=aboutModal Options=@(new DialogOptions(){FullWidth=true,
          MaxWidth=MaxWidth.Small,
          CloseButton=true})
          Title=@(AppLocalization[Lang.About]+" Blazam")>
    <AboutAppModalContent />
</AppModal>
@code {
    [Parameter]
    public string? Class { get; set; }


    AppModal? aboutModal;
}
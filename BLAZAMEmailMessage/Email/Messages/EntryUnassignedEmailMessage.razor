@using BLAZAM.Helpers
@using System.Security
@inherits EmailNotificationTemplateComponent

<EmailTemplateHeader>
    <strong>@AppLocalization[Lang.Group_member_removed]</strong>
</EmailTemplateHeader>
   
<EmailTemplateBody>
    @EntryName @AppLocalization["has been unassigned from"] @GroupName
    <br />
   
    @if (ShouldRenderLinks)
    {
        <br />
        <EmailLink Href="@EntryLink" />
    }
</EmailTemplateBody>


@code {
    [Parameter]
    public string? GroupName { get; set; }
 
    public override string Render() => new ComponentRenderer<EntryUnassignedEmailMessage>()
            .UseLayout<DefaultEmailLayout>()
            .AddServiceProvider(ApplicationInfo.services)
            .Set(c => c.EntryName, EntryName)
                .Set(c => c.EntryLink, EntryLink)
                .Set(c => c.ActorName, ActorName)
                .Set(c => c.Timestamp, Timestamp)
            .Set(c => c.GroupName, GroupName)
            .Render();
}




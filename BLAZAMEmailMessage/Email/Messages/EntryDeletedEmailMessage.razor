@using BLAZAM.Helpers
@using System.Security
@inherits EmailNotificationTemplateComponent

<EmailTemplateHeader>
    <strong>@AppLocalization[Lang.Object_deleted]</strong>
</EmailTemplateHeader>

<EmailTemplateBody>
    @if (EntryName != null)
    {
        @AppHelpLocalization[HelpLang.Deleted, EntryName]
    }

    <br />
    @if (ShouldRenderLinks)
    {
        <br />
        <EmailLink Href="/recyclebin" />
    }

</EmailTemplateBody>


@code {
    public override string Render() => new EmailTemplateRenderer<EntryDeletedEmailMessage>()
        .Set(c => c.EntryName, EntryName)
        .Set(c => c.ActorName, ActorName)
        .Set(c => c.Timestamp, Timestamp)
        .Render();
   
}




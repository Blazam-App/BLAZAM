@using BLAZAM.Helpers
@using System.Security
@inherits EmailNotificationTemplateComponent

<EmailTemplateHeader>
    <strong>@AppLocalization[Lang.Password_Reset_Requested]</strong>
</EmailTemplateHeader>

<EmailTemplateBody>
    @if (ResetUri != null)
    {
        <MudText Align="Align.Center">
            @AppHelpLocalization[HelpLang.Password_Reset_Body]<br /><br />


        </MudText>

        <MudText Align="Align.Center"> <EmailLink Href="@ResetUri">@AppHelpLocalization[HelpLang.Password_Reset_Link_Text]</EmailLink></MudText>

    }
    @if (Expires != null && Expires.HasValue)
    {
        <br />
        <MudText Align="Align.Center">
            @AppHelpLocalization[HelpLang.Password_Reset_Expiration_Text, Expires.Value.ToLocalTime().ToString("f")]
           
        </MudText>

    }
    <MudDivider Class="my-6" />
    <MudText Align="Align.Center">@AppHelpLocalization[HelpLang.Password_Reset_Ignore_Text]</MudText> <br />
    @if (!IpAddress.IsNullOrEmpty() || !Browser.IsNullOrEmpty())
    {
        <MudText Align="Align.Center">@AppHelpLocalization[HelpLang.Password_Reset_Origin_Text,IpAddress??"Unknown"]<br /> @Browser</MudText>
    
        <br />
    }

    <MudText Align="Align.Center">@AppHelpLocalization[HelpLang.Password_Reset_URL_Text]<br /> @((DatabaseCache.ApplicationSettings?.ForceHTTPS == true ? "https://" : "http://") + DatabaseCache.ApplicationSettings?.AppFQDN + ResetUri)</MudText>
</EmailTemplateBody>


@code {
    [Parameter]
    public string? ResetUri { get; set; }
    [Parameter]
    public string? IpAddress { get; set; }
    [Parameter]
    public string? Browser { get; set; }

    [Parameter]
    public DateTime? Expires { get; set; }

    public override string Render() => new ComponentRenderer<PasswordResetEmailMessage>()
            .UseLayout<DefaultEmailLayout>()
            .AddServiceProvider(ApplicationInfo.services)
            .Set(c => c.ResetUri, ResetUri)
            .Set(c => c.IpAddress, IpAddress)
            .Set(c => c.Browser, Browser)
            .Set(c => c.Expires, Expires).Render();
}




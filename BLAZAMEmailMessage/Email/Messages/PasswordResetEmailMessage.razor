@using BLAZAM.Helpers
@using System.Security
@inherits NotificationTemplateComponent

<EmailTemplateHeader>
    <strong>@AppLocalization[Lang.Password_Reset_Requested]</strong>
</EmailTemplateHeader>

<EmailTemplateBody>
    @if (ResetUri != null)
    {
        <MudText Align="Align.Center">
            A password reset has been requested for your account.<br/><br/>
        <EmailLink Href="@ResetUri">Click here to reset your password</EmailLink>
        </MudText>
    }
@if (Expires != null)
{
    <br/>
    <MudText Align="Align.Center">
        Your reset link will expire @Expires?.ToLocalTime().ToString("f")
    </MudText>
 
}
<MudDivider Class="my-6"/>
    <MudText Align="Align.Center">If you did not request this reset. Report it to your system administrator.</MudText>
</EmailTemplateBody>


@code {
    [Parameter]
    public string? ResetUri { get; set; }
    
    [Parameter]
    public DateTime? Expires { get; set; }

    public override string Render() => new ComponentRenderer<PasswordResetEmailMessage>()
            .UseLayout<DefaultEmailLayout>()
            .AddServiceProvider(ApplicationInfo.services)
            .Set(c => c.ResetUri, ResetUri)
            .Set(c => c.Expires, Expires).Render();
}




@using BLAZAM.Helpers
@using System.Security
@inherits EmailNotificationTemplateComponent

<EmailTemplateHeader>
    <strong>@AppLocalization[Lang.Password_Changed]</strong>
</EmailTemplateHeader>
   
<EmailTemplateBody>
    @(AppLocalization["The password for "] + EntryName + AppLocalization[" has been changed."])
    <br />
    @if (ShouldRenderLinks)
    {
        <br />
        <EmailLink Href="@EntryLink" />
    }
   
</EmailTemplateBody>


@code {
 
    public override string Render() => new ComponentRenderer<PasswordChangedEmailMessage>()
            .UseLayout<DefaultEmailLayout>()
            .AddServiceProvider(ApplicationInfo.services)
            .Set(c => c.EntryName, EntryName)
            .Set(c => c.EntryLink, EntryLink)
            .Render();
}




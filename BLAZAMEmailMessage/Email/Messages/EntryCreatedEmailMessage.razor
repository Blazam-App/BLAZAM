@using BLAZAM.Helpers
@using System.Security
@inherits EmailNotificationTemplateComponent

    <EmailTemplateHeader>
    <strong>@AppLocalization[Lang.Active_Directory_object_created]</strong>
    </EmailTemplateHeader>
   
    <EmailTemplateBody>
        @if(EntryName!=null){
            @AppHelpLocalization[HelpLang.Created,EntryName]
        }
    <br/>
    @if (ShouldRenderLinks)
    {
        <br />
        <EmailLink Href="@EntryLink" />
    }
   
    </EmailTemplateBody>


@code{
    public override string Render() => new EmailTemplateRenderer<LockedOutEmailMessage>()
           .Set(c => c.EntryName, EntryName)
           .Set(c => c.EntryLink, EntryLink)
           .Set(c => c.ActorName, ActorName)
           .Set(c => c.Timestamp, Timestamp)
           .Render();
}




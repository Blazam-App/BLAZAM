@using BLAZAM.Helpers
@using System.Security
@inherits EmailNotificationTemplateComponent

<EmailTemplateHeader>
    <strong>@AppLocalization[Lang.Entry_modified]</strong>
</EmailTemplateHeader>

<EmailTemplateBody>
    @(EntryName + AppLocalization[" has been modified."])
    @if (ActorName.IsNullOrEmpty())
    {
        @AppLocalization[" by"]@ActorName
    }
    @if (Timestamp.IsNullOrEmpty())
    {
        @AppLocalization[" at"]@Timestamp
    }
    
    <br />

   
</EmailTemplateBody>
@if (ShouldRenderLinks)
{
    <br />
    <EmailLink Href="@EntryLink" />
}

@code {

    public override string Render() => new ComponentRenderer<EntryEditedEmailMessage>()
                .UseLayout<DefaultEmailLayout>()
                .AddServiceProvider(ApplicationInfo.services)
                .Set(c => c.EntryName, EntryName)
                    .Set(c => c.EntryLink, EntryLink)
                    .Set(c => c.ActorName, ActorName)
                    .Set(c => c.Timestamp, Timestamp)
                .Render();
}




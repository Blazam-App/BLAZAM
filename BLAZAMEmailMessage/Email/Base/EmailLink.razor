@using BLAZAM.Helpers
@if (_appFQDN.IsNullOrEmpty())
{
    @ChildContent
}
else
{

    <a style="@Style" href="@(_forceHttps ? "https://" : "http://" + _appFQDN + Href)">
        @ChildContent
    </a>
}

@code {
    string? _appFQDN;
    bool _forceHttps;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _appFQDN = DatabaseCache.ApplicationSettings.AppFQDN;
        _forceHttps = DatabaseCache.ApplicationSettings.ForceHTTPS;
        InvokeAsync(StateHasChanged);
    }
    [Parameter]
    public string? Href { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public string Style { get; set; }
}

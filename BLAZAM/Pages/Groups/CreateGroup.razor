@page "/create/group"
@inherits TabbedAppComponentBase
@attribute [Authorize]
<AppPageTitle>@AppLocalization["Create Group"]</AppPageTitle>

<MudTabs Elevation="0" Outlined="true" @bind-ActivePanelIndex="selectedStep">
    <MudTabPanel>
        <ChildContent>
            <MudText>


                <OUTreeView Label=@AppLocalization["Parent Organizational Unit"]
                            SelectedEntryChanged="OUSelected">
                    @* <NodeContent>
                    @context.Name
                    </NodeContent>*@
                </OUTreeView>





                <MudTextField Immediate=true Label=@AppLocalization["Group Name"] @bind-Value=@newGroupName />



                <MudButton Disabled=@(parentOU==null || newGroupName.IsNullOrEmpty())
                           Color="Color.Primary"
                           OnClick="CreateNewGroup">
                    @AppLocalization["Next"]
                </MudButton>
            </MudText>
        </ChildContent>
        <TabContent>
            @AppLocalization["Create"]
        </TabContent>
    </MudTabPanel>
    <MudTabPanel Disabled=@(newGroup==null || newGroupName.IsNullOrEmpty())>
        <ChildContent>
            <MudText>

                <GroupMembersDataGrid Group="newGroup" />




                <MudButton Color="Color.Primary" OnClick="@(()=>{selectedStep=2;})">
                    @AppLocalization["Next"]
                </MudButton>
            </MudText>
        </ChildContent>
        <TabContent>
            @AppLocalization["Assign"]
        </TabContent>
    </MudTabPanel>
    <MudTabPanel Disabled=@(newGroup==null || newGroupName.IsNullOrEmpty())>
        <ChildContent>
            <MudText>
                <ConfirmNewGroup Group="@newGroup" />

            </MudText>
        </ChildContent>
        <TabContent>
            @AppLocalization["Confirm"]
        </TabContent>
    </MudTabPanel>
</MudTabs>





@code {


    int selectedStep;






    string newGroupName = "";
    IADOrganizationalUnit? parentOU;
    IADGroup? newGroup;

    async void OUSelected(IDirectoryEntryAdapter entry)
    {
        if (entry is IADOrganizationalUnit ou)
        {
            if (parentOU == null)
            {
                parentOU = ou;
                return;
            }
            parentOU = ou;


            await InvokeAsync(StateHasChanged);
        }
    }

    void CreateNewGroup()
    {
        LoadingData = true;
        newGroup = parentOU?.CreateGroup(newGroupName);



        selectedStep = 1;


        LoadingData = true;

    }
}

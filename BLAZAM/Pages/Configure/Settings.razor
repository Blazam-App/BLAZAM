@page "/settings"
@page "/settings/{ActiveTabString}"
@layout MainLayout
@attribute [Authorize(Roles = UserRoles.SuperAdmin)]

@inherits TabbedAppComponentBase
<AppPageTitle>@AppLocalization[Lang.Settings]</AppPageTitle>

<SetHeader>
    <MudText>@AppLocalization[Lang.Settings]</MudText>
</SetHeader>
<AuthorizeView>
    @{
        int activeTabIndex = 0;
        if (ActiveTabString != null && ActiveTabString != String.Empty)
        {
            switch (ActiveTabString.ToLower())
            {
                case "app":
                case "application":
                    activeTabIndex = 0;
                    break;
                case "auth":
                case "authentication":
                    activeTabIndex = 1;
                    break;
                case "directory":
                case "activedirectory":
                    activeTabIndex = 2;
                    break;
                case "db":
                case "database":
                    activeTabIndex = 3;
                    break;
                case "email":
                    activeTabIndex = 4;
                    break;
                case "update":
                    activeTabIndex = 5;
                    break;
                case "activity":
                case "useractivity":
                    activeTabIndex = 6;
                    break;
                case "system":
                    activeTabIndex = 7;
                    break;
            }
        }
    }
    <MudTabs ActivePanelIndex="@activeTabIndex">
        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/application");})">
            <ChildContent>
                <ApplicationSettings />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Application]
            </TabContent>
        </MudTabPanel>
        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/authentication");})">
            <ChildContent>
                <AuthenticationSetting />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Authentication]
            </TabContent>


        </MudTabPanel>
        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/activedirectory");})">
            <ChildContent>
                <DirectorySettings />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Active_Directory]
            </TabContent>


        </MudTabPanel>
        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/database");})">
            <ChildContent>
                <DatabaseStatus />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Database]
            </TabContent>


        </MudTabPanel>
        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/email");})">
            <ChildContent>
                <EmailSettings />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Email]
            </TabContent>


        </MudTabPanel>
        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/update");})">
            <ChildContent>
                <UpdateSettings />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Update]
            </TabContent>


        </MudTabPanel>
        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/useractivity");})">
            <ChildContent>
                <UserActivity />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.User_Activity]
            </TabContent>


        </MudTabPanel>

        <MudTabPanel OnClick="@(()=>{Nav.NavigateTo("/settings/system");})">
            <ChildContent>
                <SystemSettings />

            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.System]
            </TabContent>


        </MudTabPanel>

    </MudTabs>

</AuthorizeView>

@code {
    [Parameter]
    public string? ActiveTabString { get; set; }
}

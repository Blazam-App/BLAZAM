@page "/api-tokens"
@using BLAZAM.Global.Data
@attribute [Authorize(Roles = UserRoles.SuperAdmin)]

@inherits DatabaseComponentBase
<AppPageTitle>@AppLocalization[Lang.API_Tokens]</AppPageTitle>

<AuthorizeView Roles=@UserRoles.SuperAdmin>

    <SetHeader>
        <MudSwitch T=bool Color="@Color.Success"
                   @bind-Value=ShowDeleted
                   UncheckedColor="Color.Error"
                   Label="@AppLocalization[Lang.Show_Deleted]" />
    </SetHeader>

    <MudText Typo="Typo.h4">@AppLocalization[Lang.API_Tokens] <AppDocumentationButton Page="/admin/api" /></MudText>
    <MudLink Href="/swagger" Target="_blank">
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Filled"
                  Class="mb-5"
                  Icon="@Icons.Material.Filled.BookOnline">
            @AppLocalization["Click to view API documentation"].
        </MudAlert>
    </MudLink>
    <ApiTokenDataGrid @ref=_apiTokenDataGrid
        Tokens="_tokens"
                      ShowUser="true"
                      ShowDeleted="ShowDeleted"
                      ShowAllTokens="true"
                      OnTokenDeleted="@(async (token) => { await Delete(token); })" />
    <MudButton Color="Color.Primary" OnClick="@(Save)">@AppLocalization[Lang.Save]</MudButton>
</AuthorizeView>


@code {
    List<ApiToken> _tokens = new();

    ApiTokenDataGrid? _apiTokenDataGrid;

    bool _showDeleted;

    bool ShowDeleted
    {
        get => _showDeleted; set
        {
            if (_showDeleted == value) return;
            _showDeleted = value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _ = Task.Run(()=>
        {
            _ = GetTokensAsync();     
        }); 

        LoadingData = false;
    }

    public async Task Save()
    {
        await Context.SaveChangesAsync();
        SnackBarService.Success(AppLocalization["Changes have been saved"]);
    }

    private async Task Delete(ApiToken? tokenToDelete)
    {
        if (tokenToDelete != null
            && await MessageService.Confirm(AppLocalization["Are you sure you want to delete this API token?"]
                                            , AppLocalization["Confirm delete"]))
        {
            var existingToken = await Context.ApiTokens.FirstAsync(t => t.Id == tokenToDelete.Id);
            existingToken.DeletedAt = DateTime.UtcNow;
            await Context.SaveChangesAsync();
            if (_apiTokenDataGrid != null)
            {
                await GetTokensAsync();
            }
        }


    }

    public async Task GetTokensAsync()
    {
        LoadingData = true;
        if (ShowDeleted)
            _tokens = await Context.ApiTokens.Include(t => t.User).ToListAsync();
        else
            _tokens = await Context.ApiTokens.Where(t => t.DeletedAt == null).Include(t => t.User).ToListAsync();


        LoadingData = false;

    }
}

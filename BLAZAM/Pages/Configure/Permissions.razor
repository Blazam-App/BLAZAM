@page "/permissions"
@page "/permissions/{ActiveTab}"
@attribute [Authorize(Roles = UserRoles.SuperAdmin)]

@inherits TabbedAppComponentBase
<AppPageTitle>@AppLocalization[Lang.Permissions]</AppPageTitle>

<AuthorizeView Roles=@UserRoles.SuperAdmin>

    <SetHeader>
        <MudText>@AppLocalization[Lang.Permissions]</MudText>
    </SetHeader>




    <MudTabs ActivePanelIndex="@ActiveTab">
        <MudTabPanel>
            <ChildContent>


                @if (Monitor.DirectoryConnectionStatus == ServiceConnectionState.Up)
                {
                    <DelegateEditor />
                }


            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Delegates]
            </TabContent>
        </MudTabPanel>
        <MudTabPanel>
            <ChildContent>


                <AccessLevelEditor />


            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Access_Levels]
            </TabContent>

        </MudTabPanel>
        <MudTabPanel>
            <ChildContent>

                @if (Monitor.DirectoryConnectionStatus == ServiceConnectionState.Up)
                {
            
                    <PermissionMapper />

                }


            </ChildContent>
            <TabContent>
                @AppLocalization[Lang.Mappings]
            </TabContent>

        </MudTabPanel>
        <MudTabPanel>
            <ChildContent>

                @if (Monitor.DirectoryConnectionStatus == ServiceConnectionState.Up)
                {
                    <EffectivePermissionSimulator />

                }


            </ChildContent>
            <TabContent>
                @AppLocalization["Effective Permissions"]
            </TabContent>

        </MudTabPanel>
        <MudTabPanel>
            <ChildContent>

                @if (Monitor.DirectoryConnectionStatus == ServiceConnectionState.Up)
                {
                    <GlobalPermissions />

                }


            </ChildContent>
            <TabContent>
                @AppLocalization["Global Settings"]
            </TabContent>

        </MudTabPanel>
    </MudTabs>


    
</AuthorizeView>


@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        BaseUri = "/permissions";
    }
}

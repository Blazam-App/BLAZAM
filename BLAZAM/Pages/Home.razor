@attribute [Authorize]
@inherits DatabaseComponentBase
@page "/Home"
@using BLAZAM.Gui.UI.Dashboard
@using BLAZAM.Gui.Helper
@using BLAZAM.Gui.UI.Outputs.Jobs;
@{
    string testValue = "";
    Type valueType = testValue.GetType();
}
<AppPageTitle>@AppLocalization["Home"]</AppPageTitle>

@if (MOTD.HasValue && MOTD.Value.ToString() != "")
{
    <MudAlert Class="mb-6 mud-theme-info rounded-t-0"  ShowCloseIcon=false Elevation="3">


        @MOTD.Value

    </MudAlert>
}


<CurrentUserDashboardWidgets />


@if (ApplicationInfo.InDebugMode)
{

    <MudButton Variant="Variant.Filled" OnClick="testJob">Run Test Job</MudButton>
}

@code {
    MarkupString? MOTD;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            MOTD = (MarkupString)(await Context?.AppSettings.FirstOrDefaultAsync())?.MOTD;
        }
        catch
        {

        }
        await InvokeAsync(StateHasChanged);
    }
    private IJob TestJob
    {
        get
        {
            var job = new Job("Test Job", requestingUser: CurrentUser.State.Username);
            var job2 = new Job("Nested Job");
            var step1 = new JobStep("Regular Step Passes", (step) =>
            {
                for (int x = 1; x < 6; x++)
                {
                    Task.Delay(400).Wait();
                    step.Progress = (x / 5.0) * 100.0;
                }
                return true;
            });
            var step2 = new JobStep("Regular Step Fails", (step) => { Task.Delay(2000).Wait(); return false; });
            var step3 = new JobStep("Regular Step Throws", bool (step) => { Task.Delay(2000).Wait(); throw new ApplicationException("Test exception"); });
            var step4 = new JobStep("Nested Step Passes", (step) => { Task.Delay(2000).Wait(); return true; });
            var step5 = new JobStep("Nested Step Fails", (step) => { Task.Delay(2000).Wait(); return false; });
            var step6 = new JobStep("Nested Step Throws", bool (step) => { Task.Delay(2000).Wait(); throw new ApplicationException("Test exception"); });

            job.AddStep(step1);
            job.AddStep(step2);
            job.AddStep(step3);
            job2.AddStep(step4);
            job2.AddStep(step5);
            job2.AddStep(step6);
            job.AddStep((IJobStep)job2);
            return job;
        }
    }
    private async Task testJob()
    {
        var test = TestJob;
        test.ShowJobDetailsDialog(MessageService);
        var result = await test.RunAsync();


    }

}
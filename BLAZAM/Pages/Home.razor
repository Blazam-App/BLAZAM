@attribute [Authorize]
@inherits DatabaseComponentBase
@page "/home"
@using BLAZAM.Gui.UI.Dashboard
@using BLAZAM.Gui.Helper
@using BLAZAM.Gui.UI.Outputs.Jobs;

<AppPageTitle>@AppLocalization[Lang.Home]</AppPageTitle>

@if (MOTD.HasValue && MOTD.Value.ToString() != "")
{
    _motdShown = true;
    <MudAlert Severity=Severity.Info
              Class="mb-2 rounded-t-0"
              ShowCloseIcon=false
              Elevation="3"
              Dense=true
              Variant="Variant.Filled">


        @MOTD.Value

    </MudAlert>
}

<DemoHelpAlert />

@if (CurrentUser.State.IsSuperAdmin && ApplicationInfo.InDebugMode)
{
    string cssClass = "my-2 " + (_motdShown ? "" : "rounded-t-0");
    <MudAlert Severity=Severity.Warning
              Class=@cssClass 
              ShowCloseIcon=false
              Dense=true
              Variant="Variant.Outlined">


        @AppHelpLocalization[HelpLang.Debug_Enabled_Warning]

    </MudAlert>
}

<CurrentUserDashboardWidgets />

@code {
    MarkupString? MOTD;
    bool _motdShown;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            MOTD = (MarkupString)((await Context!.AppSettings.FirstOrDefaultAsync())!.MOTD)!;
        }
        catch
        {
            // ignored if the database isn't available
        }
        await InvokeAsync(StateHasChanged);
    }
  

}
@page "/recyclebin"
@using BLAZAM.Global.Data
@using BLAZAM.Gui.UI.Groups
@inherits AppComponentBase
@attribute [Authorize(Roles = UserRoles.SuperAdmin)]
<AppPageTitle>@AppLocalization[Lang.Recycle_Bin]</AppPageTitle>


<MudDataGrid T="IDirectoryEntryAdapter"
             Virtualize=true
             RowsPerPage=10
             ColumnResizeMode="ResizeMode.Container"
             Class=""
             Loading=@LoadingData
             Hideable=true
             @bind-SelectedItems=@selectedEntries
             Square=true
             MultiSelection=true
             Height="80vh"
             Items="@deletedObjects"
             Filterable="false"
             SortMode="@SortMode.Multiple"
             Groupable="false">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@AppLocalization[Lang.Recycle_Bin]</MudText>
        <MudSpacer />
        <MudButton Color="Color.Primary"
                   Variant="@Variant.Outlined"
                   OnClick="@(async()=>{await RestoreSelected();})">
            @AppLocalization[Lang.Restore_Selected]
        </MudButton>

    </ToolBarContent>
    <PagerContent>
        <MudDataGridPager T="IDirectoryEntryAdapter" />
    </PagerContent>
    <Columns>
        <SelectColumn T="IDirectoryEntryAdapter" ShowInFooter=false ShowInHeader=true />
        <TemplateColumn Title=@AppLocalization[Lang.Type]>
            <CellTemplate>
                <DirectoryEntryTypeIcon Entry="@context.Item" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CanonicalName" Title=@AppLocalization[Lang.Name] />
        <PropertyColumn Property="x => x.LastKnownParent" Title=@AppLocalization[Lang.Last_OU] />
        <PropertyColumn Property="x => x.LastChanged" Title=@AppLocalization[Lang.Deleted] />
        <TemplateColumn CellClass="d-flex justify-end" Title=@AppLocalization[Lang.Restore]>
            <CellTemplate>
                <MudStack Row=true>
                    <MudButton Color="Color.Primary"
                               Variant="@Variant.Outlined"
                               OnClick="@(async()=>{await Restore(context.Item);})">
                        @AppLocalization[Lang.Restore]
                    </MudButton>

                </MudStack>
            </CellTemplate>
        </TemplateColumn>

    </Columns>
</MudDataGrid>

@code {







    HashSet<IDirectoryEntryAdapter> selectedEntries = new();



    List<IDirectoryEntryAdapter> deletedObjects = new();
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await GetDeletedEntries();
    }
    async Task GetDeletedEntries()
    {

        LoadingData = true;
        await Task.Run(() =>
        {
            var search = new ADSearch(Directory) { SearchRoot = Directory.GetDeleteObjectsEntry() };
            search.SearchDeleted = true;
            deletedObjects = search.Search<DirectoryEntryAdapter, IDirectoryEntryAdapter>();
            foreach (var del in deletedObjects)
            {
                _ = del.LastKnownParent;
            }
            LoadingData = false;
        });
    }

    //TODO stop the confimation message on batch restore
    private async Task RestoreSelected()
    {
        if (await MessageService.Confirm("Are you sure you want to restore the selected entries", "Restore?"))
        {
            var batchRestore = new Job(AppLocalization[Lang.Restore]);
            foreach (var entry in selectedEntries)
            {
                var restoreEntryStep = new JobStep(AppLocalization["Restore: "] + entry.CanonicalName, (step) =>
                {
                    if (RestoreEntry(entry))
                        return true;
                    return false;

                });
                batchRestore.Steps.Add(restoreEntryStep);
            }
            await batchRestore.ShowJobDetailsDialogAsync(MessageService);
            await batchRestore.RunAsync();

        }
    }
    async Task Restore(IDirectoryEntryAdapter entryToRestore)
    {
        if (entryToRestore.LastKnownParent == null) throw new AppException("Tombstone item has no  LastKnownParent");
        if (await MessageService.Confirm("Are you sure you want to restore " + entryToRestore.CanonicalName + " to " + entryToRestore.LastKnownParent?.CanonicalName, "Restore?"))
        {
            if (RestoreEntry(entryToRestore))
            {
                SnackBarService.Success(entryToRestore.CanonicalName + " restored successfully");
                await GetDeletedEntries();
            }
            else
            {
                SnackBarService.Error(entryToRestore.CanonicalName + " could not be restored");

            }

        }
    }
    bool RestoreEntry(IDirectoryEntryAdapter entry)
    {
        var result = (entry.LastKnownParent != null && Directory.RestoreTombstone(entry, entry.LastKnownParent));
        if (result)
        {
            AuditLogger.System.Analytics.ObjectRestored(entry.ObjectType);
        }
        return result;
    }

}

@page "/install"
@page "/install/{selectedStep:int}"
@using BLAZAM.Global.Enums
@layout InstallLayout
@inherits DatabaseComponentBase
@inject ApplicationManager ApplicationManager
@inject BLAZAM.Services.Analytics AnalyticsService

<PageTitle>Install - Blazam</PageTitle>

@if (completedSteps == 0)
{
    <MudCard>
        <MudCardHeader>
            Checking Installation
        </MudCardHeader>
        <MudCardContent>
            Please wait while the installation status of the application is checked...

        </MudCardContent>
    </MudCard>
}
else
{
    <MudTabs Centered Elevation="1" ActivePanelIndex="@selectedStep" ActivePanelIndexChanged="@OnSelectedStepChanged">
        <MudTabPanel Disabled=@(completedSteps < 1)
                     Icon="@(completedSteps>1?Icons.Material.Filled.CheckCircle:null)"
                     ToolTip="Database"
                     Text="1">
            @if (completedSteps > 0)
            {
                <InstallDatabase Completed=@(completedSteps > 1) StepCompleted="UpdateStatusesAsync" />
            }
        </MudTabPanel>
        <MudTabPanel Disabled=@(completedSteps < 2)
                     Text="2"
                     ToolTip="Authentication"
                     Icon="@(completedSteps>2?Icons.Material.Filled.CheckCircle:null)">
            @if (completedSteps > 1)
            {
                <Authentication StepCompleted="UpdateStatusesAsync" />
            }

        </MudTabPanel>
        <MudTabPanel Disabled=@(completedSteps < 3)
                     Text="3"
                     ToolTip="Active Directory"
                     Icon="@(completedSteps>3?Icons.Material.Filled.CheckCircle:null)">
            @if (completedSteps > 2)
            {
                <ADirectory StepCompleted="(() => { completedSteps++; })" />
            }
        </MudTabPanel>
        <MudTabPanel Disabled=@(completedSteps < 4)
                     Icon="@Icons.Material.Filled.FlagCircle"
                     ToolTip="Finish">
            <h2>Installation Complete</h2>
            <MudButton @onclick="FinalizeInstall" Color="Color.Success">Finalize Install</MudButton>
        </MudTabPanel>

    </MudTabs>
}










@code {
    int _completedSteps = 0;
    int completedSteps
    {
        get => _completedSteps; set
        {
            _completedSteps = value;
            selectedStep = value - 1;

        }
    }
    [Parameter]
    public int selectedStep { get; set; } = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (ApplicationInfo.InstallationCompleted){
            Loggers.SystemLogger.Information("Redirecting from insall to index page.");

            Nav.NavigateTo("/");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        //CheckDatabase
        await UpdateStatusesAsync();


    }

    /// <summary>
    /// Checks system statuses sequentially and updates the UI.
    /// Refactored to a Cognitive Complexity of 11.
    /// </summary>
    async Task UpdateStatusesAsync() // Changed to `async Task` for better error handling
    {
        Context = await DbFactory.CreateDbContextAsync();
        completedSteps = 1;

        // --- Guard Clauses to Reduce Nesting ---

        // 1. Check for a valid context and database connection.
        if (Context?.Status != ServiceConnectionState.Up)
        {
            if (Context != null) // Only navigate if the context exists but is down
            {
                Nav.NavigateTo("/oops");
            }
            else // Otherwise, just update the UI with the initial step
            {
                await StateHasChangedAsync();
            }
            return; // Exit early
        }

        // 2. Check for pending migrations.
        if ((await Context.Database.GetPendingMigrationsAsync()).Any())
        {
            await StateHasChangedAsync(); // Update UI before exiting
            return;
        }

        completedSteps = 2;
        await StateHasChangedAsync();

        // --- Flattened Logic within try/finally ---
        // The try/finally ensures the UI is always updated at the end
        try
        {
            // Fetch settings once to avoid redundant database calls.
            var authSettings = await Context.AuthenticationSettings.FirstOrDefaultAsync();

            // 3. Check auth settings and return if invalid.
            if (authSettings == null || authSettings.AdminPassword == "password")
            {
                return; // Exit if auth is not configured.
            }

            completedSteps = 3;
            await StateHasChangedAsync();

            // 4. Check Active Directory settings.
            var adSettings = await Context.ActiveDirectorySettings.FirstOrDefaultAsync();
            if (adSettings == null || Directory.Status != DirectoryConnectionStatus.OK)
            {
                return; // Exit if AD is not configured or connected.
            }

            completedSteps = 4;
        }
        catch (Exception ex)
        {
            Loggers.SystemLogger.Error(ex, "Error during installation status update");
        }
        finally
        {
            // This `finally` block guarantees a final UI update, which was the
            // behavior of the original method's last line.
            await StateHasChangedAsync();
        }
    }

    private Task OnSelectedStepChanged(int index)
    {
        selectedStep = index;

        return Task.CompletedTask;
    }


    private async void FinalizeInstall()
    {
        try
        {
            if (await Context?.AppSettings.FirstOrDefaultAsync()! == null)
            {
                var settings = new AppSettings();
                settings.Id = 1;
                Context.AppSettings.Add(settings);
                await Context.SaveChangesAsync();
                DatabaseCache.ApplicationSettings = settings;
            }
            (await Context.AppSettings.FirstOrDefaultAsync())!.InstallationCompleted = true;
            _ = await Context.SaveChangesAsync();
            ApplicationInfo.InstallationCompleted = true;
            try
            {
                Loggers.SystemLogger.Warning("Installation Finalized");
            }
            catch
            {
                //Ignore logging errors
            }
            await AnalyticsService.InstallationFinalized();
            Nav.NavigateTo("/home", true);

            ApplicationManager.Restart();
        }
        catch
        {
            SnackBarService.Error("Sorry, ran into an error while finalizing install");

        }

    }
}

@inherits AppComponentBase
@inject NotificationGenerationService OUNotificationService

<AppPageTitle>@AppLocalization["Confirm OU Creation"]</AppPageTitle>

@if (OU != null)
{
    <MudCard>
            @OU.ADSPath
        
    </MudCard>
    <MudButton Color=Color.Success OnClick="CommitChanges">@AppLocalization["Create"]</MudButton>
}
@code {

    #nullable disable warnings



    [Parameter]
    public EventCallback<IADOrganizationalUnit> Confirmed { get; set; }

    [Parameter]
    public IADOrganizationalUnit OU { get; set; }

    async Task CommitChanges()
    {
        if (await MessageService.Confirm("Are you sure you want to create this OU?", "Create OU"))
        {
            var results = await OU.CommitChangesAsync();
            if (results.FailedSteps.Count == 0)
            {
                OU = (IADOrganizationalUnit)Directory.GetDirectoryEntryByDN(OU.DN);
                SnackBarService.Success(AppLocalization["OU created"]);
                await AuditLogger.OU.Created(OU);
                _ = OUNotificationService.PostAsync(OU, NotificationType.Create, CurrentUser.State);
                await Confirmed.InvokeAsync(OU);
                Nav.NavigateTo("/ou/create", true);
            }
        }
    }
}
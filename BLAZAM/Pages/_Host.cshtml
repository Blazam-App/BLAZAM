@page "/"
@namespace BLAZAM.Server.Pages
@using Microsoft.AspNetCore.Components
@using Microsoft.Data.SqlClient
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Storage
@inject NavigationManager NavManager
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";



}

<component type="typeof(App)" render-mode="Server" />


<div id="components-reconnect-modal" class="my-reconnect-modal components-reconnect-hide absolute">
    <div class="show">
        <div class="mud-overlay-scrim mud-overlay-absolute mud-overlay-is-open" style="z-index: 1300;"></div>

        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; z-index: 1301;">

            <div class="mud-dialog mud-dialog-width-sm mud-elevation-24 mud-paper">


                <div class="mud-dialog-content py-5 px-8">

                    <p class="mud-typography mud-typography-h6 text-center">Connection Lost</p>
                    <div class="d-flex justify-center my-4">
                        <div role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" class="mud-progress-circular mud-primary-text mud-progress-medium mud-progress-indeterminate">
                            <svg class="mud-progress-circular-svg" viewBox="22 22 44 44">
                                <circle class="mud-progress-circular-circle mud-progress-indeterminate" cx="44" cy="44" r="20" fill="none" stroke-width="3"></circle>
                            </svg>
                            <div class="mud-progress-circular-percentage mud-progress-circular-indeterminate-child"></div>
                        </div>
                    </div>
                    <p class="mud-typography mud-typography-body1 text-center my-4">Attempting to reconnect...</p>
                    <span id="components-reconnect-current-attempt">1</span><span>/8</span>
                </div>



            </div>
        </div>
    </div>
    <div class="failed">
        <div class="mud-overlay-scrim mud-overlay-absolute mud-overlay-is-open" style="z-index: 1300;"></div>

        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; z-index: 1301;">

            <div class="mud-dialog mud-dialog-width-sm mud-elevation-24 mud-paper">


                <div class="mud-dialog-title">
                    <p class="mud-typography mud-typography-h6 text-center mud-error-text pt-4">Connection Failed</p>
                </div>
                <div class="mud-dialog-content">
                    <p class="mud-typography mud-typography-body1 text-center my-4 px-4">Could not reconnect to Blazam. Please check your network connection.</p>
                </div>
                <div class="mud-input-control-input-container mb-5" onclick="window.location.reload();">
                    <div>
                        <label type="button" class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium mud-ripple" _bl_16e98d2d-f641-4989-b9f0-6f0817c77839="" style="--mud-ripple-offset-x: -8.1796875px; --mud-ripple-offset-y: 1.5px;">
                            <span class="mud-button-label">
                                <p class="mud-typography mud-typography-body1">Refresh</p>
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="rejected">
        <div class="mud-dialog-actions pa-4 d-flex justify-center">
            <button id="serverBackOnline" onclick="window.location.reload();" class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium mud-ripple">
                Refresh
            </button>
        </div>
    </div>
</div>






